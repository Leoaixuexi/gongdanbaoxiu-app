/* Edit User Page Styles */

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #f5f5f5;
}

.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100%;
}

.form-scroll {
  flex: 1;
  overflow-y: auto;
}

.form-container {
  padding: 32rpx;
}

.form-section {
  background-color: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.form-label.required::before {
  content: '*';
  color: #f44336;
  margin-right: 8rpx;
}

.readonly-field {
  padding: 20rpx 24rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 24rpx;
  font-size: 28rpx;
  color: #999;
  background-color: #f5f5f5;
}

.weui-input {
  padding: 20rpx 24rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 24rpx;
  font-size: 28rpx;
  background-color: #fff;
}

.weui-input.error {
  border-color: #f44336;
}

.form-hint {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
  line-height: 1.5;
}

.form-hint.warning {
  color: #ff9800;
}

.error-text {
  font-size: 24rpx;
  color: #f44336;
  margin-top: 12rpx;
}

.picker-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 24rpx;
  background-color: #fff;
}

.picker-container.disabled {
  background-color: #f5f5f5;
  color: #999;
}

.picker-text {
  font-size: 28rpx;
  color: #333;
}

.picker-text.placeholder {
  color: #999;
}

.form-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* Action Buttons */
.action-buttons {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  background-color: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.action-buttons button {
  flex: 1;
  margin: 0;
}

.cancel-btn {
  background-color: #f5f5f5;
  color: #666;
}

.cancel-btn::after {
  border: none;
}

/* Modal Styles */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.modal-container {
  width: 100%;
  max-height: 70vh;
  background-color: #fff;
  border-radius: 32rpx 32rpx 0 0;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}

.modal-content {
  max-height: 60vh;
  overflow-y: auto;
  padding: 16rpx 0;
}

.option-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  font-size: 28rpx;
  color: #333;
  transition: background-color 0.2s;
}

.option-item.selected {
  background-color: #f0f9f0;
  color: #1aad19;
}

.option-item:active {
  background-color: #f5f5f5;
}

.option-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.option-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.option-desc {
  font-size: 24rpx;
  color: #999;
}

.empty-hint {
  padding: 80rpx 32rpx;
  text-align: center;
  font-size: 28rpx;
  color: #999;
}

/* Confirmation Modal */
.confirm-modal {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 600rpx;
  background-color: #fff;
  border-radius: 24rpx;
  overflow: hidden;
}

.confirm-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  padding: 40rpx 32rpx 24rpx;
  text-align: center;
}

.confirm-content {
  font-size: 28rpx;
  color: #666;
  padding: 0 32rpx 40rpx;
  line-height: 1.6;
  text-align: center;
}

.confirm-actions {
  display: flex;
  border-top: 1rpx solid #f0f0f0;
}

.confirm-actions button {
  flex: 1;
  margin: 0;
  border-radius: 0;
}

.confirm-actions button::after {
  border: none;
}

.confirm-actions button:first-child {
  border-right: 1rpx solid #f0f0f0;
}
