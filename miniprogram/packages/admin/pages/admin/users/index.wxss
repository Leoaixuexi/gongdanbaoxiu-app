/* User Management Page Styles */

/* 页面容器 */
.user-page {
  min-height: 100vh;
  background-color: #F5F5F5;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* 筛选栏 */
.filter-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  background: #FFFFFF;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

/* 搜索框 */
.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 24rpx;
  background: #F3F4F6;
  border-radius: 32rpx;
}

.search-icon {
  font-size: 28rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1F2937;
}

.clear-icon {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #9CA3AF;
  background: #E5E7EB;
  border-radius: 50%;
}

/* 筛选按钮 */
.filter-btn {
  position: relative;
  padding: 16rpx 28rpx;
  background: #F3F4F6;
  border-radius: 32rpx;
  font-size: 28rpx;
  color: #6B7280;
}

.filter-badge {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 16rpx;
  height: 16rpx;
  background: #0CA77D;
  border-radius: 50%;
}

/* 筛选面板 */
.filter-panel {
  max-height: 0;
  overflow: hidden;
  background: #FFFFFF;
  transition: max-height 0.3s ease;
}

.filter-panel.show {
  max-height: 400rpx;
  padding: 24rpx;
  border-top: 1rpx solid #F3F4F6;
}

.filter-group {
  margin-bottom: 24rpx;
}

.filter-label {
  font-size: 26rpx;
  color: #6B7280;
  margin-bottom: 16rpx;
}

.filter-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.filter-option {
  padding: 12rpx 24rpx;
  background: #F3F4F6;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #6B7280;
}

.filter-option.active {
  background: #0CA77D;
  color: #FFFFFF;
}

.filter-actions {
  display: flex;
  justify-content: flex-end;
}

.reset-btn {
  font-size: 26rpx;
  color: #EF4444;
}

/* 用户列表 */
.user-list {
  padding: 24rpx;
}

/* 加载状态 */
.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 120rpx 0;
  color: #9CA3AF;
  font-size: 28rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #6B7280;
}

/* 用户卡片 */
.user-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.user-card.disabled {
  opacity: 0.7;
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.user-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #0CA77D 0%, #10B981 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.user-avatar text {
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.user-info {
  flex: 1;
}

.user-name {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.user-name text {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2937;
}

.status-tag {
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.status-tag.active {
  background: rgba(16, 185, 129, 0.15);
  color: #10B981;
}

.status-tag.inactive {
  background: rgba(239, 68, 68, 0.15);
  color: #EF4444;
}

.user-username {
  font-size: 26rpx;
  color: #9CA3AF;
}

.card-body {
  margin-bottom: 20rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F3F4F6;
}

.info-row {
  display: flex;
  margin-bottom: 8rpx;
}

.info-label {
  font-size: 26rpx;
  color: #9CA3AF;
  min-width: 80rpx;
}

.info-value {
  font-size: 26rpx;
  color: #374151;
}

/* 操作按钮 */
.card-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F3F4F6;
}

.action-btn {
  padding: 14rpx 28rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  background: #F3F4F6;
  color: #6B7280;
}

.action-btn:active {
  background: #E5E7EB;
}

.action-btn.primary {
  background: linear-gradient(135deg, #0CA77D 0%, #10B981 100%);
  color: #FFFFFF;
}

.action-btn.warn {
  background: linear-gradient(135deg, #F97316 0%, #FB923C 100%);
  color: #FFFFFF;
}

.action-btn.danger {
  background: linear-gradient(135deg, #EF4444 0%, #F87171 100%);
  color: #FFFFFF;
}

/* 浮动按钮 */
.fab-button {
  position: fixed;
  right: 40rpx;
  bottom: calc(100rpx + env(safe-area-inset-bottom));
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #0CA77D 0%, #10B981 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(12, 167, 125, 0.4);
  z-index: 100;
}

.fab-button:active {
  transform: scale(0.9);
}

.fab-icon {
  font-size: 56rpx;
  color: #FFFFFF;
  font-weight: 300;
}
