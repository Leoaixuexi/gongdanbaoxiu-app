/* System Config Page Styles */

/* 页面容器 */
.config-page {
  min-height: 100vh;
  background-color: #F5F5F5;
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* 页面标题 */
.page-header {
  padding: 40rpx 32rpx 32rpx;
  background: linear-gradient(135deg, #0CA77D 0%, #10B981 100%);
}

.header-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.header-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 加载状态 */
.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 120rpx 0;
  color: #9CA3AF;
  font-size: 28rpx;
}

/* 配置内容 */
.config-content {
  padding: 24rpx;
}

/* 配置列表 */
.config-list {
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

/* 配置项 */
.config-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #F3F4F6;
}

.config-item:last-child {
  border-bottom: none;
}

.config-info {
  flex: 1;
  min-width: 0;
}

.config-name {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: #1F2937;
  margin-bottom: 6rpx;
}

.config-desc {
  display: block;
  font-size: 24rpx;
  color: #9CA3AF;
}

.config-control {
  flex-shrink: 0;
  margin-left: 20rpx;
}

/* 文本输入 */
.config-input {
  width: 260rpx;
  height: 64rpx;
  padding: 0 20rpx;
  background: #F9FAFB;
  border: 2rpx solid #E5E7EB;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #374151;
  text-align: right;
}

.config-input.number {
  width: 160rpx;
}

.config-input:focus {
  border-color: #0CA77D;
  background: #FFFFFF;
}

/* 开关样式 */
.config-switch {
  padding: 8rpx;
}

.switch-track {
  width: 88rpx;
  height: 48rpx;
  background: #E5E7EB;
  border-radius: 24rpx;
  position: relative;
  transition: background 0.2s;
}

.switch-track.on {
  background: #0CA77D;
}

.switch-thumb {
  width: 40rpx;
  height: 40rpx;
  background: #FFFFFF;
  border-radius: 50%;
  position: absolute;
  top: 4rpx;
  left: 4rpx;
  transition: left 0.2s;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.switch-track.on .switch-thumb {
  left: 44rpx;
}

/* 操作按钮 */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid #F3F4F6;
  gap: 24rpx;
}

.btn-reset,
.btn-save {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.btn-reset {
  background: #F3F4F6;
  color: #6B7280;
}

.btn-save {
  background: #E5E7EB;
  color: #9CA3AF;
}

.btn-save.active {
  background: linear-gradient(135deg, #0CA77D 0%, #10B981 100%);
  color: #FFFFFF;
}

.btn-reset:active,
.btn-save.active:active {
  opacity: 0.9;
}

/* 修改提示 */
.change-tip {
  position: fixed;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  left: 50%;
  transform: translateX(-50%);
  padding: 12rpx 32rpx;
  background: rgba(239, 68, 68, 0.9);
  border-radius: 32rpx;
  font-size: 24rpx;
  color: #FFFFFF;
}
