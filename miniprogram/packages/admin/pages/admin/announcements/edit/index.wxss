/* Announcement Edit Page Styles */

/* 页面容器 */
.edit-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #F5F5F5;
}

.edit-scroll {
  flex: 1;
  overflow-y: auto;
}

.form-container {
  padding: 24rpx;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* 表单区块 */
.form-section {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.section-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
  margin-bottom: 20rpx;
}

/* 输入框 */
.form-input {
  width: 100%;
  padding: 24rpx;
  border: 2rpx solid #E5E7EB;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #1F2937;
  background: #FAFAFA;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: #0CA77D;
  background: #FFFFFF;
}

.input-counter {
  text-align: right;
  font-size: 24rpx;
  color: #9CA3AF;
  margin-top: 12rpx;
}

/* 富文本编辑器工具栏 */
.editor-toolbar {
  display: flex;
  gap: 12rpx;
  padding: 16rpx;
  background: #F3F4F6;
  border-radius: 16rpx 16rpx 0 0;
  border: 2rpx solid #E5E7EB;
  border-bottom: none;
}

.toolbar-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  border-radius: 12rpx;
  border: 1rpx solid #E5E7EB;
}

.toolbar-btn:active {
  background: #E5E7EB;
}

.toolbar-icon {
  font-size: 28rpx;
  font-weight: 600;
  color: #374151;
}

.toolbar-icon.italic {
  font-style: italic;
}

.toolbar-icon.underline {
  text-decoration: underline;
}

/* 编辑器内容区 */
.editor-content {
  min-height: 400rpx;
  padding: 24rpx;
  border: 2rpx solid #E5E7EB;
  border-top: none;
  border-radius: 0 0 16rpx 16rpx;
  background: #FFFFFF;
  font-size: 30rpx;
  line-height: 1.8;
}

/* 复选框组 */
.checkbox-group {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.checkbox-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 28rpx;
  background: #F3F4F6;
  border-radius: 32rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.checkbox-item.checked {
  background: rgba(12, 167, 125, 0.1);
  border-color: #0CA77D;
}

.checkbox-icon {
  width: 40rpx;
  height: 40rpx;
  border-radius: 8rpx;
  background: #FFFFFF;
  border: 2rpx solid #D1D5DB;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #0CA77D;
}

.checkbox-item.checked .checkbox-icon {
  background: #0CA77D;
  border-color: #0CA77D;
  color: #FFFFFF;
}

.checkbox-label {
  font-size: 28rpx;
  color: #374151;
}

/* 选择器 */
.form-picker {
  padding: 24rpx;
  border: 2rpx solid #E5E7EB;
  border-radius: 16rpx;
  background: #FAFAFA;
  font-size: 30rpx;
  color: #1F2937;
}

.form-picker .placeholder {
  color: #9CA3AF;
}

.clear-btn {
  display: inline-block;
  margin-top: 16rpx;
  padding: 12rpx 24rpx;
  background: #F3F4F6;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #EF4444;
}

/* 操作按钮 */
.action-buttons {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.save-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #0CA77D 0%, #10B981 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(12, 167, 125, 0.3);
}

.save-btn:active {
  transform: scale(0.98);
}

.save-btn[disabled] {
  background: #D1D5DB;
  box-shadow: none;
}
