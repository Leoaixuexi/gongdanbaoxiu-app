<!--
  Announcement Edit Page
  公告编辑页面 - 支持富文本编辑
-->
<view class="edit-page">
  <scroll-view scroll-y class="edit-scroll" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view class="form-container">
      <!-- 标题 -->
      <view class="form-section">
        <view class="section-label">公告标题</view>
        <input
          class="form-input"
          placeholder="请输入公告标题"
          value="{{formData.title}}"
          bindinput="onTitleInput"
          maxlength="50"
        />
        <view class="input-counter">{{formData.title.length || 0}}/50</view>
      </view>

      <!-- 富文本编辑器 -->
      <view class="form-section">
        <view class="section-label">公告内容</view>
        <view class="editor-toolbar">
          <view class="toolbar-btn" bindtap="formatText" data-type="bold">
            <text class="toolbar-icon">B</text>
          </view>
          <view class="toolbar-btn" bindtap="formatText" data-type="italic">
            <text class="toolbar-icon italic">I</text>
          </view>
          <view class="toolbar-btn" bindtap="formatText" data-type="underline">
            <text class="toolbar-icon underline">U</text>
          </view>
          <view class="toolbar-btn" bindtap="insertOrderedList">
            <text class="toolbar-icon">1.</text>
          </view>
          <view class="toolbar-btn" bindtap="insertUnorderedList">
            <text class="toolbar-icon">•</text>
          </view>
          <view class="toolbar-btn" bindtap="undo">
            <text class="toolbar-icon">↩</text>
          </view>
          <view class="toolbar-btn" bindtap="redo">
            <text class="toolbar-icon">↪</text>
          </view>
        </view>
        <editor
          id="editor"
          class="editor-content"
          placeholder="请输入公告内容"
          bindready="onEditorReady"
          bindinput="onEditorInput"
        />
      </view>

      <!-- 可见角色 -->
      <view class="form-section">
        <view class="section-label">可见角色</view>
        <view class="checkbox-group">
          <view
            wx:for="{{roleOptions}}"
            wx:key="value"
            class="checkbox-item {{item.checked ? 'checked' : ''}}"
            bindtap="toggleRole"
            data-value="{{item.value}}"
          >
            <view class="checkbox-icon">
              <text wx:if="{{item.checked}}">✓</text>
            </view>
            <text class="checkbox-label">{{item.label}}</text>
          </view>
        </view>
      </view>

      <!-- 有效期 -->
      <view class="form-section">
        <view class="section-label">有效期（可选）</view>
        <picker mode="date" value="{{formData.expire_date}}" bindchange="onExpireDateChange">
          <view class="form-picker">
            <text wx:if="{{formData.expire_date}}">{{formData.expire_date}}</text>
            <text wx:else class="placeholder">选择过期日期（不选则永久有效）</text>
          </view>
        </picker>
        <view wx:if="{{formData.expire_date}}" class="clear-btn" bindtap="clearExpireDate">
          清除
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 保存按钮 -->
  <view class="action-buttons">
    <button
      class="save-btn"
      bindtap="saveAnnouncement"
      disabled="{{saving}}"
      loading="{{saving}}"
    >
      {{saving ? '保存中...' : (isEdit ? '保存修改' : '保存草稿')}}
    </button>
  </view>
</view>
