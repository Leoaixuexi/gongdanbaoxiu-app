<!--
  Message Template Edit Page
  消息模板编辑页面
-->
<view class="edit-page">
  <scroll-view scroll-y class="edit-scroll" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view class="form-container">
      <!-- 场景选择 -->
      <view class="form-section">
        <view class="section-label">场景类型</view>
        <picker
          mode="selector"
          range="{{sceneOptions}}"
          range-key="label"
          value="{{selectedSceneIndex}}"
          bindchange="onSceneChange"
          disabled="{{isEdit}}"
        >
          <view class="form-picker {{isEdit ? 'disabled' : ''}}">
            <text>{{sceneOptions[selectedSceneIndex].label}}</text>
            <text class="picker-arrow" wx:if="{{!isEdit}}">▼</text>
          </view>
        </picker>
      </view>

      <!-- 模板标题 -->
      <view class="form-section">
        <view class="section-label">模板标题</view>
        <input
          class="form-input"
          placeholder="请输入模板标题"
          value="{{formData.title}}"
          bindinput="onTitleInput"
          maxlength="50"
        />
      </view>

      <!-- 模板正文 -->
      <view class="form-section">
        <view class="section-label">模板正文</view>
        <textarea
          class="form-textarea"
          placeholder="请输入模板正文，点击下方变量快速插入"
          value="{{formData.body}}"
          bindinput="onBodyInput"
          maxlength="500"
          auto-height
        />
        <view class="input-hint">
          点击下方变量可快速插入
        </view>
      </view>

      <!-- 可用变量 -->
      <view class="form-section">
        <view class="section-label">可用变量</view>
        <view class="variable-list">
          <view
            wx:for="{{availableVariables}}"
            wx:key="key"
            class="variable-tag"
            bindtap="insertVariable"
            data-key="{{item.key}}"
          >
            <text class="variable-name">{{item.name}}</text>
            <text class="variable-key">{{item.key}}</text>
          </view>
        </view>
        <view wx:if="{{availableVariables.length === 0}}" class="no-variables">
          当前场景暂无可用变量
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- 保存按钮 -->
  <view class="action-buttons">
    <button
      class="save-btn"
      bindtap="saveTemplate"
      disabled="{{saving}}"
      loading="{{saving}}"
    >
      {{saving ? '保存中...' : (isEdit ? '保存修改' : '创建模板')}}
    </button>
  </view>
</view>
