{
  "pages": [
    "pages/login/login",
    "pages/index/index",
    "pages/property/submit/index",
    "pages/property/submitted/index",
    "pages/work-order-detail/index",
    "pages/work-order-edit/index",
    "pages/avatar/avatar",
    "pages/password/password",
    "pages/phone/phone",
    "pages/notifications/index",
    "pages/message-list/index",
    "pages/data/index",
    "pages/admin/dashboard/index",
    "pages/admin/users/index",
    "pages/admin/users/add/index",
    "pages/admin/users/edit/index",
    "pages/admin/roles/index",
    "pages/admin/config/index",
    "pages/admin/audit-logs/index",
    "pages/admin/announcements/index",
    "pages/admin/announcements/edit/index",
    "pages/admin/dict/index",
    "pages/admin/dict/items"
  ],
  "window": {
    "backgroundTextStyle": "light",
    "navigationBarBackgroundColor": "#0CA77D",
    "navigationBarTitleText": "小物业报修系统",
    "navigationBarTextStyle": "white",
    "enablePullDownRefresh": true,
    "backgroundColor": "#F7F7F7"
  },
  "tabBar": {
    "custom": true,
    "color": "#7A7E83",
    "selectedColor": "#0CA77D",
    "backgroundColor": "#ffffff",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "工作台",
        "iconPath": "images/tabbar/placeholder.png",
        "selectedIconPath": "images/tabbar/placeholder.png"
      },
      {
        "pagePath": "pages/data/index",
        "text": "数据",
        "iconPath": "images/tabbar/placeholder.png",
        "selectedIconPath": "images/tabbar/placeholder.png"
      },
      {
        "pagePath": "pages/notifications/index",
        "text": "消息",
        "iconPath": "images/tabbar/placeholder.png",
        "selectedIconPath": "images/tabbar/placeholder.png"
      },
      {
        "pagePath": "pages/property/submitted/index",
        "text": "我的",
        "iconPath": "images/tabbar/placeholder.png",
        "selectedIconPath": "images/tabbar/placeholder.png"
      }
    ]
  },
  "permission": {
    "scope.userLocation": {
      "desc": "用于定位报修位置"
    }
  },
  "requiredBackgroundModes": ["audio", "location"],
  "networkTimeout": {
    "request": 10000,
    "downloadFile": 10000,
    "uploadFile": 10000
  },
  "debug": false,
  "style": "v2",
  "sitemapLocation": "sitemap.json",
  "lazyCodeLoading": "requiredComponents",
  "usingComponents": {
    "van-button": "@vant/weapp/button/index",
    "van-popup": "@vant/weapp/popup/index",
    "van-dialog": "@vant/weapp/dialog/index",
    "van-calendar": "@vant/weapp/calendar/index",
    "van-empty": "@vant/weapp/empty/index",
    "van-loading": "@vant/weapp/loading/index",
    "van-toast": "@vant/weapp/toast/index",
    "van-picker": "@vant/weapp/picker/index",
    "custom-picker": "/components/custom-picker/index"
  }
}
