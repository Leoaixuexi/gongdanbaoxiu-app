/* SLA Countdown Component Styles */

.sla-countdown {
  background: linear-gradient(135deg, #F5F5F7 0%, #FFFFFF 100%);
  border-radius: 24rpx;
  padding: 24rpx;
  margin: 24rpx 0;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.sla-countdown.warning {
  background: linear-gradient(135deg, #FFF9E6 0%, #FFFBF0 100%);
  border-left: 4rpx solid #FF9500;
}

.sla-countdown.critical {
  background: linear-gradient(135deg, #FFE8E6 0%, #FFF5F4 100%);
  border-left: 4rpx solid #FF3B30;
}

.sla-countdown.overdue {
  background: linear-gradient(135deg, #F0F0F0 0%, #F8F8F8 100%);
  border-left: 4rpx solid #8E8E93;
}

/* Header */
.countdown-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.status-badge {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  border-radius: 24rpx;
  background-color: rgba(52, 199, 89, 0.1);
}

.status-badge.warning {
  background-color: rgba(255, 149, 0, 0.1);
}

.status-badge.critical {
  background-color: rgba(255, 59, 48, 0.1);
}

.status-badge.overdue {
  background-color: rgba(142, 142, 147, 0.1);
}

.status-icon {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.status-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #34C759;
}

.status-badge.warning .status-text {
  color: #FF9500;
}

.status-badge.critical .status-text {
  color: #FF3B30;
}

.status-badge.overdue .status-text {
  color: #8E8E93;
}

.countdown-time {
  font-size: 32rpx;
  font-weight: 700;
  color: #34C759;
  font-variant-numeric: tabular-nums;
}

.countdown-time.warning {
  color: #FF9500;
}

.countdown-time.critical {
  color: #FF3B30;
}

.countdown-time.overdue {
  color: #8E8E93;
  text-decoration: line-through;
}

/* Progress Bar */
.countdown-progress {
  margin-bottom: 20rpx;
}

.progress-bar {
  width: 100%;
  height: 12rpx;
  background-color: rgba(0, 0, 0, 0.06);
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #34C759 0%, #30D158 100%);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.progress-fill.warning {
  background: linear-gradient(90deg, #FF9500 0%, #FFAA00 100%);
}

.progress-fill.critical {
  background: linear-gradient(90deg, #FF3B30 0%, #FF453A 100%);
}

.progress-fill.overdue {
  background: linear-gradient(90deg, #8E8E93 0%, #AEAEB2 100%);
}

.progress-text {
  font-size: 22rpx;
  color: #8E8E93;
  font-weight: 500;
}

/* Footer Info */
.countdown-footer {
  display: flex;
  justify-content: space-between;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
}

.info-item {
  display: flex;
  flex-direction: column;
}

.info-label {
  font-size: 22rpx;
  color: #8E8E93;
  margin-bottom: 4rpx;
}

.info-value {
  font-size: 26rpx;
  color: #1C1C1E;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}
