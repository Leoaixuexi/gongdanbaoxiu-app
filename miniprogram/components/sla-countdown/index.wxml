<!--
  SLA Countdown Component
  显示工单SLA倒计时
-->
<view class="sla-countdown {{sla.status}}" wx:if="{{visible}}">
  <view class="countdown-header">
    <view class="status-badge {{sla.status}}">
      <text class="status-icon">{{sla.statusIcon}}</text>
      <text class="status-text">{{sla.statusText}}</text>
    </view>
    <text class="countdown-time {{sla.status}}">{{sla.countdown}}</text>
  </view>

  <view class="countdown-progress">
    <view class="progress-bar">
      <view
        class="progress-fill {{sla.status}}"
        style="width: {{sla.percentage}}%"
      ></view>
    </view>
    <text class="progress-text">{{sla.percentage.toFixed(0)}}% 已用</text>
  </view>

  <view class="countdown-footer">
    <view class="info-item">
      <text class="info-label">SLA时限</text>
      <text class="info-value">{{sla.slaLimit}}小时</text>
    </view>
    <view class="info-item">
      <text class="info-label">截止时间</text>
      <text class="info-value">{{sla.deadlineText}}</text>
    </view>
  </view>
</view>
