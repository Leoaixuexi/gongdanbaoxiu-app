.timeline-item {
  display: flex;
  align-items: stretch;
  margin-bottom: 32rpx;
}

.timeline-axis {
  width: 90rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.dot-wrapper {
  width: 48rpx;
  height: 48rpx;
  margin-top: 20rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.outer-ring {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 9999rpx;
  background-color: rgba(16, 185, 129, 0.2);
  animation: pulse 2.4s ease-in-out infinite;
}

.inner-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 9999rpx;
  background-color: #10b981;
  position: relative;
  box-shadow: 0 0 8rpx rgba(16, 185, 129, 0.6);
}

.axis-line {
  flex: 1;
  width: 0;
  border-left: 2rpx dashed #d1d5db;
  margin-top: 16rpx;
  margin-bottom: -16rpx;
}

.timeline-card {
  flex: 1;
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  transition: box-shadow 200ms ease;
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 12rpx;
}

/* 状态标签 - 与工作台页面保持一致的胶囊样式 */
.status-badge {
  display: inline-block;
  padding: 8rpx 20rpx;
  font-size: 26rpx;
  font-weight: bold;
  border-radius: 24rpx;
}

/* 已提报状态 - 浅蓝色背景+深蓝色字体 */
.status-reported {
  background-color: #dbeafe;
  color: #2563eb;
  box-shadow: 0 2px 8px rgba(37, 99, 235, 0.2);
}

/* 维修中状态 - 浅青色背景+深青色字体 */
.status-maintenance {
  background-color: #cffafe;
  color: #0891b2;
  box-shadow: 0 2px 8px rgba(8, 145, 178, 0.2);
}

/* 已修复状态 - 浅紫色背景+深紫色字体 */
.status-repaired {
  background-color: #ede9fe;
  color: #7c3aed;
  box-shadow: 0 2px 8px rgba(124, 58, 237, 0.2);
}

/* 待复核状态 - 浅红色背景+深红色字体 */
.status-review {
  background-color: #fee2e2;
  color: #dc2626;
  box-shadow: 0 2px 8px rgba(220, 38, 38, 0.2);
}

/* 需返工状态 - 浅灰色背景+深灰色字体 */
.status-rework {
  background-color: #e2e8f0;
  color: #334155;
  box-shadow: 0 2px 8px rgba(51, 65, 85, 0.2);
}

/* 已完成状态 - 浅绿色背景+深绿色字体 */
.status-completed {
  background-color: #d1fae5;
  color: #059669;
  box-shadow: 0 2px 8px rgba(5, 150, 105, 0.2);
}

.user {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-shrink: 0;
}

.avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 2rpx solid #f3f4f6;
  box-shadow: 0 4rpx 12rpx rgba(15, 23, 42, 0.12);
}

.user-name {
  font-size: 26rpx;
  color: #6b7280;
}

.description {
  font-size: 28rpx;
  color: #4B5563;
  line-height: 1.6;
  margin-bottom: 16rpx;
  word-break: break-all;
}

.timestamp {
  font-size: 24rpx;
  color: #9ca3af;
}

@keyframes pulse {
  0% {
    transform: scale(0.85);
    opacity: 0.3;
  }
  50% {
    transform: scale(1);
    opacity: 0.55;
  }
  100% {
    transform: scale(0.85);
    opacity: 0.3;
  }
}
