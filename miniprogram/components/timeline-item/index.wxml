<view class="timeline-item">
  <view class="timeline-axis">
    <view class="dot-wrapper">
      <view class="outer-ring"></view>
      <view class="inner-dot"></view>
    </view>
    <view wx:if="{{!isLast}}" class="axis-line"></view>
  </view>

  <view class="timeline-card">
    <view class="card-header">
      <view class="status-badge {{event.statusClass || ''}}">{{event.title}}</view>
      <view wx:if="{{event.user}}" class="user">
        <view class="avatar-wrapper">
          <image wx:if="{{event.user.avatar}}" class="avatar" src="{{event.user.avatar}}" mode="aspectFill"></image>
          <view wx:else class="avatar-placeholder">{{event.user.name[0] || '?'}}</view>
        </view>
        <text class="user-name">{{event.user.name}}</text>
      </view>
    </view>

    <view wx:if="{{event.description && event.description !== '无'}}" class="description">
      {{event.description}}
    </view>

    <text class="timestamp">{{event.timestamp}}</text>
  </view>
</view>
