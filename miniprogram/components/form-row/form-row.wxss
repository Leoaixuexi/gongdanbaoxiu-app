/* components/form-row/form-row.wxss */
.form-row {
  display: flex;
  width: 100%;
  background: #ffffff;
  border-radius: 24rpx;
  border: 1rpx solid rgba(241, 245, 249, 0.8);
  padding: 0 32rpx;
  box-shadow: 0 4rpx 16rpx -4rpx rgba(0, 0, 0, 0.03);
  transition: all 0.3s ease;
  box-sizing: border-box;
  overflow: hidden;
}

.form-row:hover {
  box-shadow: 0 8rpx 24rpx -4rpx rgba(0, 0, 0, 0.06);
}

.form-row.active {
  transform: scale(0.995);
  background: rgba(248, 250, 252, 0.5);
}

/* 对齐方式 */
.align-center {
  align-items: center;
  padding-top: 32rpx;
  padding-bottom: 32rpx;
}

.align-start {
  align-items: flex-start;
  padding-top: 40rpx;
  padding-bottom: 40rpx;
}

/* 标签区域 */
.label-section {
  width: 208rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  color: #64748b;
  font-weight: 500;
  letter-spacing: -0.5rpx;
}

.label-top {
  padding-top: 4rpx;
}

.required-mark {
  color: #ef4444;
  margin-right: 4rpx;
  display: inline-block;
  vertical-align: middle;
  transform: translateY(-2rpx);
}

.label-text {
  display: inline-block;
  vertical-align: middle;
}

/* 内容区域 */
.content-section {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  min-width: 0;
}

/* 显示文本 */
.display-text {
  color: #1e293b;
  font-size: 30rpx;
  text-align: right;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  width: 100%;
  user-select: text;
}

/* 选择器 */
.select-wrapper {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  width: 100%;
  cursor: pointer;
}

.select-text {
  flex: 1;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 30rpx;
  color: #1e293b;
  font-weight: 500;
}

.select-text.placeholder {
  color: #cbd5e1;
}

/* 右箭头图标 */
.icon-chevron-right {
  width: 16rpx;
  height: 16rpx;
  border-top: 3rpx solid #cbd5e1;
  border-right: 3rpx solid #cbd5e1;
  transform: rotate(45deg);
  margin-left: 12rpx;
  flex-shrink: 0;
}

/* 多行文本输入 */
.textarea-input {
  width: 100%;
  text-align: right;
  outline: none;
  background: transparent;
  font-size: 30rpx;
  color: #1e293b;
  line-height: 1.6;
  min-height: 80rpx;
}

.textarea-input[placeholder] {
  color: #cbd5e1;
}

/* 文本输入 */
.text-input {
  width: 100%;
  text-align: right;
  outline: none;
  background: transparent;
  font-size: 30rpx;
  color: #1e293b;
  font-weight: 500;
}

.text-input[placeholder] {
  color: #cbd5e1;
}

.text-input[disabled],
.textarea-input[disabled] {
  cursor: default;
}
