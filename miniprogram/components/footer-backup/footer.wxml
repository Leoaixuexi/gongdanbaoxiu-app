<!-- components/footer/footer.wxml -->
<view class="footer-container safe-area-bottom">
  <view class="footer-content">
    <!-- 取消按钮 -->
    <button
      class="btn btn-cancel {{cancelActive ? 'btn-active' : ''}}"
      bindtap="handleCancel"
      bindtouchstart="handleCancelTouchStart"
      bindtouchend="handleCancelTouchEnd"
      hover-class="none"
    >
      取消
    </button>

    <!-- 保存按钮 -->
    <button
      class="btn btn-save {{saveActive ? 'btn-active' : ''}}"
      bindtap="handleSave"
      bindtouchstart="handleSaveTouchStart"
      bindtouchend="handleSaveTouchEnd"
      hover-class="none"
    >
      保存
    </button>
  </view>
</view>
