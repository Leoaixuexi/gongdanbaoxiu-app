/* 可滑动消息样式 */
.swipeable-message {
  position: relative;
  overflow: hidden;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
}

/* 删除按钮背景 */
.delete-bg {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 160rpx;
  background-color: #ef4444;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-btn {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
}

/* 可滑动区域 */
.movable-area {
  width: 100%;
  height: 100%;
}

.movable-view {
  width: 100%;
  height: 100%;
  background-color: #ffffff;
}

/* 消息内容 */
.message-content {
  padding: 32rpx;
  background-color: #ffffff;
  transition: background-color 0.2s;
}

.message-content:active {
  background-color: #f9fafb;
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 24rpx;
}

/* 未读指示器 */
.indicator-wrapper {
  padding-top: 12rpx;
  flex-shrink: 0;
}

.indicator-unread {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: #ef4444;
}

.indicator-read {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background-color: transparent;
}

/* 内容区域 */
.content-wrapper {
  flex: 1;
  min-width: 0;
}

.title-row {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.title-unread {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
}

.title-read {
  flex: 1;
  font-size: 32rpx;
  color: #4b5563;
}

.time-text {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #9ca3af;
  white-space: nowrap;
}

.content-text {
  font-size: 28rpx;
  color: #6b7280;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
