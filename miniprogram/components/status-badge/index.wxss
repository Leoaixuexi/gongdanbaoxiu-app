/**
 * Status Badge Component - Apple Design Style
 * Reusable status badge with consistent styling
 */

/* ==================== Base Badge Styles ==================== */
.status-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-full);
  font-weight: var(--font-weight-semibold);
  white-space: nowrap;
  transition: all var(--transition-base);
  letter-spacing: -0.2rpx;
}

/* ==================== Size Variants ==================== */
.status-badge--small {
  padding: 6rpx 12rpx;
  font-size: var(--font-size-xs);
  line-height: 1.2;
  border-radius: var(--radius-md);
}

.status-badge--medium {
  padding: var(--spacing-xs) var(--spacing-md);
  font-size: var(--font-size-sm);
  line-height: 1.3;
}

.status-badge--large {
  padding: var(--spacing-sm) var(--spacing-lg);
  font-size: var(--font-size-base);
  line-height: 1.4;
  border-radius: var(--radius-lg);
}

/* ==================== Work Order Status Colors ==================== */

/* Pending Repair */
.status-badge--pending-repair {
  background-color: rgba(255, 149, 0, 0.15);
  color: var(--color-warning);
}

/* In Progress */
.status-badge--in-progress {
  background-color: rgba(0, 122, 255, 0.15);
  color: var(--color-primary);
}

/* Repaired (Awaiting Review) */
.status-badge--repaired {
  background-color: rgba(90, 200, 250, 0.15);
  color: #5AC8FA;
}

/* Completed */
.status-badge--completed {
  background-color: rgba(52, 199, 89, 0.15);
  color: var(--color-success);
}

/* Needs Rework */
.status-badge--needs-rework {
  background-color: rgba(255, 59, 48, 0.15);
  color: var(--color-error);
}

/* Cancelled */
.status-badge--cancelled {
  background-color: rgba(142, 142, 147, 0.15);
  color: #8E8E93;
}

/* ==================== Priority Status Colors ==================== */

/* Low Priority */
.status-badge--priority-low {
  background: linear-gradient(135deg, #8E8E93 0%, #AEAEB2 100%);
  color: white;
}

/* Normal Priority */
.status-badge--priority-normal {
  background: linear-gradient(135deg, #007AFF 0%, #5AC8FA 100%);
  color: white;
}

/* High Priority */
.status-badge--priority-high {
  background: linear-gradient(135deg, #FF9500 0%, #FF9F0A 100%);
  color: white;
}

/* Emergency Priority */
.status-badge--priority-emergency {
  background: linear-gradient(135deg, #FF3B30 0%, #FF453A 100%);
  color: white;
  animation: pulse 2s infinite;
}

@keyframes pulse {
  0%, 100% {
    opacity: 1;
    transform: scale(1);
  }
  50% {
    opacity: 0.85;
    transform: scale(1.05);
  }
}

/* ==================== User Role Colors ==================== */

/* System Admin */
.status-badge--role-admin {
  background: linear-gradient(135deg, #FF2D55 0%, #FF3B5A 100%);
  color: white;
}

/* Manager */
.status-badge--role-manager {
  background: linear-gradient(135deg, #AF52DE 0%, #BF5AF2 100%);
  color: white;
}

/* Property Staff */
.status-badge--role-property {
  background: linear-gradient(135deg, #007AFF 0%, #5AC8FA 100%);
  color: white;
}

/* Maintenance Staff */
.status-badge--role-maintenance {
  background: linear-gradient(135deg, #34C759 0%, #30D158 100%);
  color: white;
}

/* Regular User */
.status-badge--role-user {
  background: linear-gradient(135deg, #FF9500 0%, #FF9F0A 100%);
  color: white;
}

/* ==================== Generic Status Colors ==================== */

/* Success */
.status-badge--success {
  background-color: rgba(52, 199, 89, 0.15);
  color: var(--color-success);
}

/* Warning */
.status-badge--warning {
  background-color: rgba(255, 149, 0, 0.15);
  color: var(--color-warning);
}

/* Error */
.status-badge--error {
  background-color: rgba(255, 59, 48, 0.15);
  color: var(--color-error);
}

/* Info */
.status-badge--info {
  background-color: rgba(0, 122, 255, 0.15);
  color: var(--color-primary);
}

/* Neutral */
.status-badge--neutral {
  background-color: rgba(142, 142, 147, 0.15);
  color: #8E8E93;
}

/* ==================== Active/Inactive States ==================== */

/* Active */
.status-badge--active {
  background-color: rgba(52, 199, 89, 0.15);
  color: var(--color-success);
}

/* Inactive */
.status-badge--inactive {
  background-color: rgba(255, 59, 48, 0.15);
  color: var(--color-error);
}

/* ==================== Special States ==================== */

/* Badge with Icon */
.status-badge--with-icon {
  padding-left: var(--spacing-xs);
  padding-right: var(--spacing-md);
  gap: var(--spacing-xs);
}

.status-badge__icon {
  font-size: 1.1em;
  line-height: 1;
}

.status-badge__text {
  line-height: 1;
}

/* Outlined Variant */
.status-badge--outlined {
  background-color: transparent;
  border: 2rpx solid currentColor;
}

/* Solid Variant */
.status-badge--solid {
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

/* ==================== Interactive States ==================== */
.status-badge--clickable {
  cursor: pointer;
}

.status-badge--clickable:active {
  transform: scale(0.95);
  opacity: 0.8;
}

/* ==================== Count Badge ==================== */
.status-badge--count {
  min-width: 48rpx;
  height: 48rpx;
  padding: 0 var(--spacing-xs);
  border-radius: 50%;
  font-weight: var(--font-weight-bold);
  font-size: var(--font-size-xs);
}
