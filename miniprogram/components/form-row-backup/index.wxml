<view class="form-row {{align === 'start' ? 'form-row--start' : ''}}">
  <view class="form-row__label {{align === 'start' ? 'form-row__label--start' : ''}}">
    <text wx:if="{{required}}" class="form-row__required">*</text>{{label}}
  </view>
  <view class="form-row__body {{align === 'start' ? 'form-row__body--start' : ''}}">
    <slot wx:if="{{useSlot}}"></slot>
    <block wx:elif="{{type === 'display'}}">
      <text class="form-row__display">{{value}}</text>
    </block>
    <block wx:elif="{{type === 'select'}}">
      <view class="form-row__select" bindtap="handleSelect">
        <text class="form-row__select-text {{!value ? 'is-placeholder' : ''}}">{{value || placeholder || '请选择'}}</text>
        <view wx:if="{{suffixIcon}}" class="chevron"></view>
      </view>
    </block>
    <block wx:elif="{{type === 'textarea'}}">
      <textarea value="{{value}}" bindinput="handleTextarea" placeholder="{{placeholder}}" disabled="{{readOnly}}" class="form-row__textarea" maxlength="-1" cursor-spacing="18"></textarea>
    </block>
    <block wx:elif="{{!useSlot}}">
      <input value="{{value}}" bindinput="handleInput" placeholder="{{placeholder}}" disabled="{{readOnly}}" class="form-row__input" type="{{type === 'number' ? 'number' : 'text'}}"/>
    </block>
  </view>
</view>
