<!--components/timeline/index.wxml-->
<view class="timeline-container">
  <!-- Empty State -->
  <view class="timeline-empty" wx:if="{{!statusHistory || statusHistory.length === 0}}">
    <text class="empty-icon">📋</text>
    <text class="empty-text">暂无历史</text>
  </view>

  <!-- Timeline Items -->
  <view class="timeline" wx:else>
    <block wx:for="{{statusHistory}}" wx:key="id" wx:for-item="item" wx:for-index="idx">
      <view class="timeline-item {{idx === 0 ? 'latest' : ''}}">
        <!-- Timeline Dot with Color -->
        <view class="timeline-dot-wrapper">
          <view class="timeline-dot status-{{item.status}}" style="background-color: {{item.dotColor}}"></view>
          <view class="timeline-line" wx:if="{{idx < statusHistory.length - 1}}"></view>
        </view>

        <!-- Timeline Content -->
        <view class="timeline-content">
          <!-- Status Badge -->
          <view class="timeline-status">
            <status-badge status="{{item.status}}" size="small" />
          </view>

          <!-- Timestamp and Actor -->
          <view class="timeline-meta">
            <text class="timeline-time">{{item.relativeTime}}</text>
            <text class="timeline-actor" wx:if="{{item.actor_name}}"> 由 {{item.actor_name}}</text>
          </view>

          <!-- Notes -->
          <view class="timeline-notes" wx:if="{{item.notes}}">
            <text>{{item.notes}}</text>
          </view>

          <!-- Photos -->
          <view class="timeline-photos" wx:if="{{item.photos && item.photos.length > 0}}">
            <block wx:for="{{item.photos}}" wx:key="photoIdx" wx:for-item="photo" wx:for-index="photoIdx">
              <image
                class="timeline-photo"
                src="{{photo}}"
                mode="aspectFill"
                bindtap="previewPhoto"
                data-photos="{{item.photos}}"
                data-index="{{photoIdx}}"
              />
            </block>
          </view>
        </view>
      </view>
    </block>
  </view>
</view>
