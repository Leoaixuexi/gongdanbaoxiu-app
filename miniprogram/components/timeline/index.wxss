/* components/timeline/index.wxss */

.timeline-container {
  width: 100%;
  padding: 10rpx 0;
}

/* Empty State */
.timeline-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
  color: #999;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}

/* Timeline */
.timeline {
  position: relative;
  padding: 10rpx 0;
}

/* Timeline Item */
.timeline-item {
  display: flex;
  position: relative;
  padding-bottom: 40rpx;
}

.timeline-item.latest {
  padding-bottom: 50rpx;
}

/* Timeline Dot Wrapper */
.timeline-dot-wrapper {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 30rpx;
  padding-top: 8rpx;
}

/* Timeline Dot */
.timeline-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  border: 4rpx solid #fff;
  box-shadow: 0 0 0 2rpx currentColor;
  z-index: 2;
  flex-shrink: 0;
}

/* Status-specific dot colors */
.timeline-dot.status-Pending.Repair {
  background-color: #ff9800;
}

.timeline-dot.status-In.Progress {
  background-color: #2196f3;
}

.timeline-dot.status-Repaired {
  background-color: #4caf50;
}

.timeline-dot.status-Needs.Rework {
  background-color: #f44336;
}

.timeline-dot.status-Completed {
  background-color: #9e9e9e;
}

/* Latest item has larger, pulsing dot */
.timeline-item.latest .timeline-dot {
  width: 28rpx;
  height: 28rpx;
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
    opacity: 1;
  }
  50% {
    transform: scale(1.1);
    opacity: 0.8;
  }
}

/* Timeline Line */
.timeline-line {
  position: absolute;
  top: 32rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 2rpx;
  height: calc(100% + 40rpx);
  background-color: #e0e0e0;
  z-index: 1;
}

/* Timeline Content */
.timeline-content {
  flex: 1;
  min-width: 0;
}

/* Status Badge */
.timeline-status {
  margin-bottom: 8rpx;
}

/* Timeline Meta */
.timeline-meta {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
  font-size: 24rpx;
  color: #666;
}

.timeline-time {
  color: #999;
}

.timeline-actor {
  color: #666;
  font-weight: 500;
}

/* Timeline Notes */
.timeline-notes {
  background-color: #f5f5f5;
  border-radius: 8rpx;
  padding: 16rpx 20rpx;
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #333;
  word-wrap: break-word;
  white-space: pre-wrap;
}

/* Timeline Photos */
.timeline-photos {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.timeline-photo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 8rpx;
  background-color: #f5f5f5;
  object-fit: cover;
}

/* Responsive adjustments */
@media screen and (max-width: 375px) {
  .timeline-photo {
    width: 140rpx;
    height: 140rpx;
  }
}
