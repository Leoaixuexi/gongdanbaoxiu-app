.filter-row {
  width: 100%;
  height: 92rpx; /* Match form input height */
  border-radius: 24rpx; /* Match form input radius */
  background: #F2F6FA; /* Match form input background */
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28rpx; /* Match form input padding */
  margin-bottom: 24rpx;
  /* No border or shadow for flat look */
  box-sizing: border-box;
  /* Removed transition to correct blurriness */
}

.filter-row:active {
  background-color: #E2E8F0; /* Slightly darker on press */
  opacity: 0.8;
  /* Removed transform to prevent blur */
}

.label {
  font-size: 28rpx; /* Larger font */
  color: #1E293B; /* Darker slate */
  font-weight: 500;
  /* Removed detailed letter-spacing to prevent blur */
}

.info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.placeholder {
  font-size: 26rpx;
  color: #94A3B8; /* Lighter slate */
}

.value {
  font-size: 26rpx;
  color: #0F172A; /* Almost black */
  font-weight: 500;
}

.arrow {
  width: 20rpx;
  height: 20rpx;
  border-top: 4rpx solid #CBD5E1;
  border-right: 4rpx solid #CBD5E1;
  transform: rotate(45deg);
  margin-left: 4rpx;
}

/* 已选中态 */
.filter-row-selected {
  background: #f0fdf4;
}

.value-selected {
  color: #10b981;
}

.arrow-selected {
  border-top-color: #10b981;
  border-right-color: #10b981;
}
