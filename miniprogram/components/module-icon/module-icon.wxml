<!-- 模块图标组件 -->
<view class="module-icon">
  <!-- 通知公告 -->
  <view wx:if="{{moduleId === 'announcements'}}" class="icon-wrapper">
    <text class="iconfont icon-tongzhigonggao" style="font-size: 48rpx; color: #F97316;"></text>
  </view>

  <!-- 待办工单 -->
  <view wx:elif="{{moduleId === 'tasks'}}" class="icon-wrapper">
    <text class="iconfont icon-daibanshixiang" style="font-size: 48rpx; color: #A855F7;"></text>
  </view>

  <!-- 提醒我的 -->
  <view wx:elif="{{moduleId === 'reminders'}}" class="icon-wrapper">
    <text class="iconfont icon-tixingwode" style="font-size: 48rpx; color: #3B82F6;"></text>
  </view>

  <!-- 默认图标 -->
  <view wx:else class="icon-wrapper">
    <text class="iconfont" style="font-size: 48rpx; color: #9CA3AF;">●</text>
  </view>
</view>
