/* components/header/header.wxss */
.header-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: linear-gradient(to right, #10b981, #14b8a6);
  z-index: 999;
  border-bottom: none;
  box-shadow: none;
  padding-bottom: 2rpx;
}

.header-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 32rpx;
  position: relative;
}

/* 左侧区域 */
.header-left {
  position: absolute;
  left: 32rpx;
  display: flex;
  align-items: center;
}

.back-btn {
  padding: 12rpx;
  margin-left: -12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-btn:active {
  opacity: 0.7;
}

/* 中间标题区域 */
.header-center {
  text-align: center;
}

.header-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 0.5rpx;
}

/* 右侧区域 */
.header-right {
  position: absolute;
  right: 32rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}
