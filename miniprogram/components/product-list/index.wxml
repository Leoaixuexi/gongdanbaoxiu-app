<wxs module="fmt">
  function price(v, unit) {
    var n = parseFloat(v);
    if (!(n > 0)) return '';
    return '¥' + n.toFixed(2) + '/' + (unit || '元');
  }
  module.exports = { price: price };
</wxs>
<view class="product-list">
  <view class="pl-header">
    <view class="pl-search-row">
      <view class="pl-search-bar">
        <van-icon name="search" size="14px" color="#a3a3a3" />
        <input
          class="pl-search-input"
          placeholder="搜索商品名称、编号"
          placeholder-class="pl-search-placeholder"
          value="{{keyword}}"
          bindinput="onSearchInput"
          bindconfirm="onSearchConfirm"
        />
      </view>
      <view class="pl-filter-btn {{hasActiveFilter ? 'pl-filter-btn-active' : ''}}" bindtap="onOpenFilter">
        <van-icon name="filter-o" size="18px" color="{{hasActiveFilter ? '#10b981' : '#525252'}}" />
        <text class="pl-filter-btn-text">筛选</text>
      </view>
    </view>

  </view>

  <scroll-view scroll-y class="list-scroll" bindscrolltolower="onLoadMore">
    <view wx:if="{{loading}}" class="loading-state">
      <text>加载中...</text>
    </view>

    <view wx:elif="{{filteredProducts.length === 0}}" class="empty-state">
      <van-icon name="gift-o" size="48px" color="#d4d4d4" />
      <text class="empty-text">暂无商品</text>
    </view>

    <view wx:else class="card-list">
      <view
        wx:for="{{filteredProducts}}"
        wx:key="product_id"
        class="m-card"
        bindtap="onCardTap"
        data-product="{{item}}"
      >
        <image
          class="m-card-img"
          src="{{item.images[0] || '/images/placeholder.png'}}"
          mode="aspectFill"
        />
        <view class="m-card-body">
          <view class="m-card-title-row">
            <view class="m-card-title">{{item.name}}</view>
            <view class="m-card-price" wx:if="{{item.purchase_price > 0}}">{{fmt.price(item.purchase_price, item.unit)}}</view>
          </view>
          <view class="m-card-row">
            <text class="m-field-label">商品编码：</text><text>{{item.product_code || '-'}}</text>
          </view>
          <view class="m-card-row">
            <text class="m-field-label">商品分类：</text><text>{{item.category || '-'}}</text>
          </view>
          <view class="m-card-row-split">
            <view class="m-card-row">
              <text class="m-field-label">规格：</text><text>{{item.spec || '-'}}</text>
            </view>
            <view class="m-card-row">
              <text class="m-field-label">单位：</text><text>{{item.unit || '-'}}</text>
            </view>
            <view class="m-card-row">
              <text class="m-field-label">预警值：</text><text>{{item.min_stock || 0}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view wx:if="{{loadingMore}}" class="loading-more">
      <text>加载更多...</text>
    </view>
  </scroll-view>

  <!-- 筛选弹层 -->
  <van-popup
    show="{{ showFilter }}"
    position="right"
    custom-style="width: 80%; height: 100%;"
    bind:close="onCloseFilter"
  >
    <view class="filter-panel">
      <view class="filter-panel-header">
        <view class="filter-panel-title-wrap">
          <text class="filter-panel-title">筛选</text>
          <text class="filter-panel-subtitle">可多选 · 已选 {{filterCategories.length + filterSources.length}} 项</text>
        </view>
        <view class="filter-panel-close" bindtap="onCloseFilter">
          <van-icon name="cross" size="20px" color="#737373" />
        </view>
      </view>

      <scroll-view scroll-y class="filter-panel-body">
       <view class="filter-panel-inner">
        <view
          wx:for="{{filterSections}}"
          wx:for-item="section"
          wx:key="group"
          class="filter-section"
        >
          <view class="filter-section-title-row">
            <van-icon name="{{section.icon}}" size="14px" color="#737373" />
            <text class="filter-section-title">{{section.title}}</text>
          </view>
          <view class="filter-chips">
            <view
              wx:for="{{section.options}}"
              wx:for-item="opt"
              wx:key="value"
              class="filter-chip {{opt.active ? 'filter-chip-active' : ''}}"
              data-group="{{section.group}}"
              data-value="{{opt.value}}"
              bindtap="onToggleFilterChip"
            >{{opt.value}}</view>
            <view wx:if="{{section.options.length === 0}}" class="filter-empty">暂无选项</view>
          </view>
        </view>
       </view>
      </scroll-view>

      <view class="filter-panel-footer">
        <view class="filter-btn filter-btn-reset" bindtap="onResetFilter">重置</view>
        <view class="filter-btn filter-btn-confirm {{matchCount === 0 ? 'filter-btn-disabled' : ''}}" bindtap="onConfirmFilter">{{matchCount === 0 ? '无匹配' : '确定 · ' + matchCount + ' 件'}}</view>
      </view>
    </view>
  </van-popup>
</view>
