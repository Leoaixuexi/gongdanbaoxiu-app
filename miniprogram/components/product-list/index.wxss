.product-list {
  height: 100%;
  display: flex;
  flex-direction: column;
}

.list-scroll {
  flex: 1;
  min-height: 0;
  padding: 0 24rpx 32rpx;
  box-sizing: border-box;
}

.loading-state,
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: #a3a3a3;
  font-size: 28rpx;
}

.empty-text {
  margin-top: 16rpx;
}

.loading-more {
  text-align: center;
  padding: 24rpx;
  color: #a3a3a3;
  font-size: 24rpx;
}

.card-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.m-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  position: relative;
  overflow: hidden;
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.78) 100%);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 24rpx;
  padding: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.95);
  border-left: 1rpx solid rgba(255, 255, 255, 0.6);
  border-right: 1rpx solid rgba(255, 255, 255, 0.6);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
  box-shadow:
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.8),
    inset 0 -1rpx 3rpx rgba(0, 0, 0, 0.015),
    0 2rpx 4rpx rgba(0, 0, 0, 0.02),
    0 8rpx 16rpx rgba(0, 0, 0, 0.025),
    0 16rpx 32rpx -8rpx rgba(0, 0, 0, 0.025);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

/* 顶部高光线 - 增强立体感 */
.m-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 10%;
  right: 10%;
  height: 1px;
  background: linear-gradient(90deg,
    rgba(255, 255, 255, 0) 0%,
    rgba(255, 255, 255, 1) 50%,
    rgba(255, 255, 255, 0) 100%);
  z-index: 1;
}

.m-card:active {
  transform: translateY(4rpx) scale(0.98);
  box-shadow:
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.6),
    inset 0 -2rpx 6rpx rgba(0, 0, 0, 0.03),
    0 2rpx 4rpx rgba(0, 0, 0, 0.06),
    0 4rpx 8rpx rgba(0, 0, 0, 0.04);
}

.m-card-img {
  width: 196rpx;
  height: 196rpx;
  margin: -20rpx 0 -20rpx -20rpx;
  border-radius: 12rpx 18rpx 18rpx 12rpx;
  flex-shrink: 0;
  background: #f0f0f0;
}

.m-card-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.m-card-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: -6rpx;
  margin-bottom: 4rpx;
}

.m-card-title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.m-card-price {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 600;
  color: #EF4444;
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
}

.m-card-row {
  font-size: 24rpx;
  color: #525252;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.m-card-row-split {
  display: grid;
  grid-template-columns: 1fr auto auto;
  gap: 38rpx;
}

.m-field-label {
  color: #a3a3a3;
}

/* ====== Header ====== */
.pl-header {
  flex-shrink: 0;
  padding: 16rpx 24rpx 0;
}

.pl-search-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.pl-search-bar {
  flex: 1;
  display: flex;
  align-items: center;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.78) 100%);
  border-radius: 24rpx;
  padding: 0 24rpx;
  height: 72rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.95);
  border-left: 1rpx solid rgba(255, 255, 255, 0.6);
  border-right: 1rpx solid rgba(255, 255, 255, 0.6);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
  box-shadow:
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.85),
    inset 0 -1rpx 2rpx rgba(0, 0, 0, 0.03),
    0 2rpx 4rpx rgba(0, 0, 0, 0.04),
    0 6rpx 16rpx rgba(0, 0, 0, 0.06);
}

.pl-search-input {
  flex: 1;
  font-size: 26rpx;
  color: #0a0a0a;
  margin-left: 12rpx;
}

.pl-search-placeholder {
  color: #c0c0c0;
  font-size: 26rpx;
}

.pl-filter-btn {
  position: relative;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.pl-filter-btn:active { opacity: 0.6; }

.pl-filter-btn-text {
  color: #525252;
  font-size: 26rpx;
  font-weight: 600;
}

.pl-filter-btn-active .pl-filter-btn-text {
  color: #10b981;
}

/* ====== 筛选弹层 ====== */
.filter-panel {
  display: flex;
  flex-direction: column;
  height: 100%;
  background: #F5F5F5;
  border-radius: 24rpx 0 0 24rpx;
  overflow: hidden;
}

.filter-panel-header {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 32rpx 24rpx;
  background: #FFFFFF;
  position: relative;
  z-index: 2;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.filter-panel-title-wrap {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.filter-panel-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.filter-panel-subtitle {
  font-size: 22rpx;
  color: #a3a3a3;
}

.filter-panel-close {
  padding: 8rpx;
}

.filter-panel-body {
  flex: 1;
  min-height: 0;
}

.filter-panel-inner {
  padding: 0 28rpx 16rpx;
}

.filter-section {
  box-sizing: border-box;
  width: 100%;
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.95) 0%, rgba(255, 255, 255, 0.78) 100%);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.95);
  border-left: 1rpx solid rgba(255, 255, 255, 0.6);
  border-right: 1rpx solid rgba(255, 255, 255, 0.6);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.03);
  box-shadow:
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.85),
    0 2rpx 6rpx rgba(0, 0, 0, 0.03),
    0 8rpx 20rpx -4rpx rgba(0, 0, 0, 0.05);
}

.filter-section-title-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.filter-section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.filter-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.filter-chip {
  padding: 14rpx 28rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #525252;
  background: rgba(0, 0, 0, 0.04);
  border: 1rpx solid transparent;
  transition: all 0.15s ease;
}

.filter-chip:active {
  transform: scale(0.95);
}

.filter-chip-active {
  color: #FFFFFF;
  background: linear-gradient(135deg, #10b981 0%, #14b8a6 100%);
  border-color: transparent;
  box-shadow: 0 4rpx 10rpx rgba(16, 185, 129, 0.3);
}

.filter-empty {
  font-size: 24rpx;
  color: #a3a3a3;
  padding: 16rpx 0;
}

.filter-panel-footer {
  flex-shrink: 0;
  display: flex;
  gap: 16rpx;
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  position: relative;
  z-index: 2;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.filter-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  transition: all 0.2s ease;
}

.filter-btn-reset {
  background: #F3F4F6;
  color: #525252;
}

.filter-btn-confirm {
  background: linear-gradient(135deg, #10b981 0%, #14b8a6 100%);
  color: #FFFFFF;
  box-shadow: 0 6rpx 14rpx rgba(16, 185, 129, 0.28), inset 0 1rpx 0 rgba(255, 255, 255, 0.18);
}

.filter-btn-reset:active,
.filter-btn-confirm:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.filter-btn-disabled {
  opacity: 0.5;
  pointer-events: none;
  box-shadow: none;
}
