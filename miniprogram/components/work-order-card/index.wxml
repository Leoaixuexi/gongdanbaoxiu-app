<!--
  Work Order Card Component
  Displays work order summary with modern UI design
-->
<view class="ticket-card" bindtap="handleTap">
  <!-- 状态标签 - 绝对定位到右上角 -->
  <view class="status-badge {{statusClass}}">
    {{statusText}}
  </view>

  <!-- 标题: ID 和紧急标签 -->
  <view class="ticket-header">
    <view class="ticket-id-row">
      <text class="ticket-id">{{workOrder.order_number || workOrder.order_id || workOrder.id}}</text>
      <view wx:if="{{isUrgent}}" class="urgent-badge">紧急</view>
      <!-- SLA 超期标签 -->
      <view wx:if="{{showSLABadge && !isUrgent}}" class="sla-badge-inline sla-{{slaColorClass}}">
        <text class="badge-icon">⚠</text>
        <text class="badge-text">{{slaBadgeText}}</text>
      </view>
    </view>
  </view>

  <!-- 描述框 -->
  <view class="description-box">
    {{workOrder.description || '无描述'}}
  </view>

  <!-- 元数据布局: 两列 -->
  <view class="metadata-row">
    <!-- 左列: 位置 & 责任方 -->
    <view class="metadata-col">
      <view class="metadata-item">
        <view class="icon icon-location"></view>
        <text class="metadata-text">{{workOrder.floor}}</text>
        <text class="location-separator"></text>
        <text class="metadata-text">{{workOrder.location}}</text>
      </view>
      <view class="metadata-item">
        <view class="icon icon-person"></view>
        <text class="metadata-text">{{workOrder.responsible_party || '未知'}}</text>
      </view>
    </view>

    <!-- 右列: 时间 & 类别 -->
    <view class="metadata-col metadata-col-right">
      <view class="metadata-item">
        <view class="icon icon-time"></view>
        <text class="metadata-text">{{relativeTime}}</text>
      </view>
      <view class="metadata-item">
        <view class="icon icon-building"></view>
        <text class="metadata-text">{{workOrder.order_category || '未分类'}}</text>
      </view>
    </view>
  </view>

  <!-- 照片列表 - 有照片才显示，最多3张 -->
  <view class="photo-list" wx:if="{{workOrder.photos && workOrder.photos.length > 0}}">
    <block wx:for="{{workOrder.photos}}" wx:key="index" wx:if="{{index < 3}}">
      <view class="photo-placeholder">
        <image
          src="{{item}}"
          class="photo-image"
          mode="aspectFill"
          lazy-load="{{true}}"
        />
      </view>
    </block>
  </view>
</view>
