/**
 * Work Order Card Component - Modern Minimalist Design
 * Clean card design inspired by modern UI principles
 */

/* ==================== Card Container ==================== */
.ticket-card {
  position: relative;
  background: linear-gradient(145deg, #ffffff, #fafafa);
  border-radius: 16rpx;
  padding: 12rpx 24rpx 24rpx 24rpx;
  box-shadow:
    0 4rpx 8rpx rgba(0, 0, 0, 0.06),
    0 8rpx 16rpx rgba(0, 0, 0, 0.04),
    0 16rpx 32rpx rgba(0, 0, 0, 0.02);
  border: 1px solid rgba(255, 255, 255, 0.8);
  margin-bottom: 32rpx;
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  transform: translateZ(0);
}

.ticket-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(90deg,
    rgba(255, 255, 255, 0) 0%,
    rgba(255, 255, 255, 0.8) 50%,
    rgba(255, 255, 255, 0) 100%);
  z-index: 1;
}

.ticket-card:active {
  transform: translateY(4rpx) scale(0.99);
  box-shadow:
    0 2rpx 4rpx rgba(0, 0, 0, 0.06),
    0 4rpx 8rpx rgba(0, 0, 0, 0.04),
    0 8rpx 16rpx rgba(0, 0, 0, 0.02);
}

/* ==================== Status Badge (Right Top Corner) ==================== */
.status-badge {
  position: absolute;
  top: 0;
  right: 0;
  padding: 12rpx 32rpx;
  font-size: 26rpx;
  font-weight: bold;
  border-radius: 12rpx;
  z-index: 10;
}

/* 已提报状态 - 浅蓝色背景+深蓝色字体 */
.status-reported {
  background-color: #dbeafe;
  color: #2563eb;
  box-shadow: 0 2px 8px rgba(37, 99, 235, 0.2);
}

/* 维修中状态 - 浅青色背景+深青色字体 */
.status-maintenance {
  background-color: #cffafe;
  color: #0891b2;
  box-shadow: 0 2px 8px rgba(8, 145, 178, 0.2);
}

/* 待复核状态 - 浅红色背景+深红色字体 */
.status-review {
  background-color: #fee2e2;
  color: #dc2626;
  box-shadow: 0 2px 8px rgba(220, 38, 38, 0.2);
}

/* 已完成状态 - 浅绿色背景+深绿色字体 */
.status-completed {
  background-color: #d1fae5;
  color: #059669;
  box-shadow: 0 2px 8px rgba(5, 150, 105, 0.2);
}

/* 保留旧样式以防其他地方使用 */
.status-processing {
  background-color: #DBEAFE;
  color: #2563EB;
}

/* ==================== Header: ID and Badges ==================== */
.ticket-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-top: 0;
  border-bottom: none;
  padding-bottom: 0;
}

.ticket-id-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.ticket-id {
  font-size: 32rpx;
  font-weight: normal;
  color: #0CA77D;
  letter-spacing: -0.5px;
  line-height: 1;
  margin-bottom: 0;
}

.urgent-badge {
  background-color: #EF4444;
  color: #ffffff;
  font-size: 20rpx;
  font-weight: bold;
  padding: 4rpx 16rpx;
  border-radius: 24rpx;
  box-shadow: 0 2px 8px rgba(239, 68, 68, 0.3);
}

.sla-badge-inline {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 4rpx 12rpx;
  border-radius: 24rpx;
  font-size: 20rpx;
  font-weight: bold;
}

.sla-badge-inline.sla-red {
  background-color: #EF4444;
  color: #ffffff;
  box-shadow: 0 2px 8px rgba(239, 68, 68, 0.3);
}

.sla-badge-inline.sla-orange {
  background-color: #FF9500;
  color: #ffffff;
  box-shadow: 0 2px 8px rgba(255, 149, 0, 0.3);
}

.sla-badge-inline.sla-yellow {
  background-color: #FFCC00;
  color: #1D1D1F;
  box-shadow: 0 2px 8px rgba(255, 204, 0, 0.3);
}

.badge-icon {
  font-size: 18rpx;
  line-height: 1;
}

.badge-text {
  line-height: 1;
}

/* ==================== Description Box ==================== */
.description-box {
  background-color: #F9FAFB;
  border-radius: 24rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 32rpx;
  color: #111827;
  font-size: 28rpx;
  line-height: 1.5;
  border: 1px solid #F3F4F6;
  display: inline-block;
  max-width: 100%;
  word-break: break-all;
}

/* ==================== Metadata Layout (Two Columns) ==================== */
.metadata-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  font-size: 24rpx;
  margin-bottom: 32rpx;
  gap: 32rpx;
}

.metadata-col {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  min-width: 0;
  flex: 1;
}

.metadata-col-right {
  align-items: flex-start;
  margin-right: 70rpx;
  flex: 0 0 auto;
}

.metadata-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.icon {
  font-size: 24rpx;
  margin-right: 8rpx;
  opacity: 0.6;
  flex-shrink: 0;
}

