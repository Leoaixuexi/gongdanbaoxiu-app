<!-- 消息卡片组件 -->
<view class="message-card" bindtap="handleTap">
  <view class="card-content">
    <view class="flex-row">
      <!-- 图标 -->
      <view class="icon-container {{iconBgColor}}">
        <module-icon moduleId="{{moduleId}}"></module-icon>
      </view>

      <!-- 标题和预览 -->
      <view class="content-wrapper">
        <view class="module-name">{{moduleName}}</view>
        <view class="latest-message">{{latestMessage ? latestMessage.title : '暂无消息'}}</view>
      </view>

      <!-- 时间和徽章 -->
      <view class="right-section">
        <view wx:if="{{latestMessage}}" class="time-text">{{timeAgo}}</view>
        <view wx:if="{{unreadCount > 0}}" class="badge">
          {{unreadCount > 99 ? '99+' : unreadCount}}
        </view>
      </view>
    </view>
  </view>
</view>
