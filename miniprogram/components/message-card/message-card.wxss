/* 消息卡片样式 */
.message-card {
  margin-bottom: 24rpx;
}

.card-content {
  background-color: #ffffff;
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  transition: background-color 0.2s;
}

.card-content:active {
  background-color: #f9fafb;
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 24rpx;
}

/* 图标容器 */
.icon-container {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 内容区域 */
.content-wrapper {
  flex: 1;
  min-width: 0;
  padding-top: 4rpx;
}

.module-name {
  color: #111827;
  font-weight: 600;
  font-size: 32rpx;
  margin-bottom: 8rpx;
}

.latest-message {
  color: #9ca3af;
  font-size: 28rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 右侧区域 */
.right-section {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 16rpx;
  flex-shrink: 0;
}

.time-text {
  color: #9ca3af;
  font-size: 24rpx;
}

.badge {
  min-width: 40rpx;
  height: 40rpx;
  padding: 0 12rpx;
  background-color: #ef4444;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 500;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 背景色工具类 */
.bg-orange-100 {
  background-color: #ffedd5;
}

.bg-purple-100 {
  background-color: #f3e8ff;
}

.bg-blue-100 {
  background-color: #dbeafe;
}

.bg-gray-100 {
  background-color: #f3f4f6;
}
