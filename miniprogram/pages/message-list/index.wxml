<!-- 消息列表页 - 基于UI设计图重新设计 -->
<view class="message-list-page">
  <!-- 自定义头部导航栏 -->
  <view class="header" style="padding-top: {{statusBarHeight}}px;">
    <view class="header-content">
      <!-- 返回按钮 -->
      <view class="back-btn" bindtap="handleBack">
        <van-icon name="arrow-left" size="40rpx" color="#fff" />
      </view>
      <!-- 标题居中区域 -->
      <view class="title-center">
        <text class="header-title">{{moduleName}}</text>
        <text class="iconfont icon-saoba clear-icon" bindtap="handleMarkAllRead"></text>
      </view>
      <!-- 右侧占位（与返回按钮宽度相同保持标题居中） -->
      <view class="header-right-placeholder"></view>
    </view>
  </view>

  <!-- 消息列表内容 -->
  <scroll-view
    scroll-y
    class="message-scroll"
    style="padding-top: {{headerHeight}}px;"
    refresher-enabled="{{true}}"
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onRefresh"
    enhanced="{{true}}"
    show-scrollbar="{{false}}"
  >
    <!-- Loading 状态 -->
    <view class="loading-state" wx:if="{{loading}}">
      <view class="loading-spinner"></view>
      <text class="loading-text">加载中...</text>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:elif="{{messages.length === 0}}">
      <image class="empty-icon" src="cloud://cloud1-7glfhm4r06e030bd.636c-cloud1-7glfhm4r06e030bd-1386591973/icons/08.png" mode="aspectFit"></image>
      <text class="empty-text">暂无消息</text>
    </view>

    <!-- 消息列表 -->
    <view class="message-list" wx:else>
      <view 
        class="swipe-container" 
        wx:for="{{messages}}" 
        wx:key="id"
      >
        <!-- 滑动显示的操作按钮 -->
        <view class="swipe-actions">
          <view class="action-btn action-cancel" bindtap="handleCancel" data-id="{{item.id}}">
            <text>取消</text>
          </view>
          <view class="action-btn action-delete" bindtap="handleDelete" data-id="{{item.id}}">
            <text>删除</text>
          </view>
        </view>
        
        <!-- 消息卡片（可滑动） -->
        <view
          class="message-item {{item.swiped ? 'swiped' : ''}}"
          bindtouchstart="onTouchStart"
          bindtouchmove="onTouchMove"
          bindtouchend="onTouchEnd"
          bindtap="handleMessageTap"
          data-id="{{item.id}}"
          data-index="{{index}}"
        >
          <!-- 消息内容 -->
          <view class="message-content">
            <!-- 标题 - 工单编号显示绿色，后面追加阅读状态 -->
            <view class="message-title-row">
              <text class="message-title {{item.isRead ? '' : 'title-unread'}}">{{item.titlePrefix}}</text>
              <text class="message-order-number">{{item.orderNumber}}</text>
              <!-- 阅读状态：未读红色，已读灰色 -->
              <text wx:if="{{!item.isRead}}" class="read-status unread">未读</text>
              <text wx:else class="read-status read">已读</text>
            </view>
            <!-- 描述文本 -->
            <text class="message-desc">{{item.content}}</text>
            <!-- 时间 - 显示在底部 -->
            <text class="message-time">{{item.timeText}}</text>
          </view>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
