/**
 * 消息列表页样式 - Professionally Redesigned V2
 * Style: Advanced Modern, Unified, High-End
 */

/* 页面容器 */
.message-list-page {
  min-height: 100vh;
  background-color: #F7F8FA; /* 统一的高级冷灰背景 */
}

/* ==================== 头部导航栏 ==================== */
.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  /* 统一使用 Emerald/Teal 渐变，保持品牌一致性 */
  background: linear-gradient(135deg, #10B981 0%, #0D9488 100%);
  z-index: 100;
  border-bottom: none;
  /* 柔和的导航栏投影 */
  box-shadow: 0 4rpx 24rpx rgba(13, 148, 136, 0.15);
}

.header-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 32rpx;
  position: relative;
}

/* 返回按钮 */
.back-btn {
  position: absolute;
  left: 32rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: all 0.2s;
}

.back-btn:active {
  background-color: rgba(255, 255, 255, 0.15);
  transform: scale(0.9);
}

.back-icon {
  width: 22rpx;
  height: 22rpx;
  border-left: 4rpx solid #ffffff;
  border-bottom: 4rpx solid #ffffff;
  transform: rotate(45deg);
  margin-left: 8rpx;
}

/* 标题居中区域 */
.title-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 标题 */
.header-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 1.5rpx;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.05);
}

/* 清除按钮 - 简洁图标样式 */
.clear-icon {
  font-size: 36rpx;
  color: #ffffff;
  margin-left: 16rpx;
  opacity: 0.9;
  transition: all 0.2s;
}

.clear-icon:active {
  opacity: 0.6;
  transform: scale(0.9);
}

/* 右侧占位 - 已不再需要，因为使用了绝对定位，但保留以防万一 */
.header-right-placeholder {
  display: none;
}

/* ==================== 消息滚动区域 ==================== */
.message-scroll {
  height: 100vh;
  box-sizing: border-box;
}

/* ==================== Loading 状态 ==================== */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 240rpx;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #E2E8F0;
  border-top-color: #10B981;
  border-radius: 50%;
  animation: spin 0.8s cubic-bezier(0.5, 0, 0.5, 1) infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 32rpx;
  font-size: 26rpx;
  color: #94A3B8;
  letter-spacing: 2rpx;
  font-weight: 500;
}

/* ==================== 空状态 ==================== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 240rpx;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 10rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #94A3B8;
  letter-spacing: 1rpx;
  font-weight: 500;
}

/* ==================== 消息列表 ==================== */
.message-list {
  padding: 24rpx; /* 减小边缘间距 */
  padding-bottom: 40rpx;
}

/* 滑动容器 */
.swipe-container {
  position: relative;
  margin-bottom: 20rpx; /* 减小项间距 */
  border-radius: 24rpx; /* 稍微减小圆角 */
  box-shadow: 0 4rpx 12rpx -4rpx rgba(0, 0, 0, 0.04), 0 2rpx 4rpx -2rpx rgba(0, 0, 0, 0.02);
}

/* 滑动操作按钮 */
.swipe-actions {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: stretch;
  border-radius: 0 24rpx 24rpx 0;
  overflow: hidden;
}

.action-btn {
  width: 120rpx; /* 稍微减小按钮宽度 */
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 500;
  letter-spacing: 1rpx;
  transition: all 0.2s;
}

.action-cancel {
  background: #CBD5E1;
  color: #475569;
}

.action-delete {
  background: #EF4444;
}

.action-btn:active {
  filter: brightness(0.95);
}

/* 消息卡片 */
.message-item {
  display: flex;
  align-items: flex-start;
  background: #FFFFFF;
  border-radius: 24rpx; /* 统一圆角 */
  padding: 24rpx; /* 显著减小内边距 */
  position: relative;
  z-index: 2;
  transition: transform 0.3s cubic-bezier(0.2, 0, 0.2, 1);
}

.message-item.swiped {
  transform: translateX(-240rpx); /* 配合减小的宽度调整 */
  border-radius: 24rpx 0 0 24rpx;
}

.message-item:active {
  background: #FAFAFA;
}

/* 未读指示点 */
.unread-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #EF4444 0%, #F87171 100%);
  flex-shrink: 0;
  margin-right: 20rpx; /* 减小间距 */
  margin-top: 12rpx;
  box-shadow: 0 0 8rpx rgba(239, 68, 68, 0.5);
  transition: opacity 0.3s;
}

/* 红点显示/隐藏状态 */
.dot-visible {
  opacity: 1;
}

.dot-hidden {
  opacity: 0;
}

/* 消息内容区域 */
.message-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx; /* 减小内部行间距 */
}

/* 标题行 - 包含前缀和工单编号 */
.message-title-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.message-title {
  font-size: 30rpx;
  color: #374151; /* 调暗标题颜色 */
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: 0.5rpx;
}

/* 工单编号 - 绿色 */
.message-order-number {
  font-size: 30rpx;
  font-weight: 600;
  color: #10b981;
  line-height: 1.4;
}

/* 阅读状态标签 */
.read-status {
  font-size: 18rpx;
  font-weight: 500;
  margin-left: 10rpx;
  line-height: 1;
  padding: 3rpx 8rpx;
  border-radius: 4rpx;
}

/* 未读 - 红色背景 */
.read-status.unread {
  color: #FFFFFF;
  background-color: #EF4444;
}

/* 已读 - 灰色边框 */
.read-status.read {
  color: #9CA3AF;
  background-color: transparent;
  border: 1rpx solid #9CA3AF;
}

.title-unread {
  color: #1F2937; /* 未读颜色也调暗 */
}

.message-desc {
  font-size: 26rpx;
  color: #4B5563;
  line-height: 1.5;
  text-align: justify;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 时间显示 - 纯文本样式 */
.message-time {
  align-self: flex-start;
  font-size: 26rpx;
  color: #9CA3AF; /* 浅灰文字 */
  background-color: transparent; /* 移除背景色 */
  padding: 0; /* 移除内边距 */
  border-radius: 0;
  font-family: 'DIN Alternate', sans-serif;
  letter-spacing: 1rpx;
  margin-top: 4rpx;
  font-weight: 400; /* 不需要太重 */
}

/* ==================== 底部提示 ==================== */
.footer-tip {
  text-align: center;
  color: #CBD5E1;
  font-size: 24rpx;
  padding: 40rpx 0 120rpx;
  letter-spacing: 2rpx;
}
