<!-- 新首页 - 仪表板风格 -->
<view class="page" style="padding-top: {{statusBarHeight}}px;">
  <!-- 顶部标签栏 -->
  <view class="tab-header">
    <view class="tab-list">
      <view
        wx:for="{{tabs}}"
        wx:key="index"
        class="tab-item {{activeTab === index ? 'tab-active' : ''}}"
        data-index="{{index}}"
        bindtap="onTabChange"
      >
        <text class="tab-text">{{item}}</text>
        <view class="tab-underline" wx:if="{{activeTab === index}}"></view>
      </view>
    </view>
  </view>

  <!-- 内容区域 - swiper 实现滑动切换 -->
  <swiper
    class="content-swiper"
    current="{{activeTab}}"
    bindchange="onSwiperChange"
    duration="{{300}}"
  >
    <!-- Tab 1: 工单维修 -->
    <swiper-item>
      <scroll-view
        scroll-y
        class="tab-content"
        scroll-top="{{scrollTops[0]}}"
        refresher-enabled="{{true}}"
        refresher-triggered="{{refreshing}}"
        bindrefresherrefresh="onRefresh"
      >
        <!-- 工单概况 -->
        <view class="wo-card wo-card-overview">
          <!-- Hero 区：渐变背景 + 总工单数 + 右侧插画 -->
          <view class="wo-hero">
            <view class="wo-hero-title">
              <text class="wo-hero-kicker">总工单数</text>
              <text class="wo-hero-num">{{workOrderStats.total}}<text class="wo-hero-unit">单</text></text>
            </view>
            <image class="wo-hero-img" src="/images/workorder-hero.png" mode="widthFix" />
          </view>

          <!-- 统计区：4 列纯数字 + 标签 -->
          <view class="wo-stat-row">
            <view class="wo-stat" bindtap="onStatCardTap" data-status="reported">
              <text class="wo-stat-num">{{workOrderStats.pending}}</text>
              <text class="wo-stat-label">已提报</text>
            </view>
            <view class="wo-stat" bindtap="onStatCardTap" data-status="maintenance">
              <text class="wo-stat-num">{{workOrderStats.inProgress}}</text>
              <text class="wo-stat-label">维修中</text>
            </view>
            <view class="wo-stat" bindtap="onStatCardTap" data-status="review">
              <text class="wo-stat-num">{{workOrderStats.review}}</text>
              <text class="wo-stat-label">待复核</text>
            </view>
            <view class="wo-stat" bindtap="onStatCardTap" data-status="completed">
              <text class="wo-stat-num">{{workOrderStats.completed}}</text>
              <text class="wo-stat-label">已完成</text>
            </view>
          </view>
        </view>

        <!-- 常用功能 -->
        <view class="wo-card">
          <text class="wo-card-title">常用功能</text>
          <view class="wo-func-row">
            <view
              wx:for="{{workOrderFunctions}}"
              wx:key="label"
              class="wo-func"
              data-module="workOrder"
              data-label="{{item.label}}"
              bindtap="onFunctionTap"
            >
              <view class="wo-func-icon wo-func-icon-{{index}} {{item.image ? 'wo-func-icon-img' : ''}}">
                <image wx:if="{{item.image}}" src="{{item.image}}" class="wo-func-img" mode="aspectFit" />
                <van-icon wx:else name="{{item.icon}}" size="30px" color="{{index === 0 ? '#3B82F6' : index === 1 ? '#A855F7' : index === 2 ? '#3B82F6' : '#F59E0B'}}" />
              </view>
              <text class="wo-func-label">{{item.label}}</text>
            </view>
          </view>
        </view>

        <!-- 快捷操作（维修员不显示） -->
        <view wx:if="{{!isMaintenanceWorker}}" class="wo-quick">
          <view class="wo-cta-row">
            <view class="wo-cta wo-cta-blue" data-action="新建工单" bindtap="onQuickAction" hover-class="wo-cta-hover">
              <image class="wo-cta-bg" src="/images/cta-new-workorder.png" mode="aspectFill" />
              <view class="wo-cta-text">
                <text class="wo-cta-title">新建工单</text>
                <text class="wo-cta-sub">快速提交维修申请</text>
              </view>
            </view>
            <view class="wo-cta wo-cta-green" data-action="物料入库" bindtap="onQuickAction" hover-class="wo-cta-hover">
              <image class="wo-cta-bg" src="/images/cta-stockin.png" mode="aspectFill" />
              <view class="wo-cta-text">
                <text class="wo-cta-title">物料入库</text>
                <text class="wo-cta-sub">物料入库登记</text>
              </view>
            </view>
          </view>
        </view>

        <!-- 最近记录（保留原样式） -->
        <view class="recent-section">
          <view class="recent-header">
            <text class="section-title">最近记录</text>
            <text class="view-all" data-module="workOrder" bindtap="onViewAll">查看全部 ›</text>
          </view>
          <view class="recent-list">
            <view
              wx:for="{{workOrderRecords}}"
              wx:key="orderId"
              class="record-item"
              data-module="workOrder"
              data-index="{{index}}"
              bindtap="onRecordTap"
            >
              <text class="record-status-badge" style="background: {{item.statusBg}}; color: {{item.statusColor}};">{{item.statusText}}</text>
              <view class="record-content">
                <text class="record-info">{{item.info}}</text>
                <text class="record-time">{{item.timeText}}</text>
              </view>
            </view>
          </view>
        </view>
      </scroll-view>
    </swiper-item>

    <!-- Tab 2: 耗品管理 -->
    <swiper-item wx:if="{{!isMaintenanceWorker}}">
      <scroll-view
        scroll-y
        class="tab-content"
        scroll-top="{{scrollTops[1]}}"
        refresher-enabled="{{true}}"
        refresher-triggered="{{refreshing}}"
        bindrefresherrefresh="onRefresh"
      >

        <view class="ds-content">
          <!-- 顶部 hero：文具图 + 库存总量 -->
          <view class="ds-banner">
            <view class="ds-banner-hero">
              <image src="/images/consumable-header.png" mode="widthFix" class="ds-banner-img"></image>
              <view class="ds-banner-title">
                <text class="ds-banner-kicker">库存总量</text>
                <text class="ds-banner-num">{{consumableOverview.totalStock}}</text>
                <text class="ds-banner-sub">统计周期 · {{consumableMonth}}</text>
              </view>
            </view>
          </view>

          <!-- 4 张统计小卡（独立行，纯代码） -->
          <view class="ds-stat-row">
            <view class="ds-stat-card" wx:for="{{consumableStatCards}}" wx:key="label">
              <view class="ds-stat-card-top">
                <view class="ds-stat-icon ds-stat-icon-{{item.tone}} {{item.iconImg ? 'ds-stat-icon-img-wrap' : ''}}">
                  <image wx:if="{{item.iconImg}}" src="{{item.iconImg}}" mode="aspectFit" class="ds-stat-icon-img" />
                  <van-icon wx:else name="{{item.icon}}" size="18px" color="#fff" />
                </view>
              </view>
              <text class="ds-stat-label">{{item.label}}</text>
              <text class="ds-stat-value">{{item.value}}<text class="ds-stat-unit">{{item.unit}}</text></text>
            </view>
          </view>

          <!-- 常用功能 6 宫格 -->
          <view class="ds-panel ds-actions-panel">
            <view class="ds-section-title"><text class="ds-h2">常用功能</text></view>
            <view class="ds-actions-grid">
              <block wx:for="{{consumableFuncRows}}" wx:for-item="row" wx:for-index="rowIdx" wx:key="rowIdx">
                <view
                  wx:for="{{row}}"
                  wx:for-item="func"
                  wx:key="label"
                  class="ds-action"
                  data-module="consumable"
                  data-label="{{func.label}}"
                  bindtap="onFunctionTap"
                  hover-class="ds-row-hover"
                >
                  <view class="ds-action-icon ds-{{func.tone}} {{func.image ? 'ds-action-icon-img' : ''}}">
                    <image wx:if="{{func.image}}" src="{{func.image}}" class="ds-action-img" mode="aspectFit" />
                    <van-icon wx:else name="{{func.icon}}" size="19px" />
                  </view>
                  <view class="ds-action-text">
                    <text class="ds-action-title">{{func.label}}</text>
                    <text class="ds-action-sub">{{func.subtitle}}</text>
                  </view>
                </view>
              </block>
            </view>
          </view>

          <!-- CTA 双按钮 -->
          <view class="ds-cta-grid">
            <view class="ds-cta ds-blue" data-action="发起申领" bindtap="onQuickAction" hover-class="ds-cta-hover">
              <image class="ds-cta-bg" src="/images/cta-faqi.jpg" mode="scaleToFill" />
              <view class="ds-cta-text">
                <text class="ds-cta-title">发起申领</text>
                <text class="ds-cta-sub">快速发起领用申请</text>
              </view>
            </view>
            <view class="ds-cta ds-green" data-action="快速入库" bindtap="onQuickAction" hover-class="ds-cta-hover">
              <image class="ds-cta-bg" src="/images/cta-saomaruku.jpg" mode="scaleToFill" />
              <view class="ds-cta-text">
                <text class="ds-cta-title">快速入库</text>
                <text class="ds-cta-sub">扫码快速入库</text>
              </view>
            </view>
          </view>

          <!-- 左右分栏：库存预警 + 出库审核 -->
          <view class="ds-split-grid">
            <view class="ds-panel ds-compact-panel">
              <view class="ds-panel-head">
                <view class="ds-h2">库存预警 <text class="ds-badge">{{consumableStats.stockWarning}}</text></view>
                <view class="ds-more" data-module="consumable" bindtap="onViewAll">
                  查看全部 <van-icon name="arrow" size="12px" color="#2f7bff" />
                </view>
              </view>
              <view
                class="ds-warning-row"
                wx:for="{{consumableWarnings}}"
                wx:key="name"
                data-module="consumable"
                bindtap="onViewAll"
                hover-class="ds-row-hover"
              >
                <view class="ds-row-text">
                  <text class="ds-row-title">{{item.name}}</text>
                  <text class="ds-row-sub">{{item.current}} · {{item.warning}}</text>
                </view>
                <van-icon name="arrow" size="13px" color="#b0b8c4" custom-class="ds-row-arrow" />
              </view>
            </view>

            <view class="ds-panel ds-compact-panel">
              <view class="ds-panel-head">
                <view class="ds-h2">出库审核 <text class="ds-badge">{{consumableStats.pendingApproval}}</text></view>
                <view class="ds-more" data-module="consumable" bindtap="onViewAll">
                  查看全部 <van-icon name="arrow" size="12px" color="#2f7bff" />
                </view>
              </view>
              <view
                class="ds-approval-row"
                wx:for="{{consumableApprovals}}"
                wx:key="applicant"
                data-module="consumable"
                bindtap="onViewAll"
                hover-class="ds-row-hover"
              >
                <view class="ds-row-text">
                  <text class="ds-row-title">申请人： {{item.applicant}}</text>
                  <text class="ds-row-sub">{{item.detail}}</text>
                </view>
                <text class="ds-status-tag">待审核</text>
              </view>
            </view>
          </view>

          <!-- 最近动态时间线 -->
          <view class="ds-panel ds-timeline-panel">
            <view class="ds-panel-head">
              <text class="ds-h2">最近动态</text>
              <view class="ds-more" data-module="consumable" bindtap="onViewAll">
                查看全部 <van-icon name="arrow" size="12px" color="#2f7bff" />
              </view>
            </view>
            <view
              class="ds-activity-row"
              wx:for="{{consumableActivities}}"
              wx:if="{{index < 4}}"
              wx:key="title"
              hover-class="ds-row-hover"
            >
              <text class="ds-activity-tag ds-tag-{{item.tone}}">{{item.type}}</text>
              <text class="ds-activity-title">{{item.title}}</text>
              <text class="ds-activity-time">{{item.time}}</text>
              <van-icon name="arrow" size="12px" color="#b0b8c4" custom-class="ds-row-arrow" />
            </view>
          </view>
        </view>

      </scroll-view>
    </swiper-item>

    <!-- Tab 3: 楼宇巡检 -->
    <swiper-item wx:if="{{!isMaintenanceWorker}}">
      <scroll-view
        scroll-y
        class="tab-content"
        scroll-top="{{scrollTops[2]}}"
        refresher-enabled="{{true}}"
        refresher-triggered="{{refreshing}}"
        bindrefresherrefresh="onRefresh"
      >
        <!-- 统计卡片 -->
        <view class="kpi-grid">
          <view class="kpi-card">
            <text class="kpi-label">待整改</text>
            <text class="kpi-value" style="color: #2563EB;">{{inspectionStats.pendingFix}}</text>
            <view class="kpi-icon-wrapper">
              <van-icon name="warning-o" size="40rpx" color="#2563EB" custom-style="opacity:0.6" />
            </view>
          </view>
          <view class="kpi-card">
            <text class="kpi-label">已整改</text>
            <text class="kpi-value" style="color: #16A34A;">{{inspectionStats.fixed}}</text>
            <view class="kpi-icon-wrapper">
              <van-icon name="passed" size="40rpx" color="#16A34A" custom-style="opacity:0.6" />
            </view>
          </view>
          <view class="kpi-card">
            <text class="kpi-label">延期整改</text>
            <text class="kpi-value" style="color: #DC2626;">{{inspectionStats.overdue}}</text>
            <view class="kpi-icon-wrapper">
              <van-icon name="clock-o" size="40rpx" color="#DC2626" custom-style="opacity:0.6" />
            </view>
          </view>
        </view>

        <!-- 功能入口 -->
        <view class="func-card">
          <view class="func-row">
            <view
              wx:for="{{inspectionFunctions}}"
              wx:key="label"
              class="func-item"
              data-module="inspection"
              data-label="{{item.label}}"
              bindtap="onFunctionTap"
            >
              <view class="func-icon">
                <van-icon name="{{item.icon}}" size="22px" color="#4F6DF5" />
              </view>
              <text class="func-label">{{item.label}}</text>
            </view>
          </view>
        </view>

        <!-- 快捷入口 -->
        <view class="quick-section">
          <text class="section-title">快捷入口</text>
          <view class="quick-row">
            <view class="quick-btn quick-btn-primary quick-btn-full" data-action="快速上报" bindtap="onQuickAction">
              <van-icon name="fire-o" size="16px" color="#fafafa" />
              <text class="quick-btn-text-light">快速上报</text>
            </view>
          </view>
        </view>

        <!-- 最近记录 -->
        <view class="recent-section">
          <view class="recent-header">
            <text class="section-title">最近记录</text>
            <text class="view-all" data-module="inspection" bindtap="onViewAll"></text>
          </view>
          <view class="recent-list">
            <view
              wx:for="{{inspectionRecords}}"
              wx:key="title"
              class="record-item"
              data-module="inspection"
              data-index="{{index}}"
              bindtap="onRecordTap"
            >
              <view class="record-dot" style="background: {{item.dotColor}};"></view>
              <view class="record-content">
                <text class="record-title">{{item.title}}</text>
                <text class="record-subtitle">{{item.subtitle}}</text>
              </view>
              <van-icon name="arrow" size="16px" color="#737373" />
            </view>
          </view>
        </view>
      </scroll-view>
    </swiper-item>
  </swiper>
</view>
