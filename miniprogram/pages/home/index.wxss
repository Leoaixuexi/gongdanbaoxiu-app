/* 新首页样式 - 仪表板风格 */

page {
  background: #EAEDF2;
  overflow-x: hidden;
}

.page {
  background: linear-gradient(180deg,
    #DCE4FF 0%,
    #DFF5F4 22%,
    #F1F3F6 50%,
    #EAEDF2 100%);
  height: 100vh;
  display: flex;
  flex-direction: column;
  width: 100%;
  overflow: hidden;
  box-sizing: border-box;
}

/* ========== 顶部标签栏 ========== */
.tab-header {
  padding: 8rpx 40rpx 0 20rpx;
  background: transparent;
  flex-shrink: 0;
  z-index: 100;
}

.tab-list {
  display: flex;
  align-items: center;
  padding: 4rpx 0;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 16rpx 12rpx;
  position: relative;
}

.tab-text {
  font-family: -apple-system, BlinkMacSystemFont, 'Inter', sans-serif;
  font-size: 34rpx;
  font-weight: 600;
  color: #a3a3a3;
  line-height: 1.2;
  position: relative;
  z-index: 1;
}

.tab-active .tab-text {
  font-weight: 800;
  color: #0a0a0a;
}

.tab-underline {
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 85%;
  height: 16rpx;
  background: #F0A030;
  border-radius: 4rpx;
  z-index: 0;
}

/* ========== Swiper 内容区 ========== */
.content-swiper {
  flex: 1;
  min-height: 0;
}

.tab-content {
  height: 100%;
  padding: 15rpx 32rpx 180rpx;
  box-sizing: border-box;
  width: 100%;
}

/* ========== KPI统计卡片（复刻数据页面样式） ========== */
.kpi-grid {
  display: flex;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.kpi-card {
  flex: 1;
  min-width: 0;
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.8) 0%, rgba(255, 255, 255, 0.6) 100%);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  padding: 24rpx 20rpx;
  border-radius: 24rpx;
  box-shadow:
    inset 0 2rpx 0 rgba(255, 255, 255, 0.5),
    0 2rpx 4rpx rgba(0, 0, 0, 0.008),
    0 6rpx 14rpx rgba(0, 0, 0, 0.018),
    0 12rpx 24rpx -6rpx rgba(0, 0, 0, 0.02);
  border-top: 1rpx solid rgba(255, 255, 255, 0.95);
  border-left: 1rpx solid rgba(255, 255, 255, 0.6);
  border-right: 1rpx solid rgba(255, 255, 255, 0.6);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.03);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.kpi-card:active {
  transform: translateY(2rpx);
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.03);
}

.kpi-card::after {
  content: '';
  position: absolute;
  top: -30rpx;
  right: -30rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, rgba(59, 130, 246, 0.10) 0%, rgba(59, 130, 246, 0.26) 100%);
  border-radius: 50%;
  z-index: 0;
}

.kpi-grid-4 .kpi-card::after {
  width: 72rpx;
  height: 72rpx;
  top: -20rpx;
  right: -20rpx;
}

.kpi-card-sm::after {
  width: 72rpx !important;
  height: 72rpx !important;
  top: -20rpx !important;
  right: -20rpx !important;
}

.kpi-icon-wrapper {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  z-index: 1;
}

.kpi-text-group {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  position: relative;
  z-index: 1;
}

.kpi-value {
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1;
  letter-spacing: -2rpx;
  position: relative;
  z-index: 1;
}

.kpi-label {
  font-size: 24rpx;
  color: #6b7280;
  font-weight: 500;
  position: relative;
  z-index: 1;
}

/* ========== 功能入口 ========== */
.func-card {
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.8) 0%, rgba(255, 255, 255, 0.6) 100%);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 32rpx;
  padding: 32rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.95);
  border-left: 1rpx solid rgba(255, 255, 255, 0.6);
  border-right: 1rpx solid rgba(255, 255, 255, 0.6);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.03);
  box-shadow:
    inset 0 2rpx 0 rgba(255, 255, 255, 0.5),
    0 2rpx 4rpx rgba(0, 0, 0, 0.008),
    0 6rpx 14rpx rgba(0, 0, 0, 0.018),
    0 12rpx 24rpx -6rpx rgba(0, 0, 0, 0.02);
  margin-bottom: 40rpx;
  box-sizing: border-box;
  width: 100%;
  position: relative;
  overflow: hidden;
}

.func-row {
  display: flex;
  gap: 20rpx;
  width: 100%;
}

.func-row + .func-row {
  margin-top: 24rpx;
}

.func-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 8rpx;
  border-radius: 32rpx;
  box-sizing: border-box;
}

.func-item:active {
  background: #f5f5f5;
}

.func-item-placeholder {
  visibility: hidden;
}

.func-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(160deg, #E8EDFF 0%, #D3DDFF 100%);
  border-top: 1rpx solid rgba(255, 255, 255, 0.9);
  box-shadow:
    inset 0 2rpx 0 rgba(255, 255, 255, 0.6),
    0 6rpx 14rpx rgba(99, 101, 237, 0.12);
}

.func-icon-sm {
  width: 80rpx;
  height: 80rpx;
  border-radius: 28rpx;
}

.func-label {
  font-family: -apple-system, BlinkMacSystemFont, 'Inter', sans-serif;
  font-size: 26rpx;
  font-weight: 600;
  color: #0a0a0a;
}

.func-label-sm {
  font-size: 24rpx;
  font-weight: 500;
}

