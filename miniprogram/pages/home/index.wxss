/* 新首页样式 - 仪表板风格 */

page {
  background: #fafafa;
  overflow-x: hidden;
}

.page {
  background: linear-gradient(180deg, #DCE4FF 0%, #DFF5F4 30%, #FAFAFA 55%);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  width: 100%;
  overflow-x: hidden;
  box-sizing: border-box;
}

/* ========== 顶部标签栏 ========== */
.tab-header {
  padding: 8rpx 40rpx 24rpx 20rpx;
  background: #DCE4FF;
  position: sticky;
  top: 0;
  z-index: 100;
}

.tab-list {
  display: flex;
  align-items: center;
  padding: 4rpx 0;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 16rpx 12rpx;
  position: relative;
}

.tab-text {
  font-family: -apple-system, BlinkMacSystemFont, 'Inter', sans-serif;
  font-size: 34rpx;
  font-weight: 600;
  color: #a3a3a3;
  line-height: 1.2;
  position: relative;
  z-index: 1;
}

.tab-active .tab-text {
  font-weight: 800;
  color: #0a0a0a;
}

.tab-underline {
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 85%;
  height: 16rpx;
  background: #F0A030;
  border-radius: 4rpx;
  z-index: 0;
}

/* ========== Swiper 内容区 ========== */
.content-swiper {
  flex: 1;
  height: calc(100vh - 120rpx);
}

.tab-content {
  height: 100%;
  padding: 15rpx 32rpx 180rpx;
  box-sizing: border-box;
  width: 100%;
}

/* ========== KPI统计卡片（复刻数据页面样式） ========== */
.kpi-grid {
  display: flex;
  gap: 16rpx;
  margin-bottom: 40rpx;
}

.kpi-card {
  flex: 1;
  min-width: 0;
  background: linear-gradient(165deg, #FFFFFF 0%, #F7F8FA 100%);
  padding: 24rpx 20rpx;
  border-radius: 24rpx;
  box-shadow:
    0 2rpx 4rpx rgba(0, 0, 0, 0.02),
    0 6rpx 16rpx rgba(0, 0, 0, 0.06),
    0 12rpx 24rpx -6rpx rgba(0, 0, 0, 0.04),
    4rpx 0 8rpx -3rpx rgba(0, 0, 0, 0.03),
    -4rpx 0 8rpx -3rpx rgba(0, 0, 0, 0.03),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.9);
  border-top: 1rpx solid rgba(255, 255, 255, 0.95);
  border-left: 1rpx solid rgba(0, 0, 0, 0.04);
  border-right: 1rpx solid rgba(0, 0, 0, 0.04);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.kpi-card:active {
  transform: translateY(2rpx);
  box-shadow:
    0 1rpx 2rpx rgba(0, 0, 0, 0.03),
    0 2rpx 6rpx rgba(0, 0, 0, 0.04);
}

.kpi-card::after {
  content: '';
  position: absolute;
  top: -30rpx;
  right: -30rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, rgba(16, 185, 129, 0.08) 0%, rgba(20, 184, 166, 0.18) 100%);
  border-radius: 50%;
  z-index: 0;
}

.kpi-grid-4 .kpi-card::after {
  width: 72rpx;
  height: 72rpx;
  top: -20rpx;
  right: -20rpx;
}

.kpi-card-sm::after {
  width: 72rpx !important;
  height: 72rpx !important;
  top: -20rpx !important;
  right: -20rpx !important;
}

.kpi-icon-wrapper {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  z-index: 1;
}

.kpi-value {
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1;
  letter-spacing: -2rpx;
  position: relative;
  z-index: 1;
}

.kpi-label {
  font-size: 24rpx;
  color: #6b7280;
  font-weight: 500;
  position: relative;
  z-index: 1;
}

/* ========== 功能入口 ========== */
.func-card {
  background: linear-gradient(180deg, #FFFFFF 0%, #FAFAFA 100%);
  border-radius: 32rpx;
  padding: 32rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.9);
  border-left: 1rpx solid rgba(0, 0, 0, 0.04);
  border-right: 1rpx solid rgba(0, 0, 0, 0.04);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.03);
  box-shadow:
    0 2rpx 4rpx rgba(0, 0, 0, 0.01),
    0 4rpx 12rpx rgba(0, 0, 0, 0.02),
    0 12rpx 32rpx -4rpx rgba(0, 0, 0, 0.03),
    4rpx 0 8rpx -2rpx rgba(0, 0, 0, 0.02),
    -4rpx 0 8rpx -2rpx rgba(0, 0, 0, 0.02),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.8);
  margin-bottom: 40rpx;
  box-sizing: border-box;
  width: 100%;
  position: relative;
  overflow: hidden;
}

.func-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.9), transparent);
}

.func-row {
  display: flex;
  gap: 20rpx;
  width: 100%;
}

.func-row + .func-row {
  margin-top: 24rpx;
}

.func-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 8rpx;
  border-radius: 32rpx;
  box-sizing: border-box;
}

.func-item:active {
  background: #f5f5f5;
}

.func-item-placeholder {
  visibility: hidden;
}

.func-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    0 4rpx 12rpx rgba(0, 0, 0, 0.08),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.3);
}

.func-icon-sm {
  width: 80rpx;
  height: 80rpx;
  border-radius: 28rpx;
}

.func-label {
  font-family: -apple-system, BlinkMacSystemFont, 'Inter', sans-serif;
  font-size: 26rpx;
  font-weight: 600;
  color: #0a0a0a;
}

.func-label-sm {
  font-size: 24rpx;
  font-weight: 500;
}

/* ========== 快捷入口 ========== */
.quick-section {
  margin-bottom: 40rpx;
}

.section-title {
  font-family: -apple-system, BlinkMacSystemFont, 'Inter', sans-serif;
  font-size: 30rpx;
  font-weight: 600;
  color: #525252;
  display: block;
  margin-bottom: 32rpx;
}

.quick-row {
  display: flex;
  gap: 20rpx;
  width: 100%;
}

.quick-btn {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.quick-btn:active {
  opacity: 0.85;
  transform: scale(0.98) translateY(2rpx);
}

.quick-btn-primary {
  background: linear-gradient(135deg, #66cce2 0%, #6365ed 100%);
  box-shadow:
    0 4rpx 12rpx rgba(99, 101, 237, 0.25),
    0 8rpx 20rpx -4rpx rgba(99, 101, 237, 0.15),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.2);
}

.quick-btn-secondary {
  background: linear-gradient(135deg, #f6d365 0%, #fda085 100%);
  box-shadow:
    0 4rpx 12rpx rgba(253, 160, 133, 0.25),
    0 8rpx 20rpx -4rpx rgba(253, 160, 133, 0.15),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.2);
}

.quick-btn-full {
  flex: 1;
}

.quick-btn-text-light {
  font-family: -apple-system, BlinkMacSystemFont, 'Inter', sans-serif;
  font-size: 26rpx;
  font-weight: 600;
  color: #fafafa;
}

.quick-btn-text-dark {
  font-family: -apple-system, BlinkMacSystemFont, 'Inter', sans-serif;
  font-size: 26rpx;
  font-weight: 600;
  color: #0a0a0a;
}

/* ========== 最近记录 ========== */
.recent-section {
  margin-top: 15rpx;
  margin-bottom: 40rpx;
}

.recent-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.recent-header .section-title {
  margin-bottom: 0;
}

.view-all {
  font-family: -apple-system, BlinkMacSystemFont, 'Inter', sans-serif;
  font-size: 24rpx;
  font-weight: 400;
  color: #737373;
}

.recent-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.record-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: linear-gradient(168deg, #FFFFFF 0%, #F6F7F9 100%);
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.95);
  border-left: 1rpx solid rgba(0, 0, 0, 0.04);
  border-right: 1rpx solid rgba(0, 0, 0, 0.04);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
  box-shadow:
    0 2rpx 4rpx rgba(0, 0, 0, 0.02),
    0 6rpx 14rpx rgba(0, 0, 0, 0.04),
    0 10rpx 24rpx -6rpx rgba(0, 0, 0, 0.03),
    4rpx 0 8rpx -3rpx rgba(0, 0, 0, 0.025),
    -4rpx 0 8rpx -3rpx rgba(0, 0, 0, 0.025),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.85);
  box-sizing: border-box;
  width: 100%;
  transition: all 0.2s ease;
}

.record-item:active {
  background: linear-gradient(180deg, #F5F5F5 0%, #EFEFEF 100%);
  box-shadow:
    0 1rpx 2rpx rgba(0, 0, 0, 0.02),
    0 2rpx 6rpx rgba(0, 0, 0, 0.03);
  transform: translateY(2rpx);
}

.record-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.record-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.record-title {
  font-family: -apple-system, BlinkMacSystemFont, 'Inter', sans-serif;
  font-size: 26rpx;
  font-weight: 500;
  color: #0a0a0a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.record-subtitle {
  font-family: -apple-system, BlinkMacSystemFont, 'Inter', sans-serif;
  font-size: 22rpx;
  font-weight: 400;
  color: #737373;
}
