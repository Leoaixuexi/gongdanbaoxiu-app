/* 新首页样式 - 仪表板风格 */

page {
  background: #DCE4FF;
  overflow-x: hidden;
}

.page {
  background: linear-gradient(180deg, #DCE4FF 0%, #DFF5F4 30%, #FAFAFA 55%);
  height: 100vh;
  display: flex;
  flex-direction: column;
  width: 100%;
  overflow: hidden;
  box-sizing: border-box;
}

/* ========== 顶部标签栏 ========== */
.tab-header {
  padding: 8rpx 40rpx 24rpx 20rpx;
  background: transparent;
  flex-shrink: 0;
  z-index: 100;
}

.tab-list {
  display: flex;
  align-items: center;
  padding: 4rpx 0;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 16rpx 12rpx;
  position: relative;
}

.tab-text {
  font-family: -apple-system, BlinkMacSystemFont, 'Inter', sans-serif;
  font-size: 34rpx;
  font-weight: 600;
  color: #a3a3a3;
  line-height: 1.2;
  position: relative;
  z-index: 1;
}

.tab-active .tab-text {
  font-weight: 800;
  color: #0a0a0a;
}

.tab-underline {
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 85%;
  height: 16rpx;
  background: #F0A030;
  border-radius: 4rpx;
  z-index: 0;
}

/* ========== Swiper 内容区 ========== */
.content-swiper {
  flex: 1;
  min-height: 0;
}

.tab-content {
  height: 100%;
  padding: 15rpx 32rpx 180rpx;
  box-sizing: border-box;
  width: 100%;
}

/* ========== KPI统计卡片（复刻数据页面样式） ========== */
.kpi-grid {
  display: flex;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.kpi-card {
  flex: 1;
  min-width: 0;
  background: #FFFFFF;
  padding: 24rpx 20rpx;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(0, 0, 0, 0.03);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.kpi-card:active {
  transform: translateY(2rpx);
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.03);
}

.kpi-card::after {
  content: '';
  position: absolute;
  top: -30rpx;
  right: -30rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, rgba(16, 185, 129, 0.08) 0%, rgba(20, 184, 166, 0.18) 100%);
  border-radius: 50%;
  z-index: 0;
}

.kpi-grid-4 .kpi-card::after {
  width: 72rpx;
  height: 72rpx;
  top: -20rpx;
  right: -20rpx;
}

.kpi-card-sm::after {
  width: 72rpx !important;
  height: 72rpx !important;
  top: -20rpx !important;
  right: -20rpx !important;
}

.kpi-icon-wrapper {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  z-index: 1;
}

.kpi-value {
  font-size: 48rpx;
  font-weight: 800;
  line-height: 1;
  letter-spacing: -2rpx;
  position: relative;
  z-index: 1;
}

.kpi-label {
  font-size: 24rpx;
  color: #6b7280;
  font-weight: 500;
  position: relative;
  z-index: 1;
}

/* ========== 功能入口 ========== */
.func-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 32rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.03);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  margin-bottom: 40rpx;
  box-sizing: border-box;
  width: 100%;
  position: relative;
  overflow: hidden;
}

.func-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.9), transparent);
}

.func-row {
  display: flex;
  gap: 20rpx;
  width: 100%;
}

.func-row + .func-row {
  margin-top: 24rpx;
}

.func-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 8rpx;
  border-radius: 32rpx;
  box-sizing: border-box;
}

.func-item:active {
  background: #f5f5f5;
}

.func-item-placeholder {
  visibility: hidden;
}

.func-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    0 4rpx 12rpx rgba(0, 0, 0, 0.08),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.3);
}

.func-icon-sm {
  width: 80rpx;
  height: 80rpx;
  border-radius: 28rpx;
}

.func-label {
  font-family: -apple-system, BlinkMacSystemFont, 'Inter', sans-serif;
  font-size: 26rpx;
  font-weight: 600;
  color: #0a0a0a;
}

.func-label-sm {
  font-size: 24rpx;
  font-weight: 500;
}

/* ========== 快捷入口 ========== */
.quick-section {
  margin-bottom: 40rpx;
}

.section-title {
  font-family: -apple-system, BlinkMacSystemFont, 'Inter', sans-serif;
  font-size: 30rpx;
  font-weight: 600;
  color: #525252;
  display: block;
  margin-bottom: 32rpx;
}

.quick-row {
  display: flex;
  gap: 20rpx;
  width: 100%;
}

.quick-btn {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.quick-btn:active {
  opacity: 0.85;
  transform: scale(0.98) translateY(2rpx);
}

.quick-btn-primary {
  background: linear-gradient(135deg, #88d0e8 0%, #8587f1 100%);
  box-shadow:
    0 4rpx 12rpx rgba(99, 101, 237, 0.2),
    0 8rpx 20rpx -4rpx rgba(99, 101, 237, 0.12),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.2);
}

.quick-btn-secondary {
  background: linear-gradient(135deg, #f8dc86 0%, #fdb29c 100%);
  box-shadow:
    0 4rpx 12rpx rgba(253, 160, 133, 0.2),
    0 8rpx 20rpx -4rpx rgba(253, 160, 133, 0.12),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.2);
}

.quick-btn-full {
  flex: 1;
}

.quick-btn-text-light {
  font-family: -apple-system, BlinkMacSystemFont, 'Inter', sans-serif;
  font-size: 26rpx;
  font-weight: 600;
  color: #fafafa;
}

.quick-btn-text-dark {
  font-family: -apple-system, BlinkMacSystemFont, 'Inter', sans-serif;
  font-size: 26rpx;
  font-weight: 600;
  color: #fafafa;
}

/* ========== 最近记录 ========== */
.recent-section {
  margin-top: 15rpx;
  margin-bottom: 40rpx;
}

.recent-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.recent-header .section-title {
  margin-bottom: 0;
}

.view-all {
  font-family: -apple-system, BlinkMacSystemFont, 'Inter', sans-serif;
  font-size: 24rpx;
  font-weight: 400;
  color: #737373;
}

.recent-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.record-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx 28rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.03);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
  width: 100%;
  transition: all 0.2s ease;
  position: relative;
}

.record-item:active {
  background: linear-gradient(180deg, #F5F5F5 0%, #EFEFEF 100%);
  box-shadow:
    0 1rpx 2rpx rgba(0, 0, 0, 0.02),
    0 2rpx 6rpx rgba(0, 0, 0, 0.03);
  transform: translateY(2rpx);
}

.record-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.record-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.record-status-badge {
  position: absolute;
  top: 0;
  right: 0;
  font-size: 20rpx;
  font-weight: 500;
  padding: 6rpx 14rpx;
  border-radius: 0 24rpx 0 16rpx;
  z-index: 10;
}

.record-info {
  font-size: 26rpx;
  font-weight: 500;
  color: #4b5563;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding-right: 100rpx;
}

.record-time {
  font-size: 22rpx;
  color: #6b7280;
}

/* ========== 耗品管理 Tab（Pencil 复刻） ========== */

.cs-card {
  background: #FFFFFF;
  border-radius: 18rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* 数据概览 */
.cs-overview-card { padding-bottom: 0; }

.cs-overview-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 20rpx 28rpx 22rpx;
}

.cs-overview-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.cs-overview-label {
  font-size: 24rpx;
  color: #8E8E8E;
  font-weight: 500;
}

.cs-overview-value {
  font-size: 56rpx;
  font-weight: 700;
  color: #1A1A1A;
  line-height: 1;
}

.cs-overview-unit {
  font-size: 24rpx;
  font-weight: 400;
  color: #666;
}

.cs-month-text {
  font-size: 20rpx;
  color: #B3B3B3;
  padding-top: 6rpx;
}

.cs-divider {
  height: 1rpx;
  background: #EFEFEF;
}

.cs-stats-grid {
  display: flex;
  flex-wrap: wrap;
}

.cs-stat-cell {
  width: 50%;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}

.cs-border-right { border-right: 1rpx solid #EFEFEF; }
.cs-border-bottom { border-bottom: 1rpx solid #EFEFEF; }

.cs-stat-icon {
  width: 50rpx;
  height: 50rpx;
  border-radius: 25rpx;
  background: #EAF2FF;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.cs-stat-texts {
  display: flex;
  flex-direction: column;
  gap: 3rpx;
  min-width: 0;
}

.cs-stat-label {
  font-size: 20rpx;
  color: #6F6F6F;
  font-weight: 500;
}

.cs-stat-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #1A1A1A;
}

.cs-stat-trend {
  font-size: 18rpx;
  color: #8FA7BF;
}

/* 功能宫格 */
.cs-func-card { padding: 28rpx; }

.cs-func-row {
  display: flex;
  justify-content: space-around;
}

.cs-func-row-mt { margin-top: 36rpx; }

.cs-func-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  flex: 1;
}

.cs-func-item:active { opacity: 0.7; }

.cs-func-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.12);
}

.cs-func-label {
  font-size: 22rpx;
  color: #1A1A1A;
  font-weight: 500;
}

/* 待办事项 */
.cs-todo-section { margin-bottom: 40rpx; }

.cs-todo-row {
  display: flex;
  gap: 18rpx;
  justify-content: center;
}

.cs-section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
  display: block;
  margin-bottom: 18rpx;
}

.cs-section-title-inline { margin-bottom: 0; }

.cs-todo-card {
  width: 250rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 18rpx 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.cs-todo-card:active { opacity: 0.8; }

.cs-todo-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.cs-todo-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #1A1A1A;
}

.cs-todo-count {
  font-size: 44rpx;
  font-weight: 700;
  color: #1A1A1A;
  line-height: 1;
}

.cs-todo-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cs-todo-icon-orange { background: #FFF3EA; }
.cs-todo-icon-blue { background: #EAF2FF; }

/* 快捷入口 */
.cs-quick-section { margin-bottom: 40rpx; }

.cs-quick-row {
  display: flex;
  gap: 18rpx;
}

.cs-quick-btn {
  flex: 1;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 14rpx;
}

.cs-quick-btn:active { opacity: 0.8; }

.cs-quick-outline {
  background: #FFFFFF;
  border: 2rpx solid #1677FF;
  box-shadow: 0 4rpx 16rpx rgba(22, 119, 255, 0.1);
}

.cs-quick-fill {
  background: #1677FF;
  box-shadow: 0 8rpx 24rpx rgba(22, 119, 255, 0.3);
}

.cs-quick-text {
  font-size: 28rpx;
  font-weight: 600;
}

.cs-quick-text-blue { color: #1677FF; }
.cs-quick-text-white { color: #FFFFFF; }

/* 最近动态 */
.cs-activity-card { padding: 28rpx; }

.cs-activity-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.cs-view-all {
  font-size: 22rpx;
  color: #1677FF;
  font-weight: 500;
}

.cs-activity-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.cs-activity-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.cs-activity-badge {
  width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
}

.cs-activity-text {
  flex: 1;
  font-size: 24rpx;
  font-weight: 500;
  color: #111111;
  min-width: 0;
}

.cs-activity-time {
  font-size: 20rpx;
  font-weight: 500;
  flex-shrink: 0;
}
