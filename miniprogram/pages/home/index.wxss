/* 新首页样式 - 仪表板风格 */

page {
  background: #EAEDF2;
  overflow-x: hidden;
}

.page {
  background: linear-gradient(180deg,
    #DCE4FF 0%,
    #DFF5F4 22%,
    #F1F3F6 50%,
    #EAEDF2 100%);
  height: 100vh;
  display: flex;
  flex-direction: column;
  width: 100%;
  overflow: hidden;
  box-sizing: border-box;
}

/* ========== 顶部标签栏 ========== */
.tab-header {
  padding: 8rpx 40rpx 0 20rpx;
  background: transparent;
  flex-shrink: 0;
  z-index: 100;
}

.tab-list {
  display: flex;
  align-items: center;
  padding: 4rpx 0;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 16rpx 12rpx;
  position: relative;
}

.tab-text {
  font-family: -apple-system, BlinkMacSystemFont, 'Inter', sans-serif;
  font-size: 34rpx;
  font-weight: 600;
  color: #a3a3a3;
  line-height: 1.2;
  position: relative;
  z-index: 1;
}

.tab-active .tab-text {
  font-weight: 800;
  color: #0a0a0a;
}

.tab-underline {
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 85%;
  height: 16rpx;
  background: #F0A030;
  border-radius: 4rpx;
  z-index: 0;
}

/* ========== Swiper 内容区 ========== */
.content-swiper {
  flex: 1;
  min-height: 0;
}

.tab-content {
  height: 100%;
  padding: 15rpx 32rpx 180rpx;
  box-sizing: border-box;
  width: 100%;
}

/* ========== KPI统计卡片（复刻数据页面样式） ========== */
.kpi-grid {
  display: flex;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.kpi-card {
  flex: 1;
  min-width: 0;
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.8) 0%, rgba(255, 255, 255, 0.6) 100%);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  padding: 24rpx 20rpx;
  border-radius: 24rpx;
  box-shadow:
    inset 0 2rpx 0 rgba(255, 255, 255, 0.5),
    0 2rpx 4rpx rgba(0, 0, 0, 0.008),
    0 6rpx 14rpx rgba(0, 0, 0, 0.018),
    0 12rpx 24rpx -6rpx rgba(0, 0, 0, 0.02);
  border-top: 1rpx solid rgba(255, 255, 255, 0.95);
  border-left: 1rpx solid rgba(255, 255, 255, 0.6);
  border-right: 1rpx solid rgba(255, 255, 255, 0.6);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.03);
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.kpi-card:active {
  transform: translateY(2rpx);
  box-shadow: 0 1rpx 4rpx rgba(0, 0, 0, 0.03);
}

.kpi-card::after {
  content: '';
  position: absolute;
  top: -30rpx;
  right: -30rpx;
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, rgba(59, 130, 246, 0.10) 0%, rgba(59, 130, 246, 0.26) 100%);
  border-radius: 50%;
  z-index: 0;
}

.kpi-grid-4 .kpi-card::after {
  width: 72rpx;
  height: 72rpx;
  top: -20rpx;
  right: -20rpx;
}

.kpi-card-sm::after {
  width: 72rpx !important;
  height: 72rpx !important;
  top: -20rpx !important;
  right: -20rpx !important;
}

.kpi-icon-wrapper {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  z-index: 1;
}

.kpi-text-group {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  position: relative;
  z-index: 1;
}

.kpi-value {
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1;
  letter-spacing: -2rpx;
  position: relative;
  z-index: 1;
}

.kpi-label {
  font-size: 24rpx;
  color: #6b7280;
  font-weight: 500;
  position: relative;
  z-index: 1;
}

/* ========== 功能入口 ========== */
.func-card {
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.8) 0%, rgba(255, 255, 255, 0.6) 100%);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 32rpx;
  padding: 32rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.95);
  border-left: 1rpx solid rgba(255, 255, 255, 0.6);
  border-right: 1rpx solid rgba(255, 255, 255, 0.6);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.03);
  box-shadow:
    inset 0 2rpx 0 rgba(255, 255, 255, 0.5),
    0 2rpx 4rpx rgba(0, 0, 0, 0.008),
    0 6rpx 14rpx rgba(0, 0, 0, 0.018),
    0 12rpx 24rpx -6rpx rgba(0, 0, 0, 0.02);
  margin-bottom: 40rpx;
  box-sizing: border-box;
  width: 100%;
  position: relative;
  overflow: hidden;
}

.func-row {
  display: flex;
  gap: 20rpx;
  width: 100%;
}

.func-row + .func-row {
  margin-top: 24rpx;
}

.func-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 8rpx;
  border-radius: 32rpx;
  box-sizing: border-box;
}

.func-item:active {
  background: #f5f5f5;
}

.func-item-placeholder {
  visibility: hidden;
}

.func-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(160deg, #E8EDFF 0%, #D3DDFF 100%);
  border-top: 1rpx solid rgba(255, 255, 255, 0.9);
  box-shadow:
    inset 0 2rpx 0 rgba(255, 255, 255, 0.6),
    0 6rpx 14rpx rgba(99, 101, 237, 0.12);
}

.func-icon-sm {
  width: 80rpx;
  height: 80rpx;
  border-radius: 28rpx;
}

.func-label {
  font-family: -apple-system, BlinkMacSystemFont, 'Inter', sans-serif;
  font-size: 26rpx;
  font-weight: 600;
  color: #0a0a0a;
}

.func-label-sm {
  font-size: 24rpx;
  font-weight: 500;
}

/* ========== 快捷入口 ========== */
.quick-section {
  margin-bottom: 40rpx;
}

.section-title {
  font-family: -apple-system, BlinkMacSystemFont, 'Inter', sans-serif;
  font-size: 30rpx;
  font-weight: 600;
  color: #525252;
  display: block;
  margin-bottom: 32rpx;
}

.quick-row {
  display: flex;
  gap: 20rpx;
  width: 100%;
}

.quick-btn {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.quick-btn:active {
  opacity: 0.85;
  transform: scale(0.98) translateY(2rpx);
}

.quick-btn-primary {
  background: linear-gradient(135deg, #5ab8d6 0%, #6366e8 100%);
  box-shadow:
    0 4rpx 12rpx rgba(99, 101, 237, 0.28),
    0 8rpx 20rpx -4rpx rgba(99, 101, 237, 0.18),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.2);
}

.quick-btn-secondary {
  background: linear-gradient(135deg, #f5c94a 0%, #fa8f6e 100%);
  box-shadow:
    0 4rpx 12rpx rgba(253, 160, 133, 0.28),
    0 8rpx 20rpx -4rpx rgba(253, 160, 133, 0.18),
    inset 0 2rpx 0 rgba(255, 255, 255, 0.2);
}

.quick-btn-full {
  flex: 1;
}

.quick-btn-text-light {
  font-family: -apple-system, BlinkMacSystemFont, 'Inter', sans-serif;
  font-size: 26rpx;
  font-weight: 600;
  color: #fafafa;
}

.quick-btn-text-dark {
  font-family: -apple-system, BlinkMacSystemFont, 'Inter', sans-serif;
  font-size: 26rpx;
  font-weight: 600;
  color: #fafafa;
}

/* ========== 最近记录 ========== */
.recent-section {
  margin-top: 15rpx;
  margin-bottom: 40rpx;
}

.recent-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.recent-header .section-title {
  margin-bottom: 0;
}

.view-all {
  font-family: -apple-system, BlinkMacSystemFont, 'Inter', sans-serif;
  font-size: 24rpx;
  font-weight: 400;
  color: #737373;
}

.recent-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.record-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.8) 0%, rgba(255, 255, 255, 0.6) 100%);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 24rpx;
  padding: 14rpx 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.95);
  border-left: 1rpx solid rgba(255, 255, 255, 0.6);
  border-right: 1rpx solid rgba(255, 255, 255, 0.6);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.03);
  box-shadow:
    inset 0 2rpx 0 rgba(255, 255, 255, 0.5),
    0 2rpx 4rpx rgba(0, 0, 0, 0.008),
    0 6rpx 14rpx rgba(0, 0, 0, 0.018),
    0 12rpx 24rpx -6rpx rgba(0, 0, 0, 0.02);
  box-sizing: border-box;
  width: 100%;
  transition: all 0.2s ease;
  position: relative;
}

.record-item:active {
  background: linear-gradient(180deg, #F5F5F5 0%, #EFEFEF 100%);
  box-shadow:
    0 1rpx 2rpx rgba(0, 0, 0, 0.02),
    0 2rpx 6rpx rgba(0, 0, 0, 0.03);
  transform: translateY(2rpx);
}

.record-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.record-content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.record-status-badge {
  position: absolute;
  top: 0;
  right: 0;
  font-size: 20rpx;
  font-weight: 500;
  padding: 6rpx 14rpx;
  border-radius: 0 24rpx 0 16rpx;
  z-index: 10;
}

.record-info {
  font-size: 26rpx;
  font-weight: 500;
  color: #4b5563;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  padding-right: 100rpx;
}

.record-time {
  font-size: 22rpx;
  color: #6b7280;
}

/* ============================================================
 * 耗品 Tab Dashboard 样式（复刻 /Users/lvleo/Desktop/test002）
 * px → rpx 比例：×1.744 (750/430)
 * ============================================================ */
.ds-content {
  --ds-ink: #101d3b;
  --ds-muted: #76819b;
  --ds-line: #edf1f8;
  --ds-blue: #2f7bff;
  --ds-green: #22c878;
  --ds-orange: #ff8b2c;
  --ds-purple: #9445e9;
  --ds-red: #ff4f58;
  --ds-panel: rgba(255, 255, 255, 0.92);
  --ds-shadow: 0 17rpx 49rpx rgba(34, 58, 112, 0.13);
}

/* ========== 顶部 banner：横长条 + 渐变底 + 右侧文具图 ========== */
.ds-banner {
  width: 100%;
  margin-top: 28rpx;
}

.ds-banner-hero {
  position: relative;
  width: 100%;
  aspect-ratio: 3.5 / 1;
  border-radius: 32rpx 32rpx 0 0;
  background: linear-gradient(135deg, #DDE4FE 0%, #CCD7FB 50%, #BFCBF9 100%);
}

.ds-banner-img {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 50%;
  height: auto;
  z-index: 3;
}

.ds-banner-title {
  position: absolute;
  left: 6%;
  top: 12%;
  width: 44%;
  z-index: 2;
}
.ds-banner-kicker { display: block; font-size: 22rpx; font-weight: 700; color: #4759a8; opacity: 0.85; }
.ds-banner-num    { display: block; font-size: 72rpx; font-weight: 900; line-height: 1.05; margin-top: 8rpx; color: #1a2a5c; letter-spacing: -1rpx; }
.ds-banner-sub    { display: block; font-size: 18rpx; font-weight: 600; color: #6577b8; margin-top: 10rpx; }

/* ========== 4 张统计小卡（独立行，纯代码） ========== */
.ds-stat-row {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14rpx;
  margin: 0 0 24rpx;
  padding: 16rpx;
  background: #f3f5fa;
  border-radius: 0 0 24rpx 24rpx;
}

.ds-stat-card {
  position: relative;
  min-width: 0;
  padding: 5rpx 10rpx;
  border-radius: 22rpx;
  background: #fff;
  border: 1rpx solid rgba(34, 58, 112, 0.06);
  box-shadow: 0 6rpx 18rpx rgba(34, 58, 112, 0.05);
  display: flex;
  flex-direction: column;
}

.ds-stat-card-top {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14rpx;
}

.ds-stat-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 10rpx rgba(0, 0, 0, 0.08);
}
.ds-stat-icon-blue   { background: linear-gradient(135deg, #4F8DFF 0%, #6BA8FF 100%); }
.ds-stat-icon-green  { background: linear-gradient(135deg, #2EC4B6 0%, #4ECDC4 100%); }
.ds-stat-icon-orange { background: linear-gradient(135deg, #FF8A3D 0%, #FFA866 100%); }
.ds-stat-icon-purple { background: linear-gradient(135deg, #8E73FF 0%, #A88FFF 100%); }
.ds-stat-icon-img-wrap {
  background: transparent;
  box-shadow: none;
  width: 74rpx;
  height: 74rpx;
}
.ds-stat-icon-img {
  width: 100%;
  height: 100%;
}

.ds-stat-label {
  font-size: 18rpx;
  color: #76819b;
  font-weight: 600;
  line-height: 1.2;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  margin-bottom: 4rpx;
  text-align: center;
}

.ds-stat-value {
  font-size: 32rpx;
  color: #101d3b;
  font-weight: 800;
  letter-spacing: -0.5rpx;
  white-space: nowrap;
  text-align: center;
}

.ds-stat-unit {
  font-size: 16rpx;
  color: #76819b;
  font-weight: 700;
  margin-left: 2rpx;
}

/* ========== 通用 panel + 标题 ========== */
.ds-panel {
  margin-bottom: 17rpx;
  padding: 26rpx 23rpx;
  border-radius: 28rpx;
  background: linear-gradient(165deg, rgba(255, 255, 255, 0.8) 0%, rgba(255, 255, 255, 0.6) 100%);
  box-shadow: inset 0 2rpx 0 rgba(255, 255, 255, 0.5);
  border-top: 1rpx solid rgba(255, 255, 255, 0.95);
  border-left: 1rpx solid rgba(255, 255, 255, 0.6);
  border-right: 1rpx solid rgba(255, 255, 255, 0.6);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.03);
}

.ds-section-title,
.ds-panel-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ds-section-title {
  justify-content: flex-start;
  gap: 16rpx;
  margin-bottom: 23rpx;
}

.ds-title-bar,
.ds-with-marker::before {
  content: "";
  width: 5rpx;
  height: 24rpx;
  border-radius: 0 7rpx 7rpx 0;
  background: var(--ds-blue);
}

.ds-h2 {
  display: inline-flex;
  align-items: center;
  font-size: 26rpx;
  line-height: 1.1;
  font-weight: 900;
  color: var(--ds-ink);
}

/* ========== 6 宫格 ========== */
.ds-actions-panel {
  padding: 26rpx 23rpx 21rpx;
  margin-bottom: 30rpx;
}

.ds-actions-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  row-gap: 21rpx;
  column-gap: 16rpx;
}

.ds-action {
  display: flex;
  min-width: 0;
  gap: 16rpx;
  align-items: center;
  padding: 16rpx 12rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.6);
  color: var(--ds-ink);
}

.ds-action-icon {
  flex: 0 0 auto;
  width: 59rpx;
  height: 59rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.54);
}

.ds-action-icon.ds-blue { color: var(--ds-blue); background: #e5f0ff; }
.ds-action-icon.ds-green { color: var(--ds-green); background: #ddf8eb; }
.ds-action-icon.ds-orange { color: var(--ds-orange); background: #fff0df; }
.ds-action-icon.ds-purple { color: var(--ds-purple); background: #f1e5ff; }

.ds-action-text {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.ds-action-title {
  font-size: 22rpx;
  font-weight: 900;
  color: var(--ds-ink);
  white-space: nowrap;
}

.ds-action-sub {
  margin-top: 5rpx;
  font-size: 18rpx;
  font-weight: 700;
  color: var(--ds-muted);
  white-space: nowrap;
}

/* ========== CTA ========== */
.ds-cta-grid,
.ds-split-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 17rpx;
}

.ds-cta-grid {
  margin-bottom: 30rpx;
}

.ds-cta {
  position: relative;
  overflow: hidden;
  display: flex;
  flex-direction: row-reverse;
  align-items: center;
  justify-content: flex-start;
  gap: 30rpx;
  height: 105rpx;
  padding: 0 37rpx 0 26rpx;
  border-radius: 24rpx;
  color: #fff;
}

.ds-cta.ds-green {
  padding-right: 90rpx;
}

.ds-cta-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.ds-cta-text {
  display: flex;
  flex-direction: column;
  position: relative;
  z-index: 1;
}

.ds-cta-title {
  font-size: 26rpx;
  line-height: 1.1;
  font-weight: 900;
  color: #fff;
}

.ds-cta-sub {
  margin-top: 9rpx;
  font-size: 19rpx;
  font-weight: 700;
  opacity: 0.88;
  color: #fff;
}

.ds-doc-stack,
.ds-cube-stack {
  position: relative;
  z-index: 1;
  flex: 0 0 auto;
}

.ds-doc-stack {
  width: 59rpx;
  height: 73rpx;
  border-radius: 10rpx;
  background: linear-gradient(180deg, #fff, #dceaff);
  box-shadow: 0 16rpx 31rpx rgba(4, 57, 157, 0.14);
}

.ds-doc-stack::before,
.ds-doc-stack::after {
  content: "";
  position: absolute;
}

.ds-doc-stack::before {
  left: 16rpx;
  top: 19rpx;
  width: 30rpx;
  height: 7rpx;
  border-radius: 7rpx;
  background: #5c97ff;
  box-shadow: 0 19rpx 0 #5c97ff;
}

.ds-doc-stack::after {
  right: -12rpx;
  bottom: 7rpx;
  width: 14rpx;
  height: 51rpx;
  border-radius: 7rpx;
  background: #ff9045;
  transform: rotate(41deg);
}

.ds-cube-stack {
  width: 75rpx;
  height: 68rpx;
  border-radius: 12rpx;
  background: linear-gradient(145deg, #fff, #dff7ec);
  box-shadow: 0 16rpx 31rpx rgba(3, 92, 45, 0.14);
}

.ds-cube-stack::before,
.ds-cube-stack::after {
  content: "";
  position: absolute;
  background: #60d890;
  border-radius: 3rpx;
}

.ds-cube-stack::before { left: 21rpx; top: 0; width: 31rpx; height: 14rpx; }
.ds-cube-stack::after { right: 9rpx; top: 21rpx; width: 12rpx; height: 33rpx; }

.ds-cta-hover { opacity: 0.9; transform: scale(0.98); }

/* ========== 左右分栏 ========== */
.ds-split-grid .ds-panel { margin-bottom: 0; }

.ds-compact-panel {
  min-width: 0;
  padding: 23rpx 21rpx 12rpx;
}

.ds-panel-head { margin-bottom: 19rpx; }

.ds-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 26rpx;
  height: 26rpx;
  margin-left: 10rpx;
  border-radius: 50%;
  background: var(--ds-red);
  color: #fff;
  font-size: 16rpx;
  font-weight: 800;
}

.ds-more {
  display: flex;
  align-items: center;
  gap: 4rpx;
  color: var(--ds-blue);
  font-size: 19rpx;
  font-weight: 800;
  white-space: nowrap;
}

.ds-warning-row,
.ds-approval-row,
.ds-activity-row {
  display: flex;
  align-items: center;
  min-width: 0;
}

.ds-warning-row {
  gap: 16rpx;
  padding: 14rpx 12rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.5);
}

.ds-warning-row + .ds-warning-row,
.ds-approval-row + .ds-approval-row {
  margin-top: 12rpx;
}

.ds-row-text {
  flex: 1 1 auto;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.ds-row-title {
  color: var(--ds-ink);
  font-size: 21rpx;
  font-weight: 900;
}

.ds-row-sub {
  margin-top: 5rpx;
  color: #73809d;
  font-size: 19rpx;
  font-weight: 700;
  line-height: 1.25;
}

.ds-warning-row .ds-row-sub,
.ds-approval-row .ds-row-sub {
  font-size: 17rpx;
  font-weight: 600;
}

.ds-row-arrow {
  flex: 0 0 auto;
  margin-left: 8rpx;
}

.ds-approval-row {
  justify-content: space-between;
  gap: 14rpx;
  padding: 14rpx 12rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.5);
}

.ds-status-tag {
  flex: 0 0 auto;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  background: #fff0e4;
  color: var(--ds-orange);
  font-size: 16rpx;
  font-weight: 700;
}

/* ========== 时间线 ========== */
.ds-timeline-panel {
  padding: 24rpx 23rpx 7rpx;
  margin-bottom: 0;
}

.ds-with-marker {
  position: relative;
  padding-left: 21rpx;
}

.ds-with-marker::before {
  position: absolute;
  left: -23rpx;
}

.ds-activity-row {
  display: grid;
  grid-template-columns: auto 1fr auto 18rpx;
  align-items: center;
  gap: 14rpx;
  padding: 14rpx 18rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.5);
}

.ds-activity-row + .ds-activity-row {
  margin-top: 8rpx;
}

.ds-activity-tag {
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  font-size: 18rpx;
  font-weight: 700;
  white-space: nowrap;
}

.ds-tag-green { background: #e6f7ee; color: var(--ds-green); }
.ds-tag-orange { background: #fff0e4; color: var(--ds-orange); }
.ds-tag-blue { background: #e8f0ff; color: var(--ds-blue); }

.ds-activity-title {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--ds-ink);
  font-size: 22rpx;
  font-weight: 600;
}

.ds-activity-time {
  color: #9aa3b6;
  font-size: 19rpx;
  font-weight: 500;
  white-space: nowrap;
}

.ds-row-hover { background: rgba(232, 238, 250, 0.4); }

/* ============================================================
 * 工单维修 Tab：白卡式布局（wo-* 命名空间）
 * 顶部纯装饰建筑 banner + 3 张白色卡片（概况 / 功能 / 快捷操作）
 * ============================================================ */

/* 顶部 banner：纯装饰，建筑图右对齐到屏幕边缘 */
.wo-banner {
  height: 170rpx;
  margin: -15rpx -32rpx -30rpx;
  display: flex;
  justify-content: flex-end;
  align-items: flex-start;
  overflow: hidden;
}

.wo-banner-img {
  width: 300rpx;
  height: 150rpx;
  margin-top: 20rpx;
  margin-right: 50rpx;
}

/* 白色卡片通用 */
.wo-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx 28rpx 36rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 18rpx rgba(34, 58, 112, 0.06);
}

.wo-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.wo-card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
  display: block;
  margin-bottom: 32rpx;
}

.wo-card-head .wo-card-title {
  margin-bottom: 0;
}

.wo-card-meta {
  font-size: 22rpx;
  color: #9ca3af;
}

/* 统计 4 列：圆形彩色背景图标 + 大数字 + 标签 */
.wo-stat-row {
  display: flex;
  align-items: stretch;
}

.wo-stat {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}

.wo-stat:active { opacity: 0.65; }

.wo-stat-icon {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.wo-icon-blue { background: linear-gradient(135deg, #DBEAFE 0%, #BFDBFE 100%); }
.wo-icon-orange { background: linear-gradient(135deg, #FFEDD5 0%, #FED7AA 100%); }
.wo-icon-purple { background: linear-gradient(135deg, #F3E8FF 0%, #E9D5FF 100%); }
.wo-icon-green { background: linear-gradient(135deg, #D1FAE5 0%, #A7F3D0 100%); }

.wo-stat-num {
  font-size: 42rpx;
  font-weight: 800;
  color: #0a0a0a;
  line-height: 1;
}

.wo-stat-label {
  font-size: 24rpx;
  color: #6b7280;
}

/* 功能 4 列：大彩色图标 + 蓝色标签 */
.wo-func-row {
  display: flex;
  align-items: stretch;
}

.wo-func {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.wo-func:active { opacity: 0.65; }

.wo-func-icon {
  width: 104rpx;
  height: 104rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.05);
}

.wo-func-icon-0 { background: linear-gradient(135deg, #EFF6FF 0%, #DBEAFE 100%); }
.wo-func-icon-1 { background: linear-gradient(135deg, #FAF5FF 0%, #F3E8FF 100%); }
.wo-func-icon-2 { background: linear-gradient(135deg, #EFF6FF 0%, #DBEAFE 100%); }
.wo-func-icon-3 { background: linear-gradient(135deg, #FFFBEB 0%, #FEF3C7 100%); }

.wo-func-label {
  font-size: 24rpx;
  color: #3B82F6;
  font-weight: 600;
}

/* 快捷操作容器（无标题、无白卡背景） */
.wo-quick {
  margin-bottom: 24rpx;
}

/* CTA 双卡：浅色背景 + 圆形加号 + 右侧 CSS 插画 + 右下小箭头 */
.wo-cta-row {
  display: flex;
  gap: 20rpx;
}

.wo-cta {
  position: relative;
  flex: 1;
  min-width: 0;
  height: 130rpx;
  border-radius: 18rpx;
  padding: 22rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.wo-cta-blue {
  background: linear-gradient(135deg, #E0EAFF 0%, #DBE6FF 100%);
}

.wo-cta-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.wo-cta-green {
  background: linear-gradient(135deg, #D5F4E6 0%, #C7EFD9 100%);
}

.wo-cta-hover {
  opacity: 0.85;
  transform: scale(0.98);
}

.wo-cta-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  z-index: 1;
  position: relative;
}

.wo-cta-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2937;
  line-height: 1.2;
}

.wo-cta-sub {
  font-size: 20rpx;
  color: #6b7280;
}


