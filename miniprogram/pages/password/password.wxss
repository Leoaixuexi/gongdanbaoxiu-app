/* pages/password/password.wxss */

/* ==================== 容器 ==================== */
.container {
  min-height: 100vh;
  background-color: #F8FAFC;
  display: flex;
  flex-direction: column;
  padding-bottom: 160rpx;
}

/* ==================== 导航栏 ==================== */
.nav-bar {
  background: #ffffff;
  border-bottom: 1rpx solid #F1F5F9;
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 32rpx;
}

.nav-left {
  width: 80rpx;
  display: flex;
  align-items: center;
}

.back-icon {
  width: 20rpx;
  height: 20rpx;
  border-left: 3rpx solid #1E293B;
  border-bottom: 3rpx solid #1E293B;
  transform: rotate(45deg);
}

.back-icon:active {
  opacity: 0.6;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #1E293B;
}

.nav-right {
  width: 80rpx;
}

/* ==================== 表单区域 ==================== */
.form-section {
  flex: 1;
  padding: 24rpx 32rpx 32rpx;
}

.form-card {
  border-radius: 24rpx;
  padding: 40rpx 32rpx 32rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.input-field {
  margin-bottom: 40rpx;
}

.input-field:last-of-type {
  margin-bottom: 0;
}

/* ==================== 字段标签 ==================== */
.field-label {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.field-icon-box {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 锁图标 */
.lock-icon {
  width: 28rpx;
  height: 32rpx;
  border: 3rpx solid #64748B;
  border-radius: 6rpx;
  border-top: none;
  position: relative;
}

.lock-icon::before {
  content: '';
  position: absolute;
  top: -16rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 20rpx;
  height: 16rpx;
  border: 3rpx solid #64748B;
  border-bottom: none;
  border-radius: 10rpx 10rpx 0 0;
}

.lock-icon::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 8rpx;
  height: 8rpx;
  background: #64748B;
  border-radius: 50%;
}

/* 钥匙图标 */
.key-icon {
  width: 14rpx;
  height: 14rpx;
  border: 3rpx solid #64748B;
  border-radius: 50%;
  position: relative;
}

.key-icon::before {
  content: '';
  position: absolute;
  left: 8rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 18rpx;
  height: 3rpx;
  background: #64748B;
}

.key-icon::after {
  content: '';
  position: absolute;
  right: -16rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 10rpx;
  height: 3rpx;
  background: #64748B;
  box-shadow: 0 -5rpx 0 #64748B, 0 5rpx 0 #64748B;
}

/* 盾牌图标 */
.shield-icon {
  width: 28rpx;
  height: 32rpx;
  border: 3rpx solid #64748B;
  border-radius: 4rpx 4rpx 14rpx 14rpx;
  position: relative;
}

.shield-icon::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 12rpx;
  height: 2rpx;
  background: #64748B;
  box-shadow: 0 -6rpx 0 #64748B;
}

.field-text {
  font-size: 28rpx;
  color: #1E293B;
  font-weight: 500;
}

/* ==================== 输入框 ==================== */
.input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
}

.input {
  flex: 1;
  width: 100%;
  padding: 24rpx 80rpx 24rpx 0;
  background-color: transparent;
  border: none;
  border-bottom: 2rpx solid #E2E8F0;
  font-size: 30rpx;
  color: #1E293B;
  transition: border-color 0.2s ease;
}

.input:focus {
  border-bottom-color: #10b981;
}

.input::placeholder {
  color: #CBD5E1;
  font-size: 28rpx;
}

/* ==================== 眼睛图标 ==================== */
.toggle-btn {
  position: absolute;
  right: 0;
  padding: 12rpx;
  background: transparent;
  border: none;
}

.toggle-btn::after {
  border: none;
}

.eye-icon {
  width: 40rpx;
  height: 28rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 睁眼状态 */
.eye-open {
  border: 3rpx solid #94A3B8;
  border-radius: 50% 50% 50% 50% / 60% 60% 40% 40%;
  background: transparent;
}

.eye-open::before {
  content: '';
  position: absolute;
  width: 12rpx;
  height: 12rpx;
  background: #94A3B8;
  border-radius: 50%;
}

/* 闭眼状态 */
.eye-close {
  border: none;
}

.eye-close::before {
  content: '';
  position: absolute;
  width: 36rpx;
  height: 3rpx;
  background: #94A3B8;
  border-radius: 2rpx;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.eye-close::after {
  content: '';
  position: absolute;
  width: 3rpx;
  height: 16rpx;
  background: #94A3B8;
  border-radius: 2rpx;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) rotate(-45deg);
}

/* ==================== 错误提示 ==================== */
.error-msg {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 32rpx;
  padding: 20rpx 24rpx;
  background-color: rgba(239, 68, 68, 0.08);
  border-radius: 12rpx;
  border-left: 4rpx solid #EF4444;
}

.error-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background-color: #EF4444;
  flex-shrink: 0;
}

.error-text {
  font-size: 26rpx;
  color: #EF4444;
  line-height: 1.5;
}

/* ==================== 安全提示 ==================== */
.security-tip {
  padding: 0 8rpx;
  margin-top: 24rpx;
}

.tip-text {
  font-size: 26rpx;
  line-height: 1.6;
  color: #64748B;
}

/* ==================== 底部按钮 ==================== */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  border-top: 1rpx solid #F1F5F9;
  display: flex;
  gap: 16rpx;
  z-index: 100;
}

.action-btn {
  flex: 1;
  padding: 28rpx;
  border-radius: 24rpx;
  font-weight: 500;
  font-size: 30rpx;
  transition: all 0.2s ease;
  border: none;
}

.action-btn::after {
  border: none;
}

.action-btn:active {
  transform: scale(0.98);
}

.cancel-btn {
  background: #F1F5F9;
}

.cancel-btn .btn-text {
  color: #64748B;
}

.cancel-btn:active {
  background: #E2E8F0;
}

.save-btn {
  background: linear-gradient(to right, #10b981, #14b8a6);
  box-shadow: 0 6rpx 20rpx rgba(16, 185, 129, 0.25);
}

.save-btn .btn-text {
  color: #ffffff;
}

.save-btn:active {
  opacity: 0.9;
  box-shadow: 0 4rpx 16rpx rgba(16, 185, 129, 0.3);
}

.btn-text {
  font-size: 30rpx;
  font-weight: 500;
}
