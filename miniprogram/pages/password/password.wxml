<!--pages/password/password.wxml-->
<view class="container">
  <!-- 导航栏 -->
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-content">
      <view class="nav-left" bindtap="handleCancel">
        <van-icon name="arrow-left" size="40rpx" color="#fff" />
      </view>
      <view class="nav-title">修改密码</view>
      <view class="nav-right"></view>
    </view>
  </view>

  <!-- 表单区域 -->
  <view class="form-section">
    <view class="form-card">
      <!-- 原密码 -->
      <view class="password-field">
        <view class="field-header">
          <view class="field-icon lock"></view>
          <text class="field-title">原密码</text>
        </view>
        <view class="field-input">
          <input
            class="text-input"
            placeholder-class="input-placeholder"
            type="{{showOld ? 'text' : 'password'}}"
            value="{{oldPassword}}"
            placeholder="请输入原密码"
            bindinput="onOldPasswordInput"
          />
          <view class="eye-toggle" bindtap="toggleShowOld">
            <view class="eye-shape {{showOld ? 'is-open' : ''}}"></view>
          </view>
        </view>
      </view>

      <!-- 新密码 -->
      <view class="password-field">
        <view class="field-header">
          <view class="field-icon key"></view>
          <text class="field-title">新密码</text>
        </view>
        <view class="field-input">
          <input
            class="text-input"
            placeholder-class="input-placeholder"
            type="{{showNew ? 'text' : 'password'}}"
            value="{{newPassword}}"
            placeholder="请输入新密码（至少6位）"
            bindinput="onNewPasswordInput"
          />
          <view class="eye-toggle" bindtap="toggleShowNew">
            <view class="eye-shape {{showNew ? 'is-open' : ''}}"></view>
          </view>
        </view>
      </view>

      <!-- 确认新密码 -->
      <view class="password-field">
        <view class="field-header">
          <view class="field-icon shield"></view>
          <text class="field-title">确认新密码</text>
        </view>
        <view class="field-input">
          <input
            class="text-input"
            placeholder-class="input-placeholder"
            type="{{showConfirm ? 'text' : 'password'}}"
            value="{{confirmPassword}}"
            placeholder="请再次输入新密码"
            bindinput="onConfirmPasswordInput"
          />
          <view class="eye-toggle" bindtap="toggleShowConfirm">
            <view class="eye-shape {{showConfirm ? 'is-open' : ''}}"></view>
          </view>
        </view>
      </view>

      <!-- 错误提示 -->
      <view class="error-msg" wx:if="{{error}}">
        <view class="error-dot"></view>
        <text class="error-text text-destructive">{{error}}</text>
      </view>
    </view>

    <!-- 安全提示 -->
    <view class="security-tip">
      <text class="tip-text">为了您的账户安全，建议使用字母、数字和符号的组合作为密码</text>
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="bottom-actions">
    <button class="action-btn cancel-btn" bindtap="handleCancel">
      <text class="btn-text">取消</text>
    </button>
    <button class="action-btn save-btn" bindtap="handleSubmit">
      <text class="btn-text">确认修改</text>
    </button>
  </view>
</view>
