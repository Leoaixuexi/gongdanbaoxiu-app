/* pages/editOrder/editOrder.wxss */
.page-container {
  min-height: 100vh;
  background: #F8FAFC;
  padding-bottom: 160rpx;
}

.main-content {
  padding-top: calc(104rpx + var(--status-bar-height, 0px));
  padding-bottom: 192rpx;
  padding-left: 32rpx;
  padding-right: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  max-width: 1024rpx;
  margin: 0 auto;
}

/* 照片容器 */
.photo-container {
  display: flex;
  gap: 24rpx;
  padding-top: 24rpx;
  padding-bottom: 16rpx;
  padding-right: 24rpx;
  width: 100%;
  overflow-x: auto;
  flex-wrap: nowrap;
  margin-left: auto;
}

.photo-container::-webkit-scrollbar {
  display: none;
}

.photo-item {
  position: relative;
  width: 176rpx;
  height: 176rpx;
  flex-shrink: 0;
}

.photo-image {
  width: 100%;
  height: 100%;
  background: #f1f5f9;
  border-radius: 24rpx;
  overflow: hidden;
  border: 1rpx solid #f1f5f9;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  transition: transform 0.5s ease;
}

.photo-image:active {
  transform: scale(0.95);
}

/* 删除按钮 */
.delete-btn {
  position: absolute;
  top: -16rpx;
  right: -16rpx;
  width: 48rpx;
  height: 48rpx;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(10rpx);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  transition: transform 0.2s ease;
}

.delete-btn:active {
  transform: scale(0.9);
}

/* X 图标 */
.icon-x {
  width: 24rpx;
  height: 24rpx;
  position: relative;
}

.icon-x::before,
.icon-x::after {
  content: '';
  position: absolute;
  width: 24rpx;
  height: 4rpx;
  background: #ffffff;
  border-radius: 2rpx;
  top: 50%;
  left: 50%;
}

.icon-x::before {
  transform: translate(-50%, -50%) rotate(45deg);
}

.icon-x::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}

/* 添加照片按钮 */
.add-photo-btn {
  width: 176rpx;
  height: 176rpx;
  flex-shrink: 0;
  border-radius: 24rpx;
  border: 4rpx dashed rgba(16, 185, 129, 0.3);
  background: rgba(16, 185, 129, 0.05);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.add-photo-btn:active {
  transform: scale(0.95);
  background: rgba(16, 185, 129, 0.1);
  border-color: rgba(16, 185, 129, 0.5);
}

/* Plus 图标 */
.icon-plus {
  width: 48rpx;
  height: 48rpx;
  position: relative;
}

.icon-plus::before,
.icon-plus::after {
  content: '';
  position: absolute;
  background: #10b981;
  border-radius: 2rpx;
}

.icon-plus::before {
  width: 48rpx;
  height: 6rpx;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.icon-plus::after {
  width: 6rpx;
  height: 48rpx;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

/* 备注区域 */
.remarks-section {
  display: flex;
  flex-direction: column;
  width: 100%;
  background: #ffffff;
  border-radius: 24rpx;
  border: 1rpx solid rgba(241, 245, 249, 0.8);
  padding: 40rpx 32rpx;
  box-shadow: 0 4rpx 16rpx -4rpx rgba(0, 0, 0, 0.03);
  transition: box-shadow 0.3s ease;
}

.remarks-section:hover {
  box-shadow: 0 8rpx 24rpx -4rpx rgba(0, 0, 0, 0.06);
}

.remarks-label {
  font-size: 28rpx;
  color: #64748b;
  font-weight: 500;
  letter-spacing: -0.5rpx;
  margin-bottom: 24rpx;
}

.remarks-input {
  width: 100%;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 30rpx;
  color: #1e293b;
  outline: none;
  resize: none;
  min-height: 200rpx;
  line-height: 1.6;
  transition: all 0.2s ease;
}

.remarks-input:focus {
  background: #ffffff;
  border-color: rgba(16, 185, 129, 0.5);
  box-shadow: 0 0 0 6rpx rgba(16, 185, 129, 0.1);
}

.remarks-input[placeholder] {
  color: #cbd5e1;
}
