/* 配件修改页面 */

page {
  font-family: "PingFang SC", -apple-system, BlinkMacSystemFont, "Segoe UI", "Hiragino Sans GB", "Microsoft YaHei", "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-size: 30rpx;
  color: #333;
}

.edit-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #DCE4FF 0%, #DFF5F4 30%, #FAFAFA 55%);
  padding-bottom: 200rpx;
}

.form-body {
  padding: 24rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 分组容器 */
.section-group {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

/* 分组标题 */
.section-title {
  font-size: 24rpx;
  font-weight: 500;
  color: #a3a3a3;
  padding-left: 4rpx;
}

/* 图片卡片 */
.photo-card {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.photos-row {
  display: flex;
  gap: 20rpx;
  justify-content: center;
}

.photo-slot {
  width: 150rpx;
  height: 150rpx;
  flex-shrink: 0;
}

.photo-filled {
  width: 100%;
  height: 100%;
  position: relative;
  border-radius: 16rpx;
  overflow: hidden;
}

.photo-img {
  width: 100%;
  height: 100%;
}

.photo-del {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.del-icon {
  font-size: 30rpx;
  color: white;
  line-height: 1;
}

.photo-empty {
  width: 100%;
  height: 100%;
  background: #F3F4F6;
  border: 2rpx dashed #D1D5DB;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.photo-empty-text {
  font-size: 22rpx;
  color: #9CA3AF;
}

.photos-tip {
  font-size: 22rpx;
  color: #b0b0b0;
}

/* 字段卡片 */
.field-card {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

/* 字段行 */
.field-row {
  display: flex;
  align-items: center;
  padding: 16rpx 28rpx;
  min-height: 68rpx;
}

.field-divider {
  height: 1rpx;
  background: rgba(0, 0, 0, 0.05);
  margin: 0 28rpx;
}

/* 标签 */
.field-label-wrap {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  min-width: 140rpx;
  padding-left: 18rpx;
  position: relative;
}

.req-star {
  position: absolute;
  left: 0;
  color: #FF3B30;
  font-size: 24rpx;
  line-height: 1;
}

.field-label {
  font-size: 30rpx;
  color: #1F1F1F;
  font-weight: 500;
}

/* 输入框 */
.field-input {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  text-align: right;
  line-height: 1;
}

.field-placeholder {
  color: #C8C8C8 !important;
  font-weight: 400 !important;
}

/* 选择器 */
.field-picker {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
}

picker {
  flex: 1;
}

.picker-val {
  font-size: 30rpx;
  color: #333;
}

.picker-placeholder {
  color: #C8C8C8;
}

.picker-arrow {
  width: 14rpx;
  height: 14rpx;
  border-top: 2rpx solid #CCCCCC;
  border-right: 2rpx solid #CCCCCC;
  transform: rotate(45deg);
  flex-shrink: 0;
}

/* 底部按钮 */
.bottom-btns {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: white;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 16rpx rgba(0, 0, 0, 0.05);
  display: flex;
  gap: 24rpx;
}

.btn-cancel {
  flex: 1;
  height: 88rpx;
  background-color: #F3F4F6;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-cancel:active {
  opacity: 0.7;
}

.btn-cancel-text {
  font-size: 30rpx;
  color: #4B5563;
}

.btn-submit {
  flex: 2;
  height: 88rpx;
  background: linear-gradient(to right, #10b981, #14b8a6);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(12, 167, 125, 0.3);
}

.btn-submit:active {
  opacity: 0.85;
}

.btn-disabled {
  opacity: 0.6;
}

.btn-submit-text {
  font-size: 30rpx;
  color: white;
  font-weight: 500;
}
