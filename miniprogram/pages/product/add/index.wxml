<!-- 新增商品页面 -->
<view class="page">
  <custom-header title="新增商品" bgColor="#FFFFFF" textColor="#1A1A1A" borderColor="#F0F0F0" />

  <view class="form" style="padding-top: calc({{headerHeight}}px + 16rpx);">

    <!-- 商品名称（必填） -->
    <view class="field">
      <view class="field-label">
        <text class="label">商品名称</text>
        <text class="star">*</text>
      </view>
      <view class="input-wrap">
        <input
          class="input"
          placeholder="请输入商品名称"
          placeholder-class="ph"
          value="{{form.name}}"
          data-field="name"
          bindinput="onInput"
        />
      </view>
    </view>

    <!-- 商品编号 -->
    <view class="field">
      <view class="field-label">
        <text class="label">商品编号</text>
        <text class="star">*</text>
      </view>
      <view class="input-wrap">
        <input
          class="input"
          placeholder="请输入或扫码"
          placeholder-class="ph"
          value="{{form.product_code}}"
          data-field="product_code"
          bindinput="onInput"
        />
        <view class="scan-btn" bindtap="onScanProductCode">
          <van-icon name="scan" size="22px" color="#525252" />
        </view>
      </view>
    </view>

    <!-- 类别 -->
    <view class="field">
      <view class="field-label">
        <text class="label">类别</text>
        <text class="star">*</text>
      </view>
      <picker mode="selector" range="{{categories}}" bindchange="onCategoryChange">
        <view class="input-wrap input-with-arrow">
          <text class="picker-text {{form.category ? '' : 'ph-text'}}">{{form.category || '请选择'}}</text>
          <view class="arrow"></view>
        </view>
      </picker>
    </view>

    <!-- 规格 + 型号（一行两列） -->
    <view class="field-row">
      <view class="field field-half">
        <view class="field-label">
          <text class="label">规格</text>
        </view>
        <view class="input-wrap">
          <input
            class="input"
            placeholder="如：500ml / A4"
            placeholder-class="ph"
            value="{{form.spec}}"
            data-field="spec"
            bindinput="onInput"
          />
        </view>
      </view>
      <view class="field field-half">
        <view class="field-label">
          <text class="label">型号</text>
        </view>
        <view class="input-wrap">
          <input
            class="input"
            placeholder="如：HP-680"
            placeholder-class="ph"
            value="{{form.model}}"
            data-field="model"
            bindinput="onInput"
          />
        </view>
      </view>
    </view>

    <!-- 单位 + 库存预警值（一行两列） -->
    <view class="field-row">
      <view class="field field-half">
        <view class="field-label">
          <text class="label">单位</text>
          <text class="star">*</text>
        </view>
        <picker mode="selector" range="{{units}}" bindchange="onUnitChange">
          <view class="input-wrap input-with-arrow">
            <text class="picker-text {{form.unit ? '' : 'ph-text'}}">{{form.unit || '请选择'}}</text>
            <view class="arrow"></view>
          </view>
        </picker>
      </view>
      <view class="field field-half">
        <view class="field-label">
          <text class="label">库存预警值</text>
          <text class="star">*</text>
        </view>
        <view class="input-wrap">
          <input
            class="input"
            type="number"
            placeholder="低于此值触发预警"
            placeholder-class="ph"
            value="{{form.min_stock}}"
            data-field="min_stock"
            bindinput="onInput"
          />
        </view>
      </view>
    </view>

    <!-- 采购渠道 -->
    <view class="field">
      <view class="field-label">
        <text class="label">采购渠道</text>
      </view>
      <view class="input-wrap">
        <input
          class="input"
          placeholder="如：供应商名称"
          placeholder-class="ph"
          value="{{form.source}}"
          data-field="source"
          bindinput="onInput"
        />
      </view>
    </view>

    <!-- 采购单价 -->
    <view class="field">
      <view class="field-label">
        <text class="label">采购单价（元）</text>
      </view>
      <view class="input-wrap">
        <input
          class="input"
          type="digit"
          placeholder="如：12.50"
          placeholder-class="ph"
          value="{{form.purchase_price}}"
          data-field="purchase_price"
          bindinput="onInput"
        />
      </view>
    </view>

    <!-- 商品图片 -->
    <view class="field">
      <view class="field-label">
        <text class="label">商品图片</text>
        <text class="star">*</text>
        <text class="label-tip">最多 3 张</text>
      </view>
      <view class="photos-row">
        <view wx:for="{{photos}}" wx:key="index" class="photo-box">
          <view wx:if="{{item}}" class="photo-preview">
            <image class="photo-img" src="{{item}}" mode="aspectFill" bindtap="onPreviewPhoto" data-index="{{index}}" />
            <view class="photo-del" catchtap="onRemovePhoto" data-index="{{index}}">
              <text class="del-text">×</text>
            </view>
          </view>
          <view wx:else class="photo-add" bindtap="onChoosePhoto" data-index="{{index}}">
            <text class="add-plus">+</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 备注 -->
    <view class="field">
      <view class="field-label">
        <text class="label">备注</text>
      </view>
      <view class="textarea-wrap">
        <textarea
          class="textarea"
          placeholder="请输入备注（选填）"
          placeholder-class="ph"
          placeholder-style="font-weight: 400; font-size: 28rpx;"
          value="{{form.remark}}"
          data-field="remark"
          bindinput="onInput"
          maxlength="30"
          auto-height
        />
        <text class="textarea-count">{{form.remark.length || 0}}/30</text>
      </view>
    </view>

  </view>

  <!-- 底部按钮 -->
  <view class="bottom-surface">
    <view class="bottom-actions">
      <view class="btn btn-cancel" bindtap="goBack">
        <text class="btn-cancel-text">取消</text>
      </view>
      <view class="btn btn-submit" bindtap="handleSubmit">
        <text class="btn-submit-text">确认添加</text>
      </view>
    </view>
  </view>
</view>
