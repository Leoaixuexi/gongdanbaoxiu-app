<!--pages/index/index.wxml-->
<view class="container">
  <!-- 自定义导航栏 -->
  <custom-header title="个人中心" showBack="{{false}}" />

  <!-- 用户信息卡片 -->
  <view class="user-card-wrapper" style="padding-top: {{headerHeight + 20}}px;">
    <view class="user-card">
      <!-- 装饰性背景元素 -->
      <view class="decoration decoration-top"></view>
      <view class="decoration decoration-bottom"></view>

      <!-- 用户信息 -->
      <view class="user-info">
        <view class="avatar-wrapper avatar-glow">
          <image
            class="avatar"
            src="{{userInfo.avatar}}"
            mode="aspectFill"
          />
        </view>
        <view class="user-text">
          <text class="user-name">{{userInfo.name}}</text>
        </view>
      </view>
    </view>
  </view>


  <!-- 资料列表 -->
  <view class="profile-card">
    <view class="bg-card premium-shadow-sm profile-list">
      <view class="profile-row">
        <view class="profile-row-left">
          <view class="profile-icon"><text class="iconfont icon-zhiwei-copy"></text></view>
          <text class="profile-label text-foreground">职位</text>
        </view>
        <text class="profile-value text-muted-foreground">{{userInfo.position}}</text>
      </view>

      <view class="profile-row border-top">
        <view class="profile-row-left">
          <view class="profile-icon"><text class="iconfont icon-zuzhibumen"></text></view>
          <text class="profile-label text-foreground">部门</text>
        </view>
        <text class="profile-value text-muted-foreground">{{userInfo.department}}</text>
      </view>

      <view class="profile-row border-top clickable" bindtap="navigateToAvatar">
        <view class="profile-row-left">
          <view class="profile-icon"><text class="iconfont icon-xiugaitouxiang"></text></view>
          <text class="profile-label text-foreground">修改头像</text>
        </view>
        <view class="profile-row-right">
          <image class="avatar-preview" src="{{userInfo.avatar}}" mode="aspectFill" />
          <view class="icon-arrow"></view>
        </view>
      </view>

      <view class="profile-row border-top clickable" bindtap="navigateToPassword">
        <view class="profile-row-left">
          <view class="profile-icon"><text class="iconfont icon-xiugaimima"></text></view>
          <text class="profile-label text-foreground">修改密码</text>
        </view>
        <view class="icon-arrow"></view>
      </view>

      <view class="profile-row border-top clickable" bindtap="navigateToPhone">
        <view class="profile-row-left">
          <view class="profile-icon"><text class="iconfont icon-xiugaishouji"></text></view>
          <text class="profile-label text-foreground">修改手机号</text>
        </view>
        <view class="profile-row-right">
          <text class="phone-text text-muted-foreground">{{userInfo.phone}}</text>
          <view class="icon-arrow"></view>
        </view>
      </view>

      <!-- 意见反馈 - 仅非管理员可见 -->
      <view wx:if="{{!isAdmin}}" class="profile-row border-top clickable" bindtap="goToFeedbackList">
        <view class="profile-row-left">
          <view class="profile-icon"><van-icon name="comment-o" size="36rpx" color="#838BA7" /></view>
          <text class="profile-label text-foreground">意见反馈</text>
        </view>
        <view class="icon-arrow"></view>
      </view>
    </view>
  </view>

  <!-- 退出登录按钮 -->
  <view class="logout-wrapper">
    <view class="logout-btn bg-card premium-shadow-sm" bindtap="handleLogout">
      <view class="logout-icon"></view>
      <text class="logout-text text-destructive">退出登录</text>
    </view>
  </view>
</view>
