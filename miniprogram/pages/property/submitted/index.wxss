/* pages/index/index.wxss */

/* 全局容器 */
.container {
  min-height: 100vh;
  background: #E9F0F6;
  padding-bottom: 48rpx;
}

/* ==================== 用户信息卡片 ==================== */
.user-card-wrapper {
  padding: 24rpx 32rpx 0;
}

.user-card {
  position: relative;
  overflow: hidden;
  padding: 12rpx 20rpx; /* Extremely compact padding */
  border-radius: 20rpx; /* Slightly smaller radius */
  background: linear-gradient(135deg, #10b981 0%, #14b8a6 100%);
  display: flex;
  align-items: center;
  box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.2);
  min-height: 100rpx; /* Ultra compact height */
}

/* 装饰性背景元素 */
.decoration {
  position: absolute;
  border-radius: 50%;
  filter: blur(50rpx); /* Smaller blur */
  opacity: 0.3;
}

.decoration-top {
  top: -60rpx;
  right: -60rpx;
  width: 180rpx;
  height: 180rpx;
  background-color: rgba(255, 255, 255, 0.2);
}

.decoration-bottom {
  bottom: -40rpx;
  left: -40rpx;
  width: 140rpx;
  height: 140rpx;
  background-color: rgba(0, 0, 0, 0.15);
}

/* 用户信息 */
.user-info {
  position: relative;
  display: flex;
  align-items: center;
  gap: 16rpx; /* Tight gap */
  z-index: 2;
}

.avatar-wrapper {
  width: 84rpx; /* Increased from 72rpx */
  height: 84rpx;
  border-radius: 50%;
  border: 3rpx solid rgba(255, 255, 255, 0.6);
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  flex-shrink: 0;
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.user-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  color: #ffffff;
  padding-left: 4rpx;
}

.user-name {
  font-size: 30rpx; /* Compact font */
  font-weight: 600;
  line-height: normal;
  letter-spacing: 0.5rpx;
  margin-top: 0;
  color: #ffffff;
  text-shadow: 0 1rpx 2rpx rgba(0,0,0,0.05);
}

/* ==================== 资料卡片 ==================== */
.profile-card {
  padding: 0 32rpx;
  margin-top: 24rpx;
}

.profile-list {
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 10rpx 30rpx rgba(15, 23, 42, 0.08);
}

.profile-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 32rpx;
  min-height: 80rpx;
}

.profile-row.clickable {
  transition: background-color 0.2s ease;
}

.profile-row.clickable:active {
  background-color: #F8FAFC;
}

.border-top {
  border-top: 1rpx solid #F1F5F9;
}

.profile-row-left {
  display: flex;
  align-items: center;
  gap: 18rpx;
  flex: 1;
}

.profile-row-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 图标样式 */
.profile-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #f7faff 0%, #eef2fb 100%);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.8), 0 6rpx 16rpx rgba(15, 23, 42, 0.08);
  flex-shrink: 0;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 32rpx;
}

