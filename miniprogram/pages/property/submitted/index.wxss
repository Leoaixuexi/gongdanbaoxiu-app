/* pages/index/index.wxss */

/* 全局容器 */
.container {
  min-height: 100vh;
  background-color: #F8FAFC;
  padding-bottom: 32rpx;
}

/* ==================== 用户信息卡片 ==================== */
.user-card-wrapper {
  padding: 24rpx 32rpx 0;
  padding-top: calc(24rpx + env(safe-area-inset-top) + 176rpx);
}

.user-card {
  position: relative;
  overflow: hidden;
  padding: 48rpx 32rpx;
  border-radius: 24rpx;
  background: linear-gradient(to right, #10b981, #14b8a6);
  box-shadow: 0 8rpx 24rpx rgba(16, 185, 129, 0.25);
}

/* 装饰性背景元素 */
.decoration {
  position: absolute;
  border-radius: 50%;
  filter: blur(60rpx);
  opacity: 0.3;
}

.decoration-top {
  top: -80rpx;
  right: -80rpx;
  width: 256rpx;
  height: 256rpx;
  background-color: rgba(255, 255, 255, 0.2);
}

.decoration-bottom {
  bottom: -60rpx;
  left: -60rpx;
  width: 192rpx;
  height: 192rpx;
  background-color: rgba(0, 0, 0, 0.15);
}

/* 用户信息 */
.user-info {
  position: relative;
  display: flex;
  align-items: center;
  gap: 24rpx;
  z-index: 2;
}

.avatar-wrapper {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.4);
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}

.avatar {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.user-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  color: #ffffff;
}

.user-name {
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.3;
  letter-spacing: 0.5rpx;
  margin-bottom: 4rpx;
}

.user-position {
  font-size: 28rpx;
  opacity: 0.85;
  font-weight: 400;
}

/* 右上角菜单按钮 */
.menu-btn {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}

.menu-btn:active {
  opacity: 0.7;
}

.menu-dots {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  align-items: center;
}

.dot {
  width: 8rpx;
  height: 8rpx;
  background: #ffffff;
  border-radius: 50%;
  opacity: 0.9;
}

/* ==================== 资料卡片 ==================== */
.profile-card {
  padding: 0 32rpx;
  margin-top: 24rpx;
}

.profile-list {
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.profile-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  min-height: 96rpx;
}

.profile-row.clickable {
  transition: background-color 0.2s ease;
}

.profile-row.clickable:active {
  background-color: #F8FAFC;
}

.border-top {
  border-top: 1rpx solid #F1F5F9;
}

.profile-row-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
}

.profile-row-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 图标样式 */
.icon-wrapper {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F8FAFC;
  flex-shrink: 0;
}

.icon {
  font-size: 36rpx;
}

/* 文字样式 */
.profile-label {
  font-size: 30rpx;
  color: #1E293B;
  font-weight: 400;
}

.profile-value {
  font-size: 30rpx;
  color: #64748B;
}

/* 头像预览 */
.avatar-preview {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  border: 2rpx solid #F1F5F9;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.06);
}

/* 手机号文字 */
.phone-text {
  font-size: 28rpx;
  color: #64748B;
}

/* 右箭头 */
.icon-arrow {
  font-size: 44rpx;
  color: #CBD5E1;
  font-weight: 300;
  line-height: 1;
}

/* ==================== 退出登录按钮 ==================== */
.logout-wrapper {
  padding: 0 32rpx;
  margin-top: 32rpx;
}

.logout-btn {
  width: 100%;
  padding: 28rpx;
  border-radius: 24rpx;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  transition: all 0.2s ease;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  border: none;
}

.logout-btn::after {
  border: none;
}

.logout-btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.logout-icon {
  font-size: 32rpx;
}

.logout-text {
  font-size: 30rpx;
  font-weight: 500;
  color: #EF4444;
}

/* ==================== 全局颜色类 ==================== */
.text-foreground {
  color: #1E293B;
}

.text-muted-foreground {
  color: #64748B;
}

.text-destructive {
  color: #EF4444;
}

.bg-card {
  background-color: #ffffff;
}

.bg-muted {
  background-color: #F8FAFC;
}

.gradient-primary {
  background: linear-gradient(135deg, #10b981 0%, #14b8a6 100%);
}

.premium-shadow {
  box-shadow: 0 8rpx 24rpx rgba(16, 185, 129, 0.25);
}

.premium-shadow-sm {
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.avatar-glow {
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.1);
}
