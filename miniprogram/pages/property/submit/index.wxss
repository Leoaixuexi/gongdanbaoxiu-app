/* 提交工单页面 - 独立卡片布局 */

/* 全局统一字体设置：优先使用苹方 */
page {
  font-family: "PingFang SC", -apple-system, BlinkMacSystemFont, "Segoe UI", "Hiragino Sans GB", "Microsoft YaHei", "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-size: 30rpx; /* 统一基准字号 */
  color: #333;
}

.submit-container {
  min-height: 100vh;
  background-color: #F5F5F5;
  padding-bottom: 200rpx;
}

/* 表单卡片容器 */
.form-cards {
  padding: 24rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

/* 单个卡片 */
.card {
  background-color: white;
  border-radius: 16rpx;
  padding: 20rpx 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 70rpx;
}

/* 标签 */
.card-label {
  font-size: 30rpx;
  color: #333;
  line-height: 30rpx;
  height: 30rpx;
}

.card-label-wrapper {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  line-height: 30rpx;
  height: 30rpx;
  min-width: 128rpx;
}

.card-label-required {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  line-height: 30rpx;
  height: 30rpx;
  min-width: 128rpx;
}

.star {
  color: #FF3B30;
  font-size: 30rpx;
  line-height: 30rpx;
}

.label {
  font-size: 30rpx;
  color: #1F1F1F;
  line-height: 30rpx;
  height: 30rpx;
  font-weight: 500;
  /* font-family 继承 page */
}

/* 右侧内容区 */
.card-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex: 1;
  justify-content: flex-end;
}

/* 输入框 */
.card-input {
  flex: 1;
  font-size: 30rpx;
  color: #333;
  text-align: right;
  line-height: 30rpx;
  min-height: 30rpx;
  /* font-family 继承 page */
}

.card-input::placeholder {
  color: #CCCCCC !important;
  font-size: 30rpx;
  /* font-family 继承 page */
}

.card-input[disabled] {
  background-color: transparent;
  color: #CCCCCC;
}

.card-input[disabled]::placeholder {
  color: #CCCCCC !important;
  font-size: 30rpx;
  /* font-family 继承 page */
}

/* 工单编号输入框 - 有值时 */
.order-number-input.has-value {
  color: #333 !important;
  text-align: right;
}

/* 通用 placeholder 样式 */
.custom-placeholder {
  color: #CCCCCC !important;
  font-weight: 400 !important; /* 不加粗 */
}

/* 工单编号 placeholder 样式 */
.order-number-placeholder {
  color: #CCCCCC !important;
  font-weight: 400 !important;
}

/* 输入框 placeholder */
.card-input::placeholder {
  color: #CCCCCC !important;
  font-size: 30rpx;
  font-weight: 400 !important;
}

.card-input[disabled]::placeholder {
  color: #CCCCCC !important;
  font-size: 30rpx;
  font-weight: 400 !important;
}

/* 扫一扫按钮 */
.scan-button-inline {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
  flex-shrink: 0;
}

/* 选择器 */
picker {
  flex: 1;
}

.card-picker {
  display: flex;
  align-items: center;
  gap: 16rpx;
  justify-content: flex-end;
}

.picker-text {
  font-size: 30rpx;
  color: #333;
  /* font-family 继承 page */
}

.picker-text.placeholder {
  color: #CCCCCC;
  font-size: 30rpx;
  font-weight: 400 !important; /* 强制不加粗 */
}

.arrow {
  font-size: 36rpx;
  color: #CCCCCC;
  font-weight: 300;
  line-height: 1;
  transform: translateY(-12rpx);
}

/* 优先级按钮行 - 水平布局 */
.priority-row {
  display: flex;
  gap: 24rpx;
  justify-content: flex-end;
}

.priority-btn {
  min-width: 90rpx;  /* 进一步调窄 */
  height: 56rpx;     /* 恢复到原始高度 */
  padding: 0 12rpx;
  background-color: #F7F8FA;
  border-radius: 28rpx; /* 适配高度的圆角 */
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  border: 1rpx solid transparent;
}

/* 选中态 - 绿色 (普通) */
.priority-btn.active-green {
  background: linear-gradient(135deg, #34C759 0%, #30B753 100%);
  box-shadow: 0 4rpx 12rpx rgba(52, 199, 89, 0.3);
}

/* 选中态 - 黄色 */
.priority-btn.active-yellow {
  background: linear-gradient(135deg, #FFCC00 0%, #E6B800 100%);
  box-shadow: 0 4rpx 12rpx rgba(255, 204, 0, 0.3);
}

/* 选中态 - 橙色 */
.priority-btn.active-orange {
  background: linear-gradient(135deg, #FF9500 0%, #E68600 100%);
  box-shadow: 0 4rpx 12rpx rgba(255, 149, 0, 0.3);
}

/* 选中态 - 红色 (紧急) */
.priority-btn.active-red {
  background: linear-gradient(135deg, #FF3B30 0%, #E6352B 100%);
  box-shadow: 0 4rpx 12rpx rgba(255, 59, 48, 0.3);
}

.priority-text {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

.priority-btn.active-green .priority-text,
.priority-btn.active-yellow .priority-text,
.priority-btn.active-orange .priority-text,
.priority-btn.active-red .priority-text {
  color: white;
  font-weight: 600;
}

/* 日期时间显示 */
.datetime-display {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.datetime-text {
  font-size: 30rpx;
  color: #333;
}

.datetime-text:first-child {
  margin-right: 8rpx;
}

/* 问题描述卡片 */
.card-textarea {
  flex-direction: column;
  align-items: flex-start;
  gap: 24rpx;
}

.textarea-box {
  width: 100%;
  min-height: 140rpx;
  font-size: 30rpx;
  color: #333;
  line-height: 1.6;
  background-color: #FAFAFA;
  border: 1rpx solid #F0E6D3;
  border-radius: 8rpx;
  padding: 24rpx;
  box-sizing: border-box;
  /* font-family 继承 page */
}

.textarea-box::placeholder {
  color: #CCCCCC;
  font-size: 30rpx;
  font-weight: 400 !important;
}

.textarea-box-remark {
  min-height: 130rpx;
  height: 130rpx;
}

/* 现场照片卡片 */
.card-photos {
  flex-direction: column;
  align-items: flex-start;
  gap: 24rpx;
}

.photos-header {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.photos-tip {
  font-size: 26rpx;
  color: #999;
}

.photos-row {
  width: 100%;
  display: flex;
  gap: 20rpx;
  justify-content: center;
  align-items: center;
}

.photo-box {
  width: 160rpx;
  height: 160rpx;
  flex-shrink: 0;
}

.photo-preview {
  width: 100%;
  height: 100%;
  position: relative;
  border-radius: 8rpx;
  overflow: hidden;
}

.photo-img {
  width: 100%;
  height: 100%;
}

.photo-del {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 36rpx;
  height: 36rpx;
  background-color: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.del-text {
  font-size: 28rpx;
  color: white;
  line-height: 1;
}

.photo-add {
  width: 100%;
  height: 100%;
  background-color: #F5F5F5;
  border: 2rpx dashed #DDDDDD;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-plus {
  font-size: 56rpx;
  color: #CCCCCC;
  line-height: 1;
  font-weight: 300;
}

/* 底部按钮 */
.bottom-btns {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: white;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -2rpx 16rpx rgba(0, 0, 0, 0.05);
  display: flex;
  gap: 24rpx;
}

.btn-cancel {
  flex: 1;
  height: 88rpx;
  background-color: white;
  border: 1rpx solid #DDDDDD;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-cancel-text {
  font-size: 30rpx;
  color: #666;
}

.btn-submit {
  flex: 1;
  height: 88rpx;
  background: linear-gradient(to right, #10b981, #14b8a6);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(12, 167, 125, 0.3);
}

.btn-submit-text {
  font-size: 30rpx;
  color: white;
  font-weight: 500;
}

/* 日期时间选择弹窗 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal-content {
  width: 100%;
  background-color: white;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  animation: slide-up 0.3s ease-out;
}

@keyframes slide-up {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 48rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 500;
  color: #333;
}

.datetime-picker-content {
  margin-bottom: 64rpx;
}

.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.picker-row:last-child {
  border-bottom: none;
}

.picker-label {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

.datetime-picker-display {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  padding: 16rpx 24rpx;
  background-color: #f9fafb;
  border-radius: 12rpx;
  margin-left: 32rpx;
}

.datetime-picker-text {
  font-size: 30rpx;
  color: #333;
}

.modal-actions {
  display: flex;
  gap: 32rpx;
}

.modal-button {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
}

.modal-button-cancel {
  background-color: white;
  border: 1rpx solid #DDDDDD;
}

.modal-button-confirm {
  background: linear-gradient(to right, #10b981, #14b8a6);
}

.modal-button-text {
  font-size: 32rpx;
  font-weight: 500;
  color: #666;
}

.modal-button-text-white {
  color: white;
}

/* ----------------------------------
 * 新增：自定义底部选择器 (Action Sheet) 样式
 * ---------------------------------- */

/* 触发器箭头 - 使用纯 CSS 绘制 Chevron */
.card-arrow {
  width: 16rpx;
  height: 16rpx;
  border-top: 3rpx solid #CCCCCC;
  border-right: 3rpx solid #CCCCCC;
  transform: rotate(45deg);
  margin-left: 8rpx;
}

/* 弹窗容器调整 */
.selector-modal {
  display: flex;
  flex-direction: column;
  max-height: 80vh; /* 限制最大高度 */
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

/* 关闭按钮 */
.modal-close {
  position: absolute;
  right: 32rpx;
  top: 32rpx;
  padding: 10rpx;
  line-height: 1;
}

.icon-close {
  font-size: 40rpx;
  color: #999;
  font-weight: 300;
}

/* 选项列表容器 */
.selector-scroll {
  width: 100%;
  max-height: 60vh;
  margin-top: 20rpx;
}

/* 单个选项 */
.selector-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 16rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.selector-item:active {
  background-color: #F9F9F9;
}

.selector-item:last-child {
  border-bottom: none;
}

/* 选项文本 */
.selector-item-text {
  font-size: 32rpx;
  color: #333;
}

/* 选中态样式 */
.selector-item.active .selector-item-text {
  color: #0CA77D; /* 主题色 */
  font-weight: 500;
}

/* 选中打钩图标 */
.selector-check {
  width: 32rpx;
  height: 16rpx;
  border-left: 4rpx solid #0CA77D;
  border-bottom: 4rpx solid #0CA77D;
  transform: rotate(-45deg) translateY(-4rpx);
}
