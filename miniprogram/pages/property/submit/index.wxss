/* 新建工单页面 - 与「新增商品」共用 UI 风格 */

page {
  font-family: "PingFang SC", -apple-system, BlinkMacSystemFont, "Segoe UI", "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-size: 28rpx;
  color: #111827;
  background-color: #F7F9FC;
}

.page {
  min-height: 100vh;
  background-color: #F7F9FC;
  padding-bottom: 240rpx;
}

.form {
  padding: 0 48rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 字段容器 */
.field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.field-row {
  display: flex;
  gap: 24rpx;
}

.field-half {
  flex: 1;
  min-width: 0;
}

.field-floor {
  flex: none;
  width: 240rpx;
}

/* 标签 */
.field-label {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.label {
  font-size: 28rpx;
  color: #111827;
  font-weight: 700;
  line-height: 1.2;
}

.star {
  font-size: 28rpx;
  color: #FF3B30;
  font-weight: 700;
  line-height: 1.2;
}

.label-tip {
  margin-left: auto;
  font-size: 22rpx;
  color: #8994A6;
  font-weight: 500;
}

/* 输入框容器 */
.input-wrap {
  height: 88rpx;
  padding: 0 28rpx;
  background-color: #FFFFFF;
  border: 1rpx solid #E3E8F0;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(154, 166, 187, 0.09);
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.input-with-arrow {
  justify-content: space-between;
}

.input {
  flex: 1;
  font-family: "PingFang SC", -apple-system, BlinkMacSystemFont, "Segoe UI", "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-size: 28rpx;
  color: #111827;
  font-weight: 400;
  line-height: 1.5;
  min-height: 40rpx;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

.ph {
  color: #9BA4B5;
  font-weight: 400;
  font-size: 28rpx;
}

.picker-text {
  flex: 1;
  font-family: "PingFang SC", -apple-system, BlinkMacSystemFont, "Segoe UI", "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-size: 28rpx;
  color: #111827;
  font-weight: 400;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

.picker-text.ph-text {
  color: #9BA4B5;
  font-weight: 400;
}

.arrow {
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid #C0C7D4;
  border-right: 3rpx solid #C0C7D4;
  transform: rotate(45deg);
  margin-left: 12rpx;
  flex-shrink: 0;
}

/* 工单编号"自动生成"灰字 */
.auto-generate-text {
  font-size: 28rpx;
  color: #9BA4B5;
  font-weight: 400;
}

/* 文本域 */
.textarea-wrap {
  background-color: #FFFFFF;
  border: 1rpx solid #E3E8F0;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(154, 166, 187, 0.09);
  padding: 20rpx 28rpx;
  box-sizing: border-box;
}

.textarea {
  width: 100%;
  min-height: 120rpx;
  font-family: "PingFang SC", -apple-system, BlinkMacSystemFont, "Segoe UI", "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-size: 28rpx;
  color: #111827;
  line-height: 1.5;
  font-weight: 400;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

.textarea-sm {
  min-height: 120rpx;
  height: 120rpx;
}

.textarea-wrap-sm {
  padding: 14rpx 28rpx;
}

/* 现场照片 */
.photos-row {
  display: flex;
  gap: 20rpx;
}

.photo-box {
  width: 160rpx;
  height: 160rpx;
  flex-shrink: 0;
}

.photo-preview {
  width: 100%;
  height: 100%;
  position: relative;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(154, 166, 187, 0.09);
}

.photo-img {
  width: 100%;
  height: 100%;
}

.photo-del {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 36rpx;
  height: 36rpx;
  background-color: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.del-text {
  font-size: 28rpx;
  color: #FFFFFF;
  line-height: 1;
}

.photo-add {
  width: 100%;
  height: 100%;
  background-color: #FBFCFF;
  border: 2rpx dashed #CFD8E6;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(154, 166, 187, 0.09);
}

.add-plus {
  font-size: 56rpx;
  color: #9CA3AF;
  line-height: 1;
  font-weight: 300;
}

/* 分段控制器：优先级 + 责任方共用容器风格 */
.priority-row,
.party-row {
  position: relative;
  display: flex;
  gap: 6rpx;
  padding: 6rpx;
  background-color: #EDEFF3;
  border-radius: 22rpx;
}

/* 滑动 thumb：选中态白底由它承载，平滑滑动到目标位置 */
.seg-thumb {
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  height: 76rpx;
  width: calc((100% - 12rpx - 6rpx * (var(--seg-count) - 1)) / var(--seg-count));
  transform: translateX(calc((100% + 6rpx) * var(--seg-idx)));
  background-color: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.08), 0 1rpx 2rpx rgba(15, 23, 42, 0.04);
  transition: transform 0.32s cubic-bezier(0.4, 0, 0.2, 1), width 0.32s cubic-bezier(0.4, 0, 0.2, 1);
  pointer-events: none;
  z-index: 0;
}

.priority-btn,
.party-btn {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
  height: 76rpx;
  background-color: transparent;
  border: none;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.18s ease;
  box-sizing: border-box;
}

/* 按下反馈 */
.seg-pressed {
  transform: scale(0.96);
}

.priority-text,
.party-text {
  font-family: "PingFang SC", -apple-system, BlinkMacSystemFont, "Segoe UI", "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-size: 28rpx;
  line-height: 1.4;
  letter-spacing: 0;
  color: #9CA3AF;
  font-weight: 500;
  transition: color 0.2s ease, font-weight 0.2s ease;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

/* 优先级选中态：色彩通过文字色承载语义 */
.priority-btn.active-green .priority-text {
  background: linear-gradient(to right, #10b981, #14b8a6);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
  font-weight: 700;
}
.priority-btn.active-yellow .priority-text { color: #B45309; font-weight: 700; }
.priority-btn.active-orange .priority-text { color: #EA580C; font-weight: 700; }
.priority-btn.active-red .priority-text { color: #DC2626; font-weight: 700; }

/* 责任方选中态：绿色渐变文字（与底部主按钮配色呼应） */
.party-btn.active .party-text {
  background: linear-gradient(to right, #10b981, #14b8a6);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  color: transparent;
  font-weight: 700;
}

/* 日期时间显示 */
.datetime-display {
  gap: 16rpx;
}

.datetime-text {
  font-size: 28rpx;
  color: #111827;
  font-weight: 400;
  line-height: 1.5;
}

/* 底部按钮 */
.bottom-surface {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  border-radius: 36rpx 36rpx 0 0;
  box-shadow: 0 -8rpx 36rpx rgba(127, 138, 157, 0.12);
  padding: 24rpx 48rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.bottom-actions {
  display: flex;
  gap: 24rpx;
  height: 96rpx;
}

.btn {
  flex: 1;
  height: 100%;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.btn-cancel {
  background-color: #F3F4F6;
  border: none;
}

.btn-cancel-text {
  font-size: 28rpx;
  color: #4B5563;
  font-weight: 600;
}

.btn-submit {
  background: linear-gradient(to right, #10b981, #14b8a6);
  box-shadow: 0 4rpx 12rpx rgba(12, 167, 125, 0.3);
}

.btn-submit-text {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 700;
}

/* 日期时间选择弹窗 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal-content {
  width: 100%;
  background-color: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  animation: slide-up 0.3s ease-out;
  box-sizing: border-box;
}

@keyframes slide-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 48rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
}

.datetime-picker-content {
  margin-bottom: 48rpx;
}

.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F0F2F5;
}

.picker-row:last-child {
  border-bottom: none;
}

.picker-label {
  font-size: 28rpx;
  color: #111827;
  font-weight: 600;
}

.datetime-picker-display {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  padding: 16rpx 24rpx;
  background-color: #F7F9FC;
  border-radius: 14rpx;
  margin-left: 32rpx;
}

.datetime-picker-text {
  font-size: 28rpx;
  color: #111827;
  font-weight: 500;
}

.modal-actions {
  display: flex;
  gap: 24rpx;
}

.modal-button {
  flex: 1;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  box-sizing: border-box;
}

.modal-button-cancel {
  background-color: #F3F4F6;
  border: none;
}

.modal-button-confirm {
  background: linear-gradient(to right, #10b981, #14b8a6);
  box-shadow: 0 4rpx 12rpx rgba(12, 167, 125, 0.3);
}

.modal-button-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #4B5563;
}

.modal-button-text-white {
  color: #FFFFFF;
}
