<!--pages/property/review/index.wxml-->
<view class="container">
  <!-- Page Header -->
  <view class="page-header">
    <text class="page-title">待审核工单</text>
    <text class="order-count" wx:if="{{!loading}}">共 {{total}} 个</text>
  </view>

  <!-- Loading State -->
  <view class="loading-state" wx:if="{{loading && workOrders.length === 0}}">
    <view class="weui-loadmore">
      <view class="weui-loading"></view>
      <view class="weui-loadmore__tips">加载中...</view>
    </view>
  </view>

  <!-- Work Orders List -->
  <view class="orders-list" wx:if="{{!loading || workOrders.length > 0}}">
    <block wx:for="{{workOrders}}" wx:key="id">
      <view class="order-item-wrapper">
        <work-order-card
          workOrder="{{item}}"
          bind:tap="navigateToDetail"
        />
        
        <!-- Additional Info for Review -->
        <view class="review-info">
          <view class="review-meta">
            <text class="repair-time">维修完成: {{item.repairedTime}}</text>
            <view class="rework-badge" wx:if="{{item.rework_count > 0}}">
              已返工 {{item.rework_count}} 次
            </view>
          </view>
        </view>
      </view>
    </block>
  </view>

  <!-- Empty State -->
  <view class="empty-state" wx:if="{{!loading && workOrders.length === 0}}">
    <text class="empty-icon">✓</text>
    <text class="empty-text">暂无待审核工单</text>
    <text class="empty-hint">已维修的工单会显示在这里</text>
  </view>

  <!-- Load More -->
  <view class="load-more" wx:if="{{hasMore && !loading}}">
    <button class="load-more-btn" bindtap="loadMore">加载更多</button>
  </view>

  <!-- Loading More -->
  <view class="loading-more" wx:if="{{loadingMore}}">
    <view class="weui-loadmore">
      <view class="weui-loading"></view>
      <view class="weui-loadmore__tips">加载中...</view>
    </view>
  </view>

  <!-- No More Data -->
  <view class="no-more" wx:if="{{!hasMore && workOrders.length > 0 && !loading}}">
    <text class="no-more-text">没有更多了</text>
  </view>
</view>
