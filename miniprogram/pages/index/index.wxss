.location-separator {
  width: 16rpx;
  display: inline-block;
}

.metadata-text {
  color: #111827;
  font-weight: normal;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  white-space: nowrap;
  font-size: 26rpx;
}

/* 照片列表 */
.photo-list {
  display: flex;
  gap: 12rpx;
  justify-content: flex-start;
}

.photo-placeholder {
  width: 120rpx;
  height: 120rpx;
  background-color: #F3F4F6;
  border-radius: 24rpx;
  border: 1px solid #E5E7EB;
  overflow: hidden;
}

.photo-image {
  width: 100%;
  height: 100%;
}

.photo-empty {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #9CA3AF;
}

.photo-label {
  font-size: 18rpx;
  margin-bottom: 6rpx;
}

.photo-icon-wrapper {
  width: 48rpx;
  height: 48rpx;
  background-color: #ffffff;
  border-radius: 50%; /* 保留圆形 */
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-icon {
  font-size: 24rpx;
  opacity: 0.4;
}

/* ==================== 筛选弹窗 ==================== */
.filter-layer {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.backdrop {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(2rpx);
  z-index: 1;
}

.filter-sheet {
  position: relative;
  background: #ffffff;
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  padding-bottom: env(safe-area-inset-bottom);
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  width: 100%;
  box-sizing: border-box;
  overflow: hidden;
  z-index: 2;
}

.sheet-header {
  padding: 40rpx 40rpx 20rpx;
  /* border-bottom: 1px solid #f3f4f6; Removed for cleaner look */
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  box-sizing: border-box;
  width: 100%;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
  letter-spacing: 0.5rpx;
}

.icon-close {
  width: 48rpx;
  height: 48rpx;
  position: absolute;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  opacity: 0.6; /* Slight transparency for gray look */
  transition: all 0.2s;
}

.icon-close:active {
  opacity: 1;
  transform: translateY(-50%) scale(0.9);
}

.icon-close::before,
.icon-close::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 32rpx;
  height: 4rpx;
  background: #9ca3af;
}

.icon-close::before {
  transform: translate(-50%, -50%) rotate(45deg);
}

.icon-close::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}

.filter-body {
  flex: 1;
  padding: 32rpx 40rpx 160rpx;
  box-sizing: border-box;
  width: 100%;
}

.no-scrollbar::-webkit-scrollbar {
  display: none;
}

.space {
  height: 16rpx;
}

.sheet-footer {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 40rpx;
  background: #ffffff;
  /* border-top: 1px solid #f3f4f6; Removed for floating effect */
  display: flex;
  gap: 32rpx;
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.04);
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  width: 100%;
}

.btn {
  flex: 1;
  border-radius: 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 24rpx 0;
  border: none;
}

.reset {
  background: #F8FAFC;
  color: #64748B;
  border: 1px solid #F1F5F9;
}

.confirm {
  flex: 1.6;
  background: linear-gradient(to right, #10b981, #14b8a6);
  color: #ffffff;
  box-shadow: 0 8rpx 20rpx rgba(16, 185, 129, 0.3);
  border: 1px solid rgba(255, 255, 255, 0.1);
}

.btn:active {
  transform: scale(0.98);
}

@keyframes slide-up {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.animate-slide-up {
  animation: slide-up 320ms cubic-bezier(0.16, 1, 0.3, 1);
}

/* ==================== 筛选选择器弹窗样式 ==================== */
.picker-modal {
  max-height: 60vh;
  display: flex;
  flex-direction: column;
}

.picker-header {
  padding: 32rpx;
  border-bottom: 1rpx solid #f0f0f0;
  text-align: center;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1E293B;
}

.picker-options {
  flex: 1;
  max-height: 400rpx;
  padding: 16rpx 0;
}

.picker-option {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  font-size: 28rpx;
  color: #333;
  transition: background-color 0.2s;
}

.picker-option:active {
  background-color: #f5f5f5;
}

.picker-option-active {
  background-color: #ECFDF5;
  color: #10b981;
  font-weight: 500;
}

.picker-check {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: linear-gradient(to right, #10b981, #14b8a6);
  position: relative;
}

.picker-check::after {
  content: '';
  position: absolute;
  left: 10rpx;
  top: 6rpx;
  width: 12rpx;
  height: 18rpx;
  border: solid white;
  border-width: 0 3rpx 3rpx 0;
  transform: rotate(45deg);
}

/* 报修人输入框样式 */
.input-wrapper {
  padding: 32rpx;
}

.reporter-input {
  width: 100%;
  height: 88rpx;
  background: #F2F6FA;
  border-radius: 24rpx;
  padding: 0 28rpx;
  font-size: 28rpx;
  color: #333;
  box-sizing: border-box;
}

/* ==================== 接单按钮 ==================== */
.accept-order-btn {
  position: absolute;
  right: 20rpx;
  bottom: 20rpx;
  padding: 14rpx 36rpx;
  background: #ffedd5;
  color: #ea580c;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 32rpx;
  box-shadow: 0 4rpx 12rpx rgba(234, 88, 12, 0.2);
  z-index: 20;
}

.accept-order-btn:active {
  transform: scale(0.95);
  opacity: 0.9;
}
