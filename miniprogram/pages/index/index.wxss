.location-separator {
  width: 16rpx;
  display: inline-block;
}

.metadata-text {
  color: #111827;
  font-weight: normal;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 26rpx;
}

/* 照片列表 */
.photo-list {
  display: flex;
  gap: 16rpx;
  justify-content: flex-start;
}

.photo-placeholder {
  width: 120rpx;
  height: 120rpx;
  background-color: #F3F4F6;
  border-radius: 16rpx;
  border: 1px solid #E5E7EB;
  overflow: hidden;
}

.photo-image {
  width: 100%;
  height: 100%;
}

.photo-empty {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #9CA3AF;
}

.photo-label {
  font-size: 18rpx;
  margin-bottom: 6rpx;
}

.photo-icon-wrapper {
  width: 48rpx;
  height: 48rpx;
  background-color: #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-icon {
  font-size: 24rpx;
  opacity: 0.4;
}

/* ==================== 筛选弹窗 ==================== */
.filter-layer {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.backdrop {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(2rpx);
  z-index: 1;
}

.filter-sheet {
  position: relative;
  background: #ffffff;
  border-top-left-radius: 40rpx;
  border-top-right-radius: 40rpx;
  padding-bottom: env(safe-area-inset-bottom);
  max-height: 85vh;
  display: flex;
  flex-direction: column;
  width: 100%;
  box-sizing: border-box;
  overflow: hidden;
  z-index: 2;
}

.sheet-header {
  padding: 32rpx 40rpx;
  border-bottom: 1px solid #f3f4f6;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  box-sizing: border-box;
  width: 100%;
}

.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1f2937;
}

.icon-close {
  width: 48rpx;
  height: 48rpx;
  position: absolute;
  right: 36rpx;
  top: 50%;
  transform: translateY(-50%);
}

.icon-close::before,
.icon-close::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 32rpx;
  height: 4rpx;
  background: #9ca3af;
}

.icon-close::before {
  transform: translate(-50%, -50%) rotate(45deg);
}

.icon-close::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}

.filter-body {
  flex: 1;
  padding: 32rpx 40rpx 160rpx;
  box-sizing: border-box;
  width: 100%;
}

.no-scrollbar::-webkit-scrollbar {
  display: none;
}

.space {
  height: 16rpx;
}

.sheet-footer {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 32rpx 40rpx;
  background: #ffffff;
  border-top: 1px solid #f3f4f6;
  display: flex;
  gap: 24rpx;
  box-shadow: 0 -10rpx 30rpx rgba(15, 23, 42, 0.08);
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  width: 100%;
}

.btn {
  flex: 1;
  border-radius: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 24rpx 0;
  border: none;
}

.reset {
  background: #f3f4f6;
  color: #6b7280;
}

.confirm {
  flex: 1.6;
  background: linear-gradient(to right, #10b981, #14b8a6);
  color: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(12, 167, 125, 0.35);
}

@keyframes slide-up {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.animate-slide-up {
  animation: slide-up 320ms cubic-bezier(0.16, 1, 0.3, 1);
}
