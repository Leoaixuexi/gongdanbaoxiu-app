<!--首页 - 工单列表界面(基于 Taro 设计)-->
<wxs src="./index.wxs" module="utils" />
<view class="container">
  <!-- 顶部固定区域 -->
  <view class="sticky-header" style="padding-top: {{statusBarHeight}}px;">
    <!-- 绿色渐变头部 -->
    <view class="header">
      <!-- 返回按钮 + 搜索框（同行） -->
      <view class="header-top-row">
        <view class="back-btn" bindtap="goBack">
          <van-icon name="arrow-left" size="20px" color="#ffffff" />
        </view>
        <view class="search-bar">
          <view class="search-input-wrapper">
            <view class="icon-search"></view>
            <input
              class="search-input"
              placeholder="编号/位置/问题描述"
              placeholder-class="search-placeholder"
              value="{{searchText}}"
              bindinput="onSearchInput"
            />
            <view wx:if="{{searchText}}" class="clear-button-inline" bindtap="clearSearch">
              <text class="clear-icon">×</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 日期筛选 + 导出/筛选按钮（同行） -->
      <view class="filter-row-container">
        <view class="time-tabs">
        <view
          class="time-tab {{activeTab === 'today' ? 'time-tab-active' : ''}}"
          bindtap="handleTabChange"
          data-tab="today"
        >
          <text class="time-tab-text {{activeTab === 'today' ? 'time-tab-text-active' : ''}}">今日</text>
        </view>
        <view
          class="time-tab {{activeTab === 'week' ? 'time-tab-active' : ''}}"
          bindtap="handleTabChange"
          data-tab="week"
        >
          <text class="time-tab-text {{activeTab === 'week' ? 'time-tab-text-active' : ''}}">本周</text>
        </view>
        <view
          class="time-tab {{activeTab === 'month' ? 'time-tab-active' : ''}}"
          bindtap="handleTabChange"
          data-tab="month"
        >
          <text class="time-tab-text {{activeTab === 'month' ? 'time-tab-text-active' : ''}}">本月</text>
        </view>
        <view
          class="time-tab {{activeTab === 'date' ? 'time-tab-active' : ''}}"
          bindtap="handleTabChange"
          data-tab="date"
        >
          <text class="time-tab-text {{activeTab === 'date' ? 'time-tab-text-active' : ''}}">按日期</text>
        </view>
      </view>
        <view class="icon-buttons">
          <!-- 导出按钮 - 行政经理 / 办美员工可见 -->
          <view wx:if="{{isManager || isPropertyStaff}}" class="export-button" bindtap="handleExport">
            <van-icon name="descending" size="32rpx" color="#ffffff" />
            <text class="btn-label">导出</text>
          </view>
          <view class="filter-button" bindtap="handleFilter">
            <view class="filter-icon-svg"></view>
            <text class="btn-label">筛选</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 状态标签 -->
    <view class="status-tabs">
      <scroll-view scroll-x class="status-scroll" enhanced="{{true}}" show-scrollbar="{{false}}" scroll-into-view="{{scrollIntoView}}" scroll-with-animation="{{true}}">
        <view class="status-tabs-inner">
          <view
            wx:for="{{statusButtons}}"
            wx:key="key"
            id="status-{{item.key}}"
            class="status-tab {{activeStatus === item.key ? 'status-tab-active status-tab-' + item.key : ''}}"
            bindtap="handleStatusChange"
            data-status="{{item.key}}"
            data-index="{{index}}"
          >
            <text class="status-tab-text {{activeStatus === item.key ? 'status-tab-text-active' : ''}}">{{item.label}}({{item.count || 0}})</text>
          </view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 工单列表 -->
  <view class="order-list" style="padding-top: calc(280rpx + {{statusBarHeight}}px);"
    bindtouchstart="onTouchStart"
    bindtouchend="onTouchEnd"
  >
    <block wx:if="{{!loading && workOrders.length > 0}}">
      <view
        wx:for="{{workOrders}}"
        wx:key="order_id"
        class="ticket-card"
        bindtap="navigateToDetail"
        data-id="{{item.order_id}}"
      >
        <!-- 状态标签 - 绝对定位到右上角（维修员的待接单状态不显示） -->
        <view wx:if="{{!(isMaintenanceWorker && item.status === 'Pending Repair')}}" class="status-badge {{item.statusClass}}">
          {{item.statusText}}
        </view>

        <!-- 标题: ID 和优先级标签 -->
        <view class="ticket-header">
          <view class="ticket-id-row">
            <text class="ticket-id">{{item.order_number || item.order_id || item.id}}</text>
            <!-- 优先级标签 - 只显示紧急 -->
            <view wx:if="{{item.priority === 'Emergency'}}" class="priority-badge priority-emergency">紧急</view>
          </view>
        </view>

        <!-- 描述框 -->
        <view class="description-box">
          {{item.description || '无描述'}}
        </view>

        <!-- 元数据布局: 两行 -->
        <view class="metadata-wrapper">
          <!-- 第1行: 责任方(左) + 姓名(中) + 工单类型(右) -->
          <view class="metadata-line">
            <view class="metadata-item metadata-left">
              <view class="icon icon-person"></view>
              <text class="metadata-text">{{item.responsible_party || '未知'}}</text>
            </view>
            <view class="metadata-item metadata-center">
              <view class="icon icon-user"></view>
              <text class="metadata-text">{{item.submitter.name || '未知'}}</text>
            </view>
            <view class="metadata-item metadata-right">
              <view class="icon icon-building"></view>
              <text class="metadata-text">{{item.order_category || item.fault_type_name || '未分类'}}</text>
            </view>
          </view>
          <!-- 第2行: 楼层/位置(左) + 日期时间(右) -->
          <view class="metadata-line">
            <view class="metadata-item">
              <view class="icon icon-location"></view>
              <text class="metadata-text">{{item.floor}}</text>
              <text class="location-separator"></text>
              <text class="metadata-text">{{item.location}}</text>
            </view>
            <view class="metadata-item">
              <view class="icon icon-time"></view>
              <text class="metadata-text">{{item.created_at}}</text>
            </view>
          </view>
        </view>

        <!-- 照片列表 + 接单按钮同行，底部对齐 -->
        <view class="photo-action-row">
          <view class="photo-list" wx:if="{{item.photos && item.photos.length > 0}}">
            <block wx:for="{{item.photos}}" wx:key="photoIndex" wx:for-item="photo" wx:for-index="photoIndex" wx:if="{{photoIndex < 3}}">
              <view class="photo-placeholder">
                <!-- 加载中状态 -->
                <view class="photo-loading" wx:if="{{!item.photoLoaded[photoIndex] && !item.photoError[photoIndex]}}">
                  <van-loading size="20px" color="#10b981" />
                </view>
                <!-- 加载失败状态 -->
                <view class="photo-error" wx:if="{{item.photoError[photoIndex]}}">
                  <text class="photo-error-icon">!</text>
                  <text class="photo-error-text">加载失败</text>
                </view>
                <!-- 图片（仅当 URL 有效时渲染，cloud:// 需要先转换） -->
                <image
                  wx:if="{{utils.isValidImageUrl(photo)}}"
                  src="{{photo}}"
                  class="photo-image {{item.photoLoaded[photoIndex] ? 'photo-loaded' : 'photo-hidden'}}"
                  mode="aspectFill"
                  lazy-load="{{true}}"
                  binderror="onPhotoError"
                  bindload="onPhotoLoad"
                  data-order-index="{{index}}"
                  data-photo-index="{{photoIndex}}"
                />
              </view>
            </block>
          </view>
          <!-- 接单按钮 - 维修员 + 待接单状态 -->
          <view
            wx:if="{{isMaintenanceWorker && item.status === 'Pending Repair'}}"
            class="accept-order-btn"
            catchtap="handleAcceptOrder"
            data-order="{{item}}"
          >
            接单
          </view>
        </view>
      </view>
    </block>

    <!-- Load More Indicator -->
    <view class="load-more-indicator" wx:if="{{!loading && workOrders.length > 0}}">
      <view wx:if="{{isLoadingMore}}" class="loading-more">
        <van-loading size="20px">加载更多...</van-loading>
      </view>
      <view wx:elif="{{hasMore}}" class="has-more-hint">
        <text>上拉加载更多</text>
      </view>
      <view wx:else class="no-more-hint">
        <text>— 已加载全部 —</text>
      </view>
    </view>

    <!-- Loading State -->
    <view class="loading-state" wx:if="{{loading}}">
      <van-loading size="24px" vertical>加载中...</van-loading>
    </view>

    <!-- Empty State -->
    <view class="empty-state" wx:if="{{!loading && workOrders.length === 0}}">
      <van-empty description="暂无工单记录" />
    </view>
  </view>

  <!-- 日期选择弹窗 -->
  <van-popup
    show="{{ isDatePickerOpen }}"
    position="bottom"
    bind:close="closeDatePicker"
    round
    closeable
    close-icon="cross"
    z-index="10000"
  >
    <view style="padding: 48rpx 32rpx 32rpx; padding-bottom: constant(safe-area-inset-bottom); padding-bottom: env(safe-area-inset-bottom);">
      <view style="font-size: 32rpx; font-weight: 600; color: #323233; text-align: center; margin-bottom: 56rpx;">选择日期范围</view>

      <view style="display: flex; align-items: center; margin-bottom: 56rpx;">
        <view style="flex: 1;">
          <view style="font-size: 26rpx; color: #969799; margin-bottom: 12rpx;">开始日期</view>
          <picker mode="date" value="{{tempStartDate}}" bindchange="onStartDateChange">
            <view style="background: #f7f8fa; border-radius: 12rpx; padding: 24rpx; font-size: 30rpx; color: {{tempStartDate ? '#323233' : '#c8c9cc'}};">
              {{tempStartDate || '请选择'}}
            </view>
          </picker>
        </view>
        <view style="padding: 0 20rpx; color: #969799; margin-top: 26rpx;">至</view>
        <view style="flex: 1;">
          <view style="font-size: 26rpx; color: #969799; margin-bottom: 12rpx;">结束日期</view>
          <picker mode="date" value="{{tempEndDate}}" start="{{tempStartDate}}" bindchange="onEndDateChange">
            <view style="background: #f7f8fa; border-radius: 12rpx; padding: 24rpx; font-size: 30rpx; color: {{tempEndDate ? '#323233' : '#c8c9cc'}};">
              {{tempEndDate || '请选择'}}
            </view>
          </picker>
        </view>
      </view>

      <button
        class="date-confirm-btn {{tempStartDate && tempEndDate ? '' : 'disabled'}}"
        style="width: 100%; height: 88rpx; line-height: 88rpx; background: {{tempStartDate && tempEndDate ? 'linear-gradient(to right, #10b981, #14b8a6)' : '#c8c9cc'}}; color: #fff; border: none; border-radius: 16rpx !important; font-size: 32rpx; margin-bottom: 0; overflow: hidden; display: flex; align-items: center; justify-content: center; padding: 0;"
        bindtap="confirmDatePicker"
      >
        确定
      </button>
    </view>
  </van-popup>

  <!-- 筛选弹窗 - 使用 van-popup -->
  <van-popup
    show="{{ isFilterOpen }}"
    position="bottom"
    bind:close="closeFilterPanel"
    round
    z-index="10000"
  >
    <view class="filter-sheet">
      <view class="sheet-header">
        <text class="sheet-title">筛选</text>
        <view class="icon-close" bindtap="closeFilterPanel"></view>
      </view>
      <scroll-view scroll-y="true" class="filter-body no-scrollbar" enhanced="{{true}}" show-scrollbar="{{false}}">
        <block wx:for="{{filterRows}}" wx:key="id">
          <filter-row
            row-id="{{item.id}}"
            label="{{item.label}}"
            has-arrow="{{item.hasArrow}}"
            placeholder="{{item.placeholder}}"
            value="{{item.value}}"
            bindrowtap="onFilterRowTap"
          ></filter-row>
        </block>
        <view class="space"></view>
      </scroll-view>
      <view class="sheet-footer">
        <view class="footer-btn footer-btn-reset" bindtap="handleReset">
          <van-icon name="replay" size="30rpx" color="#64748b" />
          <text class="footer-btn-text">重置</text>
        </view>
        <view class="footer-btn footer-btn-confirm" bindtap="handleConfirm">
          <text class="footer-btn-text footer-btn-text-white">确定</text>
        </view>
      </view>
    </view>
  </van-popup>

  <!-- 筛选选择器弹窗 - 使用可复用组件 -->
  <custom-picker
    show="{{ isPickerOpen }}"
    columns="{{ pickerColumns }}"
    value="{{ pickerSelectedValue }}"
    bind:confirm="confirmPickerSelection"
    bind:cancel="closePickerModal"
  />

  <!-- 报修人输入弹窗 - 使用 van-popup -->
  <van-popup
    show="{{ isReporterInputOpen }}"
    position="center"
    bind:close="closeReporterInput"
    round
    custom-style="width: 80%;"
    z-index="10001"
  >
    <view class="modal-content">
      <view class="picker-header">
        <text class="picker-title">报修人</text>
      </view>
      <view class="input-wrapper">
        <input
          class="reporter-input"
          placeholder="请输入报修人姓名或简拼"
          value="{{reporterInputValue}}"
          bindinput="onReporterInput"
          focus="{{isReporterInputOpen}}"
        />
      </view>
      <view class="modal-actions">
        <view class="modal-button modal-button-cancel" bindtap="closeReporterInput">
          <text class="modal-button-text">取消</text>
        </view>
        <view class="modal-button modal-button-confirm" bindtap="confirmReporterInput">
          <text class="modal-button-text modal-button-text-white">确定</text>
        </view>
      </view>
    </view>
  </van-popup>

  <!-- 浮动按钮 - 办美员工和行政经理可见 -->
  <view wx:if="{{isPropertyStaff || isManager}}" class="fab" bindtap="navigateToNewOrder">
    <text class="fab-icon">+</text>
  </view>

  <!-- 回到顶部按钮 -->
  <view wx:if="{{showBackToTop}}" class="back-to-top" bindtap="scrollToTop">
    <view class="back-to-top-arrow"></view>
    <text class="back-to-top-label">顶部</text>
  </view>

  <!-- 分享成功撤回提示 -->
  <view wx:if="{{showRevokePopup}}" class="revoke-toast">
    <view class="revoke-toast-content">
      <text class="revoke-toast-text">分享成功，30分钟内可撤回</text>
      <view class="revoke-toast-actions">
        <text class="revoke-btn" catchtap="handleRevokeShare">撤回</text>
        <text class="revoke-close" catchtap="closeRevokePopup">×</text>
      </view>
    </view>
  </view>
</view>
