.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-top: 180rpx;
  box-sizing: border-box;
}

.content {
  padding: 24rpx;
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
}

.section {
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 12rpx;
}

.section-content {
  font-size: 24rpx;
  color: #666;
  line-height: 1.6;
}

.line {
  margin-bottom: 8rpx;
}

.footer {
  margin-top: 40rpx;
  text-align: right;
  font-size: 24rpx;
  color: #333;
}
