<!--
  SLA Alerts Page
  SLA告警页面 - 显示所有需要关注的工单
-->
<view class="page">
  <!-- Header -->
  <view class="header">
    <view class="header-content">
      <view class="page-title">SLA告警</view>
      <view class="page-subtitle">{{alertSummary}}</view>
    </view>
  </view>

  <!-- Filter Tabs -->
  <view class="filter-tabs">
    <view
      wx:for="{{filterTabs}}"
      wx:key="value"
      class="tab {{currentFilter === item.value ? 'active' : ''}}"
      bindtap="onFilterChange"
      data-value="{{item.value}}"
    >
      <text class="tab-icon">{{item.icon}}</text>
      <text class="tab-label">{{item.label}}</text>
      <view wx:if="{{item.count > 0}}" class="tab-badge">{{item.count}}</view>
    </view>
  </view>

  <!-- Work Orders List -->
  <scroll-view class="content" scroll-y refresher-enabled bindrefresherrefresh="onRefresh" refresher-triggered="{{refreshing}}" enhanced="{{true}}" show-scrollbar="{{false}}">
    <!-- Loading -->
    <view wx:if="{{loading}}" class="loading-view">
      <view class="spinner"></view>
      <text>加载中...</text>
    </view>

    <!-- Empty State -->
    <view wx:elif="{{filteredOrders.length === 0}}" class="empty-view">
      <text class="empty-icon">{{emptyIcon}}</text>
      <text class="empty-text">{{emptyText}}</text>
    </view>

    <!-- Work Order Cards -->
    <view wx:else class="order-list">
      <view
        wx:for="{{filteredOrders}}"
        wx:key="_id"
        class="order-card {{item.sla.status}}"
        bindtap="onOrderTap"
        data-id="{{item._id}}"
      >
        <!-- Card Header -->
        <view class="card-header">
          <view class="order-number">{{item.work_order_number}}</view>
          <view class="sla-badge {{item.sla.status}}">
            <text class="badge-icon">{{item.sla.statusIcon}}</text>
            <text class="badge-text">{{item.sla.statusText}}</text>
          </view>
        </view>

        <!-- SLA Countdown -->
        <view class="sla-countdown">
          <text class="countdown-time {{item.sla.status}}">{{item.sla.countdown}}</text>
          <view class="progress-bar">
            <view
              class="progress-fill {{item.sla.status}}"
              style="width: {{item.sla.percentage}}%"
            ></view>
          </view>
        </view>

        <!-- Order Info -->
        <view class="order-info">
          <view class="info-row">
            <text class="info-icon">📍</text>
            <text class="info-text">{{item.floor}} - {{item.location}}</text>
          </view>
          <view class="info-row">
            <text class="info-icon">🔧</text>
            <text class="info-text">{{item.fault_type_name}}</text>
          </view>
          <view class="info-row">
            <text class="info-icon">⏰</text>
            <text class="info-text">截止：{{item.sla.deadlineText}}</text>
          </view>
        </view>

        <!-- Card Footer -->
        <view class="card-footer">
          <view class="priority-tag {{item.priority}}">
            {{priorityMap[item.priority]}}
          </view>
          <view class="status-tag {{item.status}}">
            {{statusMap[item.status]}}
          </view>
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- Statistics Panel -->
  <view class="stats-panel" wx:if="{{!loading && stats}}">
    <view class="stat-item">
      <text class="stat-value critical">{{stats.critical}}</text>
      <text class="stat-label">紧急</text>
    </view>
    <view class="stat-item">
      <text class="stat-value warning">{{stats.warning}}</text>
      <text class="stat-label">警告</text>
    </view>
    <view class="stat-item">
      <text class="stat-value overdue">{{stats.overdue}}</text>
      <text class="stat-label">超期</text>
    </view>
    <view class="stat-item">
      <text class="stat-value">{{stats.total}}</text>
      <text class="stat-label">总计</text>
    </view>
  </view>
</view>
