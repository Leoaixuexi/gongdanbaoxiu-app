/* Admin Dashboard Page - Apple Design Style */

/* ==================== Container ==================== */
.dashboard-container {
  min-height: 100vh;
  background-color: var(--color-bg-secondary);
  padding-bottom: calc(120rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* ==================== Header Section ==================== */
.dashboard-header {
  background: linear-gradient(135deg, #007AFF 0%, #5AC8FA 100%);
  padding: var(--spacing-2xl) var(--spacing-lg);
  padding-top: calc(var(--spacing-2xl) + constant(safe-area-inset-top));
  padding-top: calc(var(--spacing-2xl) + env(safe-area-inset-top));
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: var(--shadow-md);
}

.header-title {
  font-size: var(--font-size-3xl);
  font-weight: var(--font-weight-bold);
  color: white;
  letter-spacing: -0.5rpx;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
}

.refresh-time {
  font-size: var(--font-size-xs);
  color: rgba(255, 255, 255, 0.85);
  font-weight: var(--font-weight-medium);
}

.btn-refresh {
  width: 64rpx;
  height: 64rpx;
  background-color: rgba(255, 255, 255, 0.25);
  backdrop-filter: blur(20rpx);
  border: none;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  transition: all var(--transition-base);
}

.btn-refresh:active {
  background-color: rgba(255, 255, 255, 0.35);
  transform: scale(0.9);
}

.icon-refresh {
  font-size: 36rpx;
  color: white;
}

.rotating {
  animation: rotate 1s linear infinite;
}

@keyframes rotate {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

/* ==================== KPI Section ==================== */
.kpi-section {
  margin: var(--spacing-lg);
}

.section-title {
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-bold);
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-md);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.kpi-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--spacing-md);
}

.kpi-card {
  background-color: var(--color-bg-elevated);
  border-radius: var(--radius-xl);
  padding: var(--spacing-xl);
  box-shadow: var(--shadow-sm);
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
  transition: all var(--transition-base);
}

.kpi-card:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-md);
}

.kpi-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-lg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  flex-shrink: 0;
}

.kpi-icon.icon-total {
  background: linear-gradient(135deg, #007AFF 0%, #5AC8FA 100%);
  color: white;
}

.kpi-icon.icon-pending {
  background: linear-gradient(135deg, #FF9500 0%, #FF9F0A 100%);
  color: white;
}

.kpi-icon.icon-progress {
  background: linear-gradient(135deg, #5AC8FA 0%, #64D2FF 100%);
  color: white;
}

.kpi-icon.icon-completed {
  background: linear-gradient(135deg, #34C759 0%, #30D158 100%);
  color: white;
}

.kpi-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--spacing-xs);
}

.kpi-value {
  font-size: var(--font-size-3xl);
  font-weight: var(--font-weight-bold);
  color: var(--color-text-primary);
  line-height: 1;
}

.kpi-value.kpi-good {
  color: var(--color-success);
}

.kpi-value.kpi-warning {
  color: var(--color-warning);
}

.kpi-value.kpi-danger {
  color: var(--color-error);
}

.kpi-label {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
  font-weight: var(--font-weight-medium);
}

/* ==================== Filter Section ==================== */
.filter-section {
  background-color: var(--color-bg-elevated);
  margin: var(--spacing-lg);
  border-radius: var(--radius-xl);
  padding: var(--spacing-xl);
  box-shadow: var(--shadow-sm);
}

.icon-arrow {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
  margin-left: var(--spacing-xs);
  transition: transform var(--transition-base);
}

.icon-arrow-up {
  transform: rotate(180deg);
}

.icon-arrow-down {
  transform: rotate(0deg);
}

.filter-content {
  margin-top: var(--spacing-md);
}

.filter-row {
  display: flex;
  align-items: center;
  margin-bottom: var(--spacing-md);
}

.filter-row:last-child {
  margin-bottom: 0;
}

.filter-label {
  width: 140rpx;
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  font-weight: var(--font-weight-semibold);
}

.filter-picker {
  flex: 1;
  height: 88rpx;
  background-color: var(--color-bg-primary);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: 0 var(--spacing-lg);
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  transition: all var(--transition-base);
}

.filter-picker:active {
  border-color: var(--color-primary);
  background-color: white;
}

.filter-input {
  flex: 1;
  height: 88rpx;
  background-color: var(--color-bg-primary);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  padding: 0 var(--spacing-lg);
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  transition: all var(--transition-base);
}

.filter-input:focus {
  border-color: var(--color-primary);
  background-color: white;
  box-shadow: 0 0 0 4rpx rgba(0, 122, 255, 0.1);
}

.filter-actions {
  display: flex;
  gap: var(--spacing-md);
  margin-top: var(--spacing-xl);
}

.btn-clear,
.btn-apply {
  flex: 1;
  height: 88rpx;
  border-radius: var(--radius-full);
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-semibold);
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  transition: all var(--transition-base);
}

.btn-clear {
  background-color: var(--color-bg-secondary);
  color: var(--color-text-secondary);
  border: 2rpx solid var(--color-border);
}

.btn-clear:active {
  transform: scale(0.96);
  background-color: var(--color-bg-tertiary);
}

.btn-apply {
  background: linear-gradient(135deg, #007AFF 0%, #5AC8FA 100%);
  color: white;
  box-shadow: 0 4rpx 12rpx rgba(0, 122, 255, 0.3);
}

.btn-apply:active {
  transform: scale(0.96);
  box-shadow: 0 2rpx 8rpx rgba(0, 122, 255, 0.2);
}

/* ==================== Work Orders Section ==================== */
.work-orders-section {
  margin: var(--spacing-lg);
}

.count-badge {
  display: inline-block;
  background: linear-gradient(135deg, #007AFF 0%, #5AC8FA 100%);
  color: white;
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-bold);
  padding: 6rpx 12rpx;
  border-radius: var(--radius-full);
  margin-left: var(--spacing-sm);
}

/* ==================== Loading State ==================== */
.loading-container {
  background-color: var(--color-bg-elevated);
  border-radius: var(--radius-xl);
  padding: var(--spacing-xl);
  box-shadow: var(--shadow-sm);
}

.loading-skeleton {
  margin-bottom: var(--spacing-xl);
}

.loading-skeleton:last-child {
  margin-bottom: 0;
}

.skeleton-line {
  height: 32rpx;
  background: linear-gradient(90deg,
    rgba(0, 122, 255, 0.05) 25%,
    rgba(0, 122, 255, 0.08) 50%,
    rgba(0, 122, 255, 0.05) 75%
  );
  background-size: 200% 100%;
  animation: shimmer 1.5s ease-in-out infinite;
  border-radius: var(--radius-md);
  margin-bottom: var(--spacing-md);
}

.skeleton-line.short {
  width: 60%;
}

@keyframes shimmer {
  0% {
    background-position: 200% 0;
  }
  100% {
    background-position: -200% 0;
  }
}

/* ==================== Empty State ==================== */
.empty-state {
  background-color: var(--color-bg-elevated);
  border-radius: var(--radius-xl);
  padding: var(--spacing-3xl) var(--spacing-xl);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-sm);
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: var(--spacing-lg);
  opacity: 0.4;
}

.empty-text {
  font-size: var(--font-size-xl);
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-sm);
  font-weight: var(--font-weight-semibold);
}

.empty-hint {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
  font-weight: var(--font-weight-medium);
}

/* ==================== Work Order List ==================== */
.work-order-list {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}

/* ==================== Pagination ==================== */
.pagination {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-xl);
  margin-top: var(--spacing-2xl);
  padding: var(--spacing-lg);
}

.btn-prev,
.btn-next {
  flex: 1;
  max-width: 200rpx;
  height: 80rpx;
  background-color: var(--color-bg-elevated);
  border: 2rpx solid var(--color-primary);
  border-radius: var(--radius-full);
  color: var(--color-primary);
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-semibold);
  transition: all var(--transition-base);
}

.btn-prev:active,
.btn-next:active {
  transform: scale(0.96);
  background-color: rgba(0, 122, 255, 0.1);
}

.btn-prev:disabled,
.btn-next:disabled {
  border-color: var(--color-border);
  color: var(--color-text-tertiary);
  opacity: 0.5;
}

.page-info {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  font-weight: var(--font-weight-medium);
}

/* ==================== Navigation Button ==================== */
.navigation-button {
  position: fixed;
  bottom: var(--spacing-lg);
  bottom: calc(var(--spacing-lg) + constant(safe-area-inset-bottom));
  bottom: calc(var(--spacing-lg) + env(safe-area-inset-bottom));
  left: var(--spacing-lg);
  right: var(--spacing-lg);
  z-index: 100;
}

.btn-analytics {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #007AFF 0%, #5AC8FA 100%);
  color: white;
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-bold);
  border-radius: var(--radius-full);
  box-shadow: 0 8rpx 24rpx rgba(0, 122, 255, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-sm);
  border: none;
  transition: all var(--transition-base);
}

.btn-analytics:active {
  transform: scale(0.96);
  box-shadow: 0 4rpx 16rpx rgba(0, 122, 255, 0.3);
}

.btn-analytics .icon {
  font-size: 40rpx;
}
