/* Analytics Page Styles */

.analytics-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

/* Header Section */
.analytics-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
}

.btn-export {
  background-color: rgba(255, 255, 255, 0.2);
  color: #ffffff;
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 24rpx;
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.btn-export .icon {
  font-size: 28rpx;
}

/* Date Selector */
.date-selector {
  background-color: #ffffff;
  margin: 20rpx 30rpx;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.date-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.date-label {
  font-size: 24rpx;
  color: #999999;
}

.date-picker {
  height: 60rpx;
  background-color: #f5f5f5;
  border-radius: 24rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 26rpx;
  color: #333333;
}

.icon-arrow {
  font-size: 20rpx;
  color: #999999;
}

.btn-apply-date {
  width: 120rpx;
  height: 60rpx;
  background-color: #667eea;
  color: #ffffff;
  font-size: 26rpx;
  border-radius: 24rpx;
  border: none;
  margin-top: 34rpx;
}

/* Charts Section */
.charts-section {
  margin: 20rpx 30rpx;
}

/* Tab Navigation */
.tab-nav {
  background-color: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 20rpx 30rpx 0;
  display: flex;
  gap: 10rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.tab-item {
  flex: 1;
  height: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #666666;
  border-bottom: 4rpx solid transparent;
  transition: all 0.3s;
}

.tab-item.active {
  color: #667eea;
  font-weight: bold;
  border-bottom-color: #667eea;
}

/* Tab Content */
.tab-content {
  background-color: #ffffff;
  border-radius: 0 0 24rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.chart-panel {
  padding: 30rpx;
  min-height: 500rpx;
}

/* Chart Header */
.chart-header {
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.chart-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  display: block;
  margin-bottom: 8rpx;
}

.chart-subtitle {
  font-size: 24rpx;
  color: #999999;
}

/* Chart Container */
.chart-container {
  min-height: 400rpx;
  margin-top: 20rpx;
}

.chart-placeholder {
  position: relative;
  padding: 40rpx 20rpx;
}

.chart-type-label {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  font-size: 24rpx;
  color: #999999;
  background-color: #f5f5f5;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

/* Bar Chart Styles */
.chart-bars {
  display: flex;
  gap: 20rpx;
  align-items: flex-end;
  justify-content: center;
  height: 300rpx;
  padding: 20rpx;
}

.chart-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.bar-wrapper {
  flex: 1;
  width: 100%;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.bar {
  width: 60rpx;
  border-radius: 24rpx 24rpx 0 0;
  transition: height 0.3s;
}

.bar-label {
  font-size: 22rpx;
  color: #666666;
  text-align: center;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bar-value {
  font-size: 24rpx;
  font-weight: bold;
  color: #333333;
}

/* Pie Chart Styles */
.pie-chart {
  padding: 40rpx 20rpx;
}

.pie-legend-item {
  display: flex;
  align-items: center;
  gap: 15rpx;
  margin-bottom: 25rpx;
  padding: 15rpx;
  background-color: #f9f9f9;
  border-radius: 24rpx;
}

.pie-legend-item:last-child {
  margin-bottom: 0;
}

.legend-color {
  width: 40rpx;
  height: 40rpx;
  border-radius: 24rpx;
}

.legend-label {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
  font-weight: bold;
}

.legend-value {
  font-size: 26rpx;
  color: #666666;
}

/* Period Selector */
.period-selector {
  display: flex;
  gap: 20rpx;
  margin-bottom: 30rpx;
  padding: 10rpx;
  background-color: #f5f5f5;
  border-radius: 24rpx;
}

.period-item {
  flex: 1;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: transparent;
  color: #666666;
  font-size: 26rpx;
  border-radius: 24rpx;
  transition: all 0.3s;
}

.period-item.active {
  background-color: #667eea;
  color: #ffffff;
  font-weight: bold;
}

/* Trend Chart Styles */
.trend-chart {
  padding: 20rpx;
}

.trend-legend {
  display: flex;
  justify-content: center;
  gap: 30rpx;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #666666;
}

.legend-line {
  width: 30rpx;
  height: 4rpx;
  border-radius: 2rpx;
}

.trend-data {
  max-height: 400rpx;
  overflow-y: auto;
}

.trend-item {
  display: flex;
  align-items: center;
  gap: 15rpx;
  padding: 15rpx;
  margin-bottom: 10rpx;
  background-color: #f9f9f9;
  border-radius: 24rpx;
  font-size: 24rpx;
}

.trend-date {
  width: 120rpx;
  font-weight: bold;
  color: #333333;
}

.trend-value {
  flex: 1;
  color: #666666;
}

/* Performance Table Styles */
.performance-table {
  width: 100%;
  overflow-x: auto;
}

.table-header,
.table-row {
  display: flex;
  align-items: center;
  min-width: 1000rpx;
}

.table-header {
  background-color: #f5f5f5;
  padding: 20rpx;
  border-radius: 24rpx;
  margin-bottom: 10rpx;
  font-weight: bold;
}

.table-row {
  padding: 20rpx;
  margin-bottom: 10rpx;
  background-color: #f9f9f9;
  border-radius: 24rpx;
}

.col {
  font-size: 24rpx;
  color: #333333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.col-name {
  flex: 2;
  min-width: 150rpx;
}

.col-number {
  flex: 1;
  min-width: 120rpx;
  text-align: center;
}

.col.good {
  color: #4caf50;
  font-weight: bold;
}

.col.poor {
  color: #f44336;
  font-weight: bold;
}

/* Empty Chart State */
.empty-chart {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 400rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

/* Export Modal */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 600rpx;
  background-color: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
}

.modal-header {
  padding: 30rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #ffffff;
}

.modal-close {
  font-size: 48rpx;
  color: #ffffff;
  line-height: 1;
  padding: 0 10rpx;
}

.modal-body {
  padding: 30rpx;
}

.modal-field {
  margin-bottom: 25rpx;
}

.modal-field:last-child {
  margin-bottom: 0;
}

.field-label {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 10rpx;
  display: block;
}

.field-picker {
  height: 70rpx;
  background-color: #f5f5f5;
  border-radius: 24rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  color: #333333;
}

.date-range-display {
  height: 70rpx;
  background-color: #f5f5f5;
  border-radius: 24rpx;
  padding: 0 20rpx;
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #666666;
}

.modal-footer {
  padding: 20rpx 30rpx 30rpx;
  display: flex;
  gap: 20rpx;
}

.btn-modal-cancel,
.btn-modal-confirm {
  flex: 1;
  height: 80rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  border: none;
}

.btn-modal-cancel {
  background-color: #f5f5f5;
  color: #666666;
}

.btn-modal-confirm {
  background-color: #667eea;
  color: #ffffff;
}

.btn-modal-confirm:disabled {
  background-color: #cccccc;
}
