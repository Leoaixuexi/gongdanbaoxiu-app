<!-- Analytics Page - Data Visualization -->
<view class="analytics-container">
  <!-- Header -->
  <view class="analytics-header">
    <text class="header-title">数据分析</text>
    <button class="btn-export" bindtap="showExportModal">
      <text class="icon">📥</text>
      <text>导出报告</text>
    </button>
  </view>

  <!-- Date Range Selector -->
  <view class="date-selector">
    <view class="date-item">
      <text class="date-label">开始日期</text>
      <picker mode="date" value="{{dateRange.startDate}}" bindchange="handleStartDateChange">
        <view class="date-picker">
          <text>{{dateRange.startDate || '选择日期'}}</text>
          <text class="icon-arrow">▼</text>
        </view>
      </picker>
    </view>

    <view class="date-item">
      <text class="date-label">结束日期</text>
      <picker mode="date" value="{{dateRange.endDate}}" bindchange="handleEndDateChange">
        <view class="date-picker">
          <text>{{dateRange.endDate || '选择日期'}}</text>
          <text class="icon-arrow">▼</text>
        </view>
      </picker>
    </view>

    <button class="btn-apply-date" bindtap="handleApplyDateRange">应用</button>
  </view>

  <!-- Charts Section with Tabs -->
  <view class="charts-section">
    <!-- Tab Navigation -->
    <view class="tab-nav">
      <view
        class="tab-item {{activeTab === 0 ? 'active' : ''}}"
        bindtap="switchTab"
        data-index="0">
        按分类
      </view>
      <view
        class="tab-item {{activeTab === 1 ? 'active' : ''}}"
        bindtap="switchTab"
        data-index="1">
        按优先级
      </view>
      <view
        class="tab-item {{activeTab === 2 ? 'active' : ''}}"
        bindtap="switchTab"
        data-index="2">
        趋势分析
      </view>
      <view
        class="tab-item {{activeTab === 3 ? 'active' : ''}}"
        bindtap="switchTab"
        data-index="3">
        维修人员
      </view>
    </view>

    <!-- Tab Content -->
    <view class="tab-content">
      <!-- Bar Chart - By Category (T132) -->
      <view class="chart-panel" wx:if="{{activeTab === 0}}">
        <view class="chart-header">
          <text class="chart-title">工单分类统计</text>
          <text class="chart-subtitle">按故障类型分组</text>
        </view>

        <view class="chart-container" wx:if="{{categoryData.length > 0}}">
          <view class="chart-placeholder">
            <text class="chart-type-label">柱状图</text>
            <view class="chart-bars">
              <view
                wx:for="{{categoryData}}"
                wx:key="faultType"
                class="chart-bar-item">
                <view class="bar-wrapper">
                  <view
                    class="bar"
                    style="height: {{(item.count / maxCategoryCount) * 200}}rpx; background-color: #2196f3;">
                  </view>
                </view>
                <text class="bar-label">{{item.faultType}}</text>
                <text class="bar-value">{{item.count}}</text>
              </view>
            </view>
          </view>
        </view>

        <view class="empty-chart" wx:else>
          <text class="empty-icon">📊</text>
          <text class="empty-text">暂无数据</text>
        </view>
      </view>

      <!-- Pie Chart - By Priority (T133) -->
      <view class="chart-panel" wx:if="{{activeTab === 1}}">
        <view class="chart-header">
          <text class="chart-title">优先级分布</text>
          <text class="chart-subtitle">按优先级分组</text>
        </view>

        <view class="chart-container" wx:if="{{priorityData.length > 0}}">
          <view class="chart-placeholder">
            <text class="chart-type-label">饼图</text>
            <view class="pie-chart">
              <view wx:for="{{priorityData}}" wx:key="priority" class="pie-legend-item">
                <view class="legend-color" style="background-color: {{item.color}};"></view>
                <text class="legend-label">{{item.priorityDisplay}}</text>
                <text class="legend-value">{{item.count}} ({{item.percentage}}%)</text>
              </view>
            </view>
          </view>
        </view>

        <view class="empty-chart" wx:else>
          <text class="empty-icon">📊</text>
          <text class="empty-text">暂无数据</text>
        </view>
      </view>

      <!-- Line Chart - Trends (T134) -->
      <view class="chart-panel" wx:if="{{activeTab === 2}}">
        <view class="chart-header">
          <text class="chart-title">工单趋势分析</text>
          <text class="chart-subtitle">随时间变化</text>
        </view>

        <!-- Period Selector -->
        <view class="period-selector">
          <view
            class="period-item {{trendPeriod === 'daily' ? 'active' : ''}}"
            bindtap="changePeriod"
            data-period="daily">
            按日
          </view>
          <view
            class="period-item {{trendPeriod === 'weekly' ? 'active' : ''}}"
            bindtap="changePeriod"
            data-period="weekly">
            按周
          </view>
          <view
            class="period-item {{trendPeriod === 'monthly' ? 'active' : ''}}"
            bindtap="changePeriod"
            data-period="monthly">
            按月
          </view>
        </view>

        <view class="chart-container" wx:if="{{trendData.length > 0}}">
          <view class="chart-placeholder">
            <text class="chart-type-label">折线图</text>
            <view class="trend-chart">
              <view class="trend-legend">
                <view class="legend-item">
                  <view class="legend-line" style="background-color: #2196f3;"></view>
                  <text>新增工单数</text>
                </view>
                <view class="legend-item">
                  <view class="legend-line" style="background-color: #4caf50;"></view>
                  <text>完成数</text>
                </view>
                <view class="legend-item">
                  <view class="legend-line" style="background-color: #f44336;"></view>
                  <text>超期工单</text>
                </view>
              </view>

              <view class="trend-data">
                <view wx:for="{{trendData}}" wx:key="date" class="trend-item">
                  <text class="trend-date">{{item.date}}</text>
                  <text class="trend-value">新增: {{item.total}}</text>
                  <text class="trend-value">完成: {{item.completed}}</text>
                  <text class="trend-value">超期: {{item.overdue}}</text>
                </view>
              </view>
            </view>
          </view>
        </view>

        <view class="empty-chart" wx:else>
          <text class="empty-icon">📊</text>
          <text class="empty-text">暂无数据</text>
        </view>
      </view>

      <!-- Technician Performance Table (T135) -->
      <view class="chart-panel" wx:if="{{activeTab === 3}}">
        <view class="chart-header">
          <text class="chart-title">维修人员绩效</text>
          <text class="chart-subtitle">按维修人员统计</text>
        </view>

        <view class="performance-table" wx:if="{{technicianData.length > 0}}">
          <!-- Table Header -->
          <view class="table-header">
            <text class="col col-name" bindtap="sortTable" data-field="technicianName">
              维修人员 {{sortField === 'technicianName' ? (sortOrder === 'asc' ? '↑' : '↓') : ''}}
            </text>
            <text class="col col-number" bindtap="sortTable" data-field="totalAssigned">
              分配数 {{sortField === 'totalAssigned' ? (sortOrder === 'asc' ? '↑' : '↓') : ''}}
            </text>
            <text class="col col-number" bindtap="sortTable" data-field="completed">
              完成数 {{sortField === 'completed' ? (sortOrder === 'asc' ? '↑' : '↓') : ''}}
            </text>
            <text class="col col-number" bindtap="sortTable" data-field="completionRate">
              完成率 {{sortField === 'completionRate' ? (sortOrder === 'asc' ? '↑' : '↓') : ''}}
            </text>
            <text class="col col-number" bindtap="sortTable" data-field="avgResolutionTime">
              平均时长 {{sortField === 'avgResolutionTime' ? (sortOrder === 'asc' ? '↑' : '↓') : ''}}
            </text>
            <text class="col col-number" bindtap="sortTable" data-field="firstTimeFixRate">
              一次修复率 {{sortField === 'firstTimeFixRate' ? (sortOrder === 'asc' ? '↑' : '↓') : ''}}
            </text>
          </view>

          <!-- Table Body -->
          <view class="table-body">
            <view wx:for="{{technicianData}}" wx:key="technicianId" class="table-row">
              <text class="col col-name">{{item.technicianName}}</text>
              <text class="col col-number">{{item.totalAssigned}}</text>
              <text class="col col-number">{{item.completed}}</text>
              <text class="col col-number {{item.completionRate >= 90 ? 'good' : item.completionRate < 70 ? 'poor' : ''}}">
                {{item.completionRate.toFixed(1)}}%
              </text>
              <text class="col col-number">{{item.avgResolutionTime.toFixed(1)}}h</text>
              <text class="col col-number {{item.firstTimeFixRate >= 85 ? 'good' : item.firstTimeFixRate < 60 ? 'poor' : ''}}">
                {{item.firstTimeFixRate.toFixed(1)}}%
              </text>
            </view>
          </view>
        </view>

        <view class="empty-chart" wx:else>
          <text class="empty-icon">📊</text>
          <text class="empty-text">暂无数据</text>
        </view>
      </view>
    </view>
  </view>

  <!-- Export Modal (T136) -->
  <view class="modal-overlay" wx:if="{{showExport}}" bindtap="hideExportModal">
    <view class="modal-content" catchtap="preventClose">
      <view class="modal-header">
        <text class="modal-title">导出报告</text>
        <text class="modal-close" bindtap="hideExportModal">×</text>
      </view>

      <view class="modal-body">
        <!-- Report Type -->
        <view class="modal-field">
          <text class="field-label">报告类型</text>
          <picker mode="selector" range="{{exportReportTypes}}" range-key="label" value="{{exportConfig.reportTypeIndex}}" bindchange="handleReportTypeChange">
            <view class="field-picker">
              <text>{{exportReportTypes[exportConfig.reportTypeIndex].label}}</text>
              <text class="icon-arrow">▼</text>
            </view>
          </picker>
        </view>

        <!-- Format -->
        <view class="modal-field">
          <text class="field-label">文件格式</text>
          <picker mode="selector" range="{{exportFormats}}" range-key="label" value="{{exportConfig.formatIndex}}" bindchange="handleFormatChange">
            <view class="field-picker">
              <text>{{exportFormats[exportConfig.formatIndex].label}}</text>
              <text class="icon-arrow">▼</text>
            </view>
          </picker>
        </view>

        <!-- Date Range -->
        <view class="modal-field">
          <text class="field-label">时间范围</text>
          <view class="date-range-display">
            <text>{{exportConfig.startDate || '未选择'}} ~ {{exportConfig.endDate || '未选择'}}</text>
          </view>
        </view>
      </view>

      <view class="modal-footer">
        <button class="btn-modal-cancel" bindtap="hideExportModal">取消</button>
        <button class="btn-modal-confirm" bindtap="handleExport" disabled="{{exporting}}">
          {{exporting ? '导出中...' : '确认导出'}}
        </button>
      </view>
    </view>
  </view>
</view>
