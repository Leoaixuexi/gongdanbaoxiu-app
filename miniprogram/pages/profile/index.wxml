<!-- 个人中心页面 -->
<view class="container gradient-bg">
  <!-- 头部个人信息卡片 -->
  <view class="header p-5">
    <view class="primary-card" bindtap="openEditSheet">
      <view class="p-5">
        <view class="flex items-center gap-4">
          <!-- 头像 -->
          <view class="avatar">
            <image src="{{profile.avatar}}" mode="aspectFill"></image>
          </view>

          <!-- 信息 -->
          <view class="flex-1 min-w-0">
            <view class="text-xl font-bold text-white mb-1 tracking-tight">{{profile.name}}</view>
            <view class="text-sm text-white font-medium">工号: {{profile.employeeId}}</view>
            <view class="text-xs text-white mt-1" style="opacity: 0.85;">{{profile.department}}</view>
          </view>

          <!-- 箭头图标 -->
          <image src="/images/icons/chevron-right.svg" class="icon-sm" style="opacity: 0.9;"></image>
        </view>
      </view>
    </view>
  </view>

  <!-- 主内容区 -->
  <view class="main px-5">
    <!-- 设置与信息 -->
    <view class="section mb-3">
      <view class="section-title mb-3">
        <text class="text-base font-bold text-foreground tracking-tight">设置与信息</text>
      </view>

      <view class="card card-backdrop mb-3">
        <view class="p-4 flex items-center justify-between border-b" bindtap="openNotificationDialog">
          <view class="flex items-center gap-3">
            <view class="icon-wrapper" style="background: linear-gradient(135deg, #eff6ff, #dbeafe);">
              <image src="/images/icons/bell.svg" class="icon-sm" style="filter: brightness(0) saturate(100%) invert(46%) sepia(98%) saturate(1733%) hue-rotate(196deg);"></image>
            </view>
            <text class="text-sm font-semibold tracking-tight">消息通知</text>
          </view>
          <image src="/images/icons/chevron-right.svg" class="icon-sm"></image>
        </view>

        <view class="p-4 flex items-center justify-between" bindtap="openAboutDialog">
          <view class="flex items-center gap-3">
            <view class="icon-wrapper" style="background: linear-gradient(135deg, #faf5ff, #f3e8ff);">
              <image src="/images/icons/info.svg" class="icon-sm" style="filter: brightness(0) saturate(100%) invert(48%) sepia(79%) saturate(2476%) hue-rotate(243deg);"></image>
            </view>
            <text class="text-sm font-semibold tracking-tight">关于</text>
          </view>
          <image src="/images/icons/chevron-right.svg" class="icon-sm"></image>
        </view>
      </view>

      <view class="card card-backdrop">
        <view class="p-4 flex items-center justify-center gap-2" style="color: #e11d48;" bindtap="handleLogout">
          <image src="/images/icons/logout.svg" class="icon-sm" style="filter: brightness(0) saturate(100%) invert(25%) sepia(93%) saturate(3207%) hue-rotate(336deg);"></image>
          <text class="font-semibold">退出登录</text>
        </view>
      </view>
    </view>
  </view>
</view>

<!-- 编辑资料弹窗 -->
<view class="modal-overlay {{showEditSheet ? 'active' : ''}}" bindtap="closeEditSheet">
  <view class="modal-sheet bottom-sheet {{showEditSheet ? 'active' : ''}}" catchtap="stopPropagation">
    <view class="sheet-header">
      <view class="sheet-title">编辑资料</view>
      <view class="sheet-desc">更新您的个人信息,以便团队成员查看。</view>
    </view>

    <view class="sheet-body">
      <view class="avatar-edit">
        <view class="avatar" style="width: 192rpx; height: 192rpx; border: 8rpx solid #fff;">
          <image src="{{editForm.avatar}}" mode="aspectFill"></image>
        </view>
        <view class="avatar-btn">
          <image src="/images/icons/camera.svg" class="icon-sm"></image>
        </view>
      </view>

      <view class="form-group">
        <view class="form-label">昵称</view>
        <input class="form-input" value="{{editForm.name}}" bindinput="onNameInput" />
      </view>

      <view class="form-group">
        <view class="form-label">邮箱</view>
        <input class="form-input" type="email" value="{{editForm.email}}" bindinput="onEmailInput" />
      </view>

      <view class="form-group">
        <view class="form-label">手机号 (只读)</view>
        <input class="form-input disabled" value="{{editForm.phone}}" disabled />
      </view>

      <view class="separator my-4"></view>

      <view class="grid grid-cols-2 gap-2">
        <view class="info-box">
          <view class="info-label">职务</view>
          <view class="info-value">
            <image src="/images/icons/briefcase.svg" class="icon-xs"></image>
            <text>{{profile.position}}</text>
          </view>
        </view>

        <view class="info-box">
          <view class="info-label">项目</view>
          <view class="info-value">
            <image src="/images/icons/building.svg" class="icon-xs"></image>
            <text>{{profile.department}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="sheet-footer">
      <button class="btn btn-primary" bindtap="saveProfile">保存修改</button>
    </view>
  </view>
</view>

<!-- 消息通知设置弹窗 -->
<view class="modal-overlay {{showNotificationDialog ? 'active' : ''}}" bindtap="closeNotificationDialog">
  <view class="modal-dialog {{showNotificationDialog ? 'active' : ''}}" catchtap="stopPropagation">
    <view class="dialog-header">
      <view class="dialog-title">消息通知设置</view>
      <view class="dialog-desc">管理您的通知偏好,选择接收哪些类型的消息推送。</view>
    </view>

    <view class="dialog-body">
      <view class="setting-item">
        <view class="setting-info">
          <view class="setting-label">新工单分配</view>
          <view class="setting-desc">有新工单分配时通知</view>
        </view>
        <switch checked="{{notifications.newAssignment}}" bindchange="onNotificationChange" data-key="newAssignment" />
      </view>

      <view class="separator"></view>

      <view class="setting-item">
        <view class="setting-info">
          <view class="setting-label">工单状态变更</view>
          <view class="setting-desc">工单状态更新时通知</view>
        </view>
        <switch checked="{{notifications.statusChange}}" bindchange="onNotificationChange" data-key="statusChange" />
      </view>

      <view class="separator"></view>

      <view class="setting-item">
        <view class="setting-info">
          <view class="setting-label">即将超时提醒</view>
          <view class="setting-desc">工单即将超时时提醒</view>
        </view>
        <switch checked="{{notifications.timeoutWarning}}" bindchange="onNotificationChange" data-key="timeoutWarning" />
      </view>

      <view class="separator"></view>

      <view class="setting-item">
        <view class="setting-info">
          <view class="setting-label">系统公告</view>
          <view class="setting-desc">接收系统公告和通知</view>
        </view>
        <switch checked="{{notifications.announcements}}" bindchange="onNotificationChange" data-key="announcements" />
      </view>

      <view class="separator"></view>

      <view class="setting-item">
        <view class="setting-info">
          <view class="setting-label">功能更新</view>
          <view class="setting-desc">新功能上线提醒</view>
        </view>
        <switch checked="{{notifications.updates}}" bindchange="onNotificationChange" data-key="updates" />
      </view>
    </view>

    <view class="dialog-footer">
      <button class="btn btn-primary" bindtap="closeNotificationDialog">确定</button>
    </view>
  </view>
</view>

<!-- 关于弹窗 -->
<view class="modal-overlay {{showAboutDialog ? 'active' : ''}}" bindtap="closeAboutDialog">
  <view class="modal-dialog {{showAboutDialog ? 'active' : ''}}" catchtap="stopPropagation">
    <view class="dialog-header">
      <view class="dialog-title">关于应用</view>
      <view class="dialog-desc">物业员工工作台 v1.0.0</view>
    </view>

    <view class="dialog-body">
      <view class="about-content">
        <text class="text-sm text-muted-foreground">这是一款专为物业管理人员打造的移动工作平台,帮助员工高效处理日常工单和工作任务。</text>
      </view>

      <view class="separator my-3"></view>

      <view class="about-info">
        <view class="about-row">
          <text class="text-sm text-muted-foreground">版本号</text>
          <text class="text-sm font-medium">v1.0.0</text>
        </view>
        <view class="about-row">
          <text class="text-sm text-muted-foreground">更新日期</text>
          <text class="text-sm font-medium">2024-11-25</text>
        </view>
      </view>
    </view>

    <view class="dialog-footer">
      <button class="btn" style="background: transparent; border: 1rpx solid var(--border);" bindtap="closeAboutDialog">关闭</button>
    </view>
  </view>
</view>
