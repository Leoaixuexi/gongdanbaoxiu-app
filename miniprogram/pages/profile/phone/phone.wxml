<!--pages/phone/phone.wxml-->
<view class="container">
  <!-- 表单区域 -->
  <view class="form-section">
    <!-- 当前手机号 -->
    <view class="current-phone-card bg-card premium-shadow-sm">
      <view class="phone-icon-wrapper">
        <text class="phone-icon">📞</text>
      </view>
      <view class="phone-info">
        <text class="phone-label text-muted-foreground">当前手机号</text>
        <text class="phone-number text-foreground">{{currentPhone}}</text>
      </view>
    </view>

    <!-- 新手机号表单 -->
    <view class="form-card bg-card premium-shadow-sm">
      <!-- 新手机号 -->
      <view class="input-field">
        <view class="field-label">
          <text class="field-icon text-muted-foreground">📱</text>
          <text class="field-text text-foreground">新手机号</text>
        </view>
        <input
          class="input"
          type="number"
          maxlength="11"
          value="{{newPhone}}"
          placeholder="请输入新手机号"
          bindinput="onPhoneInput"
        />
      </view>

      <!-- 验证码 -->
      <view class="input-field">
        <view class="field-label">
          <text class="field-icon text-muted-foreground">💬</text>
          <text class="field-text text-foreground">验证码</text>
        </view>
        <view class="code-input-wrapper">
          <input
            class="input code-input"
            type="number"
            maxlength="6"
            value="{{verifyCode}}"
            placeholder="请输入验证码"
            bindinput="onCodeInput"
          />
          <button
            class="send-code-btn {{countdown > 0 ? 'disabled' : ''}}"
            bindtap="sendCode"
            disabled="{{countdown > 0}}"
          >
            <text class="send-code-text">{{countdown > 0 ? countdown + 's' : '获取验证码'}}</text>
          </button>
        </view>
      </view>

      <!-- 错误提示 -->
      <view class="error-msg" wx:if="{{error}}">
        <view class="error-dot"></view>
        <text class="error-text text-destructive">{{error}}</text>
      </view>
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="bottom-actions">
    <button class="action-btn cancel-btn bg-muted" bindtap="handleCancel">
      <text class="text-muted-foreground">取消</text>
    </button>
    <button class="action-btn save-btn bg-primary" bindtap="handleSubmit">
      <text class="text-white">确认修改</text>
    </button>
  </view>
</view>
