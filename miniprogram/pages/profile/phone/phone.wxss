/* pages/phone/phone.wxss */

.container {
  min-height: 100vh;
  background-color: var(--background);
  display: flex;
  flex-direction: column;
}

/* 表单区域 */
.form-section {
  flex: 1;
  padding: 16rpx;
}

/* 当前手机号卡片 */
.current-phone-card {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
  border-radius: 32rpx;
  margin-bottom: 16rpx;
}

.phone-icon-wrapper {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(72, 182, 160, 0.1), rgba(52, 211, 153, 0.1));
  display: flex;
  align-items: center;
  justify-content: center;
}

.phone-icon {
  font-size: 40rpx;
}

.phone-info {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.phone-label {
  font-size: 24rpx;
}

.phone-number {
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

/* 表单卡片 */
.form-card {
  border-radius: 32rpx;
  padding: 40rpx;
}

.input-field {
  margin-bottom: 40rpx;
}

.input-field:last-of-type {
  margin-bottom: 0;
}

.field-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.field-icon {
  font-size: 28rpx;
}

.field-text {
  font-size: 26rpx;
  font-weight: 500;
}

.input {
  width: 100%;
  padding: 28rpx 32rpx;
  background-color: rgba(0, 0, 0, 0.02);
  border: 2rpx solid transparent;
  border-radius: 24rpx;
  font-size: 28rpx;
  color: var(--foreground);
  transition: all 0.2s ease;
}

.input:focus {
  background-color: var(--card);
  border-color: rgba(72, 182, 160, 0.2);
  box-shadow: 0 0 0 6rpx rgba(72, 182, 160, 0.05);
}

.input-placeholder {
  color: rgba(122, 122, 133, 0.6);
}

/* 验证码输入 */
.code-input-wrapper {
  display: flex;
  gap: 12rpx;
}

.code-input {
  flex: 1;
  min-width: 0;
}

.send-code-btn {
  flex-shrink: 0;
  padding: 28rpx 32rpx;
  background: linear-gradient(135deg, rgba(72, 182, 160, 0.1), rgba(52, 211, 153, 0.1));
  border-radius: 24rpx;
  transition: all 0.2s ease;
}

.send-code-btn:active {
  opacity: 0.8;
}

.send-code-btn.disabled {
  background-color: var(--muted);
  cursor: not-allowed;
}

.send-code-text {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--primary);
  white-space: nowrap;
}

.send-code-btn.disabled .send-code-text {
  color: var(--muted-foreground);
}

/* 错误提示 */
.error-msg {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 32rpx;
  padding: 24rpx 32rpx;
  background-color: rgba(217, 83, 79, 0.1);
  border-radius: 24rpx;
}

.error-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: var(--destructive);
  flex-shrink: 0;
}

.error-text {
  font-size: 24rpx;
  line-height: 1.5;
}

/* 底部按钮 */
.bottom-actions {
  position: sticky;
  bottom: 0;
  padding: 16rpx;
  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(20rpx);
  border-top: 1rpx solid var(--border);
  display: flex;
  gap: 12rpx;
}

.action-btn {
  flex: 1;
  padding: 28rpx;
  border-radius: 24rpx;
  font-weight: 500;
  font-size: 28rpx;
  transition: all 0.2s ease;
}

.action-btn:active {
  transform: scale(0.98);
}

.cancel-btn {
  color: var(--muted-foreground);
}

.cancel-btn:active {
  opacity: 0.8;
}

.save-btn {
  box-shadow: 0 4rpx 16rpx rgba(72, 182, 160, 0.3);
}

.save-btn:active {
  opacity: 0.9;
}
