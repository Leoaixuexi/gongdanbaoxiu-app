/* pages/password/password.wxss */

.container {
  min-height: 100vh;
  background-color: var(--background);
  display: flex;
  flex-direction: column;
}

/* 表单区域 */
.form-section {
  flex: 1;
  padding: 16rpx;
}

.form-card {
  border-radius: 32rpx;
  padding: 40rpx;
}

.input-field {
  margin-bottom: 40rpx;
}

.input-field:last-of-type {
  margin-bottom: 0;
}

.field-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.field-icon {
  font-size: 28rpx;
}

.field-text {
  font-size: 26rpx;
  font-weight: 500;
}

.input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
}

.input {
  flex: 1;
  padding: 28rpx 88rpx 28rpx 32rpx;
  background-color: rgba(0, 0, 0, 0.02);
  border: 2rpx solid transparent;
  border-radius: 24rpx;
  font-size: 28rpx;
  color: var(--foreground);
  transition: all 0.2s ease;
}

.input:focus {
  background-color: var(--card);
  border-color: rgba(72, 182, 160, 0.2);
  box-shadow: 0 0 0 6rpx rgba(72, 182, 160, 0.05);
}

.input-placeholder {
  color: rgba(122, 122, 133, 0.6);
}

.toggle-btn {
  position: absolute;
  right: 12rpx;
  padding: 12rpx;
  background: transparent;
}

.toggle-icon {
  font-size: 32rpx;
}

/* 错误提示 */
.error-msg {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 32rpx;
  padding: 24rpx 32rpx;
  background-color: rgba(217, 83, 79, 0.1);
  border-radius: 24rpx;
}

.error-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: var(--destructive);
  flex-shrink: 0;
}

.error-text {
  font-size: 24rpx;
  line-height: 1.5;
}

/* 安全提示 */
.security-tip {
  padding: 0 8rpx;
  margin-top: 16rpx;
}

.tip-text {
  font-size: 24rpx;
  line-height: 1.6;
}

/* 底部按钮 */
.bottom-actions {
  position: sticky;
  bottom: 0;
  padding: 16rpx;
  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(20rpx);
  border-top: 1rpx solid var(--border);
  display: flex;
  gap: 12rpx;
}

.action-btn {
  flex: 1;
  padding: 28rpx;
  border-radius: 24rpx;
  font-weight: 500;
  font-size: 28rpx;
  transition: all 0.2s ease;
}

.action-btn:active {
  transform: scale(0.98);
}

.cancel-btn {
  color: var(--muted-foreground);
}

.cancel-btn:active {
  opacity: 0.8;
}

.save-btn {
  box-shadow: 0 4rpx 16rpx rgba(72, 182, 160, 0.3);
}

.save-btn:active {
  opacity: 0.9;
}
