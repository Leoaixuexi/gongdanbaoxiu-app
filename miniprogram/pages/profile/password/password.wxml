<!--pages/password/password.wxml-->
<view class="container">
  <!-- 表单区域 -->
  <view class="form-section">
    <view class="form-card bg-card premium-shadow-sm">
      <!-- 原密码 -->
      <view class="input-field">
        <view class="field-label">
          <text class="field-icon text-muted-foreground">🔒</text>
          <text class="field-text text-foreground">原密码</text>
        </view>
        <view class="input-wrapper">
          <input
            class="input"
            type="{{showOld ? 'text' : 'password'}}"
            value="{{oldPassword}}"
            placeholder="请输入原密码"
            bindinput="onOldPasswordInput"
          />
          <button class="toggle-btn" bindtap="toggleShowOld">
            <text class="toggle-icon text-muted-foreground">{{showOld ? '🙈' : '👁️'}}</text>
          </button>
        </view>
      </view>

      <!-- 新密码 -->
      <view class="input-field">
        <view class="field-label">
          <text class="field-icon text-muted-foreground">🔑</text>
          <text class="field-text text-foreground">新密码</text>
        </view>
        <view class="input-wrapper">
          <input
            class="input"
            type="{{showNew ? 'text' : 'password'}}"
            value="{{newPassword}}"
            placeholder="请输入新密码（至少6位）"
            bindinput="onNewPasswordInput"
          />
          <button class="toggle-btn" bindtap="toggleShowNew">
            <text class="toggle-icon text-muted-foreground">{{showNew ? '🙈' : '👁️'}}</text>
          </button>
        </view>
      </view>

      <!-- 确认新密码 -->
      <view class="input-field">
        <view class="field-label">
          <text class="field-icon text-muted-foreground">🛡️</text>
          <text class="field-text text-foreground">确认新密码</text>
        </view>
        <view class="input-wrapper">
          <input
            class="input"
            type="{{showConfirm ? 'text' : 'password'}}"
            value="{{confirmPassword}}"
            placeholder="请再次输入新密码"
            bindinput="onConfirmPasswordInput"
          />
          <button class="toggle-btn" bindtap="toggleShowConfirm">
            <text class="toggle-icon text-muted-foreground">{{showConfirm ? '🙈' : '👁️'}}</text>
          </button>
        </view>
      </view>

      <!-- 错误提示 -->
      <view class="error-msg" wx:if="{{error}}">
        <view class="error-dot"></view>
        <text class="error-text text-destructive">{{error}}</text>
      </view>
    </view>

    <!-- 安全提示 -->
    <view class="security-tip">
      <text class="tip-text text-muted-foreground">为了您的账户安全，建议使用字母、数字和符号的组合作为密码</text>
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="bottom-actions">
    <button class="action-btn cancel-btn bg-muted" bindtap="handleCancel">
      <text class="text-muted-foreground">取消</text>
    </button>
    <button class="action-btn save-btn bg-primary" bindtap="handleSubmit">
      <text class="text-white">确认修改</text>
    </button>
  </view>
</view>
