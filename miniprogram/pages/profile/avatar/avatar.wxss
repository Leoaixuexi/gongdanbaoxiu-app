/* pages/avatar/avatar.wxss */

.container {
  min-height: 100vh;
  background-color: var(--background);
  display: flex;
  flex-direction: column;
}

/* 预览区域 */
.preview-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  padding: 48rpx 24rpx;
}

.avatar-glow-wrapper {
  position: relative;
}

.avatar-glow-wrapper::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%) scale(1.5);
  width: 280rpx;
  height: 280rpx;
  background: linear-gradient(135deg, rgba(72, 182, 160, 0.2), rgba(52, 211, 153, 0.2));
  border-radius: 50%;
  filter: blur(80rpx);
}

.avatar-container {
  position: relative;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  border: 8rpx solid var(--card);
  overflow: hidden;
}

.avatar-preview {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.camera-btn {
  position: absolute;
  bottom: 8rpx;
  right: 8rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
  transition: all 0.2s ease;
}

.camera-btn:active {
  transform: scale(0.95);
  opacity: 0.9;
}

.camera-icon {
  font-size: 40rpx;
}

/* 选择按钮 */
.choose-btn {
  width: 100%;
  max-width: 600rpx;
  padding: 24rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  transition: all 0.2s ease;
}

.choose-btn:active {
  opacity: 0.8;
}

.choose-icon-wrapper {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(72, 182, 160, 0.1), rgba(52, 211, 153, 0.1));
  display: flex;
  align-items: center;
  justify-content: center;
}

.choose-icon {
  font-size: 40rpx;
}

.choose-text-wrapper {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  text-align: left;
}

.choose-title {
  font-size: 28rpx;
  font-weight: 500;
}

.choose-desc {
  font-size: 24rpx;
}

/* 底部按钮 */
.bottom-actions {
  position: sticky;
  bottom: 0;
  padding: 16rpx;
  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(20rpx);
  border-top: 1rpx solid var(--border);
  display: flex;
  gap: 12rpx;
}

.action-btn {
  flex: 1;
  padding: 28rpx;
  border-radius: 24rpx;
  font-weight: 500;
  font-size: 28rpx;
  transition: all 0.2s ease;
}

.action-btn:active {
  transform: scale(0.98);
}

.cancel-btn {
  color: var(--muted-foreground);
}

.cancel-btn:active {
  opacity: 0.8;
}

.save-btn {
  box-shadow: 0 4rpx 16rpx rgba(72, 182, 160, 0.3);
}

.save-btn:active {
  opacity: 0.9;
}
