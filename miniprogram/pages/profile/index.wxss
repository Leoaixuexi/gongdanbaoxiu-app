/* pages/profile/index.wxss */

/* 全局变量定义 */
page {
  --border: #e5e7eb;
  --foreground: #1f2937;
  --muted-foreground: #6b7280;
  --muted: #f3f4f6;
  --secondary: #f5f5f5;
  --primary: #00A678;
}

.container {
  min-height: 100vh;
  padding-bottom: 64rpx;
  background: #f5f5f5;
}

.gradient-bg {
  background: #f5f5f5;
}

/* 工具类 */
.flex {
  display: flex;
}

.items-center {
  align-items: center;
}

.justify-between {
  justify-content: space-between;
}

.flex-1 {
  flex: 1;
}

.min-w-0 {
  min-width: 0;
}

.gap-1 {
  gap: 8rpx;
}

.gap-2 {
  gap: 16rpx;
}

.gap-3 {
  gap: 24rpx;
}

.gap-4 {
  gap: 32rpx;
}

.flex-col {
  flex-direction: column;
}

.text-center {
  text-align: center;
}

.text-right {
  text-align: right;
}

.truncate {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tracking-tight {
  letter-spacing: -0.5rpx;
}

/* 文字大小 */
.text-xs {
  font-size: 24rpx;
}

.text-sm {
  font-size: 28rpx;
}

.text-base {
  font-size: 32rpx;
}

.text-xl {
  font-size: 36rpx;
}

.text-2xl {
  font-size: 48rpx;
}

.text-3xl {
  font-size: 56rpx;
}

/* 字重 */
.font-medium {
  font-weight: 500;
}

.font-semibold {
  font-weight: 600;
}

.font-bold {
  font-weight: 700;
}

/* 颜色 */
.text-white {
  color: #ffffff;
}

.text-foreground {
  color: var(--foreground);
}

.text-muted-foreground {
  color: var(--muted-foreground);
}

.text-primary {
  color: var(--primary);
}

.text-orange-500 {
  color: #f97316;
}

.text-blue-500 {
  color: #3b82f6;
}

.text-emerald-500 {
  color: #10b981;
}

.text-rose-500 {
  color: #f43f5e;
}

.text-amber-500 {
  color: #f59e0b;
}

/* 背景色 */
.bg-blue-50 {
  background-color: #eff6ff;
}

.bg-amber-50 {
  background-color: #fffbeb;
}

.bg-emerald-50 {
  background-color: #ecfdf5;
}

/* 间距 */
.p-4 {
  padding: 32rpx;
}

.p-5 {
  padding: 40rpx;
}

.px-5 {
  padding-left: 40rpx;
  padding-right: 40rpx;
}

.mb-1 {
  margin-bottom: 8rpx;
}

.mb-3 {
  margin-bottom: 24rpx;
}

.mt-1 {
  margin-top: 8rpx;
}

.mt-2 {
  margin-top: 16rpx;
}

.ml-1 {
  margin-left: 8rpx;
}

.my-3 {
  margin-top: 24rpx;
  margin-bottom: 24rpx;
}

.my-4 {
  margin-top: 32rpx;
  margin-bottom: 32rpx;
}

/* 边框 */
.border-r {
  border-right: 1rpx solid #e5e7eb;
}

.border-b {
  border-bottom: 1rpx solid #e5e7eb;
}

/* 网格 */
.grid {
  display: grid;
}

.grid-cols-2 {
  grid-template-columns: repeat(2, 1fr);
}

.grid-cols-3 {
  grid-template-columns: repeat(3, 1fr);
}

.grid-cols-4 {
  grid-template-columns: repeat(4, 1fr);
}

/* 头部区域 */
.header {
  padding: 40rpx;
  padding-bottom: 0;
  background: #f5f5f5;
}

.primary-card {
  background-color: #00A678;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 166, 120, 0.15);
  overflow: hidden;
  transition: all 0.3s;
}

.primary-card:active {
  transform: scale(0.98);
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
  flex-shrink: 0;
}

.avatar-sm {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid var(--border);
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.05);
  flex-shrink: 0;
}

.current-user-avatar {
  border-color: #00A678;
  box-shadow: 0 0 0 4rpx rgba(0, 166, 120, 0.2);
}

.avatar image,
.avatar-sm image {
  width: 100%;
  height: 100%;
}

.icon-sm {
  width: 40rpx;
  height: 40rpx;
}

.icon-xs {
  width: 28rpx;
  height: 28rpx;
}

/* 主内容区 */
.main {
  padding: 0 40rpx;
}

.section {
  margin-bottom: 32rpx;
}

.section-title {
  margin-bottom: 24rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
}

/* 卡片样式 */
.card {
  background-color: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
  transition: all 0.3s;
}

.card-backdrop {
  background-color: #ffffff;
}

/* 统计卡片 */
.stat-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 24rpx 16rpx;
  border-radius: 16rpx;
  transition: all 0.2s;
}

.stat-card:active {
  transform: scale(1.05);
}

/* 图标容器 */
.icon-wrapper {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 分隔线 */
.separator {
  height: 1rpx;
  background-color: #e5e7eb;
  opacity: 0.6;
}

/* 徽章 */
.badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 9999rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.badge-primary {
  background-color: #00A678;
  color: #ffffff;
  box-shadow: 0 2rpx 4rpx rgba(0, 166, 120, 0.2);
}

/* 趋势标识 */
.trend-badge {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.trend-badge.up {
  background-color: #ecfdf5;
  color: #059669;
}

.trend-badge.down {
  background-color: #fff1f2;
  color: #e11d48;
}

.trend-badge.same {
  background-color: #f8fafc;
  color: #64748b;
}

.trend-badge.down image {
  transform: rotate(180deg);
}

.trend-line {
  width: 28rpx;
  height: 4rpx;
  background-color: #64748b;
  border-radius: 2rpx;
}

/* 模态框遮罩 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0);
  z-index: 999;
  display: none;
  transition: background-color 0.3s;
}

.modal-overlay.active {
  display: block;
  background-color: rgba(0, 0, 0, 0.5);
}

/* 底部弹出框 */
.modal-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: -100%;
  max-height: 85vh;
  background-color: #ffffff;
  border-radius: 48rpx 48rpx 0 0;
  z-index: 1000;
  transition: bottom 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  flex-direction: column;
}

.modal-sheet.active {
  bottom: 0;
}

.sheet-header {
  padding: 48rpx 48rpx 32rpx;
  border-bottom: 1rpx solid var(--border);
}

.sheet-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--foreground);
  margin-bottom: 8rpx;
}

.sheet-desc {
  font-size: 28rpx;
  color: var(--muted-foreground);
  line-height: 1.5;
}

.sheet-body {
  flex: 1;
  padding: 48rpx;
  overflow-y: auto;
}

.sheet-footer {
  padding: 32rpx;
  border-top: 1rpx solid var(--border);
  background-color: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
}

/* 头像编辑 */
.avatar-edit {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 48rpx;
  position: relative;
}

.avatar-btn {
  position: absolute;
  bottom: 0;
  right: 50%;
  transform: translateX(calc(50% + 64rpx));
  width: 64rpx;
  height: 64rpx;
  background-color: var(--secondary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

/* 表单组 */
.form-group {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--foreground);
  margin-bottom: 16rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 32rpx;
  background-color: #ffffff;
  border: 2rpx solid var(--border);
  border-radius: 16rpx;
  font-size: 28rpx;
  color: var(--foreground);
}

.form-input.disabled {
  background-color: var(--muted);
  color: var(--muted-foreground);
  opacity: 0.6;
}

/* 信息盒子 */
.info-box {
  padding: 24rpx;
  background-color: var(--muted);
  border: 1rpx solid var(--border);
  border-radius: 16rpx;
}

.info-label {
  font-size: 24rpx;
  color: var(--muted-foreground);
  margin-bottom: 12rpx;
}

.info-value {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--foreground);
}

/* 对话框 */
.modal-dialog {
  position: fixed;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%) scale(0.9);
  width: 600rpx;
  max-height: 80vh;
  background-color: #ffffff;
  border-radius: 40rpx;
  z-index: 1000;
  opacity: 0;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  pointer-events: none;
  display: flex;
  flex-direction: column;
}

.modal-dialog.active {
  transform: translate(-50%, -50%) scale(1);
  opacity: 1;
  pointer-events: auto;
}

.dialog-header {
  padding: 48rpx 48rpx 32rpx;
  border-bottom: 1rpx solid var(--border);
}

.dialog-title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--foreground);
  margin-bottom: 8rpx;
}

.dialog-desc {
  font-size: 28rpx;
  color: var(--muted-foreground);
  line-height: 1.5;
}

.dialog-body {
  flex: 1;
  padding: 32rpx 48rpx;
  overflow-y: auto;
}

.dialog-footer {
  padding: 32rpx 48rpx;
  border-top: 1rpx solid var(--border);
}

/* 设置项 */
.setting-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
}

.setting-info {
  flex: 1;
}

.setting-label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--foreground);
  margin-bottom: 8rpx;
}

.setting-desc {
  font-size: 24rpx;
  color: var(--muted-foreground);
}

/* 关于页面 */
.about-content {
  line-height: 1.8;
  margin-bottom: 24rpx;
}

.about-info {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.about-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

/* 按钮 */
.btn {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  transition: all 0.2s;
  border: none;
}

.btn-primary {
  background-color: #00A678;
  color: #ffffff;
}

.btn-primary:active {
  background-color: #008f67;
  transform: scale(0.98);
}

/* 微信组件样式覆盖 */
switch {
  transform: scale(0.9);
}

button::after {
  border: none;
}

input {
  height: 88rpx;
}
