/* pages/avatar/avatar.wxss */

/* ==================== 容器 ==================== */
.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #E0F2F1 0%, #F8FAFC 50%);
  display: flex;
  flex-direction: column;
  padding-bottom: 160rpx;
}

/* ==================== 导航栏 ==================== */
.nav-bar {
  background: transparent;
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 32rpx;
}

.nav-left {
  width: 80rpx;
  display: flex;
  align-items: center;
}

.back-icon {
  width: 20rpx;
  height: 20rpx;
  border-left: 3rpx solid #1E293B;
  border-bottom: 3rpx solid #1E293B;
  transform: rotate(45deg);
}

.back-icon:active {
  opacity: 0.6;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #1E293B;
}

.nav-right {
  width: 80rpx;
}

/* ==================== 预览区域 ==================== */
.preview-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 48rpx;
  padding: 48rpx 32rpx;
}

/* ==================== 头像容器 ==================== */
.avatar-wrapper {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-container {
  position: relative;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  overflow: visible;
}

.avatar-preview {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  border: 8rpx solid #ffffff;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
}

/* ==================== 相机按钮 ==================== */
.camera-btn {
  position: absolute;
  bottom: 8rpx;
  right: 8rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(to right, #10b981, #14b8a6);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(16, 185, 129, 0.4);
  transition: all 0.2s ease;
  border: 4rpx solid #ffffff;
  z-index: 10;
  padding: 0;
}

.camera-btn::after {
  border: none;
}

.camera-btn:active {
  transform: scale(0.95);
  box-shadow: 0 4rpx 16rpx rgba(16, 185, 129, 0.3);
}

.camera-icon-wrapper {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

/* 相机图标 - CSS绘制 */
.camera-icon {
  width: 40rpx;
  height: 32rpx;
  border: 3rpx solid #ffffff;
  border-radius: 6rpx;
  position: relative;
  background: transparent;
}

.camera-icon::before {
  content: '';
  position: absolute;
  top: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 16rpx;
  height: 6rpx;
  background: #ffffff;
  border-radius: 3rpx 3rpx 0 0;
}

.camera-icon::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 16rpx;
  height: 16rpx;
  border: 3rpx solid #ffffff;
  border-radius: 50%;
}

/* ==================== 选择按钮 ==================== */
.choose-btn {
  width: 100%;
  max-width: 600rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: center;
  gap: 24rpx;
  transition: all 0.2s ease;
  border: none;
}

.choose-btn::after {
  border: none;
}

.choose-btn:active {
  transform: scale(0.98);
  background: #F8FAFC;
}

.choose-icon-wrapper {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(16, 185, 129, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 图片图标 - CSS绘制 */
.image-icon {
  width: 44rpx;
  height: 40rpx;
  border: 3rpx solid #10b981;
  border-radius: 6rpx;
  position: relative;
}

.image-icon::before {
  content: '';
  position: absolute;
  top: 6rpx;
  left: 6rpx;
  width: 10rpx;
  height: 10rpx;
  border: 2rpx solid #10b981;
  border-radius: 50%;
}

.image-icon::after {
  content: '';
  position: absolute;
  bottom: 2rpx;
  left: 2rpx;
  right: 2rpx;
  height: 14rpx;
  background: linear-gradient(135deg, transparent 30%, #10b981 30%, #10b981 70%, transparent 70%);
}

.choose-text-wrapper {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  text-align: left;
  flex: 1;
}

.choose-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #1E293B;
}

.choose-desc {
  font-size: 26rpx;
  color: #10b981;
}

/* ==================== 底部按钮 ==================== */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  border-top: 1rpx solid #F1F5F9;
  display: flex;
  gap: 16rpx;
  z-index: 100;
}

.action-btn {
  flex: 1;
  padding: 28rpx;
  border-radius: 24rpx;
  font-weight: 500;
  font-size: 30rpx;
  transition: all 0.2s ease;
  border: none;
}

.action-btn::after {
  border: none;
}

.action-btn:active {
  transform: scale(0.98);
}

.cancel-btn {
  background: #F1F5F9;
}

.cancel-btn .btn-text {
  color: #64748B;
}

.cancel-btn:active {
  background: #E2E8F0;
}

.save-btn {
  background: linear-gradient(to right, #10b981, #14b8a6);
  box-shadow: 0 6rpx 20rpx rgba(16, 185, 129, 0.25);
}

.save-btn .btn-text {
  color: #ffffff;
}

.save-btn:active {
  opacity: 0.9;
  box-shadow: 0 4rpx 16rpx rgba(16, 185, 129, 0.3);
}

.btn-text {
  font-size: 30rpx;
  font-weight: 500;
}
