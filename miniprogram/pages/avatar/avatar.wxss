/* pages/avatar/avatar.wxss */

/* ==================== 容器 ==================== */
.container {
  min-height: 100vh;
  background-color: #F8FAFC;
  display: flex;
  flex-direction: column;
  padding-bottom: 160rpx;
}

/* ==================== 导航栏 ==================== */
.nav-bar {
  background: linear-gradient(to right, #10b981, #14b8a6);
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 32rpx;
}

.nav-left {
  width: 80rpx;
  display: flex;
  align-items: center;
}

.back-icon {
  width: 20rpx;
  height: 20rpx;
  border-left: 3rpx solid #ffffff;
  border-bottom: 3rpx solid #ffffff;
  transform: rotate(45deg);
}

.back-icon:active {
  opacity: 0.6;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.nav-right {
  width: 80rpx;
}

/* ==================== 预览区域 ==================== */
.preview-section {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  gap: 48rpx;
  padding: 40rpx 32rpx;
}

/* 头像光晕效果 */
.avatar-glow-wrapper {
  position: relative;
  margin-top: 60rpx;
}

.avatar-glow-wrapper::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 360rpx;
  height: 360rpx;
  background: radial-gradient(circle, rgba(16, 185, 129, 0.15) 0%, transparent 70%);
  border-radius: 50%;
}

/* 头像容器 */
.avatar-container {
  position: relative;
  width: 600rpx;
  height: 600rpx;
  border-radius: 50%;
  border: 18rpx solid #ffffff;
  overflow: visible;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.15);
  margin: 0 auto;
}

.avatar-preview {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

/* 相机按钮 */
.camera-btn {
  position: absolute;
  bottom: 8rpx;
  right: 8rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(to right, #10b981, #14b8a6);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(16, 185, 129, 0.4);
  z-index: 10;
}

.camera-btn:active {
  transform: scale(0.95);
}

.camera-icon-wrapper {
  width: 36rpx;
  height: 28rpx;
  position: relative;
}

/* 相机图标 - CSS绘制 */
.camera-icon {
  width: 36rpx;
  height: 24rpx;
  border: 3rpx solid #ffffff;
  border-radius: 4rpx;
  position: relative;
}

.camera-icon::before {
  content: '';
  position: absolute;
  top: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 16rpx;
  height: 6rpx;
  background: #ffffff;
  border-radius: 2rpx 2rpx 0 0;
}

.camera-icon::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 14rpx;
  height: 14rpx;
  border: 3rpx solid #ffffff;
  border-radius: 50%;
}

/* ==================== 底部按钮 ==================== */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  border-top: 1rpx solid #F1F5F9;
  display: flex;
  gap: 16rpx;
  z-index: 100;
}

.action-btn {
  flex: 1;
  padding: 28rpx;
  border-radius: 24rpx;
  font-weight: 500;
  font-size: 30rpx;
  transition: all 0.2s ease;
  border: none;
}

.action-btn::after {
  border: none;
}

.action-btn:active {
  transform: scale(0.98);
}

.cancel-btn {
  background: #F1F5F9;
}

.cancel-btn .btn-text {
  color: #64748B;
}

.cancel-btn:active {
  background: #E2E8F0;
}

.save-btn {
  background: linear-gradient(to right, #10b981, #14b8a6);
  box-shadow: 0 6rpx 20rpx rgba(16, 185, 129, 0.25);
}

.save-btn .btn-text {
  color: #ffffff;
}

.save-btn:active {
  opacity: 0.9;
  box-shadow: 0 4rpx 16rpx rgba(16, 185, 129, 0.3);
}

.btn-text {
  font-size: 30rpx;
  font-weight: 500;
}
