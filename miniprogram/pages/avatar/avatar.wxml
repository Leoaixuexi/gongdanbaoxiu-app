<!--pages/avatar/avatar.wxml-->
<view class="container">
  <!-- 导航栏 -->
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-content">
      <view class="nav-left" bindtap="handleCancel">
        <van-icon name="arrow-left" size="40rpx" color="#fff" />
      </view>
      <view class="nav-title">修改头像</view>
      <view class="nav-right"></view>
    </view>
  </view>

  <!-- 头像预览区域 -->
  <view class="preview-section">
    <view class="avatar-glow-wrapper">
      <view class="avatar-container" bindtap="chooseImage">
        <image
          class="avatar-preview"
          src="{{preview}}"
          mode="aspectFill"
        />
        <!-- 相机图标 -->
        <view class="camera-btn">
          <view class="camera-icon-wrapper">
            <view class="camera-icon"></view>
          </view>
        </view>
      </view>
    </view>

  </view>

  <!-- 底部按钮 -->
  <view class="bottom-actions">
    <button class="action-btn cancel-btn" bindtap="handleCancel">
      <text class="btn-text">取消</text>
    </button>
    <button class="action-btn save-btn" bindtap="saveAvatar">
      <text class="btn-text">保存</text>
    </button>
  </view>
</view>
