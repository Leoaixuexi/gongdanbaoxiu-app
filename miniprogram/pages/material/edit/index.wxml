<!-- 配件修改页面 -->
<view class="edit-container">
  <view class="form-body">

    <!-- 基本信息 -->
    <view class="section-group">
      <text class="section-title">基本信息</text>
      <view class="field-card">
        <view class="field-row">
          <view class="field-label-wrap">
            <text class="req-star">*</text>
            <text class="field-label">物品名称</text>
          </view>
          <input
            class="field-input"
            placeholder="请输入"
            placeholder-class="field-placeholder"
            value="{{form.name}}"
            data-field="name"
            bindinput="onInput"
          />
        </view>
        <view class="field-divider"></view>
        <view class="field-row field-row-last">
          <view class="field-label-wrap">
            <text class="field-label">编号</text>
          </view>
          <input
            class="field-input"
            placeholder="请输入"
            placeholder-class="field-placeholder"
            value="{{form.material_number}}"
            data-field="material_number"
            bindinput="onInput"
          />
        </view>
      </view>
    </view>

    <!-- 分类与规格 -->
    <view class="section-group">
      <text class="section-title">配件参数</text>
      <view class="field-card">
        <view class="field-row">
          <view class="field-label-wrap">
            <text class="req-star">*</text>
            <text class="field-label">类别</text>
          </view>
          <picker mode="selector" range="{{categories}}" value="{{categoryIndex}}" bindchange="onCategoryChange">
            <view class="field-picker">
              <text class="picker-val {{form.category ? '' : 'picker-placeholder'}}">{{form.category || '请选择'}}</text>
              <view class="picker-arrow"></view>
            </view>
          </picker>
        </view>
        <view class="field-divider"></view>
        <view class="field-row">
          <view class="field-label-wrap">
            <text class="req-star">*</text>
            <text class="field-label">单位</text>
          </view>
          <picker mode="selector" range="{{units}}" value="{{unitIndex}}" bindchange="onUnitChange">
            <view class="field-picker">
              <text class="picker-val {{form.unit ? '' : 'picker-placeholder'}}">{{form.unit || '请选择'}}</text>
              <view class="picker-arrow"></view>
            </view>
          </picker>
        </view>
        <view class="field-divider"></view>
        <view class="field-row">
          <view class="field-label-wrap">
            <text class="field-label">规格</text>
          </view>
          <input
            class="field-input"
            placeholder="如：LED 18W"
            placeholder-class="field-placeholder"
            value="{{form.spec}}"
            data-field="spec"
            bindinput="onInput"
          />
        </view>
        <view class="field-divider"></view>
        <view class="field-row field-row-last">
          <view class="field-label-wrap">
            <text class="field-label">型号</text>
          </view>
          <input
            class="field-input"
            placeholder="如：SKF-6205"
            placeholder-class="field-placeholder"
            value="{{form.model}}"
            data-field="model"
            bindinput="onInput"
          />
        </view>
      </view>
    </view>

    <!-- 配件图片 -->
    <view class="section-group">
      <text class="section-title">配件图片</text>
      <view class="photo-card">
        <view class="photos-row">
          <view wx:for="{{photos}}" wx:key="index" class="photo-slot">
            <view wx:if="{{item}}" class="photo-filled">
              <image class="photo-img" src="{{item}}" mode="aspectFill" bindtap="onPreviewPhoto" data-index="{{index}}" />
              <view class="photo-del" catchtap="onRemovePhoto" data-index="{{index}}">
                <text class="del-icon">×</text>
              </view>
            </view>
            <view wx:else class="photo-empty" bindtap="onChoosePhoto" data-index="{{index}}">
              <van-icon name="photograph" size="32px" color="#C4C4C4" />
              <text class="photo-empty-text">添加</text>
            </view>
          </view>
        </view>
        <text class="photos-tip">最多3张，点击可更换</text>
      </view>
    </view>

    <!-- 其他信息 -->
    <view class="section-group">
      <text class="section-title">其他信息</text>
      <view class="field-card">
        <view class="field-row">
          <view class="field-label-wrap">
            <text class="field-label">配件来源</text>
          </view>
          <input
            class="field-input"
            placeholder="如：供应商名称"
            placeholder-class="field-placeholder"
            value="{{form.source}}"
            data-field="source"
            bindinput="onInput"
          />
        </view>
        <view class="field-divider"></view>
        <view class="field-row">
          <view class="field-label-wrap">
            <text class="field-label">使用区域</text>
          </view>
          <input
            class="field-input"
            placeholder="如：1-3楼公区"
            placeholder-class="field-placeholder"
            value="{{form.usage_area}}"
            data-field="usage_area"
            bindinput="onInput"
          />
        </view>
        <view class="field-divider"></view>
        <view class="field-row field-row-last">
          <view class="field-label-wrap">
            <text class="field-label">预警值</text>
          </view>
          <input
            class="field-input"
            type="number"
            placeholder="低于此值触发预警"
            placeholder-class="field-placeholder"
            value="{{form.min_stock}}"
            data-field="min_stock"
            bindinput="onInput"
          />
        </view>
      </view>
    </view>

  </view>

  <!-- 底部按钮 -->
  <view class="bottom-btns">
    <view class="btn-cancel" bindtap="goBack">
      <text class="btn-cancel-text">取消</text>
    </view>
    <view class="btn-submit {{submitting ? 'btn-disabled' : ''}}" bindtap="handleSubmit">
      <text class="btn-submit-text">{{submitting ? '保存中...' : '保存修改'}}</text>
    </view>
  </view>
</view>
