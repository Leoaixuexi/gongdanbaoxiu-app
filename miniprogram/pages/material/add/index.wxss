/* 新增配件页面 - 与「新增商品」共用 UI 风格 */

page {
  font-family: "PingFang SC", -apple-system, BlinkMacSystemFont, "Segoe UI", "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-size: 28rpx;
  color: #111827;
  background-color: #F7F9FC;
}

.page {
  min-height: 100vh;
  background-color: #F7F9FC;
  padding-bottom: 240rpx;
}

.form {
  padding: 0 48rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 字段容器 */
.field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.field-row {
  display: flex;
  gap: 24rpx;
}

.field-half {
  flex: 1;
  min-width: 0;
}

/* 标签 */
.field-label {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.label {
  font-size: 28rpx;
  color: #111827;
  font-weight: 700;
  line-height: 1.2;
}

.star {
  font-size: 28rpx;
  color: #FF3B30;
  font-weight: 700;
  line-height: 1.2;
}

.label-tip {
  margin-left: auto;
  font-size: 22rpx;
  color: #8994A6;
  font-weight: 500;
}

/* 输入框容器 */
.input-wrap {
  height: 88rpx;
  padding: 0 28rpx;
  background-color: #FFFFFF;
  border: 1rpx solid #E3E8F0;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(154, 166, 187, 0.09);
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.input-with-arrow {
  justify-content: space-between;
}

.input {
  flex: 1;
  font-family: "PingFang SC", -apple-system, BlinkMacSystemFont, "Segoe UI", "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-size: 28rpx;
  color: #111827;
  font-weight: 400;
  line-height: 1.5;
  min-height: 40rpx;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

.ph {
  color: #9BA4B5;
  font-weight: 400;
  font-size: 28rpx;
}

.picker-text {
  flex: 1;
  font-family: "PingFang SC", -apple-system, BlinkMacSystemFont, "Segoe UI", "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-size: 28rpx;
  color: #111827;
  font-weight: 400;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

.picker-text.ph-text {
  color: #9BA4B5;
  font-weight: 400;
}

picker {
  width: 100%;
}

.arrow {
  width: 14rpx;
  height: 14rpx;
  border-top: 3rpx solid #C0C7D4;
  border-right: 3rpx solid #C0C7D4;
  transform: rotate(45deg);
  margin-left: 12rpx;
  flex-shrink: 0;
}

/* 文本域 */
.textarea-wrap {
  position: relative;
  background-color: #FFFFFF;
  border: 1rpx solid #E3E8F0;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(154, 166, 187, 0.09);
  padding: 20rpx 28rpx 36rpx;
  box-sizing: border-box;
}

.textarea {
  width: 100%;
  min-height: 120rpx;
  font-family: "PingFang SC", -apple-system, BlinkMacSystemFont, "Segoe UI", "Helvetica Neue", Helvetica, Arial, sans-serif;
  font-size: 28rpx;
  color: #111827;
  line-height: 1.5;
  font-weight: 400;
  box-sizing: border-box;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

.textarea-sm {
  min-height: 80rpx;
  height: 80rpx;
}

.textarea-count {
  position: absolute;
  right: 28rpx;
  bottom: 16rpx;
  font-size: 22rpx;
  color: #8B94A5;
  font-weight: 600;
}

/* 配件图片 */
.photos-row {
  display: flex;
  gap: 20rpx;
}

.photo-box {
  width: 160rpx;
  height: 160rpx;
  flex-shrink: 0;
}

.photo-preview {
  width: 100%;
  height: 100%;
  position: relative;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(154, 166, 187, 0.09);
}

.photo-img {
  width: 100%;
  height: 100%;
}

.photo-del {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 36rpx;
  height: 36rpx;
  background-color: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.del-text {
  font-size: 28rpx;
  color: #FFFFFF;
  line-height: 1;
}

.photo-add {
  width: 100%;
  height: 100%;
  background-color: #FBFCFF;
  border: 2rpx dashed #CFD8E6;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(154, 166, 187, 0.09);
}

.add-plus {
  font-size: 56rpx;
  color: #9CA3AF;
  line-height: 1;
  font-weight: 300;
}

/* 底部按钮 */
.bottom-surface {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10px);
  border-radius: 36rpx 36rpx 0 0;
  box-shadow: 0 -8rpx 36rpx rgba(127, 138, 157, 0.12);
  padding: 24rpx 48rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.bottom-actions {
  display: flex;
  gap: 24rpx;
  height: 96rpx;
}

.btn {
  flex: 1;
  height: 100%;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.btn-cancel {
  background-color: #F3F4F6;
  border: none;
}

.btn-cancel-text {
  font-size: 28rpx;
  color: #4B5563;
  font-weight: 600;
}

.btn-submit {
  background: linear-gradient(to right, #10b981, #14b8a6);
  box-shadow: 0 4rpx 12rpx rgba(12, 167, 125, 0.3);
}

.btn-submit-text {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 700;
}
