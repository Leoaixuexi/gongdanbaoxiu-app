/* 记录详情页 - 按 Pencil 设计稿 */

page {
  background: #F2F4F8;
}

.rd-page {
  padding: 32rpx;
}

/* 出库单号头部 */
.rd-header {
  margin-bottom: 32rpx;
}

.rd-number {
  display: block;
  font-size: 38rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}

.rd-date {
  font-size: 24rpx;
  color: #a3a3a3;
}

/* 分组 */
.rd-group {
  margin-bottom: 32rpx;
}

.rd-group-title {
  font-size: 24rpx;
  font-weight: 500;
  color: #a3a3a3;
  display: block;
  margin-bottom: 16rpx;
}

/* 卡片 */
.rd-card {
  background: linear-gradient(165deg, rgba(255,255,255,0.8) 0%, rgba(255,255,255,0.6) 100%);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 20rpx;
  border-top: 1rpx solid rgba(255,255,255,0.95);
  border-left: 1rpx solid rgba(255,255,255,0.6);
  border-right: 1rpx solid rgba(255,255,255,0.6);
  border-bottom: 1rpx solid rgba(0,0,0,0.03);
  box-shadow:
    inset 0 2rpx 4rpx rgba(255,255,255,0.8),
    inset 0 -1rpx 3rpx rgba(0,0,0,0.015),
    0 2rpx 4rpx rgba(0,0,0,0.02),
    0 8rpx 16rpx rgba(0,0,0,0.035),
    0 16rpx 32rpx -8rpx rgba(0,0,0,0.04);
  overflow: hidden;
}

/* 行 */
.rd-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
}

.rd-row-last {
  border-bottom: none;
}

.rd-label {
  font-size: 26rpx;
  color: #737373;
}

.rd-value {
  font-size: 26rpx;
  color: #1a1a1a;
  font-weight: 500;
}

.qty-in {
  color: #16A34A;
  font-weight: 600;
}

.qty-out {
  color: #DC2626;
  font-weight: 600;
}

/* 备注 */
.rd-remark {
  padding: 24rpx 28rpx;
  font-size: 26rpx;
  color: #525252;
  line-height: 1.6;
}
