/* 新增入库页（参考图二次优化版） */

page {
  background: #F5F7FA;
  height: 100vh;
}

.add-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F5F7FA;
}

/* ========== 滚动容器 ========== */
.add-scroll {
  flex: 1;
  min-height: 0;
}

/* ========== 通用 wrap / card ========== */
.add-wrap {
  padding: 24rpx 32rpx 0;
}

.add-wrap-last {
  padding-bottom: 32rpx;
}

.add-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
}

/* ========== 识别成功 banner ========== */
.add-banner {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx 28rpx;
  background: #E8F5EE;
  border-radius: 16rpx;
}

.add-banner-text {
  font-size: 28rpx;
  color: #1F9254;
  font-weight: 500;
}

/* ========== 商品卡 ========== */
.add-product-card {
  display: flex;
  gap: 28rpx;
  align-items: flex-start;
}

.add-product-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  background: #F0F0F0;
  flex-shrink: 0;
}

.add-product-img-empty {
  background: #F0F0F0;
}

.add-product-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.add-product-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1A1A1A;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.add-product-meta-row {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.add-product-meta-label {
  font-size: 26rpx;
  color: #999999;
  flex-shrink: 0;
}

.add-product-meta-value {
  font-size: 26rpx;
  color: #666666;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.add-product-price {
  font-size: 26rpx;
  color: #2563EB;
  font-weight: 500;
}

.add-product-cat-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 4rpx;
}

.add-product-cat-tag {
  padding: 8rpx 20rpx;
  background: #E8F0FE;
  border-radius: 10rpx;
}

.add-product-cat-text {
  font-size: 26rpx;
  color: #2563EB;
  font-weight: 500;
}

/* ========== 标签 + 必填星号 ========== */
.add-label-row {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.add-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
}

.add-required {
  font-size: 28rpx;
  color: #FF4D4F;
  margin-left: 4rpx;
}

/* ========== 数量 stepper ========== */
.add-stepper {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 136rpx;
  padding: 0 36rpx;
  margin-top: 28rpx;
  background: #F5F7FA;
  border-radius: 20rpx;
}

.add-stepper-btn {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  transition: transform 0.1s ease;
}

.add-stepper-btn:active {
  transform: scale(0.92);
}

.add-stepper-minus {
  border: 2rpx solid #D1D5DB;
}

.add-stepper-plus {
  border: 2rpx solid #2563EB;
}

.add-stepper-value {
  font-size: 64rpx;
  font-weight: 600;
  color: #1A1A1A;
  line-height: 1;
  min-width: 120rpx;
  text-align: center;
}

.add-stock-row {
  display: flex;
  justify-content: flex-end;
  margin-top: 20rpx;
}

.add-stock-text {
  font-size: 26rpx;
  color: #999999;
}

/* ========== 表单卡（位置 / 入库人 / 时间 / 备注） ========== */
.add-form-card {
  padding: 0 32rpx;
}

.add-form-row {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 32rpx 0;
}

.add-form-row-bordered {
  border-bottom: 1rpx solid #F0F2F5;
}

.add-form-value-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.add-form-value {
  font-size: 30rpx;
  color: #1A1A1A;
}

.add-form-placeholder {
  color: #BFBFBF;
}

/* ========== 备注 ========== */
.add-notes-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
}

.add-notes-input {
  flex: 1;
  min-height: 60rpx;
  font-size: 30rpx;
  color: #1A1A1A;
  line-height: 1.5;
}

.add-notes-placeholder {
  color: #BFBFBF;
}

.add-notes-counter {
  font-size: 24rpx;
  color: #BFBFBF;
  flex-shrink: 0;
  padding-bottom: 8rpx;
}

/* ========== 底部按钮栏 ========== */
.add-bottom {
  display: flex;
  gap: 24rpx;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #FFFFFF;
  border-top: 1rpx solid #F0F2F5;
  flex-shrink: 0;
}

.add-btn {
  flex: 1;
  height: 96rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  transition: opacity 0.15s ease;
}

.add-btn:active {
  opacity: 0.85;
}

.add-btn-secondary {
  background: #FFFFFF;
  border: 2rpx solid #2563EB;
}

.add-btn-secondary-text {
  font-size: 30rpx;
  font-weight: 500;
  color: #2563EB;
}

.add-btn-primary {
  background: #2563EB;
}

.add-btn-primary-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
}

.add-btn-disabled {
  opacity: 0.6;
  pointer-events: none;
}
