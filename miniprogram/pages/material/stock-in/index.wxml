<!-- 入库管理（独立页）— UI 重做 -->
<view class="sin-page">
  <!-- TabBar -->
  <view class="sin-tabbar">
    <view
      wx:for="{{subTabs}}"
      wx:key="index"
      class="sin-tab {{activeSubTab === index ? 'sin-tab-active' : ''}}"
      data-sub="{{index}}"
      bindtap="onSubTabChange"
    >
      <text class="sin-tab-text">{{item}}</text>
      <view class="sin-tab-ind"></view>
    </view>
  </view>
  <view class="sin-tab-divider"></view>

  <!-- 子页 0：入库记录 -->
  <scroll-view
    wx:if="{{activeSubTab === 0}}"
    scroll-y
    class="sin-scroll"
    bindscrolltolower="onLoadMoreRecords"
  >
    <!-- 搜索 + 筛选 -->
    <view class="sin-search-section">
      <view class="sin-search-input">
        <van-icon name="search" size="16px" color="#9CA3AF" />
        <text class="sin-search-ph">搜索商品名称、入库人、入库位置</text>
      </view>
      <view class="sin-filter-btn">
        <van-icon name="filter-o" size="16px" color="#2563EB" />
        <text class="sin-filter-text">筛选</text>
      </view>
    </view>

    <!-- 日期范围 -->
    <view class="sin-date-section">
      <view class="sin-date-card">
        <van-icon name="calendar-o" size="18px" color="#2563EB" />
        <text class="sin-date-text">选择日期范围</text>
      </view>
    </view>

    <!-- 卡片列表 -->
    <view wx:if="{{inLoading}}" class="sin-state">
      <text>加载中...</text>
    </view>
    <view wx:elif="{{inRecords.length === 0}}" class="sin-state sin-empty">
      <van-icon name="orders-o" size="48px" color="#d4d4d4" />
      <text class="sin-empty-text">暂无入库记录</text>
    </view>
    <view wx:else class="sin-rec-list">
      <view
        wx:for="{{inRecords}}"
        wx:key="record_id"
        class="sin-rec-card"
        bindtap="goToRecordDetail"
        data-record="{{item}}"
      >
        <image
          class="sin-rec-img"
          src="{{item.product_image || '/images/placeholder.png'}}"
          mode="aspectFill"
        />
        <view class="sin-rec-body">
          <view class="sin-rec-top">
            <text class="sin-rec-name">{{item.product_name}}</text>
            <view class="sin-rec-badge">+{{item.quantity}}</view>
          </view>
          <view class="sin-rec-info-row">
            <text class="sin-rec-info-label">入库单号</text>
            <text class="sin-rec-info-value sin-rec-info-mono">{{item.recordNumber}}</text>
          </view>
          <view class="sin-rec-info-row">
            <text class="sin-rec-info-label">入库时间</text>
            <text class="sin-rec-info-value">{{item.timeText}}</text>
          </view>
          <view class="sin-rec-info-row">
            <text class="sin-rec-info-label">入库仓库</text>
            <text class="sin-rec-info-value">{{item.usage_area || '-'}}</text>
          </view>
          <view class="sin-rec-info-row">
            <text class="sin-rec-info-label">操作人</text>
            <text class="sin-rec-info-value">{{(item.operator && item.operator.name) || '-'}}</text>
          </view>
        </view>
      </view>
    </view>
    <view wx:if="{{inLoadingMore}}" class="sin-loading-more">
      <text>加载更多...</text>
    </view>
  </scroll-view>

  <!-- 子页 1：分类管理 -->
  <scroll-view
    wx:if="{{activeSubTab === 1}}"
    scroll-y
    class="sin-scroll"
  >
    <!-- 搜索 + 新增分类 -->
    <view class="sin-cat-search-wrap">
      <view class="sin-search-input">
        <van-icon name="search" size="16px" color="#9CA3AF" />
        <text class="sin-search-ph">搜索分类名称</text>
      </view>
      <view
        wx:if="{{canManage}}"
        class="sin-cat-add-btn"
        bindtap="onAddCategoryTap"
      >
        <van-icon name="plus" size="16px" color="#FFFFFF" />
        <text class="sin-cat-add-text">新增分类</text>
      </view>
    </view>

    <!-- 统计 + 排序 -->
    <view class="sin-cat-info">
      <view class="sin-cat-info-left">
        <text class="sin-cat-info-lbl">共</text>
        <text class="sin-cat-info-cnt">{{categoryItems.length}}</text>
        <text class="sin-cat-info-lbl">个分类</text>
      </view>
      <view class="sin-cat-sort">
        <van-icon name="exchange" size="14px" color="#6B7280" />
        <text class="sin-cat-sort-text">排序</text>
      </view>
    </view>

    <view wx:if="{{categoriesLoading}}" class="sin-state">
      <text>加载中...</text>
    </view>
    <view wx:elif="{{categoryItems.length === 0}}" class="sin-state sin-empty">
      <van-icon name="apps-o" size="48px" color="#d4d4d4" />
      <text class="sin-empty-text">暂无分类</text>
    </view>
    <view wx:else class="sin-cat-list">
      <view
        wx:for="{{categoryItems}}"
        wx:key="value"
        wx:if="{{item.enabled !== false}}"
        class="sin-cat-card"
      >
        <view class="sin-cat-thumb sin-cat-thumb-{{index % 6}}">
          <text class="sin-cat-thumb-text">{{item.label}}</text>
        </view>
        <view class="sin-cat-info-block">
          <text class="sin-cat-name">{{item.label}}</text>
          <text class="sin-cat-sub">{{item.value}}</text>
        </view>
        <view class="sin-cat-actions" wx:if="{{canManage}}">
          <view class="sin-cat-act" data-index="{{index}}" bindtap="onRenameCategoryTap">
            <van-icon name="edit" size="16px" color="#6B7280" />
          </view>
          <view class="sin-cat-act sin-cat-act-danger" data-index="{{index}}" bindtap="onDeleteCategoryTap">
            <van-icon name="delete-o" size="16px" color="#DC2626" />
          </view>
        </view>
        <view class="sin-cat-chevron" wx:else>
          <van-icon name="arrow" size="20px" color="#9CA3AF" />
        </view>
      </view>
    </view>
  </scroll-view>

  <!-- FAB -->
  <view
    wx:if="{{canManage && activeSubTab === 0}}"
    class="sin-fab"
    bindtap="directScan"
  >
    <van-icon name="plus" size="26px" color="#FFFFFF" />
  </view>

</view>
