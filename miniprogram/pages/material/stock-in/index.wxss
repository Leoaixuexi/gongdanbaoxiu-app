/* 入库管理（独立页）— UI 重做（Pencil oTkGz + J5OUY） */

page {
  background: #F5F7FA;
}

.sin-page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* ========== TabBar ========== */
.sin-tabbar {
  display: flex;
  height: 88rpx;
  background: #FFFFFF;
  flex-shrink: 0;
}

.sin-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  padding-bottom: 12rpx;
  gap: 12rpx;
  position: relative;
}

.sin-tab-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #6B7280;
  line-height: 1;
}

.sin-tab-ind {
  width: 96rpx;
  height: 6rpx;
  border-radius: 4rpx;
  background: transparent;
}

.sin-tab-active .sin-tab-text {
  color: #2563EB;
  font-weight: 700;
}

.sin-tab-active .sin-tab-ind {
  background: #2563EB;
}

.sin-tab-divider {
  height: 1rpx;
  background: #E5E7EB;
  flex-shrink: 0;
}

/* ========== Scroll 容器 ========== */
.sin-scroll {
  flex: 1;
  min-height: 0;
  height: calc(100vh - 89rpx);
  box-sizing: border-box;
}

/* ========== 入库记录：搜索 + 筛选 ========== */
.sin-search-section {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
}

.sin-search-input {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: 76rpx;
  padding: 0 28rpx;
  background: #F1F3F5;
  border-radius: 999rpx;
}

.sin-search-ph {
  font-size: 26rpx;
  color: #9CA3AF;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.sin-filter-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 76rpx;
  padding: 0 8rpx;
  flex-shrink: 0;
}

.sin-filter-text {
  font-size: 28rpx;
  color: #2563EB;
}

/* ========== 入库记录：日期范围 ========== */
.sin-date-section {
  padding: 16rpx 32rpx 24rpx;
  background: #FFFFFF;
}

.sin-date-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  height: 88rpx;
  padding: 0 28rpx;
  background: #F8F9FA;
  border-radius: 20rpx;
}

.sin-date-text {
  font-size: 26rpx;
  color: #6B7280;
}

/* ========== 入库记录：卡片列表 ========== */
.sin-rec-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding: 24rpx;
}

.sin-rec-card {
  display: flex;
  gap: 24rpx;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.15s ease;
}

.sin-rec-card:active {
  transform: scale(0.98);
}

.sin-rec-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  background: #F0F0F0;
  flex-shrink: 0;
}

.sin-rec-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.sin-rec-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 6rpx;
}

.sin-rec-name {
  flex: 1;
  font-size: 30rpx;
  font-weight: 700;
  color: #1F2937;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.sin-rec-badge {
  flex-shrink: 0;
  padding: 6rpx 18rpx;
  background: #DBEAFE;
  color: #2563EB;
  font-size: 22rpx;
  font-weight: 700;
  border-radius: 999rpx;
  line-height: 1.3;
}

.sin-rec-info-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-height: 36rpx;
}

.sin-rec-info-label {
  width: 112rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  color: #9CA3AF;
}

.sin-rec-info-value {
  flex: 1;
  font-size: 24rpx;
  color: #1F2937;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.sin-rec-info-mono {
  font-family: SFMono-Regular, Menlo, Monaco, Consolas, monospace;
  letter-spacing: 0.5rpx;
}

/* ========== 分类管理：搜索 ========== */
.sin-cat-search-wrap {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 32rpx;
}

.sin-cat-search-wrap .sin-search-input {
  height: 80rpx;
}

.sin-cat-add-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  height: 80rpx;
  padding: 0 28rpx;
  flex-shrink: 0;
  background: #2563EB;
  border-radius: 999rpx;
  box-shadow: 0 6rpx 16rpx rgba(37, 99, 235, 0.3);
  transition: transform 0.15s ease;
}

.sin-cat-add-btn:active {
  transform: scale(0.95);
}

.sin-cat-add-text {
  font-size: 26rpx;
  color: #FFFFFF;
  white-space: nowrap;
}

/* ========== 分类管理：统计 + 排序 ========== */
.sin-cat-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx 24rpx;
}

.sin-cat-info-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.sin-cat-info-lbl {
  font-size: 24rpx;
  color: #6B7280;
}

.sin-cat-info-cnt {
  font-size: 28rpx;
  color: #2563EB;
  font-weight: 700;
}

.sin-cat-sort {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.sin-cat-sort-text {
  font-size: 24rpx;
  color: #6B7280;
}

/* ========== 分类管理：卡片列表 ========== */
.sin-cat-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 0 32rpx 32rpx;
}

.sin-cat-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
}

.sin-cat-thumb {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.sin-cat-thumb-text {
  font-size: 32rpx;
  font-weight: 700;
  color: rgba(0, 0, 0, 0.55);
}

.sin-cat-thumb-0 { background: #FEF3E2; }
.sin-cat-thumb-0 .sin-cat-thumb-text { color: #FF8400; }

.sin-cat-thumb-1 { background: #E5EEFC; }
.sin-cat-thumb-1 .sin-cat-thumb-text { color: #2563EB; }

.sin-cat-thumb-2 { background: #DFE6E1; }
.sin-cat-thumb-2 .sin-cat-thumb-text { color: #4B7A5A; }

.sin-cat-thumb-3 { background: #DFDFE6; }
.sin-cat-thumb-3 .sin-cat-thumb-text { color: #5B5BAA; }

.sin-cat-thumb-4 { background: #E5DCDA; }
.sin-cat-thumb-4 .sin-cat-thumb-text { color: #A04545; }

.sin-cat-thumb-5 { background: #E9E3D8; }
.sin-cat-thumb-5 .sin-cat-thumb-text { color: #8C7B3A; }

.sin-cat-info-block {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.sin-cat-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #111111;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.sin-cat-sub {
  font-size: 24rpx;
  color: #6B7280;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.sin-cat-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

.sin-cat-act {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5F7FA;
}

.sin-cat-act-danger {
  background: #FEF2F2;
}

.sin-cat-chevron {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* ========== 加载 / 空状态 ========== */
.sin-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  color: #a3a3a3;
  font-size: 28rpx;
}

.sin-empty-text {
  margin-top: 16rpx;
  color: #a3a3a3;
  font-size: 28rpx;
}

.sin-loading-more {
  text-align: center;
  padding: 24rpx;
  color: #a3a3a3;
  font-size: 24rpx;
}

/* ========== FAB ========== */
.sin-fab {
  position: fixed;
  right: 36rpx;
  bottom: 96rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #2563EB;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(37, 99, 235, 0.35);
  z-index: 100;
  transition: transform 0.15s ease;
}

.sin-fab:active {
  transform: scale(0.92);
}

