<!-- 扫码入库（全屏相机预览） -->
<view class="scan-page">
  <!-- 全屏 camera -->
  <camera
    wx:if="{{cameraAuthorized}}"
    class="scan-camera-full"
    device-position="back"
    binderror="onCameraError"
  ></camera>
  <view wx:else class="scan-camera-full scan-camera-placeholder"></view>

  <!-- 绿色扫描线（全屏从上到下滚动） -->
  <view class="scan-line-full"></view>

  <!-- 左上 返回按钮 -->
  <view
    class="scan-fab-btn scan-fab-back"
    style="top: {{statusBarHeight + 8}}px;"
    bindtap="onBack"
  >
    <van-icon name="arrow-left" size="22px" color="#1A1A1A" />
  </view>

  <!-- 中央点击区（用于触发原生 wx.scanCode） -->
  <view class="scan-tap-area" bindtap="onScanFromCamera"></view>

  <!-- 底部：左下手动输入 + 右下相册（两端分布） -->
  <view class="scan-bottom">
    <text class="scan-hint-text">将商品条码对准屏幕即可识别</text>
    <view class="scan-actions">
      <view class="scan-action" bindtap="onManualInput">
        <view class="scan-action-btn">
          <van-icon name="description" size="22px" color="#FFFFFF" />
        </view>
        <text class="scan-action-text">手动输入</text>
      </view>
      <view class="scan-action" bindtap="onUploadImage">
        <view class="scan-action-btn">
          <van-icon name="photo-o" size="22px" color="#FFFFFF" />
        </view>
        <text class="scan-action-text">相册</text>
      </view>
    </view>
  </view>
</view>
