/* 扫码入库页 — 全屏相机预览 */

page {
  background: #000000;
  height: 100vh;
}

.scan-page {
  position: relative;
  width: 100vw;
  height: 100vh;
  background: #000000;
  overflow: hidden;
}

/* ========== 全屏 camera ========== */
.scan-camera-full {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.scan-camera-placeholder {
  background: #1A1A1A;
}

/* ========== 扫描线（从上到下滚动的蓝色光带） ========== */
.scan-line-full {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 240rpx;
  background: linear-gradient(
    180deg,
    rgba(64, 128, 255, 0) 0%,
    rgba(64, 128, 255, 0.18) 50%,
    rgba(64, 128, 255, 0.75) 100%
  );
  z-index: 4;
  pointer-events: none;
  animation: scan-vertical-move 3.2s linear infinite;
}

@keyframes scan-vertical-move {
  0% {
    transform: translateY(-240rpx);
    opacity: 0;
  }
  10% {
    opacity: 1;
  }
  90% {
    opacity: 1;
  }
  100% {
    transform: translateY(100vh);
    opacity: 0;
  }
}

/* ========== 中央点击区 ========== */
.scan-tap-area {
  position: absolute;
  inset: 0;
  z-index: 3;
}

/* ========== 悬浮圆形按钮（左上返回 / 右上手电筒） ========== */
.scan-fab-btn {
  position: absolute;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

.scan-fab-back {
  left: 32rpx;
}

/* ========== 底部提示 + 两端分布动作按钮 ========== */
.scan-bottom {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 0 64rpx;
  padding-bottom: calc(80rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 32rpx;
  z-index: 10;
}

.scan-hint-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.4);
  text-align: center;
}

.scan-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.scan-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.scan-action-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.45);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: transform 0.15s ease;
}

.scan-action-btn:active {
  transform: scale(0.92);
  background: rgba(0, 0, 0, 0.6);
}

.scan-action-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.4);
}
