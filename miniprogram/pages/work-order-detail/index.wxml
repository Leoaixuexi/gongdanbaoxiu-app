<!--工单详情页面 (基于 Taro 设计)-->
<view class="order-detail-container">
  <!-- 自定义导航栏 -->
  <custom-header title="工单详情" showBack="{{!isReadOnlyMode}}" />

  <!-- Loading State -->
  <view class="loading-state" wx:if="{{loading}}" style="padding-top: {{headerHeight}}px;">
    <view class="weui-loadmore">
      <view class="weui-loading"></view>
      <view class="weui-loadmore__tips">加载中...</view>
    </view>
  </view>

  <!-- Work Order Content -->
  <block wx:if="{{!loading && workOrder}}">
    <!-- 顶部绿色渐变区域 -->
    <view class="header" style="padding-top: calc({{headerHeight}}px + 4rpx);">
      <!-- 使用新的步骤条组件 -->
      <work-order-stepper workOrderData="{{stepperData}}" />
    </view>

    <!-- Tab 切换 -->
    <view class="tab-nav">
      <view class="tab-item {{activeTab === 'info' ? 'tab-item-active' : ''}}" bindtap="switchTab" data-tab="info">
        <text class="tab-text {{activeTab === 'info' ? 'tab-text-active' : ''}}">工单信息</text>
      </view>
      <view class="tab-item {{activeTab === 'service' ? 'tab-item-active' : ''}}" bindtap="switchTab" data-tab="service">
        <text class="tab-text {{activeTab === 'service' ? 'tab-text-active' : ''}}">工单进度</text>
      </view>
    </view>

    <!-- 工单信息 Tab -->
    <view class="content-area" wx:if="{{activeTab === 'info'}}">
      <view class="info-content">
        <view class="info-card">
          <view class="info-row">
            <text class="info-label">工单编号</text>
            <text class="info-value">{{workOrder.order_number}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">楼层</text>
            <text class="info-value">{{workOrder.floor}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">具体位置</text>
            <text class="info-value">{{workOrder.location}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">工单类别</text>
            <text class="info-value">{{workOrder.order_category || '未知'}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">责任方</text>
            <text class="info-value">{{workOrder.responsible_party || '未知'}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">优先级</text>
            <view class="priority-tag {{workOrder.priority === 'Emergency' ? 'priority-red' : 'priority-green'}}">
              {{priorityDisplay}}
            </view>
          </view>
          <view class="info-row">
            <text class="info-label">报修时间</text>
            <view class="info-value-datetime">
              <text class="datetime-date">{{reportDate}}</text>
              <text class="datetime-time">{{reportTimeOnly}}</text>
            </view>
          </view>
          <view class="info-row">
            <text class="info-label">问题描述</text>
            <text class="info-value">{{workOrder.description}}</text>
          </view>

          <!-- 现场照片 -->
          <view class="info-row info-row-photos" wx:if="{{workOrder.photos && workOrder.photos.length > 0}}">
            <text class="info-label">现场照片</text>
            <view class="info-value info-value-photos">
              <view class="photo-grid-inline">
                <view wx:for="{{workOrder.photos}}" wx:key="index" class="photo-item-wrapper">
                  <!-- 加载中状态 -->
                  <view class="photo-loading" wx:if="{{!photoLoaded[index] && !photoError[index]}}">
                    <van-loading size="20px" color="#10b981" />
                  </view>
                  <!-- 加载失败状态 -->
                  <view class="photo-error" wx:if="{{photoError[index]}}">
                    <text class="photo-error-icon">!</text>
                    <text class="photo-error-text">加载失败</text>
                  </view>
                  <!-- 图片 -->
                  <image
                    class="photo-item-inline {{photoLoaded[index] ? 'photo-loaded' : 'photo-hidden'}}"
                    src="{{item}}"
                    mode="aspectFill"
                    bindtap="previewPhoto"
                    binderror="onPhotoError"
                    bindload="onPhotoLoad"
                    data-index="{{index}}"
                  />
                </view>
              </view>
            </view>
          </view>

          <view class="info-row">
            <text class="info-label">报修人</text>
            <text class="info-value">{{workOrder.submitter.name || workOrder.submitter_name || '未知'}}</text>
          </view>

          <!-- 备注 -->
          <view class="remark-row">
            <text class="info-label">备注</text>
            <view class="remark-box {{workOrder.remark ? '' : 'remark-box-empty'}}">
              <text wx:if="{{workOrder.remark}}" class="remark-text">{{workOrder.remark}}</text>
              <text wx:else class="remark-placeholder">暂无备注信息</text>
            </view>
          </view>

          <!-- 使用配件 -->
          <view wx:if="{{workOrder.parts_used && workOrder.parts_used.length > 0}}" class="parts-used-row">
            <text class="info-label">使用配件</text>
            <view class="parts-used-list">
              <view wx:for="{{workOrder.parts_used}}" wx:key="material_id" class="parts-used-item">
                <text class="parts-used-name">{{item.material_name}}</text>
                <text class="parts-used-qty">×{{item.quantity}} {{item.unit || '个'}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 工单进度 Tab -->
    <view class="content-area" wx:if="{{activeTab === 'service'}}">
      <view class="service-content">
        <view class="timeline-page">
          <block wx:for="{{timelineData}}" wx:key="id" wx:for-item="item" wx:for-index="index">
            <timeline-item event="{{item}}" is-last="{{index === timelineData.length - 1}}"></timeline-item>
          </block>
        </view>
      </view>
    </view>

    <!-- 底部操作按钮 (仅在工单信息Tab显示) -->
        <view class="bottom-actions" wx:if="{{activeTab === 'info' && showActions}}">
      <!-- 三个点按钮 -->
      <button
        wx:if="{{showThreeDots}}"
        class="action-button action-button-more"
        bindtap="handleMore"
      >
        <text class="more-icon">⋯</text>
      </button>

      <!-- 修改按钮 - 物业人员 + 已提报状态 -->
      <button
        wx:if="{{showEditBtn}}"
        class="action-button action-button-edit"
        bindtap="handleEdit"
      >
        <text class="action-button-text">修改</text>
      </button>

      <!-- 接单按钮 - 维修员 + 待接单状态 -->
      <button
        wx:if="{{showAcceptBtn}}"
        class="action-button action-button-accept"
        bindtap="handleAcceptOrder"
      >
        <text class="action-button-text">接单</text>
      </button>

      <!-- 确认修复按钮 - 维修员 + 维修中/需重修状态 -->
      <button
        wx:if="{{showConfirmRepairBtn}}"
        class="action-button action-button-success"
        bindtap="handleUpdate"
      >
        <text class="action-button-text">确认修复</text>
      </button>

      <!-- 催维修按钮 - 物业人员 + 维修中/需重修状态 -->
      <button
        wx:if="{{showUrgeRepairBtn}}"
        class="action-button action-button-urge"
        bindtap="handleUrgeRepair"
      >
        <text class="action-button-text">催维修</text>
      </button>

      <!-- 催复核按钮 - 维修员/行政经理 + 已修复状态 -->
      <button
        wx:if="{{showUrgeReviewBtn}}"
        class="action-button action-button-urge"
        bindtap="handleUrgeReview"
      >
        <text class="action-button-text">催复核</text>
      </button>

      <!-- 需返工按钮 - 办美员工(提交者) + 已修复状态 -->
      <button
        wx:if="{{showNeedsReworkInMenu}}"
        class="action-button action-button-rework"
        bindtap="handleReject"
      >
        <text class="action-button-text">需返工</text>
      </button>

      <!-- 已复核按钮 - 办美员工(提交者) + 已修复状态 -->
      <button
        wx:if="{{showReviewedBtn}}"
        class="action-button action-button-reviewed"
        bindtap="handleApprove"
      >
        <text class="action-button-text">已复核</text>
      </button>
    </view>
  </block>

  <!-- Error State -->
  <view class="error-state" wx:if="{{!loading && !workOrder}}">
    <text class="error-text">工单数据加载失败</text>
    <button class="error-btn" bindtap="navigateBack">返回</button>
  </view>

  <!-- 维修完成表单弹窗 -->
  <view class="modal-overlay" wx:if="{{showRepairForm}}" catchtap="cancelRepairForm">
    <view class="modal-container modal-container-simple" catchtap="stopPropagation">
      <view class="modal-body">
        <!-- 使用配件 -->
        <view class="form-group parts-section">
          <view class="parts-section-title">
            <text>使用配件</text>
            <text class="parts-section-hint">（选填）</text>
          </view>
          <view wx:if="{{selectedParts.length > 0}}" class="selected-parts-list">
            <view wx:for="{{selectedParts}}" wx:key="material_id" class="selected-part-row">
              <text class="selected-part-name">{{item.material_name}}</text>
              <view class="qty-stepper">
                <view class="stepper-btn {{item.quantity <= 1 ? 'stepper-btn-disabled' : ''}}"
                      data-index="{{index}}" data-delta="-1" bindtap="onAdjustPartQty">−</view>
                <text class="stepper-num">{{item.quantity}}</text>
                <view class="stepper-btn {{item.quantity >= item.stock ? 'stepper-btn-disabled' : ''}}"
                      data-index="{{index}}" data-delta="1" bindtap="onAdjustPartQty">+</view>
              </view>
              <text class="part-remove" data-index="{{index}}" bindtap="onRemovePart">×</text>
            </view>
          </view>
          <view class="add-part-btn" bindtap="openPartsPicker">
            <van-icon name="plus" size="14px" color="#10b981" />
            <text>添加配件</text>
          </view>
        </view>

        <!-- 完成描述 -->
        <view class="form-group">
          <view class="parts-section-title">
            <text>完成描述</text>
            <text class="parts-section-hint">（选填）</text>
          </view>
          <textarea
            class="form-textarea rework-textarea"
            placeholder="请填写完成描述"
            placeholder-class="rework-placeholder"
            value="{{completionNotes}}"
            bindinput="onNotesInput"
            maxlength="50"
            style="height: 170rpx;"
          />
          <view class="form-hint rework-hint">{{completionNotes.length}}/50</view>
        </view>
      </view>

      <view class="modal-footer">
        <button class="modal-btn cancel" bindtap="cancelRepairForm">取消</button>
        <button
          class="modal-btn modal-btn-success"
          bindtap="submitRepairCompletion"
          disabled="{{submittingRepair}}"
        >
          {{submittingRepair ? '提交中...' : '确认提交'}}
        </button>
      </view>
    </view>
  </view>

  <!-- 配件选择器弹层 -->
  <view class="modal-overlay" wx:if="{{showPartsPicker}}" catchtap="closePartsPicker">
    <view class="parts-picker-drawer" catchtap="stopPropagation">
      <view class="parts-picker-header">
        <text class="parts-picker-title">选择配件</text>
        <text class="parts-picker-close" bindtap="closePartsPicker">×</text>
      </view>
      <view class="parts-picker-search">
        <van-icon name="search" size="14px" color="#a3a3a3" />
        <input
          class="parts-picker-input"
          placeholder="搜索配件名称"
          placeholder-class="parts-picker-placeholder"
          value="{{partsSearchKey}}"
          bindinput="onPartsSearchInput"
        />
      </view>
      <scroll-view scroll-y class="parts-picker-list">
        <view wx:if="{{partsLoading}}" class="parts-picker-loading">加载中...</view>
        <view wx:elif="{{filteredParts.length === 0}}" class="parts-picker-empty">
          <van-icon name="search" size="40px" color="#d4d4d4" />
          <text class="parts-picker-empty-text">{{partsSearchKey ? '没有匹配的配件' : '暂无配件'}}</text>
        </view>
        <block wx:else>
          <view
            wx:for="{{filteredParts}}"
            wx:key="_id"
            class="parts-picker-item {{item.stock <= 0 ? 'parts-picker-item-disabled' : ''}}"
            data-part="{{item}}"
            bindtap="onPickPart"
          >
            <view class="parts-picker-info">
              <text class="parts-picker-name">{{item.name}}</text>
              <text class="parts-picker-meta">规格 {{item.spec || '-'}} · 型号 {{item.model || '-'}}</text>
            </view>
            <text wx:if="{{item._added}}" class="parts-picker-added">已添加</text>
            <text wx:else class="parts-picker-stock {{item.stock <= 0 ? 'stock-out' : ''}}">库存 {{item.stock}}</text>
          </view>
        </block>
      </scroll-view>
    </view>
  </view>

  <!-- 需返工表单弹窗 -->
  <view class="modal-overlay" wx:if="{{showReviewForm}}" catchtap="cancelReviewForm">
    <view class="modal-container modal-container-simple" catchtap="stopPropagation">
      <view class="modal-body">

        
        <!-- 需返工原因（必填） -->
        <view class="form-group">
          <textarea
            class="form-textarea rework-textarea"
            placeholder="请输入返工原因（必填）"
            placeholder-class="rework-placeholder"
            value="{{reviewNotes}}"
            bindinput="onReviewNotesInput"
            maxlength="50"
            style="height: 170rpx;"
          />
          <view class="form-hint rework-hint">{{reviewNotes.length}}/50</view>
        </view>
      </view>

      <view class="modal-footer">
        <button class="modal-btn cancel" bindtap="cancelReviewForm">取消</button>
        <button
          class="modal-btn modal-btn-rework"
          bindtap="submitReview"
          disabled="{{submittingReview}}"
        >
          {{submittingReview ? '提交中...' : '确认返工'}}
        </button>
      </view>
    </view>
  </view>

  <!-- 更多操作弹窗 - 底部抽屉 -->
  <view wx:if="{{showMoreActions}}" class="modal-overlay" catchtap="closeMoreActions">
    <view class="more-actions-drawer" catchtap="stopPropagation">
      <!-- 催接单按钮 - 经理或提交者 + 已提报状态 -->
      <view wx:if="{{showUrgeAcceptInMenu}}" class="drawer-action-item urge-action" catchtap="handleUrgeAccept">
        <view class="icon-wrapper">
          <van-icon name="bell" size="28px" color="#10b981" />
        </view>
        <text class="action-label">催接单</text>
      </view>
      <!-- 转收费工单按钮 - 经理/办美员工 + 已提报(待维修)状态 -->
      <view wx:if="{{showTransferToChargeBtn}}" class="drawer-action-item" catchtap="handleTransferToCharge">
        <view class="icon-wrapper">
          <van-icon name="gold-coin-o" size="28px" color="#f59e0b" />
        </view>
        <text class="action-label">转收费工单</text>
      </view>
      <!-- 删除按钮 - 物业人员可见 -->
      <view wx:if="{{showDeleteInMenu}}" class="drawer-action-item delete-action" catchtap="handleDelete">
        <view class="icon-wrapper">
          <text class="iconfont icon-shanchu1"></text>
        </view>
        <text class="action-label">删除</text>
      </view>
      <!-- 分享按钮 -->
      <view class="drawer-action-item share-action">
        <button class="hidden-share-btn" open-type="share"></button>
        <view class="icon-wrapper">
          <van-icon name="share-o" size="32px" color="#10b981" />
        </view>
        <text class="action-label">分享</text>
      </view>
    </view>
  </view>

  <!-- 切换状态弹窗 (保留颜色圆点) -->
  <view wx:if="{{showStatusPicker}}" class="modal-overlay" catchtap="closeStatusPicker">
    <view class="modal-content selector-modal" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">请选择工单状态</text>
        <view class="modal-close" catchtap="closeStatusPicker">
          <text class="iconfont icon-close">×</text>
        </view>
      </view>

      <scroll-view scroll-y class="selector-scroll">
        <view
          wx:for="{{availableStatuses}}"
          wx:key="value"
          class="selector-item status-item {{selectedStatus === item.value ? 'active' : ''}}"
          catchtap="selectStatus"
          data-status="{{item.value}}"
        >
          <view class="status-with-dot">
            <view class="status-color-dot" style="background-color: {{item.color}};"></view>
            <text class="selector-item-text">{{item.label}}</text>
          </view>
          <view wx:if="{{selectedStatus === item.value}}" class="selector-check"></view>
        </view>
      </scroll-view>
    </view>
  </view>
</view>

