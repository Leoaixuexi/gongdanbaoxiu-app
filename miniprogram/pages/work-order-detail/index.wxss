/* 工单详情页面 (基于 Taro 设计) */

.order-detail-container {
  min-height: 100vh;
  background-color: #F7F8FA;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  width: 100%;
  overflow-x: hidden;
}

/* ==================== Loading State ==================== */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 80vh;
}

.weui-loadmore {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.weui-loading {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(12, 167, 125, 0.2);
  border-top-color: #10b981;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.weui-loadmore__tips {
  font-size: 28rpx;
  color: #9CA3AF;
}

/* ==================== Header ==================== */
.header {
  background: linear-gradient(to right, #10b981, #14b8a6);
  padding: 32rpx 32rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

/* ==================== Tab Navigation (Modern Text Style) ==================== */
.tab-nav {
  position: sticky;
  top: 0;
  z-index: 50;
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 0 40rpx 0 40rpx;
  margin: 0 0 4rpx 0;
  background-color: transparent; /* Seamless blend */
  border: none;
  border-radius: 0;
  box-shadow: none;
}

.tab-item {
  position: relative;
  padding: 16rpx 32rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  background: transparent;
}

.tab-item:first-child.tab-item-active,
.tab-item:last-child.tab-item-active {
  background: transparent;
  border-radius: 0;
}

.tab-item:active {
  transform: scale(0.98);
  opacity: 1;
}

.tab-text {
  font-size: 30rpx;
  font-weight: 500;
  color: #9CA3AF; /* Gray for inactive */
  transition: all 0.3s;
}

.tab-item-active .tab-text,
.tab-text-active {
  color: #374151; /* Softer dark gray */
  font-weight: 600; /* Reduced weight */
  font-size: 32rpx; /* Slightly larger */
  transform: scale(1.05);
}

/* Custom indicator removed to match Data page style (text only) 
   or we can keep a very subtle dot if needed, but per request implies matching exactly.
   Data page has active-indicator display: none.
*/
.tab-indicator {
  display: none;
}

.tab-item-active::after {
  content: none;
}


/* ==================== Content Area ==================== */
.content-area {
  box-sizing: border-box;
  width: 100%;
}

/* ==================== Info Content ==================== */
.info-content {
  width: 100%;
  box-sizing: border-box;
  padding: 16rpx 40rpx 40rpx 40rpx;
  padding-bottom: 220rpx;
}

.info-card {
  background-color: white;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  box-sizing: border-box;
  width: 100%;
  border: 1rpx solid rgba(0, 0, 0, 0.04);
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid #E5E7EB;
  transition: background-color 0.2s;
  box-sizing: border-box;
  width: 100%;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #6B7280;
  flex-shrink: 0;
  min-width: 130rpx;
  margin-right: 20rpx;
  letter-spacing: 0.5rpx;
}

.info-value {
  font-size: 28rpx;
  color: #4B5563;
  font-weight: 600;
  text-align: right;
  line-height: 1.6;
  flex: 1;
  word-wrap: break-word;
  word-break: break-word;
}

/* 分隔线 */
.info-divider {
  height: 1rpx;
  background-color: #E5E7EB;
  margin: 16rpx 32rpx;
}

/* 照片行特殊样式 */
.info-row-photos {
  flex-direction: column;
  align-items: flex-start;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #F9FAFB;
}

.info-value-photos {
  max-width: 100%;
  width: 100%;
  text-align: right;
}

/* 日期时间显示 */
.info-value-datetime {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 8rpx;
}

.datetime-date {
  font-size: 28rpx;
  color: #4B5563;
  font-weight: 600;
}

.datetime-time {
  font-size: 28rpx;
  color: #4B5563;
  font-weight: 600;
}

/* 内联照片网格 */
.photo-grid-inline {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  width: 100%;
  justify-content: flex-end;
}

.photo-item-inline {
  width: 120rpx;
  height: 120rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background-color: #F3F4F6;
  flex-shrink: 0;
}

.info-badge {
  background-color: #FFF7ED;
  border: 1rpx solid #FED7AA;
  border-radius: 24rpx;
  padding: 4rpx 16rpx;
}

.badge-text {
  font-size: 22rpx;
  color: #EA580C;
  font-weight: 500;
}

/* 备注模块 */
.remark-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  border-bottom: 1rpx solid #F9FAFB;
  box-sizing: border-box;
  width: 100%;
  gap: 24rpx;
}

.remark-label {
  font-size: 28rpx;
  color: #6B7280;
  min-width: 130rpx;
  flex-shrink: 0;
  margin-right: 24rpx;
  letter-spacing: 0.5rpx;
}

.remark-box {
  background-color: #F9FAFB;
  border: 1rpx solid #E5E7EB;
  border-radius: 24rpx;
  padding: 24rpx;
  min-height: 120rpx;
  line-height: 1.6;
  flex: 1;
  width: calc(100% + 40px);
  margin-right: -40px;
}

.remark-box-empty {
  border-style: dashed;
  color: #9CA3AF;
}

.remark-text {
  font-size: 28rpx;
  color: #4B5563;
  white-space: pre-wrap;
  word-break: break-word;
  font-weight: 500;
}

.remark-placeholder {
  font-size: 28rpx;
  color: #9CA3AF;
}

/* ==================== Photo Section ==================== */
.photo-section {
  background-color: white;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-top: 32rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2937;
  margin-bottom: 32rpx;
}

.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.photo-item {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 24rpx;
  overflow: hidden;
  background-color: #F3F4F6;
  transition: all 0.2s;
}

.photo-item:active {
  transform: scale(0.95);
}

/* ==================== Service Content ==================== */
.service-content {
  width: 100%;
  padding: 0;
}

.timeline-page {
  padding: 32rpx;
}

.timeline {
  position: relative;
  padding: 0;
}

.timeline-item {
  margin-bottom: 0;
  padding: 0;
  background-color: transparent;
}

.timeline-dot-wrapper {
  position: relative;
  flex-shrink: 0;
  padding-top: 8rpx;
}

.timeline-dot {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background-color: #10b981;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 10;
  box-shadow: 0 0 0 8rpx rgba(12, 167, 125, 0.15);
}

.timeline-dot-inner {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: white;
}

.timeline-line {
  position: absolute;
  left: 50%;
  top: 48rpx;
  transform: translateX(-50%);
  width: 2rpx;
  height: calc(100% + 32rpx);
  background-color: transparent;
  border-left: 2rpx dashed #E5E7EB;
}

.timeline-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.timeline-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.timeline-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2937;
  line-height: 1.4;
}

.timeline-user {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.user-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: #E5E7EB;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-text {
  font-size: 24rpx;
  color: #6B7280;
  font-weight: 500;
}

.user-name {
  font-size: 28rpx;
  color: #6B7280;
  font-weight: 400;
}

.timeline-notes {
  font-size: 28rpx;
  color: #6B7280;
  line-height: 1.6;
  display: block;
}

.timeline-time {
  font-size: 24rpx;
  color: #9CA3AF;
  font-weight: 400;
  display: block;
}

/* ==================== Bottom Actions ==================== */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(40rpx);
  border-top: 1rpx solid rgba(0, 0, 0, 0.08);
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.08);
  padding: 32rpx;
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
}

.action-button {
  flex: 0 0 auto;
  height: 96rpx;
  border-radius: 24rpx;
  border: none;
  font-size: 32rpx;
  font-weight: 500;
  transition: all 0.2s;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 16rpx rgba(12, 167, 125, 0.2);
  padding: 0 48rpx;
}

.action-button:active {
  transform: scale(0.96);
}

.action-button-more {
  flex: 0 0 110rpx;
  width: 110rpx;
  height: 110rpx;
  padding: 0;
  background: #F3F4F6;
  color: #6B7280;
  box-shadow: none;
  border-radius: 50%;
  align-self: center;
  transform: translateY(-10rpx);
}

.more-icon {
  font-size: 48rpx;
  font-weight: bold;
  color: #6B7280;
  line-height: 1;
}

.action-button-edit {
  background: linear-gradient(to right, #10b981, #14b8a6);
  color: white;
  box-shadow: 0 8rpx 16rpx rgba(12, 167, 125, 0.2);
  min-width: 500rpx;
}

.action-button-accept {
  background: linear-gradient(to right, #3b82f6, #2563eb);
  color: white;
  box-shadow: 0 8rpx 16rpx rgba(59, 130, 246, 0.25);
  min-width: 500rpx;
}

.action-button-primary {
  background: linear-gradient(to right, #10b981, #14b8a6);
  color: white;
}

.action-button-success {
  background: linear-gradient(to right, #10b981, #14b8a6);
  color: white;
  box-shadow: 0 8rpx 16rpx rgba(12, 167, 125, 0.2);
  min-width: 500rpx;
}

.action-button-approve {
  background: linear-gradient(135deg, #34C759 0%, #30D158 100%);
  color: white;
  box-shadow: 0 4rpx 12rpx rgba(52, 199, 89, 0.3);
}

.action-button-reject {
  background: linear-gradient(135deg, #FF3B30 0%, #FF453A 100%);
  color: white;
  box-shadow: 0 4rpx 12rpx rgba(255, 59, 48, 0.3);
}

/* 已复核按钮 - 与修改按钮渐变色一致 */
.action-button-reviewed {
  background: linear-gradient(to right, #10b981, #14b8a6);
  color: white;
  box-shadow: 0 8rpx 16rpx rgba(12, 167, 125, 0.2);
}

/* 需返工按钮 - 橙色渐变 */
.action-button-rework {
  background: linear-gradient(to right, #f97316, #ea580c);
  color: white;
  box-shadow: 0 8rpx 16rpx rgba(249, 115, 22, 0.2);
  padding: 0 32rpx;
  max-width: 220rpx;
}

/* 催维修/催复核按钮 - 橙色风格 */
.action-button-urge {
  background: linear-gradient(to right, #f97316, #ea580c);
  color: white;
  box-shadow: 0 8rpx 16rpx rgba(249, 115, 22, 0.25);
  min-width: 500rpx;
}

.action-button-text {
  color: white;
  font-size: 32rpx;
  font-weight: 500;
}

/* ==================== Error State ==================== */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 80vh;
  padding: 64rpx 32rpx;
}

.error-text {
  font-size: 32rpx;
  color: #9CA3AF;
  margin-bottom: 48rpx;
  text-align: center;
}

.error-btn {
  min-width: 320rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: linear-gradient(to right, #10b981, #14b8a6);
  color: white;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(12, 167, 125, 0.3);
  transition: all 0.2s;
}

.error-btn:active {
  transform: scale(0.96);
}

/* ==================== Modal ==================== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 1000;
  animation: fadeIn 0.25s;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.modal-container {
  width: 100%;
  max-width: 100%;
  max-height: 85vh;
  background-color: white;
  border-radius: 32rpx 32rpx 0 0;
  overflow: hidden;
  animation: slideUpFromBottom 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.2);
}

@keyframes slideUpFromBottom {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

/* 顶部横条 */
.modal-handle {
  width: 80rpx;
  height: 8rpx;
  background-color: #E5E7EB;
  border-radius: 4rpx;
  margin: 16rpx auto 0;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 32rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
  background-color: #ffffff;
  position: relative;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2937;
  text-align: center;
}

.modal-close {
  position: absolute;
  top: 20rpx;
  right: 32rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #CCCCCC;
  background-color: transparent;
  border-radius: 50%;
  transition: all 0.2s;
}

.modal-close:active {
  transform: scale(0.9);
  color: #999999;
}

.modal-body {
  max-height: 70vh;
  overflow-y: auto;
  padding: 0;
  -webkit-overflow-scrolling: touch;
}

.modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 32rpx;
  background-color: transparent;
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  transition: all 0.2s;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-btn:active {
  transform: scale(0.96);
}

.modal-btn.cancel {
  background-color: white;
  color: #6B7280;
  border: 1rpx solid #E5E7EB;
}

.modal-btn.confirm {
  background: linear-gradient(to right, #10b981, #14b8a6);
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(12, 167, 125, 0.3);
}

/* 绿色渐变确认按钮 */
.modal-btn-success {
  background: linear-gradient(to right, #10b981, #14b8a6);
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(12, 167, 125, 0.3);
}

/* 橙色渐变返工按钮 */
.modal-btn-rework {
  background: linear-gradient(to right, #f97316, #ea580c);
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(249, 115, 22, 0.3);
}

/* 简化版弹窗容器 - 无标题栏 */
.modal-container-simple {
  padding-top: 0;
}

.modal-container-simple .modal-body {
  padding-top: 32rpx;
}

.modal-btn.approve {
  background: linear-gradient(135deg, #34C759 0%, #30D158 100%);
  color: white;
  box-shadow: 0 4rpx 12rpx rgba(52, 199, 89, 0.3);
}

.modal-btn.reject {
  background: linear-gradient(135deg, #FF3B30 0%, #FF453A 100%);
  color: white;
  box-shadow: 0 4rpx 12rpx rgba(255, 59, 48, 0.3);
}

.modal-btn:disabled {
  opacity: 0.4;
  pointer-events: none;
}

/* ==================== Form Components ==================== */
.form-group {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 28rpx;
  color: #1F2937;
  font-weight: 600;
  margin-bottom: 16rpx;
  display: block;
}

.form-label.required::after {
  content: '*';
  color: #FF3B30;
  margin-left: 4rpx;
}

.form-picker {
  background-color: #F3F4F6;
  border-radius: 24rpx;
  padding: 24rpx 32rpx;
  transition: all 0.2s;
}

.form-picker:active {
  background-color: #E5E7EB;
}

.picker-value {
  font-size: 32rpx;
  color: #1F2937;
  font-weight: 500;
}

.form-textarea {
  width: 100%;
  min-height: 240rpx;
  padding: 24rpx 32rpx;
  background-color: #F3F4F6;
  border-radius: 24rpx;
  font-size: 32rpx;
  color: #1F2937;
  box-sizing: border-box;
  line-height: 1.6;
  border: none;
}

.form-hint {
  font-size: 24rpx;
  color: #9CA3AF;
  margin-top: 12rpx;
  text-align: right;
}

/* ==================== Photo Uploader ==================== */
.photo-uploader {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.upload-photo-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.upload-photo {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.upload-photo-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 56rpx;
  height: 56rpx;
  background-color: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(20rpx);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 36rpx;
  transition: all 0.2s;
}

.upload-photo-remove:active {
  transform: scale(0.9);
  background-color: rgba(0, 0, 0, 0.8);
}

.upload-btn {
  width: 200rpx;
  height: 200rpx;
  border: 3rpx dashed rgba(12, 167, 125, 0.3);
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: rgba(12, 167, 125, 0.05);
  transition: all 0.2s;
}

.upload-btn:active {
  transform: scale(0.95);
  background-color: rgba(12, 167, 125, 0.1);
  border-color: #10b981;
}

.upload-btn.uploading {
  opacity: 0.5;
  pointer-events: none;
}

.upload-icon {
  font-size: 72rpx;
  margin-bottom: 12rpx;
  color: #10b981;
}

.upload-text {
  font-size: 24rpx;
  color: #9CA3AF;
  font-weight: 500;
}

/* ==================== Review Decision ==================== */
.review-decision {
  padding: 32rpx;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 24rpx;
}

.review-decision.approved {
  background: linear-gradient(135deg, rgba(52, 199, 89, 0.1) 0%, rgba(48, 209, 88, 0.05) 100%);
  color: #34C759;
  border: 2rpx solid rgba(52, 199, 89, 0.3);
}

.review-decision.rejected {
  background: linear-gradient(135deg, rgba(255, 59, 48, 0.1) 0%, rgba(255, 69, 58, 0.05) 100%);
  color: #FF3B30;
  border: 2rpx solid rgba(255, 59, 48, 0.3);
}

/* ==================== Review Warning ==================== */
.review-warning {
  display: flex;
  align-items: flex-start;
  padding: 32rpx;
  background: linear-gradient(135deg, rgba(255, 149, 0, 0.08) 0%, rgba(255, 159, 10, 0.05) 100%);
  border-radius: 24rpx;
  border-left: 6rpx solid #FF9500;
  margin-top: 32rpx;
}

.warning-icon {
  font-size: 48rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.warning-text {
  flex: 1;
  font-size: 28rpx;
  color: #6B7280;
  line-height: 1.6;
}

/* ==================== More Actions Popup ==================== */
.more-actions-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 2000;
  animation: fadeIn 0.25s;
}

.more-actions-content {
  display: flex;
  gap: 32rpx;
  padding: 48rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  background-color: white;
  border-radius: 32rpx 32rpx 0 0;
  width: 100%;
  box-sizing: border-box;
  animation: slideUpFromBottom 0.3s;
}

@keyframes slideUpFromBottom {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.more-action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  background-color: #F3F4F6;
  border-radius: 24rpx;
  padding: 24rpx;
  width: 140rpx;
  height: 140rpx;
  transition: all 0.2s;
}

.more-action-item:active {
  transform: scale(0.95);
  background-color: #E5E7EB;
}

.more-action-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: transparent;
}

.delete-icon {
  background-color: #FEE2E2;
}

.toggle-icon {
  background-color: #D1FAE5;
}

.rework-icon {
  background-color: #FEF3C7;
}

.icon-text {
  font-size: 28rpx;
  color: #10b981;
}

/* 删除图标 - 使用图片 */
.delete-icon-img {
  width: 60rpx;
  height: 60rpx;
}

/* 切换状态图标 - 使用图片 */
.toggle-icon-img {
  width: 80rpx;
  height: 80rpx;
}

.more-action-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #1F2937;
}

/* ==================== Status Picker ==================== */
.status-picker-container {
  width: 100%;
  max-width: 100%;
  border-radius: 32rpx 32rpx 0 0;
}

.status-list {
  display: flex;
  flex-direction: column;
  padding: 0;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.status-option {
  display: flex;
  align-items: center;
  padding: 40rpx 48rpx;
  background-color: #ffffff;
  border-bottom: 1rpx solid #f5f5f5;
  transition: background-color 0.15s;
  position: relative;
}

.status-option:last-child {
  border-bottom: none;
}

.status-option:active {
  background-color: #f5f5f5;
}

.status-option-selected {
  background-color: #f0f9ff;
}

.status-color-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  margin-right: 28rpx;
  flex-shrink: 0;
}

.status-label {
  flex: 1;
  font-size: 34rpx;
  font-weight: 400;
  color: #1F2937;
  letter-spacing: 0rpx;
}

/* ==================== Edit Form Modal ==================== */
.edit-modal-container {
  width: 100%;
  max-width: 100%;
  max-height: 90vh;
  background-color: white;
  border-radius: 32rpx 32rpx 0 0;
  overflow: hidden;
  animation: slideUpFromBottom 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.2);
  display: flex;
  flex-direction: column;
}

.edit-modal-header {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
  background-color: #ffffff;
  position: relative;
  flex-shrink: 0;
}

.edit-modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1F2937;
  text-align: center;
}

.edit-modal-body {
  flex: 1;
  padding: 32rpx;
  overflow-y: auto;
  max-height: 60vh;
}

.edit-form-group {
  margin-bottom: 32rpx;
}

.edit-form-label {
  font-size: 28rpx;
  color: #1F2937;
  font-weight: 600;
  margin-bottom: 16rpx;
  display: block;
}

.edit-form-label.required::before {
  content: '*';
  color: #FF3B30;
  margin-right: 4rpx;
}

.edit-form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background-color: #F3F4F6;
  border-radius: 24rpx;
  font-size: 28rpx;
  color: #1F2937;
  box-sizing: border-box;
}

.edit-form-picker {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background-color: #F3F4F6;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
}

.edit-picker-text {
  font-size: 28rpx;
  color: #1F2937;
}

.edit-picker-text.placeholder {
  color: #9CA3AF;
}

.edit-form-textarea {
  width: 100%;
  min-height: 180rpx;
  padding: 24rpx;
  background-color: #F3F4F6;
  border-radius: 24rpx;
  font-size: 28rpx;
  color: #1F2937;
  box-sizing: border-box;
  line-height: 1.6;
}

.edit-priority-row {
  display: flex;
  gap: 16rpx;
}

.edit-priority-btn {
  flex: 1;
  height: 72rpx;
  background-color: #F3F4F6;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.edit-priority-btn.active-green {
  background-color: #34C759;
  color: white;
}

.edit-priority-btn.active-yellow {
  background-color: #FFCC00;
  color: white;
}

.edit-priority-btn.active-orange {
  background-color: #FF9500;
  color: white;
}

.edit-priority-btn.active-red {
  background-color: #FF3B30;
  color: white;
}

.edit-priority-text {
  font-size: 28rpx;
  font-weight: 500;
}

.edit-photos-row {
  display: flex;
  gap: 16rpx;
}

.edit-photo-box {
  width: 180rpx;
  height: 180rpx;
}

.edit-photo-preview {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
  overflow: hidden;
}

.edit-photo-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.edit-photo-del {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 48rpx;
  height: 48rpx;
  background-color: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(20rpx);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 32rpx;
  transition: all 0.2s;
}

.edit-photo-add {
  width: 100%;
  height: 100%;
  border: 3rpx dashed rgba(12, 167, 125, 0.3);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(12, 167, 125, 0.05);
  transition: all 0.2s;
}

.add-plus {
  font-size: 64rpx;
  color: #10b981;
}

.edit-modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 32rpx;
  border-top: 1rpx solid #F3F4F6;
  background-color: #FAFAFA;
  flex-shrink: 0;
}

.edit-modal-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  transition: all 0.2s;
  display: flex;
  align-items: center;
  justify-content: center;
}

.edit-modal-btn:active {
  transform: scale(0.96);
}

.edit-modal-btn.cancel {
  background-color: #F3F4F6;
  color: #6B7280;
}

.edit-modal-btn.confirm {
  background: linear-gradient(to right, #10b981, #14b8a6);
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(12, 167, 125, 0.3);
}

.edit-modal-btn:disabled {
  opacity: 0.4;
  pointer-events: none;
}

/* ==================== Rework Modal Styles ==================== */
.rework-notice {
  background-color: #FFF7ED;
  padding: 24rpx 32rpx;
  border-radius: 16rpx;
  margin-bottom: 32rpx;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.rework-icon-circle {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background-color: #EA580C;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.rework-notice-text {
  font-size: 26rpx;
  color: #9A3412;
  line-height: 1.5;
  flex: 1;
}

.rework-textarea {
  min-height: 170rpx;
  width: calc(100% - 40rpx);
  margin: 0 auto;
  display: block;
  background-color: #F9FAFB;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.rework-placeholder {
  font-size: 28rpx;
  color: #9CA3AF;
}

.rework-hint {
  margin-right: 24rpx;
}

.rework-textarea:focus {
  background-color: white;
  border-color: #FB923C;
  box-shadow: 0 0 0 4rpx rgba(251, 146, 60, 0.1);
}
