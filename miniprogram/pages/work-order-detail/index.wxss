}

.parts-picker-added {
  font-size: 22rpx;
  color: #10b981;
  font-weight: 500;
  padding: 4rpx 12rpx;
  background: rgba(16, 185, 129, 0.12);
  border-radius: 8rpx;
  flex-shrink: 0;
}

/* ==================== 详情页使用配件区块 ==================== */
.parts-used-row {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
}

.parts-used-list {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding-left: 0;
}

.parts-used-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 20rpx;
  background: #F9FAFB;
  border-radius: 12rpx;
}

.parts-used-name {
  font-size: 26rpx;
  color: #1a1a1a;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.parts-used-qty {
  font-size: 26rpx;
  color: #10b981;
  font-weight: 600;
  flex-shrink: 0;
}

