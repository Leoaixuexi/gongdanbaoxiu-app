  gap: 16rpx;
}

.parts-picker-empty-text {
  font-size: 26rpx;
  color: #a3a3a3;
}

.parts-picker-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 16rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.parts-picker-item:active {
  background: #F9FAFB;
}

.parts-picker-item-disabled {
  opacity: 0.4;
  pointer-events: none;
}

.parts-picker-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  overflow: hidden;
}

.parts-picker-name {
  font-size: 28rpx;
  color: #1a1a1a;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.parts-picker-meta {
  font-size: 22rpx;
  color: #a3a3a3;
}

.parts-picker-stock {
  font-size: 24rpx;
  color: #10b981;
  font-weight: 500;
  flex-shrink: 0;
}

.parts-picker-stock.stock-out {
