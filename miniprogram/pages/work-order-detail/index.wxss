/* 工单详情页面 (基于 Taro 设计) */

.order-detail-container {
  min-height: 100vh;
  background-color: #F7F8FA;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  width: 100%;
  overflow-x: hidden;
}

/* ==================== Loading State ==================== */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 80vh;
}

.weui-loadmore {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.weui-loading {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid rgba(12, 167, 125, 0.2);
  border-top-color: #10b981;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.weui-loadmore__tips {
  font-size: 28rpx;
  color: #9CA3AF;
}

/* ==================== Header ==================== */
.header {
  background: linear-gradient(to right, #10b981, #14b8a6);
  padding: 20rpx 24rpx 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

/* ==================== Tab Navigation (Modern Text Style) ==================== */
.tab-nav {
  position: sticky;
  top: 0;
  z-index: 50;
  display: flex;
  justify-content: space-around;
  align-items: center;
  padding: 0 40rpx 0 40rpx;
  margin: 0 0 4rpx 0;
  background-color: transparent; /* Seamless blend */
  border: none;
  border-radius: 0;
  box-shadow: none;
}

.tab-item {
  display: inline-block;
  padding: 12rpx 16rpx;
  background: transparent;
  position: relative;
  overflow: visible;
}

.tab-item:first-child.tab-item-active,
.tab-item:last-child.tab-item-active {
  background: transparent;
  border-radius: 0;
}

.tab-item:active {
  transform: scale(0.98);
  opacity: 1;
}

.tab-text {
  font-size: 30rpx;
  font-weight: 500;
  color: #9CA3AF;
}

.tab-item-active .tab-text,
.tab-text-active {
  color: #374151;
  font-weight: 600;
}

.tab-item-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 64rpx;
  height: 6rpx;
  background: linear-gradient(to right, #10b981, #14b8a6);
  border-radius: 3rpx;
}


/* ==================== Content Area ==================== */
.content-area {
  box-sizing: border-box;
  width: 100%;
}

/* ==================== Info Content (Apple Grouped Card Style) ==================== */
.info-content {
  width: 100%;
  box-sizing: border-box;
  padding: 24rpx 32rpx;
  padding-bottom: 220rpx;
}

/* 分组标题 */
.section-header {
  display: block;
  font-size: 26rpx;
  color: #999999;
  padding-left: 16rpx;
  margin-bottom: 8rpx;
  margin-top: 4rpx;
}

.info-card {
  background: linear-gradient(165deg, rgba(255,255,255,0.8) 0%, rgba(255,255,255,0.6) 100%);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 24rpx;
  padding: 0 24rpx;
  box-shadow:
    inset 0 2rpx 0 rgba(255,255,255,0.5),
    0 2rpx 4rpx rgba(0,0,0,0.008),
    0 6rpx 14rpx rgba(0,0,0,0.018),
    0 12rpx 24rpx -6rpx rgba(0,0,0,0.02);
  border-top: 1rpx solid rgba(255,255,255,0.95);
  border-left: 1rpx solid rgba(255,255,255,0.6);
  border-right: 1rpx solid rgba(255,255,255,0.6);
  border-bottom: 1rpx solid rgba(0,0,0,0.03);
  width: 100%;
  box-sizing: border-box;
  margin-bottom: 24rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #ECECEC;
  box-sizing: border-box;
  width: 100%;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 30rpx;
  color: #333333;
  flex-shrink: 0;
  min-width: 160rpx; /* 稍微加宽 Label 区域 */
  margin-right: 20rpx;
  font-weight: 400; /* 字体不加粗 */
  line-height: 1.5;
}

.info-value {
  font-size: 30rpx;
  color: #999999;
  font-weight: 400; /* 保持正常粗细，清晰即可 */
  text-align: right;
  line-height: 1.5;
  /* flex: 1;  移除 flex: 1，改为由内容撑开但限制最大宽度 */
  flex-shrink: 1; /* 允许压缩 */
  margin-left: auto; /* 靠右 */
  max-width: 360rpx; /* 限制宽度，约10-12个中文字符宽度，强制换行 */
  word-wrap: break-word;
  word-break: break-all;
}

/* 特殊：状态标签样式 (模仿图中的胶囊) */
.status-pill {
  display: inline-block;
  padding: 4rpx 16rpx;
  background-color: #FFF7ED; /* 浅橙色背景 */
  color: #FF9500;            /* 橙色文字 */
  font-size: 26rpx;
  border-radius: 8rpx;
  line-height: 1.4;
}

/* 分隔线 - 如果需要显式分割，可以用这个，但参考图没有 */
.info-divider {
  display: none;
}

/* 优先级标签 - 复刻提交页按钮样式 */
.priority-tag {
  padding: 4rpx 16rpx; /* 减小内边距 */
  border-radius: 20rpx; /* 调整圆角 */
  font-size: 24rpx;     /* 减小字号 */
  color: white;
  font-weight: 500;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1.4;
  min-width: 64rpx;     /* 减小最小宽度 */
}

/* 绿色渐变 (普通) */
.priority-green {
  background: linear-gradient(135deg, #34C759 0%, #30B753 100%);
  box-shadow: 0 4rpx 10rpx rgba(52, 199, 89, 0.3);
}

/* 红色渐变 (紧急) */
.priority-red {
  background: linear-gradient(135deg, #FF3B30 0%, #E6352B 100%);
  box-shadow: 0 4rpx 10rpx rgba(255, 59, 48, 0.3);
}

/* 照片行特殊样式 */
.info-row-photos {
  flex-direction: column;
  align-items: flex-start;
  gap: 24rpx;
  padding-top: 32rpx;
  margin-top: 12rpx;
  /* border-top: 1rpx solid #F5F5F5; 可选：照片区域上方加一条极淡的线区分 */
}

.info-value-photos {
  max-width: 100%;
  width: 100%;
  text-align: left; /* 照片靠左排列 */
}

/* 日期时间显示 */
.info-value-datetime {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: flex-end;
  gap: 12rpx;
  color: #333333;
}

.datetime-date {
  font-size: 30rpx;
  color: #999999;
}

.datetime-time {
  font-size: 30rpx;
  color: #999999;
}

/* 内联照片网格 */
.photo-grid-inline {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  width: 100%;
  justify-content: flex-end; /* 照片改为靠右，与文字对齐 */
}

.photo-item-wrapper {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background-color: #F3F4F6;
  flex-shrink: 0;
  position: relative;
}

.photo-item-inline {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.photo-hidden {
  opacity: 0;
}

.photo-loaded {
  opacity: 1;
}

/* 图片加载中状态 */
.photo-loading {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #F3F4F6;
}

/* 图片加载失败状态 */
.photo-error {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: #F3F4F6;
}

.photo-error-icon {
  font-size: 32rpx;
  color: #9CA3AF;
  margin-bottom: 4rpx;
}

.photo-error-text {
  font-size: 18rpx;
  color: #9CA3AF;
}

/* 备注模块 */
.remark-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 24rpx 0;
  box-sizing: border-box;
  width: 100%;
}

.remark-box {
  background-color: transparent;
  border: none;
  padding: 0;
  min-height: auto;
  line-height: 1.5;
  flex: 1;
  text-align: right;
}

.remark-box-empty {
  border-style: none;
}

.remark-text {
  font-size: 30rpx;
  color: #333333;
  white-space: pre-wrap;
  word-break: break-word;
  font-weight: 400;
}

.remark-placeholder {
  font-size: 30rpx;
  color: #CCCCCC; /* 浅色占位符 */
}

/* ==================== Photo Section ==================== */
.photo-section {
  background: linear-gradient(165deg, rgba(255,255,255,0.8) 0%, rgba(255,255,255,0.6) 100%);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-top: 32rpx;
  box-shadow:
    inset 0 2rpx 0 rgba(255,255,255,0.5),
    0 2rpx 4rpx rgba(0,0,0,0.008),
    0 6rpx 14rpx rgba(0,0,0,0.018),
    0 12rpx 24rpx -6rpx rgba(0,0,0,0.02);
  border-top: 1rpx solid rgba(255,255,255,0.95);
  border-left: 1rpx solid rgba(255,255,255,0.6);
  border-right: 1rpx solid rgba(255,255,255,0.6);
  border-bottom: 1rpx solid rgba(0,0,0,0.03);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2937;
  margin-bottom: 32rpx;
}

.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.photo-item {
  width: 100%;
  aspect-ratio: 1;
  border-radius: 24rpx;
  overflow: hidden;
  background-color: #F3F4F6;
  transition: all 0.2s;
}

.photo-item:active {
  transform: scale(0.95);
}

/* ==================== Service Content ==================== */
.service-content {
  width: 100%;
  padding: 0;
}

.timeline-page {
  padding: 32rpx;
}

.timeline {
  position: relative;
  padding: 0;
}

.timeline-item {
  margin-bottom: 0;
  padding: 0;
  background-color: transparent;
}

.timeline-dot-wrapper {
  position: relative;
  flex-shrink: 0;
  padding-top: 8rpx;
}

.timeline-dot {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background-color: #10b981;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 10;
  box-shadow: 0 0 0 8rpx rgba(12, 167, 125, 0.15);
}

.timeline-dot-inner {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background-color: white;
}

.timeline-line {
  position: absolute;
  left: 50%;
  top: 48rpx;
  transform: translateX(-50%);
  width: 2rpx;
  height: calc(100% + 32rpx);
  background-color: transparent;
  border-left: 2rpx dashed #E5E7EB;
}

.timeline-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.timeline-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.timeline-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2937;
  line-height: 1.4;
}

.timeline-user {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.user-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background-color: #E5E7EB;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-text {
  font-size: 24rpx;
  color: #6B7280;
  font-weight: 500;
}

.user-name {
  font-size: 28rpx;
  color: #6B7280;
  font-weight: 400;
}

.timeline-notes {
  font-size: 28rpx;
  color: #6B7280;
  line-height: 1.6;
  display: block;
}

.timeline-time {
  font-size: 24rpx;
  color: #9CA3AF;
  font-weight: 400;
  display: block;
}

/* ==================== Bottom Actions ==================== */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(40rpx);
  border-top: 1rpx solid rgba(0, 0, 0, 0.08);
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.08);
  padding: 32rpx;
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
}

.action-button {
  flex: 0 0 auto;
  height: 96rpx;
  border-radius: 24rpx;
  border: none;
  font-size: 32rpx;
  font-weight: 500;
  transition: all 0.2s;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 16rpx rgba(12, 167, 125, 0.2);
  padding: 0 48rpx;
}

.action-button:active {
  transform: scale(0.96);
}

.action-button-more {
  flex: 0 0 110rpx;
  width: 110rpx;
  height: 110rpx;
  padding: 0;
  background: #F3F4F6;
  color: #6B7280;
  box-shadow: none;
  border-radius: 50%;
  align-self: center;
  transform: translateY(-10rpx);
}

.more-icon {
  font-size: 48rpx;
  font-weight: bold;
  color: #6B7280;
  line-height: 1;
}

.action-button-edit {
  background: linear-gradient(to right, #10b981, #14b8a6);
  color: white;
  box-shadow: 0 8rpx 16rpx rgba(12, 167, 125, 0.2);
  min-width: 500rpx;
}

.action-button-accept {
  background: linear-gradient(to right, #F5A623, #F57C00);
  color: white;
  box-shadow: 0 8rpx 16rpx rgba(245, 124, 0, 0.35);
  min-width: 480rpx;
  margin: 0 auto;
}

.action-button-primary {
  background: linear-gradient(to right, #10b981, #14b8a6);
  color: white;
}

.action-button-success {
  background: linear-gradient(to right, #10b981, #14b8a6);
  color: white;
  box-shadow: 0 8rpx 16rpx rgba(12, 167, 125, 0.2);
  min-width: 500rpx;
}

.action-button-approve {
  background: linear-gradient(135deg, #34C759 0%, #30D158 100%);
  color: white;
  box-shadow: 0 4rpx 12rpx rgba(52, 199, 89, 0.3);
}

.action-button-reject {
  background: linear-gradient(135deg, #FF3B30 0%, #FF453A 100%);
  color: white;
  box-shadow: 0 4rpx 12rpx rgba(255, 59, 48, 0.3);
}

/* 已复核按钮 - 与修改按钮渐变色一致 */
.action-button-reviewed {
  background: linear-gradient(to right, #10b981, #14b8a6);
  color: white;
  box-shadow: 0 8rpx 16rpx rgba(12, 167, 125, 0.2);
}

/* 需返工按钮 - 橙色渐变 */
.action-button-rework {
  background: linear-gradient(to right, #F5A623, #F57C00);
  color: white;
  box-shadow: 0 8rpx 16rpx rgba(245, 124, 0, 0.35);
  padding: 0 32rpx;
  max-width: 220rpx;
}

/* 催维修/催复核按钮 - 橙色风格 */
.action-button-urge {
  background: linear-gradient(to right, #f97316, #ea580c);
  color: white;
  box-shadow: 0 8rpx 16rpx rgba(249, 115, 22, 0.25);
  min-width: 500rpx;
}

.action-button-text {
  color: white;
  font-size: 32rpx;
  font-weight: 500;
}

/* ==================== Error State ==================== */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 80vh;
  padding: 64rpx 32rpx;
}

.error-text {
  font-size: 32rpx;
  color: #9CA3AF;
  margin-bottom: 48rpx;
  text-align: center;
}

.error-btn {
  min-width: 320rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: linear-gradient(to right, #10b981, #14b8a6);
  color: white;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(12, 167, 125, 0.3);
  transition: all 0.2s;
}

.error-btn:active {
  transform: scale(0.96);
}

/* ==================== Modal (标准弹窗样式) ==================== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal-content {
  width: 100%;
  background-color: white;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  animation: slide-up 0.3s ease-out;
}

@keyframes slide-up {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 48rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 500;
  color: #333;
}

.selector-modal {
  display: flex;
  flex-direction: column;
  max-height: 80vh;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.modal-close {
  position: absolute;
  right: 32rpx;
  top: 32rpx;
  padding: 10rpx;
  line-height: 1;
}

.icon-close {
  font-size: 40rpx;
  color: #999;
  font-weight: 300;
}

.selector-scroll {
  width: 100%;
  max-height: 60vh;
  margin-top: 20rpx;
}

.selector-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 16rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.selector-item:active {
  background-color: #F9F9F9;
}

.selector-item:last-child {
  border-bottom: none;
}

.selector-item-text {
  font-size: 32rpx;
  color: #333;
}

.selector-item.active .selector-item-text {
  color: #0CA77D;
  font-weight: 500;
}

.selector-check {
  width: 32rpx;
  height: 16rpx;
  border-left: 4rpx solid #0CA77D;
  border-bottom: 4rpx solid #0CA77D;
  transform: rotate(-45deg) translateY(-4rpx);
}

/* 弹窗容器基础样式 */
.modal-container {
  width: 100%;
  background-color: white;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 弹窗底部按钮区域 */
.modal-footer {
  display: flex;
  padding: 24rpx 0 0 0;
  border-top: 1rpx solid #F3F4F6;
  gap: 24rpx;
  margin-top: 16rpx;
}

/* 弹窗按钮基础样式 */
.modal-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: 500;
}

.modal-btn.cancel {
  background-color: white;
  color: #6B7280;
  border: 1rpx solid #E5E7EB;
}

.modal-btn.confirm {
  background: linear-gradient(to right, #10b981, #14b8a6);
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(12, 167, 125, 0.3);
}

/* 绿色渐变确认按钮 */
.modal-btn-success {
  background: linear-gradient(to right, #10b981, #14b8a6);
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(12, 167, 125, 0.3);
}

/* 橙色渐变返工按钮 */
.modal-btn-rework {
  background: linear-gradient(to right, #f97316, #ea580c);
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(249, 115, 22, 0.3);
}

/* 简化版弹窗容器 - 无标题栏 */
.modal-container-simple {
  padding-top: 0;
}

.modal-container-simple .modal-body {
  padding-top: 32rpx;
}

.modal-btn.approve {
  background: linear-gradient(135deg, #34C759 0%, #30D158 100%);
  color: white;
  box-shadow: 0 4rpx 12rpx rgba(52, 199, 89, 0.3);
}

.modal-btn.reject {
  background: linear-gradient(135deg, #FF3B30 0%, #FF453A 100%);
  color: white;
  box-shadow: 0 4rpx 12rpx rgba(255, 59, 48, 0.3);
}

.modal-btn:disabled {
  opacity: 0.4;
  pointer-events: none;
}

/* ==================== Form Components ==================== */
.form-group {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 28rpx;
  color: #1F2937;
  font-weight: 600;
  margin-bottom: 16rpx;
  display: block;
}

.form-label.required::after {
  content: '*';
  color: #FF3B30;
  margin-left: 4rpx;
}

.form-picker {
  background-color: #F3F4F6;
  border-radius: 24rpx;
  padding: 24rpx 32rpx;
  transition: all 0.2s;
}

.form-picker:active {
  background-color: #E5E7EB;
}

.picker-value {
  font-size: 32rpx;
  color: #1F2937;
  font-weight: 500;
}

.form-textarea {
  width: 100%;
  min-height: 240rpx;
  padding: 24rpx 32rpx;
  background-color: #F3F4F6;
  border-radius: 24rpx;
  font-size: 32rpx;
  color: #1F2937;
  box-sizing: border-box;
  line-height: 1.6;
  border: none;
}

.form-hint {
  font-size: 24rpx;
  color: #9CA3AF;
  margin-top: 12rpx;
  text-align: right;
}

/* ==================== Photo Uploader ==================== */
.photo-uploader {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.upload-photo-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.upload-photo {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.upload-photo-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 56rpx;
  height: 56rpx;
  background-color: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(20rpx);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 36rpx;
  transition: all 0.2s;
}

.upload-photo-remove:active {
  transform: scale(0.9);
  background-color: rgba(0, 0, 0, 0.8);
}

.upload-btn {
  width: 200rpx;
  height: 200rpx;
  border: 3rpx dashed rgba(12, 167, 125, 0.3);
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: rgba(12, 167, 125, 0.05);
  transition: all 0.2s;
}

.upload-btn:active {
  transform: scale(0.95);
  background-color: rgba(12, 167, 125, 0.1);
  border-color: #10b981;
}

.upload-btn.uploading {
  opacity: 0.5;
  pointer-events: none;
}

.upload-icon {
  font-size: 72rpx;
  margin-bottom: 12rpx;
  color: #10b981;
}

.upload-text {
  font-size: 24rpx;
  color: #9CA3AF;
  font-weight: 500;
}

/* ==================== Review Decision ==================== */
.review-decision {
  padding: 32rpx;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  margin-bottom: 24rpx;
}

.review-decision.approved {
  background: linear-gradient(135deg, rgba(52, 199, 89, 0.1) 0%, rgba(48, 209, 88, 0.05) 100%);
  color: #34C759;
  border: 2rpx solid rgba(52, 199, 89, 0.3);
}

.review-decision.rejected {
  background: linear-gradient(135deg, rgba(255, 59, 48, 0.1) 0%, rgba(255, 69, 58, 0.05) 100%);
  color: #FF3B30;
  border: 2rpx solid rgba(255, 59, 48, 0.3);
}

/* ==================== Review Warning ==================== */
.review-warning {
  display: flex;
  align-items: flex-start;
  padding: 32rpx;
  background: linear-gradient(135deg, rgba(255, 149, 0, 0.08) 0%, rgba(255, 159, 10, 0.05) 100%);
  border-radius: 24rpx;
  border-left: 6rpx solid #FF9500;
  margin-top: 32rpx;
}

.warning-icon {
  font-size: 48rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.warning-text {
  flex: 1;
  font-size: 28rpx;
  color: #6B7280;
  line-height: 1.6;
}

/* ==================== 特殊样式: 删除和空状态 ==================== */
.delete-text {
  color: #EF4444 !important;
}

.empty-text {
  color: #999 !important;
  text-align: center;
}

/* ==================== 特殊样式: 工单状态选择器(保留颜色圆点) ==================== */
.status-item .status-with-dot {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.status-color-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

/* ==================== Edit Form Modal ==================== */
.edit-modal-container {
  width: 100%;
  max-width: 100%;
  max-height: 90vh;
  background-color: white;
  border-radius: 32rpx 32rpx 0 0;
  overflow: hidden;
  animation: slideUpFromBottom 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.2);
  display: flex;
  flex-direction: column;
}

.edit-modal-header {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  border-bottom: 1rpx solid #f5f5f5;
  background-color: #ffffff;
  position: relative;
  flex-shrink: 0;
}

.edit-modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1F2937;
  text-align: center;
}

.edit-modal-body {
  flex: 1;
  padding: 32rpx;
  overflow-y: auto;
  max-height: 60vh;
}

.edit-form-group {
  margin-bottom: 32rpx;
}

.edit-form-label {
  font-size: 28rpx;
  color: #1F2937;
  font-weight: 600;
  margin-bottom: 16rpx;
  display: block;
}

.edit-form-label.required::before {
  content: '*';
  color: #FF3B30;
  margin-right: 4rpx;
}

.edit-form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background-color: #F3F4F6;
  border-radius: 24rpx;
  font-size: 28rpx;
  color: #1F2937;
  box-sizing: border-box;
}

.edit-form-picker {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background-color: #F3F4F6;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
}

.edit-picker-text {
  font-size: 28rpx;
  color: #1F2937;
}

.edit-picker-text.placeholder {
  color: #9CA3AF;
}

.edit-form-textarea {
  width: 100%;
  min-height: 180rpx;
  padding: 24rpx;
  background-color: #F3F4F6;
  border-radius: 24rpx;
  font-size: 28rpx;
  color: #1F2937;
  box-sizing: border-box;
  line-height: 1.6;
}

.edit-priority-row {
  display: flex;
  gap: 16rpx;
}

.edit-priority-btn {
  flex: 1;
  height: 72rpx;
  background-color: #F3F4F6;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;
}

.edit-priority-btn.active-green {
  background-color: #34C759;
  color: white;
}

.edit-priority-btn.active-yellow {
  background-color: #FFCC00;
  color: white;
}

.edit-priority-btn.active-orange {
  background-color: #FF9500;
  color: white;
}

.edit-priority-btn.active-red {
  background-color: #FF3B30;
  color: white;
}

.edit-priority-text {
  font-size: 28rpx;
  font-weight: 500;
}

.edit-photos-row {
  display: flex;
  gap: 16rpx;
}

.edit-photo-box {
  width: 180rpx;
  height: 180rpx;
}

.edit-photo-preview {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
  overflow: hidden;
}

.edit-photo-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.edit-photo-del {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 48rpx;
  height: 48rpx;
  background-color: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(20rpx);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 32rpx;
  transition: all 0.2s;
}

.edit-photo-add {
  width: 100%;
  height: 100%;
  border: 3rpx dashed rgba(12, 167, 125, 0.3);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: rgba(12, 167, 125, 0.05);
  transition: all 0.2s;
}

.add-plus {
  font-size: 64rpx;
  color: #10b981;
}

.edit-modal-footer {
  display: flex;
  gap: 16rpx;
  padding: 32rpx;
  border-top: 1rpx solid #F3F4F6;
  background-color: #FAFAFA;
  flex-shrink: 0;
}

.edit-modal-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 24rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  transition: all 0.2s;
  display: flex;
  align-items: center;
  justify-content: center;
}

.edit-modal-btn:active {
  transform: scale(0.96);
}

.edit-modal-btn.cancel {
  background-color: #F3F4F6;
  color: #6B7280;
}

.edit-modal-btn.confirm {
  background: linear-gradient(to right, #10b981, #14b8a6);
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(12, 167, 125, 0.3);
}

.edit-modal-btn:disabled {
  opacity: 0.4;
  pointer-events: none;
}

/* ==================== Rework Modal Styles ==================== */
.rework-notice {
  background-color: #FFF7ED;
  padding: 24rpx 32rpx;
  border-radius: 16rpx;
  margin-bottom: 32rpx;
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.rework-icon-circle {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background-color: #EA580C;
  color: white;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.rework-notice-text {
  font-size: 26rpx;
  color: #9A3412;
  line-height: 1.5;
  flex: 1;
}

.rework-textarea {
  min-height: 170rpx;
  width: calc(100% - 40rpx);
  margin: 0 auto;
  display: block;
  background-color: #F9FAFB;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.rework-placeholder {
  font-size: 28rpx;
  color: #9CA3AF;
}

.rework-hint {
  margin-right: 24rpx;
}

.rework-textarea:focus {
  background-color: white;
  border-color: #FB923C;
  box-shadow: 0 0 0 4rpx rgba(251, 146, 60, 0.1);
}

/* ==================== 更多操作抽屉（底部弹出） ==================== */
.more-actions-drawer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: white;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  animation: slideUp 0.3s ease-out;
  display: flex;
  justify-content: flex-start;
  align-items: flex-start;
  gap: 24rpx;
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.drawer-action-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
  transition: all 0.2s;
}

.drawer-action-item .icon-wrapper {
  width: 100rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #F5F5F5;
  border: 2rpx solid #E5E5E5;
  border-radius: 16rpx;
  line-height: 1;
}

/* 修复 van-icon 对齐 */
.drawer-action-item .icon-wrapper van-icon {
  display: flex;
  align-items: center;
  justify-content: center;
}

.drawer-action-item .icon-wrapper:active {
  background-color: #EBEBEB;
}

.drawer-action-item.delete-action .icon-wrapper {
  color: transparent;
}

/* 删除按钮 iconfont - 绿色渐变 */
.drawer-action-item.delete-action .icon-wrapper .iconfont {
  background: linear-gradient(to right, #10b981, #14b8a6);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.drawer-action-item .iconfont {
  font-size: 52rpx;
}

.drawer-action-item .action-label {
  font-size: 24rpx;
  color: #333;
  margin-top: 12rpx;
}

.drawer-action-item.empty-action {
  color: #999;
}

.drawer-action-item .empty-text {
  font-size: 32rpx;
  color: #999;
}

/* 分享按钮样式 */
.drawer-action-item.share-action {
  position: relative;
}

/* 防止子元素拦截点击 */
.drawer-action-item.share-action .icon-wrapper,
.drawer-action-item.share-action .action-label {
  pointer-events: none;
}

.hidden-share-btn {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  margin: 0 !important;
  padding: 0 !important;
  border: none !important;
  background: transparent !important;
  z-index: 999 !important;
  line-height: normal;
  pointer-events: auto;
}

.hidden-share-btn::after {
  border: none !important;
  display: none !important;
  content: none !important;
}

/* 点击反馈 - 让用户知道点击生效了 */
.drawer-action-item.share-action:active .icon-wrapper {
  transform: scale(0.95);
  background-color: #E0F2FE;
  transition: all 0.1s;
}

.empty-action {
  color: #999;
}

.empty-action .empty-text {
  font-size: 24rpx;
}

/* ==================== 使用配件（维修完成弹窗内） ==================== */
.parts-section {
  margin-top: 24rpx;
}

.parts-section-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #1a1a1a;
  margin-bottom: 16rpx;
}

.parts-section-hint {
  font-size: 24rpx;
  color: #a3a3a3;
  font-weight: 400;
  margin-left: 8rpx;
}

.selected-parts-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.selected-part-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 20rpx;
  background: #F9FAFB;
  border-radius: 16rpx;
}

.selected-part-name {
  flex: 1;
  font-size: 28rpx;
  color: #1a1a1a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.qty-stepper {
  display: flex;
  align-items: center;
  background: white;
  border-radius: 8rpx;
  border: 1rpx solid #E5E7EB;
}

.stepper-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #10b981;
}

.stepper-btn-disabled {
  color: #D1D5DB;
}

.stepper-num {
  min-width: 48rpx;
  text-align: center;
  font-size: 28rpx;
  color: #1a1a1a;
  font-weight: 500;
}

.part-remove {
  font-size: 32rpx;
  color: #9CA3AF;
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
}

.add-part-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 18rpx 0;
  border: 2rpx dashed rgba(16, 185, 129, 0.4);
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #10b981;
  font-weight: 500;
}

.add-part-btn:active {
  opacity: 0.7;
}

/* ==================== 配件选择器抽屉 ==================== */
.parts-picker-drawer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  max-height: 75vh;
  background: white;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  animation: slideUp 0.3s ease-out;
  display: flex;
  flex-direction: column;
}

.parts-picker-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.parts-picker-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.parts-picker-close {
  font-size: 44rpx;
  color: #9CA3AF;
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
}

.parts-picker-search {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 24rpx;
  background: #F3F4F6;
  border-radius: 28rpx;
  margin-bottom: 20rpx;
}

.parts-picker-input {
  flex: 1;
  font-size: 26rpx;
  color: #1a1a1a;
}

.parts-picker-placeholder {
  color: #9CA3AF;
}

.parts-picker-list {
  flex: 1;
  max-height: 50vh;
}

.parts-picker-loading {
  text-align: center;
  padding: 40rpx;
  color: #9CA3AF;
  font-size: 26rpx;
}

.parts-picker-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
