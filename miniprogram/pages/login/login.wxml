<view class="page">
  <!-- 顶部区域 -->
  <view class="top-area">
    <!-- 光斑效果 -->
    <view class="blob blob-a"></view>
    <view class="blob blob-b"></view>
    <!-- 右上角装饰图 -->
    <image class="top-image" src="/images/icons/Image1.png" mode="aspectFit"></image>
    <!-- 标题 -->
    <view class="title">欢迎使用\n小物业工单管理</view>
  </view>

  <!-- 内容区域 -->
  <view class="content">
    <view class="login-card">
      <!-- 用户名输入 -->
      <view class="field">
        <view class="label">用户名/手机号</view>
        <input class="input" type="text" placeholder="请输入用户名或手机号" placeholder-class="placeholder" value="{{username}}" bindinput="onUsernameInput" />
        <view class="line"></view>
      </view>

      <!-- 密码输入 -->
      <view class="field password-field">
        <view class="label">密码</view>
        <input class="input" type="password" placeholder="请输入您的密码" placeholder-class="placeholder" value="{{password}}" bindinput="onPasswordInput" password="true" />
        <view class="line"></view>
        <text class="forget" bindtap="onForget">忘记密码?</text>
      </view>

      <!-- 登录按钮 -->
      <view class="btn-wrap">
        <view class="btn" bindtap="onLogin">
          <view class="btn-bg"></view>
          <view class="btn-text">登 录</view>
        </view>
      </view>

      <!-- 协议勾选 -->
      <view class="agreement">
        <view class="checkbox {{agreed ? 'checked' : ''}}" bindtap="toggleAgree">
          <view wx:if="{{agreed}}" class="check-icon">✓</view>
        </view>
        <view class="agreement-text">
          <text>我已阅读并同意</text>
          <text class="link" bindtap="openUserAgreement">《用户服务协议》</text>
          <text>和</text>
          <text class="link" bindtap="openPrivacyAgreement">《隐私政策》</text>
        </view>
      </view>
    </view>
  </view>

</view>
