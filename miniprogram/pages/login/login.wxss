/* 容器 - 加深的青绿色渐变 */
.container {
  width: 100vw;
  min-height: 100vh;
  position: relative;
  overflow-x: hidden;
  overflow-y: auto;
  /* 核心3色渐变：从深蓝到青色到亮青绿色 */
  background: linear-gradient(135deg,
    #0172AF 0%,      /* 深蓝色 - 左上角 */
    #00A9B5 50%,     /* 青色 - 正中心 */
    #74FEBD 100%     /* 亮青绿色 - 右下角 */
  );
}

/* 背景层 */
.background-layer {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  overflow: hidden;
  pointer-events: none;
}

/* 光晕效果 - 增强版：更强对比度 + 径向渐变 */
.glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(100rpx);
  animation: glow-pulse-enhanced 4s ease-in-out infinite;
}

.glow-1 {
  top: 80rpx;
  left: 80rpx;
  width: 750rpx;
  height: 750rpx;
  background: radial-gradient(circle,
    rgba(1, 114, 175, 0.8) 0%,
    rgba(1, 114, 175, 0.5) 50%,
    rgba(1, 114, 175, 0.2) 100%
  );
  animation-delay: 0s;
}

.glow-2 {
  bottom: 80rpx;
  right: 80rpx;
  width: 950rpx;
  height: 950rpx;
  background: radial-gradient(circle,
    rgba(116, 254, 189, 0.8) 0%,
    rgba(116, 254, 189, 0.5) 50%,
    rgba(116, 254, 189, 0.2) 100%
  );
  animation-delay: 2s;
}

.glow-3 {
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 850rpx;
  height: 850rpx;
  background: radial-gradient(circle,
    rgba(0, 169, 181, 0.7) 0%,
    rgba(0, 169, 181, 0.4) 50%,
    rgba(0, 169, 181, 0.15) 100%
  );
  animation-delay: 1s;
}

.glow-4 {
  top: 25%;
  right: 25%;
  width: 800rpx;
  height: 800rpx;
  background: radial-gradient(circle,
    rgba(0, 197, 208, 0.75) 0%,
    rgba(0, 197, 208, 0.45) 50%,
    rgba(0, 197, 208, 0.18) 100%
  );
  animation-delay: 3s;
}

.glow-5 {
  bottom: 25%;
  left: 25%;
  width: 820rpx;
  height: 820rpx;
  background: radial-gradient(circle,
    rgba(63, 232, 200, 0.65) 0%,
    rgba(63, 232, 200, 0.35) 50%,
    rgba(63, 232, 200, 0.12) 100%
  );
  animation-delay: 1.5s;
}

.glow-6 {
  top: 75%;
  left: 50%;
  transform: translateX(-50%);
  width: 760rpx;
  height: 760rpx;
  background: radial-gradient(circle,
    rgba(1, 153, 184, 0.85) 0%,
    rgba(1, 153, 184, 0.55) 50%,
    rgba(1, 153, 184, 0.2) 100%
  );
  animation-delay: 2.5s;
}

/* 增强版光晕脉动动画 - 更大的变化范围 */
@keyframes glow-pulse-enhanced {
  0%, 100% {
    opacity: 0.3;
    transform: scale(0.9);
  }
  50% {
    opacity: 1;
    transform: scale(1.5);
  }
}

/* 登录卡片包装器 */
.login-wrapper {
  position: relative;
  z-index: 10;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 80rpx 48rpx;
  box-sizing: border-box;
}

/* 登录卡片 - 3D透明玻璃立体效果 */
.login-card {
  width: 100%;
  max-width: 500rpx;
  padding: 60rpx 40rpx;
  border-radius: 24rpx;
  /* 深色渐变背景 + 透明玻璃叠加 - 5色增加层次感 */
  background:
    linear-gradient(135deg,
      rgba(255, 255, 255, 0.15) 0%,
      rgba(255, 255, 255, 0.10) 100%
    ),
    linear-gradient(135deg,
      rgba(1, 48, 84, 0.60) 0%,
      rgba(1, 74, 115, 0.55) 20%,
      rgba(1, 114, 175, 0.50) 45%,
      rgba(0, 169, 181, 0.45) 70%,
      rgba(116, 254, 189, 0.40) 100%
    );
  /* 增强模糊效果营造玻璃感 */
  backdrop-filter: blur(50rpx) saturate(200%) brightness(1.15);
  -webkit-backdrop-filter: blur(50rpx) saturate(200%) brightness(1.15);
  /* 增强3D立体效果 - 多层阴影营造深度 */
  box-shadow:
    /* 内部顶部和左侧高光 - 营造凸出玻璃效果 */
    inset 0 6rpx 12rpx rgba(255, 255, 255, 0.25),
    inset 0 12rpx 24rpx rgba(255, 255, 255, 0.18),
    inset 6rpx 0 12rpx rgba(255, 255, 255, 0.2),
    inset 12rpx 0 24rpx rgba(255, 255, 255, 0.15),
    /* 内部底部和右侧暗影 - 增强立体深度 */
    inset 0 -6rpx 12rpx rgba(0, 0, 0, 0.12),
    inset -6rpx 0 12rpx rgba(0, 0, 0, 0.1),
    /* 外部多层阴影 - 营造悬浮效果 */
    0 20rpx 40rpx rgba(0, 0, 0, 0.15),
    0 35rpx 70rpx rgba(0, 0, 0, 0.12),
    0 50rpx 100rpx rgba(0, 0, 0, 0.1),
    /* 彩色辉光增强玻璃质感 */
    0 30rpx 60rpx rgba(1, 114, 175, 0.45),
    0 50rpx 100rpx rgba(0, 169, 181, 0.4),
    0 70rpx 140rpx rgba(116, 254, 189, 0.35);
  /* 去掉边框 */
  border: none;
  position: relative;
  overflow: hidden;
  /* 3D变换 */
  transform: translateZ(0);
  will-change: transform;
}

/* 彩虹反光效果 */
.login-card::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 200rpx;
  background: linear-gradient(
    to top,
    rgba(255, 100, 200, 0.2) 0%,
    rgba(255, 200, 100, 0.15) 25%,
    rgba(100, 200, 255, 0.2) 50%,
    rgba(200, 100, 255, 0.15) 75%,
    rgba(200, 255, 100, 0.2) 100%
  );
  border-radius: 0 0 24rpx 24rpx;
  pointer-events: none;
  opacity: 0.8;
  filter: blur(25rpx);
}

/* 标题区域 */
.title-section {
  text-align: center;
  margin-bottom: 60rpx;
  position: relative;
  z-index: 1;
}

.title {
  display: block;
  font-size: 60rpx;
  font-weight: bold;
  color: #ffffff;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
  margin-bottom: 16rpx;
}

.subtitle {
  display: block;
  font-size: 30rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.95);
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

/* 输入框组 */
.input-group {
  position: relative;
  margin-bottom: 30rpx;
  z-index: 1;
  /* 缩小宽度，左右留出更多空间 */
  padding: 0 40rpx;
}

/* 通用图标包装器 */
.icon-wrapper {
  width: 40rpx;
  height: 40rpx;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 用户图标 - CSS绘制，白色线条 */
.user-icon::before {
  content: '';
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%; /* 保留圆形 */
  border: 3rpx solid rgba(255, 255, 255, 0.9);
  position: absolute;
  top: 2rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.3));
}

.user-icon::after {
  content: '';
  width: 32rpx;
  height: 20rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 24rpx 24rpx 0 0; /* 保留非对称圆角 */
  position: absolute;
  bottom: 0;
  border-bottom: none;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.3));
}

/* 锁图标 - CSS绘制，白色线条 */
.lock-icon::before {
  content: '';
  width: 24rpx;
  height: 16rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 24rpx 24rpx 0 0; /* 保留非对称圆角 */
  border-bottom: none;
  position: absolute;
  top: 4rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.3));
}

.lock-icon::after {
  content: '';
  width: 28rpx;
  height: 18rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 4rpx;
  position: absolute;
  bottom: 4rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.3));
}

/* 眼睛图标 - 睁开状态（参考图2）：椭圆外框 + 实心瞳孔 */
.eye-open-icon::before {
  content: '';
  width: 40rpx;
  height: 26rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 50%; /* 保留圆形 */
  position: absolute;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.3));
}

.eye-open-icon::after {
  content: '';
  width: 14rpx;
  height: 14rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 50%; /* 保留圆形 */
  position: absolute;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.3));
}

/* 眼睛图标 - 闭合状态（参考图1）：椭圆外框 + 斜线穿过 */
.eye-close-icon::before {
  content: '';
  width: 40rpx;
  height: 26rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.9);
  border-radius: 50%; /* 保留圆形 */
  position: absolute;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.3));
}

.eye-close-icon::after {
  content: '';
  width: 50rpx;
  height: 3rpx;
  background: rgba(255, 255, 255, 0.9);
  position: absolute;
  border-radius: 2rpx;
  transform: rotate(-45deg);
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.3));
}

.input-icon {
  position: absolute;
  left: 61rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 10;
}

.input-eye-icon {
  position: absolute;
  right: 66rpx;
  top: 50%;
  transform: translateY(-50%);
  z-index: 10;
}

.icon {
  width: 40rpx;
  height: 40rpx;
  filter: drop-shadow(0 2rpx 4rpx rgba(0, 0, 0, 0.3));
}

/* 输入框 - 3D透明玻璃凸出效果 */
.input-field {
  width: 100%;
  height: 96rpx;
  padding: 0 60rpx 0 80rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: #ffffff;
  /* 完全透明背景，让背景渐变完全透出 */
  background: transparent;
  /* 3D凸出阴影效果 - 仅保留内部高光和彩色辉光 */
  box-shadow:
    /* 内部顶部和左侧白色高光 - 营造凸出效果 */
    inset 0 4rpx 8rpx rgba(255, 255, 255, 0.5),
    inset 0 8rpx 16rpx rgba(255, 255, 255, 0.3),
    inset 4rpx 0 8rpx rgba(255, 255, 255, 0.4),
    /* 彩色辉光 */
    0 8rpx 20rpx rgba(100, 200, 255, 0.15),
    0 6rpx 15rpx rgba(150, 255, 200, 0.1);
  /* 透明玻璃边框 - 凸出边缘效果 */
  border-top: 2rpx solid rgba(255, 255, 255, 0.5);
  border-left: 2rpx solid rgba(255, 255, 255, 0.4);
  border-right: 1rpx solid rgba(255, 255, 255, 0.15);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.15);
  box-sizing: border-box;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  /* 增强3D变换 */
  transform: translateZ(0);
  will-change: box-shadow, border-color, background;
}

.input-field:focus {
  /* 聚焦时保持透明，只增加白色发光 */
  background: rgba(255, 255, 255, 0.1);
  /* 聚焦时增强凸出效果并添加发光 */
  box-shadow:
    /* 更强的内部高光 */
    inset 0 5rpx 10rpx rgba(255, 255, 255, 0.6),
    inset 0 10rpx 20rpx rgba(255, 255, 255, 0.4),
    inset 5rpx 0 10rpx rgba(255, 255, 255, 0.5),
    /* 外部透明发光环 */
    0 0 0 3rpx rgba(255, 255, 255, 0.4),
    0 0 0 6rpx rgba(255, 255, 255, 0.15),
    /* 外部彩色玻璃辉光 */
    0 10rpx 30rpx rgba(150, 220, 255, 0.25),
    0 6rpx 18rpx rgba(100, 200, 255, 0.15);
  /* 边框增亮 */
  border-top-color: rgba(255, 255, 255, 0.6);
  border-left-color: rgba(255, 255, 255, 0.5);
  border-right-color: rgba(255, 255, 255, 0.2);
  border-bottom-color: rgba(255, 255, 255, 0.2);
}

.input-placeholder {
  color: rgba(255, 255, 255, 0.6);
}

/* 忘记密码区域 */
.forgot-section {
  display: flex;
  justify-content: flex-end;
  padding: 8rpx 40rpx 20rpx 40rpx;
  margin-top: -20rpx;
  position: relative;
  z-index: 1;
}

.forgot-link {
  font-size: 26rpx;
  font-weight: 500;
  color: rgba(255, 255, 255, 0.9);
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.2);
}

/* 登录按钮 - 增强3D凸起效果 */
.login-button {
  width: calc(100% - 80rpx);
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 与输入框宽度保持一致并居中 */
  margin: 0 auto;
  /* 背景色跟随整体渐变 */
  background: linear-gradient(135deg,
    rgba(1, 114, 175, 0.6) 0%,
    rgba(0, 169, 181, 0.55) 50%,
    rgba(116, 254, 189, 0.5) 100%);
  /* 保留作为增强效果 */
  backdrop-filter: blur(15rpx) saturate(180%);
  -webkit-backdrop-filter: blur(15rpx) saturate(180%);
  /* 3D凸起阴影效果 - 仅保留内部高光和彩色辉光 */
  box-shadow:
    /* 内部顶部和左侧强烈高光 - 营造凸起 */
    inset 0 6rpx 12rpx rgba(255, 255, 255, 0.7),
    inset 0 10rpx 20rpx rgba(255, 255, 255, 0.5),
    inset 6rpx 0 12rpx rgba(255, 255, 255, 0.5),
    /* 彩色辉光增强立体感 */
    0 15rpx 40rpx rgba(72, 219, 251, 0.4),
    0 10rpx 30rpx rgba(100, 255, 218, 0.3);
  /* 渐变边框增强立体感 */
  border-top: 2rpx solid rgba(255, 255, 255, 0.6);
  border-left: 2rpx solid rgba(255, 255, 255, 0.5);
  border-right: 1rpx solid rgba(255, 255, 255, 0.2);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.1);
  margin-top: 50rpx;
  position: relative;
  z-index: 1;
  transition: all 0.2s ease;
  /* 3D变换准备 */
  transform: translateY(0) translateZ(0);
  will-change: transform, box-shadow;
}

/* 按钮点击态效果 - 按下凹陷 */
.login-button:active {
  /* 向下移动营造按下效果 */
  transform: translateY(4rpx) scale(0.98);
  /* 更亮的背景 */
  background: linear-gradient(135deg,
    rgba(120, 255, 230, 0.9) 0%,
    rgba(92, 230, 255, 0.9) 50%,
    rgba(84, 235, 220, 0.9) 100%);
  /* 减弱外部阴影，增强内部阴影 - 营造按下效果 */
  box-shadow:
    /* 内部阴影加深 */
    inset 0 4rpx 8rpx rgba(0, 0, 0, 0.2),
    inset 0 8rpx 16rpx rgba(0, 0, 0, 0.15),
    inset 4rpx 0 8rpx rgba(0, 0, 0, 0.15),
    /* 内部底部高光 */
    inset 0 -2rpx 4rpx rgba(255, 255, 255, 0.5),
    inset -2rpx 0 4rpx rgba(255, 255, 255, 0.4),
    /* 外部阴影减弱 */
    0 8rpx 20rpx rgba(0, 0, 0, 0.25),
    0 4rpx 10rpx rgba(0, 0, 0, 0.2),
    /* 外发光 */
    0 0 0 4rpx rgba(255, 255, 255, 0.5),
    0 8rpx 25rpx rgba(100, 255, 218, 0.4);
  /* 边框反转 */
  border-top-color: rgba(0, 0, 0, 0.15);
  border-left-color: rgba(0, 0, 0, 0.1);
  border-right-color: rgba(255, 255, 255, 0.4);
  border-bottom-color: rgba(255, 255, 255, 0.5);
}

.button-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
  letter-spacing: 10rpx;
}

/* 测试账号区域 - 独立模块，页面底部 */
.test-accounts-section {
  position: relative;
  z-index: 999;
  width: 100%;
  padding: 40rpx 48rpx 80rpx 48rpx;
  box-sizing: border-box;
  margin-top: 40rpx;
}

.test-accounts-title {
  display: block;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 30rpx;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3);
}

.test-accounts-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

/* 测试账号卡片 - 玻璃效果 */
.test-account-card {
  padding: 24rpx;
  border-radius: 24rpx;
  /* 半透明玻璃背景 */
  background: linear-gradient(135deg,
    rgba(255, 255, 255, 0.12) 0%,
    rgba(255, 255, 255, 0.08) 100%
  );
  backdrop-filter: blur(15rpx) saturate(180%);
  -webkit-backdrop-filter: blur(15rpx) saturate(180%);
  /* 玻璃质感阴影 */
  box-shadow:
    /* 内部顶部高光 */
    inset 0 3rpx 6rpx rgba(255, 255, 255, 0.3),
    inset 3rpx 0 6rpx rgba(255, 255, 255, 0.2),
    /* 外部阴影 */
    0 6rpx 16rpx rgba(0, 0, 0, 0.12),
    /* 彩色辉光 */
    0 4rpx 12rpx rgba(100, 200, 255, 0.1);
  /* 玻璃边框 */
  border-top: 1rpx solid rgba(255, 255, 255, 0.4);
  border-left: 1rpx solid rgba(255, 255, 255, 0.3);
  border-right: 1rpx solid rgba(255, 255, 255, 0.1);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  /* 3D变换准备 */
  transform: translateZ(0);
  will-change: transform, box-shadow;
}

/* 点击反馈 */
.test-account-card:active {
  transform: scale(0.96);
  background: linear-gradient(135deg,
    rgba(255, 255, 255, 0.18) 0%,
    rgba(255, 255, 255, 0.12) 100%
  );
  box-shadow:
    /* 内部阴影增强按下效果 */
    inset 0 2rpx 4rpx rgba(0, 0, 0, 0.15),
    inset 0 -1rpx 3rpx rgba(255, 255, 255, 0.4),
    /* 外部阴影减弱 */
    0 3rpx 8rpx rgba(0, 0, 0, 0.1),
    /* 发光 */
    0 0 0 2rpx rgba(255, 255, 255, 0.3);
}

.test-account-role {
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.95);
  text-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.2);
  text-align: center;
}
