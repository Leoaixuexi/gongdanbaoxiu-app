.page {
  width: 750rpx;
  min-height: 100vh;
  background: #ffffff;
  position: relative;
  box-sizing: border-box;
  overflow: hidden;
}

/* 顶部区域 */
.top-area {
  width: 750rpx;
  height: 580rpx;
  position: relative;
  background: linear-gradient(180deg, #C2FAEB 0%, #AAF3DF 50%, #A4F7DC 100%);
  overflow: hidden;
}

/* 光斑效果 */
.blob {
  position: absolute;
  border-radius: 50%;
  pointer-events: none;
}

/* 右下侧光斑 - Blob A */
.blob-a {
  width: 532rpx;
  height: 300rpx;
  background: rgba(198, 255, 189, 0.8);
  filter: blur(44rpx);
  right: -80rpx;
  bottom: 60rpx;
  animation: blob-a-move 8s ease-in-out infinite;
}

/* 左上侧光斑 - Blob B */
.blob-b {
  width: 476rpx;
  height: 268rpx;
  background: rgba(198, 255, 189, 0.6);
  filter: blur(44rpx);
  left: -60rpx;
  top: 80rpx;
  animation: blob-b-move 10s ease-in-out infinite;
}

/* 光斑A动画 - 缓慢漂移和呼吸 */
@keyframes blob-a-move {
  0%, 100% {
    transform: translate(0, 0) scale(1);
    opacity: 0.8;
  }
  25% {
    transform: translate(-30rpx, -20rpx) scale(1.05);
    opacity: 0.9;
  }
  50% {
    transform: translate(-50rpx, 10rpx) scale(0.95);
    opacity: 0.7;
  }
  75% {
    transform: translate(-20rpx, -30rpx) scale(1.02);
    opacity: 0.85;
  }
}

/* 光斑B动画 - 反向漂移 */
@keyframes blob-b-move {
  0%, 100% {
    transform: translate(0, 0) scale(1);
    opacity: 0.6;
  }
  33% {
    transform: translate(40rpx, 20rpx) scale(1.08);
    opacity: 0.7;
  }
  66% {
    transform: translate(20rpx, -25rpx) scale(0.92);
    opacity: 0.5;
  }
}

.top-image {
  position: absolute;
  right: 20rpx;
  top: 180rpx;
  width: 320rpx;
  height: 320rpx;
  z-index: 2;
}

.title {
  position: absolute;
  left: 40rpx;
  top: 260rpx;
  width: 450rpx;
  color: #323232;
  font-size: 52rpx;
  font-weight: 800;
  line-height: 90rpx;
  white-space: pre-line;
  z-index: 2;
}

/* 内容区域 */
.content {
  position: absolute;
  left: 0;
  top: 520rpx;
  width: 750rpx;
  min-height: 700rpx;
  background: #ffffff;
  border-radius: 40rpx 40rpx 0 0;
  box-sizing: border-box;
  padding-top: 20rpx;
}

/* 输入字段 */
.field {
  margin-left: 40rpx;
  margin-top: 52rpx;
  width: 670rpx;
}

.label {
  color: #323232;
  font-size: 32rpx;
  font-weight: 500;
  line-height: 44rpx;
  /* 颜色过渡动画 */
  transition: color 0.25s ease;
}

/* 焦点态 - 标签变绿 */
.field.focused .label,
.input-group.focused .label {
  color: #0CCCB6;
}

/* 输入框组 */
.input-group {
  margin: 0 40rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f2f2f2;
  transition: border-color 0.25s ease;
}

/* 焦点态 - 下划线渐变绿色 */
.input-group.focused {
  border-bottom: 3rpx solid #0CCCB6;
  border-image: linear-gradient(90deg, #0CCCB6 0%, #78F2D0 100%) 1;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 670rpx;
}

.input {
  width: 670rpx;
  color: #323232;
  font-size: 30rpx;
  line-height: 42rpx;
  padding: 18rpx 0;
}

.placeholder {
  color: #cbcbcb;
  font-size: 30rpx;
  font-weight: 400;
}

.password-field {
  position: relative;
}

.forget {
  position: absolute;
  right: 0;
  bottom: 10rpx;
  color: #11bdA7;
  font-size: 30rpx;
  line-height: 42rpx;
  /* 透明度过渡效果 */
  opacity: 0.85;
  transition: opacity 0.2s ease;
}

.forget:active {
  opacity: 0.6;
}

.line {
  width: 670rpx;
  height: 2rpx;
  background: #f2f2f2;
  margin-top: 0rpx;
  /* 过渡动画 */
  transition: background 0.25s ease, height 0.25s ease;
}

/* 焦点态 - 下划线渐变绿色+加粗 */
.field.focused .line {
  height: 3rpx;
  background: linear-gradient(90deg, #0CCCB6 0%, #78F2D0 100%);
}

/* 登录按钮 */
.btn-wrap {
  margin-left: 40rpx;
  margin-top: 70rpx;
}

.btn {
  width: 670rpx;
  height: 88rpx;
  border-radius: 50rpx;
  position: relative;
  overflow: hidden;
  /* 绿色投影 */
  box-shadow: 0 8rpx 24rpx rgba(12, 204, 182, 0.4);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

/* 点击反馈 - 按下时下沉+阴影收缩 */
.btn:active {
  transform: translateY(4rpx);
  box-shadow: 0 4rpx 12rpx rgba(12, 204, 182, 0.3);
}

.btn-bg {
  position: absolute;
  left: -60rpx;
  top: 0;
  width: 790rpx;
  height: 88rpx;
  /* 渐变角度135deg，增加中间过渡色 */
  background: linear-gradient(135deg, #0CCCB6 0%, #3DD9C1 50%, #78F2D0 100%);
  transform: skewX(-5deg);
}

.btn-text {
  position: absolute;
  left: 0;
  top: 0;
  width: 670rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 32rpx;
  /* 文字加粗 + 轻微文字阴影 */
  font-weight: 600;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.15);
}

/* 快捷登录 */
.quick-login {
  margin-top: 60rpx;
  padding: 0 40rpx;
}

.quick-login-title {
  font-size: 26rpx;
  color: #999;
  text-align: center;
  margin-bottom: 24rpx;
}

.quick-login-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: center;
}

.quick-login-btn {
  padding: 16rpx 28rpx;
  background: #f5f5f5;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666;
  transition: all 0.2s ease;
}

.quick-login-btn:active {
  background: #e8e8e8;
  transform: scale(0.96);
}

/* 协议区 */
.agreement {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  font-size: 24rpx;
}

.check {
  margin-right: 8rpx;
}

.box {
  width: 30rpx;
  height: 30rpx;
  border: 2rpx solid #cbcbcb;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
}

.checked {
  border-color: #11bdA7;
  background: #11bdA7;
}

.tick {
  font-size: 20rpx;
  color: #ffffff;
  line-height: 20rpx;
}

.agree-grey {
  color: #cbcbcb;
}

.agree-link {
  color: #333333;
}

.bottom-safe {
  position: fixed;
  left: 0;
  bottom: 0;
  width: 750rpx;
  height: 68rpx;
}