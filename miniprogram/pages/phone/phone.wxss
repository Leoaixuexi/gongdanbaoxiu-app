/* pages/phone/phone.wxss */

/* ==================== 容器 ==================== */
.container {
  min-height: 100vh;
  background-color: #F8FAFC;
  display: flex;
  flex-direction: column;
  padding-bottom: 160rpx;
}

/* ==================== 导航栏 ==================== */
.nav-bar {
  background: #ffffff;
  border-bottom: 1rpx solid #F1F5F9;
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 32rpx;
}

.nav-left {
  width: 80rpx;
  display: flex;
  align-items: center;
}

.back-icon {
  width: 20rpx;
  height: 20rpx;
  border-left: 3rpx solid #1E293B;
  border-bottom: 3rpx solid #1E293B;
  transform: rotate(45deg);
}

.back-icon:active {
  opacity: 0.6;
}

.nav-title {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #1E293B;
}

.nav-right {
  width: 80rpx;
}

/* ==================== 表单区域 ==================== */
.form-section {
  flex: 1;
  padding: 24rpx 32rpx 32rpx;
}

/* ==================== 当前手机号卡片 ==================== */
.current-phone-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx;
  border-radius: 24rpx;
  background: #ffffff;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.phone-icon-wrapper {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(16, 185, 129, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 电话图标 - 使用CSS绘制 */
.phone-icon-svg {
  width: 44rpx;
  height: 44rpx;
  position: relative;
}

.phone-icon-inner {
  width: 100%;
  height: 100%;
  border: 4rpx solid #10b981;
  border-radius: 8rpx;
  transform: rotate(-25deg);
  position: relative;
}

.phone-icon-inner::before {
  content: '';
  position: absolute;
  bottom: 2rpx;
  left: 2rpx;
  width: 14rpx;
  height: 14rpx;
  background: #10b981;
  border-radius: 50%;
}

.phone-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
}

.phone-label {
  font-size: 26rpx;
  color: #64748B;
}

.phone-number {
  font-size: 34rpx;
  font-weight: 600;
  color: #1E293B;
  letter-spacing: 2rpx;
}

/* ==================== 表单卡片 ==================== */
.form-card {
  border-radius: 24rpx;
  padding: 40rpx 32rpx 32rpx;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.input-field {
  margin-bottom: 40rpx;
}

.input-field:last-of-type {
  margin-bottom: 0;
}

.field-label {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.field-icon-box {
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 手机图标 */
.mobile-icon {
  width: 24rpx;
  height: 32rpx;
  border: 3rpx solid #64748B;
  border-radius: 4rpx;
  position: relative;
}

.mobile-icon::after {
  content: '';
  position: absolute;
  bottom: 3rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 8rpx;
  height: 2rpx;
  background: #64748B;
  border-radius: 1rpx;
}

/* 验证码图标 */
.code-icon {
  width: 32rpx;
  height: 28rpx;
  border: 3rpx solid #64748B;
  border-radius: 4rpx;
  position: relative;
}

.code-icon::before {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 16rpx;
  height: 2rpx;
  background: #64748B;
  box-shadow: 0 -6rpx 0 #64748B, 0 6rpx 0 #64748B;
}

.field-text {
  font-size: 28rpx;
  color: #1E293B;
  font-weight: 500;
}

/* ==================== 输入框 ==================== */
.input {
  width: 100%;
  padding: 24rpx 0;
  background-color: transparent;
  border: none;
  border-bottom: 2rpx solid #E2E8F0;
  font-size: 30rpx;
  color: #1E293B;
  transition: border-color 0.2s ease;
}

.input:focus {
  border-bottom-color: #10b981;
}

.input::placeholder {
  color: #CBD5E1;
  font-size: 28rpx;
}

/* ==================== 验证码输入 ==================== */
.code-input-wrapper {
  display: flex;
  gap: 16rpx;
  align-items: flex-end;
}

.code-input {
  flex: 1;
  min-width: 0;
}

.send-code-btn {
  flex-shrink: 0;
  padding: 20rpx 28rpx;
  background: rgba(16, 185, 129, 0.1);
  border-radius: 12rpx;
  transition: all 0.2s ease;
  border: none;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.send-code-btn::after {
  border: none;
}

.send-code-btn:active {
  opacity: 0.7;
  transform: scale(0.98);
}

.send-code-btn.disabled {
  background: #F1F5F9;
  opacity: 1;
}

.send-code-btn.disabled:active {
  transform: none;
}

.send-code-text {
  font-size: 26rpx;
  font-weight: 500;
  color: #10b981;
  white-space: nowrap;
}

.send-code-btn.disabled .send-code-text {
  color: #94A3B8;
}

/* ==================== 错误提示 ==================== */
.error-msg {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 32rpx;
  padding: 20rpx 24rpx;
  background-color: rgba(239, 68, 68, 0.08);
  border-radius: 12rpx;
  border-left: 4rpx solid #EF4444;
}

.error-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background-color: #EF4444;
  flex-shrink: 0;
}

.error-text {
  font-size: 26rpx;
  color: #EF4444;
  line-height: 1.5;
}

/* ==================== 底部按钮 ==================== */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  border-top: 1rpx solid #F1F5F9;
  display: flex;
  gap: 16rpx;
  z-index: 100;
}

.action-btn {
  flex: 1;
  padding: 28rpx;
  border-radius: 24rpx;
  font-weight: 500;
  font-size: 30rpx;
  transition: all 0.2s ease;
  border: none;
}

.action-btn::after {
  border: none;
}

.action-btn:active {
  transform: scale(0.98);
}

.cancel-btn {
  background: #F1F5F9;
}

.cancel-btn .btn-text {
  color: #64748B;
}

.cancel-btn:active {
  background: #E2E8F0;
}

.save-btn {
  background: linear-gradient(to right, #10b981, #14b8a6);
  box-shadow: 0 6rpx 20rpx rgba(16, 185, 129, 0.25);
}

.save-btn .btn-text {
  color: #ffffff;
}

.save-btn:active {
  opacity: 0.9;
  box-shadow: 0 4rpx 16rpx rgba(16, 185, 129, 0.3);
}

.btn-text {
  font-size: 30rpx;
  font-weight: 500;
}
