<!--pages/phone/phone.wxml-->
<view class="container">
  <!-- 导航栏 -->
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-content">
      <view class="nav-left" bindtap="handleCancel">
        <view class="back-icon"></view>
      </view>
      <view class="nav-title">修改手机号</view>
      <view class="nav-right"></view>
    </view>
  </view>

  <!-- 表单区域 -->
  <view class="form-section">
    <!-- 当前手机号 -->
    <view class="current-phone-card">
      <view class="phone-icon-wrapper">
        <view class="phone-icon-svg">
          <view class="phone-icon-inner"></view>
        </view>
      </view>
      <view class="phone-info">
        <text class="phone-label">当前手机号</text>
        <text class="phone-number">{{currentPhone}}</text>
      </view>
    </view>

    <!-- 新手机号表单 -->
    <view class="form-card">
      <!-- 新手机号 -->
      <view class="input-field">
        <view class="field-label">
          <view class="field-icon-box">
            <view class="mobile-icon"></view>
          </view>
          <text class="field-text">新手机号</text>
        </view>
        <input
          class="input"
          type="number"
          maxlength="11"
          value="{{newPhone}}"
          placeholder="请输入新手机号"
          bindinput="onPhoneInput"
        />
      </view>

      <!-- 验证码 -->
      <view class="input-field">
        <view class="field-label">
          <view class="field-icon-box">
            <view class="code-icon"></view>
          </view>
          <text class="field-text">验证码</text>
        </view>
        <view class="code-input-wrapper">
          <input
            class="input code-input"
            type="number"
            maxlength="6"
            value="{{verifyCode}}"
            placeholder="请输入验证码"
            bindinput="onCodeInput"
          />
          <button
            class="send-code-btn {{countdown > 0 ? 'disabled' : ''}}"
            bindtap="sendCode"
            disabled="{{countdown > 0}}"
          >
            <text class="send-code-text">{{countdown > 0 ? countdown + 's' : '获取验证码'}}</text>
          </button>
        </view>
      </view>

      <!-- 错误提示 -->
      <view class="error-msg" wx:if="{{error}}">
        <view class="error-dot"></view>
        <text class="error-text text-destructive">{{error}}</text>
      </view>
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="bottom-actions">
    <button class="action-btn cancel-btn" bindtap="handleCancel">
      <text class="btn-text">取消</text>
    </button>
    <button class="action-btn save-btn" bindtap="handleSubmit">
      <text class="btn-text">确认修改</text>
    </button>
  </view>
</view>
