<!--pages/phone/phone.wxml-->
<view class="container">
  <!-- 导航栏 -->
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-content">
      <view class="nav-left" bindtap="handleCancel">
        <van-icon name="arrow-left" size="40rpx" color="#fff" />
      </view>
      <view class="nav-title">修改手机号</view>
      <view class="nav-right"></view>
    </view>
  </view>

  <!-- 表单区域 -->
  <view class="form-section">
    <!-- 当前手机号 -->
    <view class="current-phone-card">
      <view class="current-icon">
        <view class="current-icon-inner"></view>
      </view>
      <view class="current-info">
        <text class="current-label">当前手机号</text>
        <text class="current-number">{{currentPhone}}</text>
      </view>
    </view>

    <!-- 新手机号表单 -->
    <view class="form-card">
      <!-- 新手机号 -->
      <view class="field-block">
        <view class="field-header">
          <view class="field-icon mobile"></view>
          <text class="field-title">新手机号</text>
        </view>
        <input
          class="text-input"
          type="number"
          maxlength="11"
          value="{{newPhone}}"
          placeholder="请输入新手机号"
          bindinput="onPhoneInput"
          placeholder-class="input-placeholder"
        />
      </view>

      <!-- 验证码 -->
      <view class="field-block">
        <view class="field-header">
          <view class="field-icon sms"></view>
          <text class="field-title">验证码</text>
        </view>
        <view class="code-row">
          <input
            class="text-input"
            type="number"
            maxlength="6"
            value="{{verifyCode}}"
            placeholder="请输入验证码"
            bindinput="onCodeInput"
            placeholder-class="input-placeholder"
          />
          <button
            class="code-btn {{countdown > 0 ? 'disabled' : ''}}"
            bindtap="sendCode"
            disabled="{{countdown > 0}}"
          >
            <text class="code-btn-text">{{countdown > 0 ? countdown + 's' : '获取验证码'}}</text>
          </button>
        </view>
      </view>

      <!-- 错误提示 -->
      <view class="error-msg" wx:if="{{error}}">
        <view class="error-dot"></view>
        <text class="error-text text-destructive">{{error}}</text>
      </view>
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="bottom-actions">
    <button class="action-btn cancel-btn" bindtap="handleCancel">
      <text class="btn-text">取消</text>
    </button>
    <button class="action-btn save-btn" bindtap="handleSubmit">
      <text class="btn-text">确认修改</text>
    </button>
  </view>
</view>
