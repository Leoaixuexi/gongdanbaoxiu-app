/* 意见反馈提交页面 */

.feedback-submit-page {
  min-height: 100vh;
  background-color: #fff;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* 导航栏 */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  z-index: 100;
  border-bottom: 1rpx solid #f0f0f0;
}

.nav-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}

.nav-left {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-left:active {
  opacity: 0.7;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.nav-right {
  width: 80rpx;
}

/* 表单区域 */
.form-area {
  padding: 32rpx;
}

.form-group {
  margin-bottom: 40rpx;
}

.form-label {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.form-label-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.label-text {
  font-size: 30rpx;
  font-weight: 500;
  color: #1a1a1a;
}

.required {
  color: #ef4444;
  font-size: 30rpx;
  margin-left: 4rpx;
}

.photo-count {
  font-size: 26rpx;
  color: #999;
}

/* 输入框 - 底部边框样式 */
.form-input {
  width: 100%;
  height: 88rpx;
  font-size: 30rpx;
  color: #333;
  background-color: transparent;
  border: none;
  border-bottom: 1rpx solid #e5e5e5;
  padding: 0;
  box-sizing: border-box;
}

.placeholder {
  color: #ccc;
}

/* 文本域 */
.textarea-wrapper {
  position: relative;
  border: 1rpx solid #e5e5e5;
  border-radius: 12rpx;
  overflow: hidden;
}

.form-textarea {
  width: 100%;
  min-height: 240rpx;
  font-size: 30rpx;
  color: #333;
  background-color: #fff;
  padding: 24rpx;
  padding-bottom: 60rpx;
  box-sizing: border-box;
  line-height: 1.6;
}

.char-count {
  position: absolute;
  right: 24rpx;
  bottom: 16rpx;
  font-size: 24rpx;
  color: #999;
}

/* 图片网格 */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-item {
  width: 160rpx;
  height: 160rpx;
  position: relative;
  border-radius: 12rpx;
  overflow: hidden;
}

.photo-img {
  width: 100%;
  height: 100%;
}

.photo-delete {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 36rpx;
  height: 36rpx;
  background-color: rgba(0, 0, 0, 0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-icon {
  font-size: 28rpx;
  color: #fff;
  line-height: 1;
}

.photo-add {
  width: 160rpx;
  height: 160rpx;
  background-color: #fafafa;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.photo-add:active {
  background-color: #f5f5f5;
}

.add-icon {
  font-size: 48rpx;
  color: #ccc;
  line-height: 1;
}

.add-text {
  font-size: 24rpx;
  color: #999;
}

/* 底部按钮 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.submit-btn {
  width: 100%;
  height: 100rpx;
  background-color: #3b82f6;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn:active {
  opacity: 0.9;
}

.submit-btn.disabled {
  opacity: 0.6;
}

.submit-text {
  font-size: 34rpx;
  font-weight: 500;
  color: #fff;
}
