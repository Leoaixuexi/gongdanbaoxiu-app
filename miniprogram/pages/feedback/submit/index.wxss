/* 意见反馈提交页面 - 现代风格 */

.feedback-submit-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f7ff 0%, #f5f5f5 100%);
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

/* 导航栏 */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: linear-gradient(to right, #10b981, #14b8a6);
  z-index: 100;
}

.nav-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}

.nav-left {
  width: 80rpx;
  display: flex;
  align-items: center;
}

.nav-left:active {
  opacity: 0.6;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
}

.nav-right {
  width: 80rpx;
}

/* 表单区域 */
.form-area {
  padding: 24rpx;
}

/* 提示卡片 */
.tip-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: linear-gradient(135deg, #fffbeb 0%, #fef3c7 100%);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid rgba(245, 158, 11, 0.2);
}

.tip-icon {
  width: 72rpx;
  height: 72rpx;
  background: #fff;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(245, 158, 11, 0.15);
}

.tip-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.tip-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #92400e;
}

.tip-desc {
  font-size: 24rpx;
  color: #b45309;
  line-height: 1.4;
}

/* 表单卡片 */
.form-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.form-group {
  padding-bottom: 28rpx;
  margin-bottom: 28rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-group.no-border {
  padding-bottom: 0;
  margin-bottom: 0;
  border-bottom: none;
}

.form-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.form-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.label-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.required-badge {
  font-size: 22rpx;
  color: #ef4444;
  background: #fef2f2;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.photo-count-badge {
  font-size: 24rpx;
  color: #10b981;
  background: #ecfdf5;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

/* 输入框 */
.form-input {
  width: 100%;
  height: 88rpx;
  font-size: 30rpx;
  color: #333;
  background: #f8f9fa;
  border: 2rpx solid #e5e5e5;
  border-radius: 16rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.form-input:focus {
  border-color: #3b82f6;
  background: #fff;
}

.placeholder {
  color: #bbb;
}

/* 类型选择器 */
.type-picker {
  width: 100%;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f8f9fa;
  border: 2rpx solid #e5e5e5;
  border-radius: 16rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  transition: all 0.2s ease;
}

.type-picker.selected {
  border-color: #10b981;
  background: #fff;
}

.picker-text {
  font-size: 30rpx;
  color: #bbb;
}

.type-picker.selected .picker-text {
  color: #333;
}

.picker-arrow {
  font-size: 24rpx;
  color: #bbb;
}

.type-picker.selected .picker-arrow {
  color: #333;
}

/* 文本域 */
.textarea-wrapper {
  position: relative;
  background: #f8f9fa;
  border: 2rpx solid #e5e5e5;
  border-radius: 16rpx;
  overflow: hidden;
  transition: all 0.2s ease;
}

.textarea-wrapper:focus-within {
  border-color: #3b82f6;
  background: #fff;
}

.form-textarea {
  width: 100%;
  min-height: 200rpx;
  font-size: 30rpx;
  color: #333;
  background: transparent;
  padding: 24rpx;
  padding-bottom: 60rpx;
  box-sizing: border-box;
  line-height: 1.6;
}

.char-count-wrapper {
  position: absolute;
  right: 24rpx;
  bottom: 16rpx;
}

.char-count {
  font-size: 24rpx;
  color: #999;
}

.char-count.warning {
  color: #f59e0b;
}

/* 照片提示 */
.photo-hint {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 20rpx;
  display: block;
}

/* 图片网格 */
.photo-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.photo-item {
  width: 160rpx;
  height: 160rpx;
  position: relative;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.photo-img {
  width: 100%;
  height: 100%;
}

.photo-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 8rpx rgba(239, 68, 68, 0.3);
}

.photo-add {
  width: 160rpx;
  height: 160rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #f0f0f0 100%);
  border: 2rpx dashed #ddd;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  transition: all 0.2s ease;
}

.photo-add:active {
  background: #f0f0f0;
  border-color: #3b82f6;
}

.add-icon-wrapper {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-text {
  font-size: 22rpx;
  color: #999;
}

/* 底部按钮 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.submit-btn {
  width: 100%;
  padding: 28rpx 0;
  background: linear-gradient(to right, #10b981, #14b8a6);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 6rpx 20rpx rgba(16, 185, 129, 0.25);
  transition: all 0.2s ease;
  box-sizing: border-box;
}

.submit-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
  box-shadow: 0 4rpx 16rpx rgba(16, 185, 129, 0.3);
}

.submit-btn.disabled {
  opacity: 0.7;
}

.submit-text {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
}
