<!--意见反馈系统入口页-->
<view class="feedback-entry-page">
  <!-- 内容区域 -->
  <view class="content-area">
    <!-- 图标 -->
    <view class="icon-wrapper">
      <view class="icon-bg">
        <text class="icon-text">+</text>
      </view>
    </view>

    <!-- 标题 -->
    <text class="main-title">意见反馈系统</text>
    <text class="sub-title">您的反馈是我们进步的动力</text>

    <!-- 按钮区域 -->
    <view class="btn-area">
      <view class="btn-primary" bindtap="goToSubmit">
        <text class="btn-text">提交反馈</text>
        <text class="btn-arrow">></text>
      </view>
      <view class="btn-secondary" bindtap="goToList">
        <text class="btn-text">查看我的反馈</text>
      </view>
    </view>
  </view>
</view>
