/* 意见反馈系统入口页 - 现代风格 */

.feedback-entry-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f7ff 0%, #f5f5f5 50%, #fff 100%);
  padding: 0 40rpx;
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
}

/* 导航栏 */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: linear-gradient(to right, #10b981, #14b8a6);
  z-index: 100;
}

.nav-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}

.nav-left {
  width: 80rpx;
  display: flex;
  align-items: center;
}

.nav-left:active {
  opacity: 0.6;
}

.nav-right {
  width: 80rpx;
}

/* 内容区域 */
.content-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  padding-top: 60rpx;
  padding-bottom: 60rpx;
  position: relative;
  z-index: 1;
}

/* 图标卡片 */
.icon-card {
  position: relative;
  margin-bottom: 48rpx;
}

.icon-inner {
  width: 140rpx;
  height: 140rpx;
  background: linear-gradient(135deg, #fff 0%, #ecfdf5 100%);
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 48rpx rgba(16, 185, 129, 0.15),
              0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.icon-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 44rpx;
  height: 44rpx;
  background: linear-gradient(135deg, #10b981 0%, #14b8a6 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.4);
}

/* 标题区域 */
.title-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 64rpx;
}

.main-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 16rpx;
  letter-spacing: 2rpx;
}

.sub-title {
  font-size: 28rpx;
  color: #666;
  letter-spacing: 1rpx;
}

/* 功能卡片区域 */
.card-area {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.action-card {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
  transition: all 0.2s ease;
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08),
              0 12rpx 24rpx rgba(0, 0, 0, 0.04),
              inset 0 2rpx 0 rgba(255, 255, 255, 0.8);
}

.action-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}


.card-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.card-icon-wrapper {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.primary-icon {
  background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
  box-shadow: 0 6rpx 20rpx rgba(59, 130, 246, 0.35);
}

.secondary-icon {
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  box-shadow: 0 6rpx 20rpx rgba(16, 185, 129, 0.35);
}

.card-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.card-desc {
  font-size: 24rpx;
  color: #999;
}

.card-arrow {
  width: 60rpx;
  height: 60rpx;
  background: #f8f9fa;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
