/* 意见反馈系统入口页 */

.feedback-entry-page {
  min-height: 100vh;
  background-color: #f5f5f5;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx;
  box-sizing: border-box;
}

/* 内容区域 */
.content-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 100%;
  margin-top: -100rpx;
}

/* 图标 */
.icon-wrapper {
  margin-bottom: 32rpx;
}

.icon-bg {
  width: 120rpx;
  height: 120rpx;
  background-color: #e0edff;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.icon-bg::before {
  content: '';
  position: absolute;
  width: 56rpx;
  height: 48rpx;
  border: 4rpx solid #3b82f6;
  border-radius: 8rpx;
  background-color: transparent;
}

.icon-bg::after {
  content: '';
  position: absolute;
  bottom: 28rpx;
  right: 28rpx;
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-top: 12rpx solid #3b82f6;
}

.icon-text {
  font-size: 36rpx;
  font-weight: bold;
  color: #3b82f6;
  margin-top: -8rpx;
}

/* 标题 */
.main-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 16rpx;
}

.sub-title {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 80rpx;
}

/* 按钮区域 */
.btn-area {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.btn-primary {
  width: 100%;
  height: 100rpx;
  background-color: #3b82f6;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 8rpx 24rpx rgba(59, 130, 246, 0.3);
}

.btn-primary:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.btn-primary .btn-text {
  font-size: 32rpx;
  font-weight: 500;
  color: #fff;
}

.btn-primary .btn-arrow {
  font-size: 32rpx;
  color: #fff;
  font-weight: 500;
}

.btn-secondary {
  width: 100%;
  height: 100rpx;
  background-color: #fff;
  border: 2rpx solid #e5e5e5;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-secondary:active {
  background-color: #f9f9f9;
}

.btn-secondary .btn-text {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
}
