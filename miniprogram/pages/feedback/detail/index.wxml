<!--反馈详情页面-->
<view class="feedback-page">
  <!-- 自定义导航栏 -->
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-content">
      <view class="nav-left" bindtap="goBack">
        <van-icon name="arrow-left" size="40rpx" color="#333" />
      </view>
      <text class="nav-title">反馈详情</text>
      <view class="nav-right"></view>
    </view>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-wrapper" style="padding-top: {{navBarHeight}}px;">
    <van-loading size="48rpx" color="#0CA77D">加载中...</van-loading>
  </view>

  <!-- 详情内容 -->
  <view wx:else class="detail-content" style="padding-top: {{navBarHeight}}px;">
    <!-- 基本信息卡片 -->
    <view class="info-card">
      <view class="info-row">
        <text class="info-label">提交时间</text>
        <text class="info-value">{{feedback.created_at_str}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">提交者</text>
        <text class="info-value">{{feedback.user_name}}</text>
      </view>
      <view wx:if="{{isAdmin && feedback.user_role_name}}" class="info-row">
        <text class="info-label">用户角色</text>
        <text class="info-value role-badge">{{feedback.user_role_name}}</text>
      </view>
    </view>

    <!-- 标题卡片 -->
    <view class="content-card">
      <view class="card-header">
        <text class="card-title">标题</text>
      </view>
      <view class="card-body">
        <text class="title-text">{{feedback.title}}</text>
      </view>
    </view>

    <!-- 内容卡片 -->
    <view class="content-card">
      <view class="card-header">
        <text class="card-title">详细描述</text>
      </view>
      <view class="card-body">
        <text class="content-text">{{feedback.content}}</text>
      </view>
    </view>

    <!-- 照片卡片 -->
    <view wx:if="{{feedback.photos && feedback.photos.length > 0}}" class="content-card">
      <view class="card-header">
        <text class="card-title">问题截图</text>
        <text class="photo-count">{{feedback.photos.length}}张</text>
      </view>
      <view class="card-body">
        <view class="photos-grid">
          <image
            wx:for="{{feedback.photos}}"
            wx:key="index"
            class="photo-item"
            src="{{item}}"
            mode="aspectFill"
            bindtap="previewPhoto"
            data-index="{{index}}"
          />
        </view>
      </view>
    </view>

    <!-- 管理员查看时显示上下文信息 -->
    <view wx:if="{{isAdmin && feedback.context_info}}" class="content-card">
      <view class="card-header">
        <text class="card-title">上下文信息</text>
      </view>
      <view class="card-body context-info">
        <view wx:if="{{feedback.context_info.system_info}}" class="context-row">
          <text class="context-label">设备信息</text>
          <text class="context-value">{{feedback.context_info.system_info}}</text>
        </view>
        <view wx:if="{{feedback.context_info.user_agent}}" class="context-row">
          <text class="context-label">系统版本</text>
          <text class="context-value">{{feedback.context_info.user_agent}}</text>
        </view>
        <view wx:if="{{feedback.context_info.app_version}}" class="context-row">
          <text class="context-label">SDK版本</text>
          <text class="context-value">{{feedback.context_info.app_version}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
