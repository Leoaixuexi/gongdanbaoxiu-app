/* 反馈详情页面 - 现代风格 */

.feedback-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f7ff 0%, #f5f5f5 100%);
  padding-bottom: 48rpx;
}

/* 导航栏 */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: linear-gradient(to right, #10b981, #14b8a6);
  z-index: 100;
}

.nav-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}

.nav-left {
  width: 80rpx;
  display: flex;
  align-items: center;
}

.nav-left:active {
  opacity: 0.6;
}

.nav-right {
  width: 80rpx;
}

/* 加载中 */
.loading-wrapper {
  display: flex;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  background: #fff;
  padding: 60rpx 80rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.loading-text {
  font-size: 28rpx;
  color: #666;
}

.detail-content {
  padding: 24rpx;
}

/* 信息卡片 */
.info-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 8rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08),
              0 12rpx 24rpx rgba(0, 0, 0, 0.04),
              inset 0 2rpx 0 rgba(255, 255, 255, 0.8);
  border: 1rpx solid rgba(0, 0, 0, 0.05);
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-row:last-child {
  border-bottom: none;
}

.info-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.info-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}

.info-value {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
}

.content-value {
  flex: 1;
  text-align: right;
  word-break: break-all;
  line-height: 1.6;
}

.role-badge {
  background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%);
  color: #10b981;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
}

/* 内容卡片 */
.content-card {
  background: #fff;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08),
              0 12rpx 24rpx rgba(0, 0, 0, 0.04),
              inset 0 2rpx 0 rgba(255, 255, 255, 0.8);
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  overflow: hidden;
}

.card-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 24rpx 28rpx;
  background: linear-gradient(180deg, #fafafa 0%, #fff 100%);
  border-bottom: 1rpx solid #f0f0f0;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
}

.photo-count {
  font-size: 24rpx;
  color: #10b981;
  background: #ecfdf5;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  font-weight: 500;
}

.card-body {
  padding: 28rpx;
}

/* 标题文本 */
.title-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.5;
}

/* 内容文本 */
.content-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-all;
  display: block;
  background: linear-gradient(135deg, #f8fafb 0%, #f5f7f9 100%);
  padding: 24rpx;
  border-radius: 16rpx;
}

/* 照片网格 */
.photos-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.photo-item {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  object-fit: cover;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.photo-item:active {
  opacity: 0.8;
}

/* 上下文信息 */
.context-info {
  padding: 16rpx 28rpx;
}

.context-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.context-row:last-child {
  border-bottom: none;
}

.context-label {
  font-size: 26rpx;
  color: #999;
  flex-shrink: 0;
  margin-right: 16rpx;
}

.context-value {
  font-size: 26rpx;
  color: #666;
  text-align: right;
  word-break: break-all;
}
