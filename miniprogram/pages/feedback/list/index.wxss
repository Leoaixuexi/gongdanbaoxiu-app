/* 我的反馈列表页面 - 现代风格 */

.feedback-list-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f7ff 0%, #f5f5f5 100%);
  padding-bottom: 48rpx;
}

/* 导航栏 */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: linear-gradient(to right, #10b981, #14b8a6);
  z-index: 100;
}

.nav-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}

.nav-left {
  width: 80rpx;
  display: flex;
  align-items: center;
}

.nav-left:active {
  opacity: 0.6;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
}

.nav-right {
  width: 80rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.nav-right:active {
  opacity: 0.6;
}

/* 列表区域 */
.list-content {
  padding: 24rpx;
}

/* 统计卡片 */
.stats-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(59, 130, 246, 0.08);
  border: 2rpx solid rgba(59, 130, 246, 0.1);
}

.stats-icon {
  width: 72rpx;
  height: 72rpx;
  background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stats-info {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.stats-count {
  font-size: 44rpx;
  font-weight: 700;
  color: #3b82f6;
}

.stats-label {
  font-size: 28rpx;
  color: #666;
}

/* 加载中 */
.loading-wrapper {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}

.loading-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  background: #fff;
  padding: 60rpx 80rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.loading-text {
  font-size: 28rpx;
  color: #666;
}

/* 空态 */
.empty-wrapper {
  padding: 80rpx 0;
}

.empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #fff;
  padding: 80rpx 60rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.empty-icon {
  margin-bottom: 32rpx;
  opacity: 0.6;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.empty-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
  padding: 24rpx 48rpx;
  border-radius: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(59, 130, 246, 0.35);
}

.empty-btn:active {
  transform: scale(0.98);
}

.empty-btn-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #fff;
}

/* 反馈列表 */
.feedback-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.feedback-card {
  position: relative;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  transition: all 0.2s ease;
}

.feedback-card:active {
  transform: scale(0.99);
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

/* 卡片头部 */
.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.card-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.card-time {
  font-size: 26rpx;
  color: #999;
}

/* 类型标签 - 渐变样式 */
.type-tag {
  position: absolute;
  top: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 10rpx 20rpx;
  border-radius: 0 20rpx 0 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.15);
}

.type-tag-text {
  font-size: 26rpx;
  font-weight: 500;
  color: #fff;
}

/* 系统BUG - 红→橙 */
.type-tag.type-bug {
  background: linear-gradient(135deg, #ef4444 0%, #f97316 100%);
}

/* 新增功能建议 - 蓝→紫 */
.type-tag.type-feature {
  background: linear-gradient(135deg, #3b82f6 0%, #8b5cf6 100%);
}

/* 现有模块优化 - 绿→青 */
.type-tag.type-optimize {
  background: linear-gradient(135deg, #10b981 0%, #14b8a6 100%);
}

/* 个人想法 - 橙→黄 */
.type-tag.type-idea {
  background: linear-gradient(135deg, #f59e0b 0%, #eab308 100%);
}

/* 默认/其他 - 灰色渐变 */
.type-tag.type-default {
  background: linear-gradient(135deg, #6b7280 0%, #9ca3af 100%);
}

.card-status {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
}

.card-status.pending {
  background: #fef3c7;
  color: #d97706;
}

.card-status.processing {
  background: #dbeafe;
  color: #2563eb;
}

.card-status.done {
  background: #dcfce7;
  color: #16a34a;
}

.status-text {
  font-weight: 500;
}

/* 卡片内容 */
.card-body {
  margin-bottom: 20rpx;
}

.card-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.card-content {
  display: -webkit-box;
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 照片缩略图 */
.card-photos {
  display: flex;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.photo-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  object-fit: cover;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.photo-more {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #f0f0f0 0%, #e5e5e5 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.more-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #666;
}

/* 卡片底部 */
.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.card-user {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.user-name {
  font-size: 24rpx;
  color: #999;
}

.card-actions {
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.action-delete {
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(239, 68, 68, 0.08);
}

.action-delete:active {
  background: rgba(239, 68, 68, 0.15);
}

.delete-text {
  font-size: 24rpx;
  color: #ef4444;
}

.card-arrow {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.arrow-text {
  font-size: 24rpx;
  background: linear-gradient(to right, #10b981, #14b8a6);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

/* 加载更多 */
.load-more {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
}

.load-more-inner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #fff;
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

.load-more-inner:active {
  background: #f5f5f5;
}

.load-more-text {
  font-size: 28rpx;
  color: #3b82f6;
  font-weight: 500;
}

.no-more {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  padding: 40rpx 0;
}

.no-more-line {
  width: 80rpx;
  height: 2rpx;
  background: linear-gradient(90deg, transparent 0%, #ddd 50%, transparent 100%);
}

.no-more-text {
  font-size: 24rpx;
  color: #ccc;
}
