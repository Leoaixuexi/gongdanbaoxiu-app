/* 我的反馈列表页面 - 现代化UI设计 */

.feedback-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0fdf4 0%, #f5f5f5 100%);
  padding-bottom: 48rpx;
}

/* 导航栏 - 绿色渐变背景 */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  z-index: 100;
}

.nav-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}

.nav-left {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: background-color 0.2s;
}

.nav-left:active {
  background-color: rgba(255, 255, 255, 0.15);
}

.nav-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: 1rpx;
}

.nav-right {
  width: 80rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

/* 列表区域 */
.list-content {
  padding: 24rpx;
}

/* 加载中 */
.loading-wrapper {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}

/* 空态 */
.empty-wrapper {
  padding: 120rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 反馈列表 */
.feedback-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.feedback-card {
  background-color: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(16, 185, 129, 0.08);
  transition: all 0.2s;
  position: relative;
  overflow: hidden;
}

.feedback-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  background: linear-gradient(180deg, #10b981 0%, #059669 100%);
  border-radius: 3rpx;
}

.feedback-card:active {
  transform: scale(0.99);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

/* 卡片头部 */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-left: 12rpx;
}

.card-user {
  font-size: 26rpx;
  color: #10b981;
  font-weight: 600;
  background: linear-gradient(135deg, #f0fdf4 0%, #ecfdf5 100%);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.card-time {
  font-size: 24rpx;
  color: #9ca3af;
}

/* 标题 */
.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 12rpx;
  padding-left: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 内容摘要 */
.card-content {
  font-size: 28rpx;
  color: #6b7280;
  line-height: 1.6;
  padding-left: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 照片缩略图 */
.card-photos {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
  padding-left: 12rpx;
}

.photo-thumb {
  width: calc((100% - 48rpx) / 4);
  aspect-ratio: 1;
  border-radius: 12rpx;
  object-fit: cover;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.photo-more {
  width: calc((100% - 48rpx) / 4);
  aspect-ratio: 1;
  border-radius: 12rpx;
  background: linear-gradient(135deg, rgba(16, 185, 129, 0.8) 0%, rgba(5, 150, 105, 0.8) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-more text {
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 32rpx 0;
  color: #10b981;
  font-size: 28rpx;
  font-weight: 500;
}

.load-more:active {
  opacity: 0.7;
}

.no-more {
  text-align: center;
  padding: 32rpx 0;
  color: #d1d5db;
  font-size: 26rpx;
}

.no-more::before,
.no-more::after {
  content: '—';
  margin: 0 16rpx;
  color: #e5e7eb;
}
