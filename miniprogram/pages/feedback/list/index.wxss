/* 我的反馈列表页面 */

.feedback-list-page {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 48rpx;
}

/* 导航栏 */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  z-index: 100;
  border-bottom: 1rpx solid #f0f0f0;
}

.nav-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}

.nav-left {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-left:active {
  opacity: 0.7;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.nav-right {
  width: 80rpx;
}

/* 列表区域 */
.list-content {
  padding: 24rpx;
}

/* 加载中 */
.loading-wrapper {
  display: flex;
  justify-content: center;
  padding: 120rpx 0;
}

/* 空态 */
.empty-wrapper {
  padding: 120rpx 0;
}

/* 反馈列表 */
.feedback-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.feedback-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  position: relative;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.feedback-card:active {
  background-color: #fafafa;
}

/* 卡片头部 */
.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.card-time {
  font-size: 26rpx;
  color: #999;
}

.card-dot {
  font-size: 26rpx;
  color: #999;
  margin: 0 12rpx;
}

.card-user {
  font-size: 26rpx;
  color: #999;
}

/* 标题 */
.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 12rpx;
  padding-right: 60rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 内容摘要 */
.card-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
  padding-right: 60rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 照片缩略图 */
.card-photos {
  display: flex;
  gap: 12rpx;
  margin-top: 20rpx;
}

.photo-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  object-fit: cover;
}

/* 右箭头 */
.card-arrow {
  position: absolute;
  right: 24rpx;
  top: 50%;
  transform: translateY(-50%);
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 32rpx 0;
  color: #3b82f6;
  font-size: 28rpx;
}

.load-more:active {
  opacity: 0.7;
}

.no-more {
  text-align: center;
  padding: 32rpx 0;
  color: #ccc;
  font-size: 26rpx;
}
