<!--我的反馈列表页面-->
<view class="feedback-list-page">
  <!-- 自定义导航栏 -->
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-content">
      <view class="nav-left" bindtap="goBack">
        <van-icon name="arrow-left" size="40rpx" color="#fff" />
      </view>
      <view class="nav-right"></view>
    </view>
  </view>

  <!-- 列表区域 -->
  <view class="list-content" style="padding-top: {{navBarHeight + 20}}px;">
    <!-- 统计卡片 -->
    <view wx:if="{{!loading && list.length > 0}}" class="stats-card">
      <view class="stats-icon">
        <van-icon name="todo-list-o" size="44rpx" color="#3b82f6" />
      </view>
      <view class="stats-info">
        <text class="stats-count">{{list.length}}</text>
        <text class="stats-label">条反馈记录</text>
      </view>
    </view>

    <!-- 加载中 -->
    <view wx:if="{{loading && list.length === 0}}" class="loading-wrapper">
      <view class="loading-card">
        <van-loading size="48rpx" color="#3b82f6" />
        <text class="loading-text">加载中...</text>
      </view>
    </view>

    <!-- 空态 -->
    <view wx:elif="{{!loading && list.length === 0}}" class="empty-wrapper">
      <view class="empty-card">
        <view class="empty-icon">
          <van-icon name="comment-o" size="120rpx" color="#ddd" />
        </view>
        <text class="empty-title">暂无反馈记录</text>
      </view>
    </view>

    <!-- 反馈列表 -->
    <view wx:else class="feedback-list">
      <view
        wx:for="{{list}}"
        wx:key="feedback_id"
        class="feedback-card"
        bindtap="goToDetail"
        data-id="{{item.feedback_id}}"
      >
        <!-- 卡片头部 -->
        <view class="card-header">
          <view class="card-meta">
            <van-icon name="clock-o" size="26rpx" color="#999" />
            <text class="card-time">{{item.created_at_str}}</text>
          </view>
          <!-- 类型标签 -->
          <view class="type-tag {{item.typeClass}}">
            <text class="type-tag-text">{{item.type || '其他'}}</text>
          </view>
        </view>

        <!-- 卡片内容 -->
        <view class="card-body">
          <text class="card-content">{{item.content_summary}}</text>
        </view>

        <!-- 底部：照片缩略图 -->
        <view wx:if="{{item.photos && item.photos.length > 0}}" class="card-photos">
          <image
            wx:for="{{item.photos}}"
            wx:for-item="photo"
            wx:for-index="pIndex"
            wx:key="pIndex"
            wx:if="{{pIndex < 3}}"
            class="photo-thumb"
            src="{{photo}}"
            mode="aspectFill"
          />
          <view wx:if="{{item.photos.length > 3}}" class="photo-more">
            <text class="more-text">+{{item.photos.length - 3}}</text>
          </view>
        </view>

        <!-- 卡片底部 -->
        <view class="card-footer">
          <view class="card-user">
            <van-icon name="user-o" size="24rpx" color="#999" />
            <text class="user-name">{{item.user_name}}</text>
          </view>
          <view class="card-actions">
            <view class="action-delete" catchtap="onDelete" data-id="{{item.feedback_id}}">
              <text class="delete-text">删除</text>
            </view>
            <view class="card-arrow">
              <text class="arrow-text">查看详情</text>
              <van-icon name="arrow" size="28rpx" color="#10b981" />
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 加载更多 -->
    <view wx:if="{{list.length > 0 && hasMore}}" class="load-more" bindtap="loadMore">
      <view wx:if="{{!loadingMore}}" class="load-more-inner">
        <van-icon name="replay" size="28rpx" color="#3b82f6" />
        <text class="load-more-text">加载更多</text>
      </view>
      <van-loading wx:else size="32rpx" color="#3b82f6">加载中...</van-loading>
    </view>

    <!-- 没有更多了 -->
    <view wx:if="{{list.length > 0 && !hasMore}}" class="no-more">
      <view class="no-more-line"></view>
      <text class="no-more-text">没有更多了</text>
      <view class="no-more-line"></view>
    </view>
  </view>
</view>
