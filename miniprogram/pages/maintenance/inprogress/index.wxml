<!--pages/maintenance/inprogress/index.wxml-->
<view class="container">
  <!-- Page Header -->
  <view class="page-header">
    <view class="page-title">维修中工单</view>
    <view class="count-badge" wx:if="{{totalCount > 0}}">
      {{totalCount}} 个
    </view>
  </view>

  <!-- Work Order List -->
  <view class="list-section">
    <block wx:if="{{!loading && workOrders.length > 0}}">
      <block wx:for="{{workOrders}}" wx:key="id">
        <view class="order-wrapper">
          <work-order-card
            workOrder="{{item}}"
            showDetails="{{false}}"
            bindtap="navigateToDetail"
            data-id="{{item.id}}"
          />

          <!-- Elapsed Time Info -->
          <view class="elapsed-info">
            <view class="elapsed-icon">⏱</view>
            <view class="elapsed-content">
              <text class="elapsed-label">{{item.elapsed_time}}</text>
              <text class="started-time"> 开始于 {{item.started_at_display}}</text>
            </view>
          </view>

          <!-- SLA Countdown -->
          <view class="sla-info" wx:if="{{item.sla_deadline}}">
            <view class="sla-icon">⏱</view>
            <view class="sla-content">
              <text class="sla-label">SLA剩余时间</text>
              <text class="sla-time {{item.sla_urgent ? 'urgent' : ''}}">
                {{item.sla_display}}
              </text>
            </view>
          </view>

          <!-- Priority Badge -->
          <view class="priority-badge priority-{{item.priority}}">
            {{item.priority_display}}
          </view>
        </view>
      </block>

      <!-- Load More -->
      <view class="load-more" wx:if="{{hasMore}}">
        <view class="weui-loadmore" wx:if="{{loadingMore}}">
          <view class="weui-loading"></view>
          <view class="weui-loadmore__tips">加载中...</view>
        </view>
        <view class="load-more-btn" wx:else bindtap="loadMore">
          <text>加载更多</text>
        </view>
      </view>

      <!-- No More -->
      <view class="no-more" wx:if="{{!hasMore && workOrders.length > 0}}">
        <text class="no-more-text">没有更多了</text>
      </view>
    </block>

    <!-- Loading State -->
    <view class="loading-state" wx:if="{{loading}}">
      <view class="skeleton-card" wx:for="{{[1,2,3]}}" wx:key="*this">
        <view class="skeleton-header"></view>
        <view class="skeleton-line"></view>
        <view class="skeleton-line short"></view>
      </view>
    </view>

    <!-- Empty State -->
    <view class="empty-state" wx:if="{{!loading && workOrders.length === 0}}">
      <image class="empty-icon" src="/assets/images/empty-order.png" mode="aspectFit"></image>
      <text class="empty-text">暂无维修中工单</text>
      <text class="empty-desc">当前没有正在处理的工单</text>
    </view>
  </view>
</view>
