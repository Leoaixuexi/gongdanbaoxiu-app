<!--pages/maintenance/history/index.wxml-->
<view class="container">
  <!-- Page Header with Tabs -->
  <view class="page-header">
    <view class="tabs">
      <block wx:for="{{tabs}}" wx:key="name">
        <view
          class="tab-item {{activeTab === index ? 'active' : ''}}"
          bindtap="switchTab"
          data-index="{{index}}"
        >
          <text class="tab-text">{{item.name}}</text>
          <view class="tab-indicator" wx:if="{{activeTab === index}}"></view>
        </view>
      </block>
    </view>
  </view>

  <!-- Work Order List -->
  <view class="list-section">
    <block wx:if="{{!loading && workOrders.length > 0}}">
      <block wx:for="{{workOrders}}" wx:key="id">
        <view class="order-wrapper">
          <work-order-card
            workOrder="{{item}}"
            showDetails="{{false}}"
            bindtap="navigateToDetail"
            data-id="{{item.id}}"
          />

          <!-- Completion Info -->
          <view class="completion-info status-{{item.status_color}}">
            <view class="completion-icon">
              <text wx:if="{{item.status === 'Completed'}}">✓</text>
              <text wx:elif="{{item.status === 'Repaired'}}">✓</text>
              <text wx:elif="{{item.status === 'Needs Rework'}}">↻</text>
            </view>
            <view class="completion-content">
              <text class="completion-label">
                <block wx:if="{{item.status === 'Completed'}}">已完成</block>
                <block wx:elif="{{item.status === 'Repaired'}}">待审核</block>
                <block wx:elif="{{item.status === 'Needs Rework'}}">需返工</block>
              </text>
              <text class="completion-time">{{item.relative_completed_time}}</text>
            </view>
            <view class="completion-date">
              {{item.completed_at_display}}
            </view>
          </view>

          <!-- Priority Badge -->
          <view class="priority-badge priority-{{item.priority}}">
            {{item.priority_display}}
          </view>
        </view>
      </block>

      <!-- Load More -->
      <view class="load-more" wx:if="{{hasMore}}">
        <view class="weui-loadmore" wx:if="{{loadingMore}}">
          <view class="weui-loading"></view>
          <view class="weui-loadmore__tips">加载中...</view>
        </view>
        <view class="load-more-btn" wx:else bindtap="loadMore">
          <text>加载更多</text>
        </view>
      </view>

      <!-- No More -->
      <view class="no-more" wx:if="{{!hasMore && workOrders.length > 0}}">
        <text class="no-more-text">没有更多了</text>
      </view>
    </block>

    <!-- Loading State -->
    <view class="loading-state" wx:if="{{loading}}">
      <view class="skeleton-card" wx:for="{{[1,2,3]}}" wx:key="*this">
        <view class="skeleton-header"></view>
        <view class="skeleton-line"></view>
        <view class="skeleton-line short"></view>
      </view>
    </view>

    <!-- Empty State -->
    <view class="empty-state" wx:if="{{!loading && workOrders.length === 0}}">
      <image class="empty-icon" src="/assets/images/empty-order.png" mode="aspectFit"></image>
      <text class="empty-text">暂无历史工单</text>
      <text class="empty-desc">您还没有完成的工单</text>
    </view>
  </view>
</view>
