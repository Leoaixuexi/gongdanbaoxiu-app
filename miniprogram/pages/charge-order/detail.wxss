page { background: #F2F4F8; }
.page { min-height: 100vh; width: 100vw; max-width: 100vw; background: #F2F4F8; display: flex; flex-direction: column; box-sizing: border-box; overflow-x: hidden; }

.scroll-area { flex: 1; padding: 24rpx 32rpx 0; width: 100%; box-sizing: border-box; overflow-x: hidden; }

/* 底部操作栏（参考工单详情样式） */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(40rpx);
  border-top: 1rpx solid rgba(0, 0, 0, 0.08);
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.08);
  padding: 32rpx;
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
}
.action-button {
  flex: 0 0 auto;
  height: 96rpx;
  border-radius: 24rpx;
  border: none;
  font-size: 32rpx;
  font-weight: 500;
  transition: all 0.2s;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx;
}
.action-button::after { border: none; }
.action-button:active { transform: scale(0.96); }
.action-button-more {
  flex: 0 0 110rpx;
  width: 110rpx;
  height: 110rpx;
  padding: 0;
  background: #F3F4F6;
  color: #6B7280;
  box-shadow: none;
  border-radius: 50%;
  align-self: center;
  transform: translateY(-10rpx);
}
.more-icon {
  font-size: 48rpx;
  font-weight: bold;
  color: #6B7280;
  line-height: 1;
}
.action-button-success {
  background: linear-gradient(to right, #10b981, #14b8a6);
  color: white;
  box-shadow: 0 8rpx 16rpx rgba(12, 167, 125, 0.2);
  min-width: 500rpx;
}
.action-button-edit {
  background: linear-gradient(to right, #10b981, #14b8a6);
  color: white;
  box-shadow: 0 8rpx 16rpx rgba(12, 167, 125, 0.2);
  min-width: 500rpx;
}
.action-button-text { color: inherit; }

/* 更多操作抽屉（参考工单详情样式） */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}
.more-actions-drawer {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: white;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  animation: slideUp 0.3s ease-out;
  display: flex;
  justify-content: flex-start;
  align-items: flex-start;
  gap: 24rpx;
}
@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
.drawer-action-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
  transition: all 0.2s;
}
.drawer-action-item .icon-wrapper {
  width: 100rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #F5F5F5;
  border: 2rpx solid #E5E5E5;
  border-radius: 16rpx;
  line-height: 1;
}
.drawer-action-item .icon-wrapper:active { background-color: #EBEBEB; }
.drawer-action-item .action-label {
  font-size: 24rpx;
  color: #333;
  margin-top: 12rpx;
}

.bottom-spacer { height: 100px; }

/* 待维修详情：参考物料入库详情 .rd-* 样式（.pending-info 作用域隔离 Completed 分支的同名类） */
.pending-info { width: 100%; box-sizing: border-box; overflow: hidden; }
.pending-info .rd-group { margin-bottom: 32rpx; }
.pending-info .rd-group-title {
  font-size: 24rpx;
  font-weight: 500;
  color: #a3a3a3;
  display: block;
  margin-bottom: 16rpx;
}

.pending-info .rd-card {
  background: linear-gradient(165deg, rgba(255,255,255,0.8) 0%, rgba(255,255,255,0.6) 100%);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 20rpx;
  border-top: 1rpx solid rgba(255,255,255,0.95);
  border-left: 1rpx solid rgba(255,255,255,0.6);
  border-right: 1rpx solid rgba(255,255,255,0.6);
  border-bottom: 1rpx solid rgba(0,0,0,0.03);
  box-shadow:
    inset 0 2rpx 4rpx rgba(255,255,255,0.8),
    inset 0 -1rpx 3rpx rgba(0,0,0,0.015),
    0 2rpx 4rpx rgba(0,0,0,0.02),
    0 8rpx 16rpx rgba(0,0,0,0.035),
    0 16rpx 32rpx -8rpx rgba(0,0,0,0.04);
  overflow: hidden;
  width: 100%;
  box-sizing: border-box;
}

.pending-info .rd-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid rgba(0,0,0,0.04);
  width: 100%;
  box-sizing: border-box;
}
.pending-info .rd-row-last { border-bottom: none; }

.pending-info .rd-label {
  font-size: 26rpx;
  color: #737373;
  flex-shrink: 0;
}
.pending-info .rd-value {
  font-size: 26rpx;
  color: #1a1a1a;
  font-weight: 500;
  flex-shrink: 1;
  margin-left: auto;
  max-width: 380rpx;
  text-align: right;
  word-wrap: break-word;
  word-break: break-all;
  line-height: 1.5;
}

.pending-info .rd-remark {
  padding: 24rpx 28rpx;
  font-size: 26rpx;
  color: #525252;
  line-height: 1.6;
}

.pending-info .priority-tag {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #ffffff;
  font-weight: 500;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1.4;
  min-width: 64rpx;
}
.pending-info .priority-green {
  background: linear-gradient(135deg, #34C759 0%, #30B753 100%);
  box-shadow: 0 4rpx 10rpx rgba(52, 199, 89, 0.3);
}
.pending-info .priority-red {
  background: linear-gradient(135deg, #FF3B30 0%, #E6352B 100%);
  box-shadow: 0 4rpx 10rpx rgba(255, 59, 48, 0.3);
}

.pending-info .photo-grid-inline {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 24rpx 28rpx;
}
.pending-info .photo-item-wrapper {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background-color: #F3F4F6;
  flex-shrink: 0;
}
.pending-info .photo-item-inline {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

/* ===== 已完成态：毛玻璃风格（.rd-* 作用域复用） ===== */
.completed-info { width: 100%; box-sizing: border-box; overflow: hidden; padding: 16rpx 0 0; }
.completed-info .rd-group { margin-bottom: 32rpx; }
.completed-info .rd-group-title {
  font-size: 24rpx;
  font-weight: 500;
  color: #a3a3a3;
  display: block;
  margin-bottom: 16rpx;
}
.completed-info .rd-card {
  background: linear-gradient(165deg, rgba(255,255,255,0.8) 0%, rgba(255,255,255,0.6) 100%);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 20rpx;
  border-top: 1rpx solid rgba(255,255,255,0.95);
  border-left: 1rpx solid rgba(255,255,255,0.6);
  border-right: 1rpx solid rgba(255,255,255,0.6);
  border-bottom: 1rpx solid rgba(0,0,0,0.03);
  box-shadow:
    inset 0 2rpx 4rpx rgba(255,255,255,0.8),
    inset 0 -1rpx 3rpx rgba(0,0,0,0.015),
    0 2rpx 4rpx rgba(0,0,0,0.02),
    0 8rpx 16rpx rgba(0,0,0,0.035),
    0 16rpx 32rpx -8rpx rgba(0,0,0,0.04);
  overflow: hidden;
  width: 100%;
  box-sizing: border-box;
}
.completed-info .rd-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid rgba(0,0,0,0.04);
  width: 100%;
  box-sizing: border-box;
}
.completed-info .rd-row-last { border-bottom: none; }
.completed-info .rd-label {
  font-size: 26rpx;
  color: #737373;
  flex-shrink: 0;
}
.completed-info .rd-value {
  font-size: 26rpx;
  color: #1a1a1a;
  font-weight: 500;
  flex-shrink: 1;
  margin-left: auto;
  max-width: 380rpx;
  text-align: right;
  word-wrap: break-word;
  word-break: break-all;
  line-height: 1.5;
}
.completed-info .rd-value-blue { color: #1d4ed8; font-weight: 600; }
.completed-info .rd-value-green { color: #16a34a; font-weight: 500; }
.completed-info .rd-remark {
  padding: 24rpx 28rpx;
  font-size: 26rpx;
  color: #525252;
  line-height: 1.6;
}

/* 动态彩色徽章（沿用 inline-style 背景/文字色） */
.completed-info .status-badge {
  padding: 4rpx 20rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  font-weight: 500;
  display: inline-flex;
  align-items: center;
  line-height: 1.4;
}

/* 配件行（左列名+meta，右列金额） */
.completed-info .parts-list-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid rgba(0,0,0,0.04);
}
.completed-info .parts-name { font-size: 28rpx; color: #1a1a1a; font-weight: 500; }
.completed-info .parts-meta { font-size: 24rpx; color: #a3a3a3; display: block; margin-top: 4rpx; }
.completed-info .parts-subtotal { font-size: 28rpx; color: #1a1a1a; font-weight: 500; }

/* 费用明细总额行 */
.completed-info .fee-grand .rd-label { font-size: 28rpx; color: #1a1a1a; font-weight: 600; }
.completed-info .fee-grand .rd-value { font-size: 40rpx; color: #ef4444; font-weight: 700; }

/* 附件图片分段（rd-card 内 3 段） */
.completed-info .img-block {
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid rgba(0,0,0,0.04);
}
.completed-info .img-block-last { border-bottom: none; }
.completed-info .img-block-title { font-size: 26rpx; color: #737373; display: block; margin-bottom: 16rpx; }
.completed-info .img-row { display: flex; flex-wrap: wrap; gap: 16rpx; }
.completed-info .img-thumb { width: 144rpx; height: 144rpx; border-radius: 12rpx; background: rgba(255,255,255,0.5); }
.completed-info .img-placeholder {
  width: 144rpx; height: 144rpx; border-radius: 12rpx;
  background: rgba(255,255,255,0.3);
  border: 1rpx dashed rgba(0,0,0,0.1);
  display: flex; align-items: center; justify-content: center;
}

/* 状态双列行 */
.completed-info .status-pair {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  gap: 24rpx;
}
.completed-info .status-pair-item { flex: 1; display: flex; flex-direction: column; gap: 12rpx; }
