.page { height: 100vh; background: #f5f7fb; display: flex; flex-direction: column; box-sizing: border-box; }

/* Tab */
.tab-header { display: flex; background: #ffffff; border-bottom: 1rpx solid #f0f0f0; }
.tab-item { flex: 1; padding: 12px 0; display: flex; flex-direction: column; align-items: center; position: relative; }
.tab-text { font-size: 15px; color: #737373; }
.tab-active .tab-text { color: #1d4ed8; font-weight: 600; }
.tab-underline { position: absolute; bottom: 0; width: 28px; height: 3px; background: #1d4ed8; border-radius: 2px; }

.swiper { flex: 1; }
.scroll-area { height: 100%; box-sizing: border-box; }
.list-scroll { height: 100%; box-sizing: border-box; background: #f5f7fb; }

/* ========== 搜索 ========== */
.search-float { padding: 12px 16px 0; }
.search-card {
  background: #ffffff;
  border-radius: 14rpx;
  padding: 11px 14px;
  display: flex;
  align-items: center;
  gap: 10px;
  box-shadow: 0 6rpx 24rpx rgba(30, 64, 175, 0.14);
}
.search-input { flex: 1; font-size: 14px; color: #1e293b; height: 20px; line-height: 20px; }
.search-ph { color: #94a3b8; font-size: 14px; }
.search-clear { padding: 2px; }

/* ========== Segmented Control ========== */
.segmented {
  display: inline-flex;
  background: #eef2f7;
  margin: 16px 16px 12px;
  border-radius: 12rpx;
  padding: 6rpx;
  gap: 4rpx;
}
.seg-item {
  padding: 7px 28rpx;
  font-size: 13px;
  font-weight: 500;
  color: #64748b;
  text-align: center;
  border-radius: 10rpx;
  transition: all 0.2s;
}
.seg-active {
  background: #ffffff;
  color: #1e40af;
  font-weight: 600;
  box-shadow: 0 2rpx 6rpx rgba(15,23,42,0.08);
}

/* ========== 空状态 ========== */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  padding: 80px 0;
}
.empty-title { font-size: 14px; color: #64748b; font-weight: 500; }
.empty-sub { font-size: 12px; color: #94a3b8; }

/* ========== 列表卡片 ========== */
.list-wrap { padding: 0 16px; }

.card {
  position: relative;
  box-sizing: border-box;
  background: linear-gradient(165deg, rgba(255,255,255,0.8) 0%, rgba(255,255,255,0.6) 100%);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 24rpx;
  padding: 20rpx 24rpx 16rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow:
    inset 0 2rpx 4rpx rgba(255,255,255,0.8),
    inset 0 -1rpx 3rpx rgba(0,0,0,0.015),
    0 2rpx 4rpx rgba(0,0,0,0.02),
    0 8rpx 16rpx rgba(0,0,0,0.035),
    0 16rpx 32rpx -8rpx rgba(0,0,0,0.04);
  border-top: 1rpx solid rgba(255,255,255,0.95);
  border-left: 1rpx solid rgba(255,255,255,0.6);
  border-right: 1rpx solid rgba(255,255,255,0.6);
  border-bottom: 1rpx solid rgba(0,0,0,0.05);
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.card-row { display: flex; align-items: center; }
.card-row-between { justify-content: space-between; }
.row-gap { gap: 16rpx; }
.mt2 { margin-top: 4rpx; }

.order-no-row { display: flex; align-items: center; gap: 12rpx; }
.order-no { font-size: 28rpx; font-weight: bold; color: #10b981; letter-spacing: -0.5px; }

.tag-emergency { font-size: 20rpx; padding: 4rpx 12rpx; border-radius: 8rpx; background: #fee2e2; color: #dc2626; font-weight: 500; }
.tag-status { font-size: 22rpx; font-weight: 500; padding: 4rpx 14rpx; border-radius: 12rpx; }
.tag-pay { font-size: 20rpx; padding: 4rpx 14rpx; border-radius: 12rpx; }

.meta-chip-text { font-size: 24rpx; color: #64748b; }
.meta-compact {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-wrap: wrap;
  color: #94a3b8;
}

/* 客户/设备 */
.cust-name { font-size: 26rpx; font-weight: 500; color: #1e293b; }
.cust-device { font-size: 24rpx; color: #64748b; }
.dot { font-size: 20rpx; color: #cbd5e1; }

/* 卡片底 */
.card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 10rpx;
  margin-top: 4rpx;
  border-top: 1rpx dashed rgba(0,0,0,0.08);
}
.amount { font-size: 34rpx; font-weight: 700; color: #1e40af; letter-spacing: 0.3px; }
.footer-right { display: flex; align-items: center; gap: 16rpx; }

/* 已完成卡片头部 */
.charge-header { display: flex; align-items: center; justify-content: space-between; }

/* 总费用小标签 */
.amount-tag {
  font-size: 20rpx;
  font-weight: 700;
  color: #059669;
  background: #d1fae5;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  letter-spacing: 0.3px;
}

/* 确认单照片：蓝色边框以区分维修后照片 */
.photo-placeholder-confirm { border-color: #bfdbfe; background-color: #eff6ff; }

/* ========== Tab 2 · 数据看板（保留） ========== */
.kpi-grid { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; padding: 10px 16px 0; }
.kpi-card { flex: 1 1 calc(50% - 4px); min-width: calc(50% - 4px); background: #ffffff; border-radius: 10px; padding: 12px; border: 1rpx solid #e5e7eb; display: flex; flex-direction: column; gap: 4px; }
.kpi-label { font-size: 11px; color: #737373; }
.kpi-value { font-size: 22px; font-weight: 700; color: #1a1a1a; }
.kpi-accent { color: #1d4ed8; }
.kpi-trend { font-size: 11px; font-weight: 500; }

.chart-card { background: #ffffff; border-radius: 10px; padding: 14px; margin: 0 16px 12px; border: 1rpx solid #e5e7eb; }
.chart-title { font-size: 14px; font-weight: 600; color: #1a1a1a; display: block; margin-bottom: 8px; }
.chart-box { width: 100%; height: 200px; }
.chart-box-pie { height: 240px; }

.rank-card { background: #ffffff; border-radius: 10px; padding: 14px; margin: 0 16px 12px; border: 1rpx solid #e5e7eb; }
.rank-item { display: flex; align-items: center; gap: 10px; padding: 8px 0; border-bottom: 1rpx solid #f5f5f5; }
.rank-item:last-child { border-bottom: 0; }
.rank-index { width: 20px; height: 20px; border-radius: 10px; background: #eff6ff; color: #1d4ed8; font-size: 11px; font-weight: 600; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.rank-main { flex: 1; }
.rank-head { display: flex; justify-content: space-between; margin-bottom: 4px; }
.rank-name { font-size: 13px; color: #1a1a1a; }
.rank-amount { font-size: 13px; font-weight: 600; color: #1d4ed8; }
.rank-bar-bg { height: 4px; background: #eff6ff; border-radius: 2px; overflow: hidden; }
.rank-bar-fg { height: 100%; background: linear-gradient(to right, #60a5fa, #1d4ed8); border-radius: 2px; }

/* ========== 待维修卡片：复用主工单列表 ticket-card 样式 ========== */
.ticket-card {
  position: relative;
  box-sizing: border-box;
  background: linear-gradient(165deg, rgba(255,255,255,0.8) 0%, rgba(255,255,255,0.6) 100%);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-radius: 24rpx;
  padding: 20rpx 24rpx 16rpx 24rpx;
  box-shadow:
    inset 0 2rpx 4rpx rgba(255,255,255,0.8),
    inset 0 -1rpx 3rpx rgba(0,0,0,0.015),
    0 2rpx 4rpx rgba(0,0,0,0.02),
    0 8rpx 16rpx rgba(0,0,0,0.035),
    0 16rpx 32rpx -8rpx rgba(0,0,0,0.04);
  border-top: 1rpx solid rgba(255,255,255,0.95);
  border-left: 1rpx solid rgba(255,255,255,0.6);
  border-right: 1rpx solid rgba(255,255,255,0.6);
  border-bottom: 1rpx solid rgba(0,0,0,0.05);
  margin-bottom: 16rpx;
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.ticket-card::before {
  content: "";
  position: absolute;
  top: 0; left: 10%; right: 10%;
  height: 1px;
  background: linear-gradient(90deg, rgba(255,255,255,0) 0%, rgba(255,255,255,1) 50%, rgba(255,255,255,0) 100%);
  z-index: 1;
}
.ticket-card:active { transform: translateY(6rpx) scale(0.98); }

.status-badge {
  position: absolute;
  top: 0; right: 0;
  padding: 10rpx 26rpx;
  font-size: 22rpx;
  font-weight: bold;
  border-radius: 0 24rpx 0 16rpx;
  z-index: 10;
}
.status-reported {
  background-color: #dbeafe;
  color: #2563eb;
  box-shadow: 0 2px 8px rgba(37, 99, 235, 0.2);
}
.status-completed {
  background-color: #d1fae5;
  color: #059669;
  box-shadow: 0 2px 8px rgba(5, 150, 105, 0.2);
}

.ticket-id-row { display: flex; align-items: center; gap: 16rpx; }
.ticket-id { font-size: 28rpx; font-weight: bold; color: #10b981; letter-spacing: -0.5px; line-height: 1; }

.priority-badge { font-size: 18rpx; font-weight: bold; padding: 4rpx 16rpx; border-radius: 24rpx; }
.priority-emergency { background-color: #EF4444; color: #ffffff; box-shadow: 0 2px 8px rgba(239, 68, 68, 0.3); }

.description-box {
  background-color: #E5E7EB;
  border-radius: 24rpx;
  padding: 2rpx 20rpx;
  color: #111827;
  font-size: 26rpx;
  line-height: 1.5;
  border: 1px solid #F3F4F6;
  display: inline-block;
  max-width: 78%;
  word-break: break-all;
}

.metadata-wrapper { display: flex; flex-direction: column; gap: 10rpx; font-size: 24rpx; padding-right: 32rpx; }
.metadata-line { display: flex; justify-content: space-between; align-items: center; }
.metadata-left { flex: 1; justify-content: flex-start; }
.metadata-center { flex: 1; justify-content: center; }
.metadata-right { flex: 1; justify-content: flex-end; }
.metadata-item { display: flex; align-items: center; gap: 8rpx; color: #777; }
.metadata-text { color: #111827; font-weight: normal; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 24rpx; }
.location-separator { width: 16rpx; display: inline-block; }

/* 图标：person/building/location/time 均 24rpx，user 28rpx */
.icon { margin-right: 6rpx; opacity: 0.6; flex-shrink: 0; background-size: contain; background-repeat: no-repeat; background-position: center; }
.icon-person, .icon-building, .icon-location, .icon-time { width: 24rpx; height: 24rpx; }
.icon-user { width: 28rpx; height: 28rpx; }
