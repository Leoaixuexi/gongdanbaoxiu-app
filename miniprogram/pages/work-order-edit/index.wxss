/* pages/editOrder/editOrder.wxss */
.page-container {
  min-height: 100vh;
  background: #F5F5F5;
  padding-bottom: 160rpx;
}

.main-content {
  padding-top: 140rpx;
  padding-bottom: 80rpx;
  padding-left: 32rpx; /* Aligned with Submit Page */
  padding-right: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx; /* Submit Page gap */
  max-width: 1024rpx;
  margin: 0 auto;
}

/* Individual Card Style for Form Rows */
.main-content .form-row {
  background-color: white;
  border-radius: 16rpx;
  padding: 12rpx 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  border: none;
  margin-bottom: 0;
  align-items: center;
  min-height: 50rpx;
}

/* Extra compact for select type rows */
.main-content .form-row.compact {
  padding: 8rpx 28rpx;
  min-height: 40rpx;
}

.main-content .form-row:last-child {
  border-bottom: none;
}

/* Typography alignment */
.main-content .form-row .label-section {
  width: auto;
  min-width: 128rpx;
  font-size: 30rpx;
  color: #1F1F1F;
  font-weight: 500;
}

.main-content .form-row .content-section {
  justify-content: flex-end;
  align-items: center;
  padding-left: 16rpx;
}

.main-content .form-row .display-text,
.main-content .form-row .select-text,
.main-content .form-row .text-input,
.main-content .form-row .textarea-input {
  text-align: right;
  font-size: 30rpx;
  color: #333333;
  font-weight: 400;
}

/* Inputs styling */
.main-content .form-row .text-input,
.main-content .form-row .textarea-input {
  background: transparent;
  border-radius: 0;
  padding: 0;
  border: none;
  width: 100%;
  height: auto;
  line-height: 1.5;
  text-align: right;
}

.main-content .form-row .text-input::placeholder,
.main-content .form-row .textarea-input::placeholder {
  color: #CCCCCC;
}

.main-content .form-row .text-input[disabled],
.main-content .form-row .textarea-input[disabled],
.main-content .form-row .display-text {
  background: transparent;
  font-weight: 400;
  color: #CCCCCC; /* Disabled looking like submit page input disabled */
}

/* Submit page display text is often just input value styling */
.main-content .form-row .display-text {
   color: #333333; 
}


/* Select wrapper */
.main-content .form-row .select-wrapper {
  justify-content: flex-end;
  background: transparent;
  border-radius: 0;
  padding: 0;
  height: auto;
}

.main-content .form-row .select-text {
  font-weight: 400;
}

.main-content .form-row .select-text.placeholder {
  color: #CCCCCC;
}

/* Layout adjustments */
.main-content .form-row.align-start {
  align-items: flex-start;
  padding-top: 24rpx;
  padding-bottom: 24rpx;
  flex-direction: column; /* Submit page textarea cards are column flex */
  gap: 24rpx;
}

.main-content .form-row.align-start .content-section {
  width: 100%;
  padding-left: 0;
  justify-content: flex-start;
}

.main-content .form-row.align-start .text-input,
.main-content .form-row.align-start .textarea-input {
  text-align: left;
  min-height: 140rpx;
  background-color: #FAFAFA;
  border: 1rpx solid #F0E6D3; /* Submit page style */
  border-radius: 24rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

/* Photo Container */
.photo-container {
  display: flex;
  gap: 16rpx;
  padding: 0;
  width: 100%;
  justify-content: center;
  flex-wrap: nowrap;
}

/* Photo Items */
.photo-item, .add-photo-btn {
  width: 140rpx;
  height: 140rpx;
  border-radius: 24rpx;
}

.photo-image {
  width: 100%;
  height: 100%;
  background: #F9FAFB;
  border-radius: 24rpx;
  border: none;
}

.add-photo-btn {
  border: 2rpx dashed #DDDDDD;
  background: #F5F5F5;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

/* Remarks Section Card */
.remarks-section {
  display: flex;
  flex-direction: column;
  width: 100%;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 12rpx 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  box-sizing: border-box;
  gap: 8rpx; /* Minimal gap */
}

.remarks-section:hover {
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
}

.remarks-label {
  font-size: 30rpx;
  color: #333333;
  font-weight: 500;
  margin-bottom: 0; /* Handled by gap */
}

.remarks-input {
  width: 85%;
  margin-left: auto;
  background: #FAFAFA;
  border: 1rpx solid #F0E6D3; /* Match submit page border */
  border-radius: 24rpx;
  padding: 8rpx;
  font-size: 30rpx;
  color: #333;
  outline: none;
  resize: none;
  height: 160rpx !important;
  line-height: 1.6;
  box-sizing: border-box;
}

.remarks-input:focus {
  background: #FFFFFF;
  border-color: #10B981;
}

/* Remove Card Container */
.card-container {
  display: contents;
}

/* Custom Card Styles (for priority and datetime) */
.card {
  background-color: white;
  border-radius: 16rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
}

.card-label-required {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
}

.card-label-required .star {
  color: #FF3B30;
  font-size: 30rpx;
}

.card-label-required .label {
  font-size: 30rpx;
  color: #1F1F1F;
  font-weight: 500;
}

/* Priority Row */
.priority-row {
  display: flex;
  gap: 12rpx;
}

.priority-btn {
  width: 72rpx;
  height: 48rpx;
  background-color: #F5F5F5;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.priority-btn.active-green {
  background-color: #34C759;
}

.priority-btn.active-yellow {
  background-color: #FFCC00;
}

.priority-btn.active-orange {
  background-color: #FF9500;
}

.priority-btn.active-red {
  background-color: #FF3B30;
}

.priority-text {
  font-size: 26rpx;
  color: #666;
}

.priority-btn.active-green .priority-text,
.priority-btn.active-yellow .priority-text,
.priority-btn.active-orange .priority-text,
.priority-btn.active-red .priority-text {
  color: white;
}

/* DateTime Display */
.datetime-display {
  display: flex;
  align-items: center;
}

.datetime-text {
  font-size: 30rpx;
  color: #333;
}

/* Modal Overlay */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal-content {
  width: 100%;
  background-color: white;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  animation: slide-up 0.3s ease-out;
}

@keyframes slide-up {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 48rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 500;
  color: #333;
}

.datetime-picker-content {
  margin-bottom: 64rpx;
}

.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.picker-row:last-child {
  border-bottom: none;
}

.picker-label {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

.datetime-picker-display {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  padding: 16rpx 24rpx;
  background-color: #f9fafb;
  border-radius: 12rpx;
  margin-left: 32rpx;
}

.datetime-picker-text {
  font-size: 30rpx;
  color: #333;
}

.modal-actions {
  display: flex;
  gap: 32rpx;
}

.modal-button {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
}

.modal-button-cancel {
  background-color: white;
  border: 1rpx solid #DDDDDD;
}

.modal-button-confirm {
  background: linear-gradient(to right, #10b981, #14b8a6);
}

.modal-button-text {
  font-size: 32rpx;
  font-weight: 500;
  color: #666;
}

.modal-button-text-white {
  color: white;
}
