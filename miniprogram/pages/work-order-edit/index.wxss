/* pages/editOrder/editOrder.wxss */
.page-container {
  min-height: 100vh;
  background: #F8FAFC;
  padding-bottom: 160rpx;
}

.main-content {
  padding-top: 140rpx;
  padding-bottom: 192rpx;
  padding-left: 32rpx;
  padding-right: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  max-width: 1024rpx;
  margin: 0 auto;
}

/* 照片容器 */
.photo-container {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 0 12rpx 0;
  width: 100%;
  justify-content: flex-end;
  box-sizing: border-box;
}

.photo-container::-webkit-scrollbar {
  display: none;
}

/* 照片槽位 */
.photo-slot {
  flex-shrink: 0;
}

.photo-item {
  position: relative;
  width: 120rpx;
  height: 120rpx;
  flex-shrink: 0;
}

.photo-image {
  width: 100%;
  height: 100%;
  background: #f1f5f9;
  border-radius: 12rpx;
  overflow: hidden;
  border: 1rpx solid #e2e8f0;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.3s ease;
  box-sizing: border-box;
  display: block;
}

.photo-image:active {
  transform: scale(0.95);
}

/* 删除按钮 */
.delete-btn {
  position: absolute;
  top: 2rpx;
  right: 2rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.6);
  backdrop-filter: blur(10rpx);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
  border: 2rpx solid rgba(255, 255, 255, 0.2);
  transition: transform 0.2s ease;
}

.delete-btn:active {
  transform: scale(0.9);
}

/* X 图标 */
.icon-x {
  width: 20rpx;
  height: 20rpx;
  position: relative;
}

.icon-x::before,
.icon-x::after {
  content: '';
  position: absolute;
  width: 20rpx;
  height: 3rpx;
  background: #ffffff;
  border-radius: 2rpx;
  top: 50%;
  left: 50%;
}

.icon-x::before {
  transform: translate(-50%, -50%) rotate(45deg);
}

.icon-x::after {
  transform: translate(-50%, -50%) rotate(-45deg);
}

/* 添加照片按钮 */
.add-photo-btn {
  width: 120rpx;
  height: 120rpx;
  flex-shrink: 0;
  border-radius: 12rpx;
  border: 2rpx dashed rgba(16, 185, 129, 0.2);
  background: rgba(248, 250, 252, 0.5);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
  box-sizing: border-box;
}

.add-photo-btn:active {
  transform: scale(0.98);
  background: rgba(16, 185, 129, 0.08);
  border-color: rgba(16, 185, 129, 0.4);
}

/* Plus 图标 */
.icon-plus {
  width: 36rpx;
  height: 36rpx;
  position: relative;
  opacity: 0.5;
}

.icon-plus::before,
.icon-plus::after {
  content: '';
  position: absolute;
  background: #10b981;
  border-radius: 2rpx;
}

.icon-plus::before {
  width: 36rpx;
  height: 4rpx;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.icon-plus::after {
  width: 4rpx;
  height: 36rpx;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}

.add-photo-btn:active .icon-plus {
  opacity: 0.7;
}

/* 备注区域 */
.remarks-section {
  display: flex;
  flex-direction: column;
  width: 100%;
  background: #ffffff;
  border-radius: 24rpx;
  border: 1rpx solid rgba(241, 245, 249, 0.8);
  padding: 40rpx 32rpx;
  box-shadow: 0 4rpx 16rpx -4rpx rgba(0, 0, 0, 0.03);
  transition: box-shadow 0.3s ease;
  box-sizing: border-box;
}

.remarks-section:hover {
  box-shadow: 0 8rpx 24rpx -4rpx rgba(0, 0, 0, 0.06);
}

.remarks-label {
  font-size: 28rpx;
  color: #64748b;
  font-weight: 500;
  letter-spacing: -0.5rpx;
  margin-bottom: 24rpx;
}

.remarks-input {
  width: 100%;
  background: #f8fafc;
  border: 1rpx solid #e2e8f0;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 30rpx;
  color: #1e293b;
  outline: none;
  resize: none;
  min-height: 200rpx;
  line-height: 1.6;
  transition: all 0.2s ease;
  box-sizing: border-box;
}

.remarks-input:focus {
  background: #ffffff;
  border-color: rgba(16, 185, 129, 0.5);
  box-shadow: 0 0 0 6rpx rgba(16, 185, 129, 0.1);
}

.remarks-input[placeholder] {
  color: #cbd5e1;
}
