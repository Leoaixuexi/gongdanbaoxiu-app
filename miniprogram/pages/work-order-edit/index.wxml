<!--编辑工单页面-->
<wxs module="seg">
  module.exports = {
    findIdx: function (arr, key) {
      for (var i = 0; i < arr.length; i++) {
        if (arr[i].key === key) return i;
      }
      return 0;
    },
    findStrIdx: function (arr, value) {
      for (var i = 0; i < arr.length; i++) {
        if (arr[i] === value) return i;
      }
      return -1;
    }
  };
</wxs>
<view class="page">
  <custom-header title="编辑工单" />

  <view class="form" style="padding-top: calc({{headerHeight}}px + 16rpx);">

    <!-- 工单编号（只读） -->
    <view class="field">
      <view class="field-label">
        <text class="star">*</text>
        <text class="label">工单编号</text>
      </view>
      <view class="input-wrap">
        <input
          class="input"
          disabled
          value="{{formData.orderCode}}"
        />
      </view>
    </view>

    <!-- 楼层 + 具体位置 -->
    <view class="field-row">
      <view class="field field-half field-floor">
        <view class="field-label">
          <text class="label">楼层</text>
          <text class="star">*</text>
        </view>
        <view class="input-wrap input-with-arrow" bindtap="openSelector" data-type="floor">
          <text class="picker-text {{formData.floor ? '' : 'ph-text'}}">{{formData.floor || '请选择'}}</text>
          <view class="arrow"></view>
        </view>
      </view>
      <view class="field field-half">
        <view class="field-label">
          <text class="label">具体位置</text>
          <text class="star">*</text>
        </view>
        <view class="input-wrap">
          <input
            class="input"
            placeholder="请填写"
            placeholder-class="ph"
            value="{{formData.location}}"
            bindinput="handleLocationChange"
          />
        </view>
      </view>
    </view>

    <!-- 工单类别 -->
    <view class="field">
      <view class="field-label">
        <text class="label">工单类别</text>
        <text class="star">*</text>
      </view>
      <view class="input-wrap input-with-arrow" bindtap="openSelector" data-type="category">
        <text class="picker-text {{formData.category ? '' : 'ph-text'}}">{{formData.category || '请选择'}}</text>
        <view class="arrow"></view>
      </view>
    </view>

    <!-- 责任方（按钮组） -->
    <view class="field">
      <view class="field-label">
        <text class="label">责任方</text>
        <text class="star">*</text>
      </view>
      <view class="party-row" style="--seg-idx: {{seg.findStrIdx(responsibleOptions, formData.responsible)}}; --seg-count: {{responsibleOptions.length}};">
        <view class="seg-thumb" wx:if="{{formData.responsible}}"></view>
        <view
          wx:for="{{responsibleOptions}}"
          wx:key="*this"
          class="party-btn {{formData.responsible === item ? 'active' : ''}}"
          hover-class="seg-pressed"
          hover-stay-time="120"
          bindtap="onResponsiblePartySelect"
          data-value="{{item}}"
        >
          <text class="party-text">{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 优先级（按钮组） -->
    <view class="field">
      <view class="field-label">
        <text class="label">优先级</text>
        <text class="star">*</text>
      </view>
      <view class="priority-row" style="--seg-idx: {{seg.findIdx(priorityOptions, selectedPriority)}}; --seg-count: {{priorityOptions.length}};">
        <view class="seg-thumb" wx:if="{{selectedPriority}}"></view>
        <view
          wx:for="{{priorityOptions}}"
          wx:key="key"
          class="priority-btn {{selectedPriority === item.key ? 'active-' + item.color : ''}}"
          hover-class="seg-pressed"
          hover-stay-time="120"
          bindtap="onPrioritySelect"
          data-key="{{item.key}}"
        >
          <text class="priority-text">{{item.label}}</text>
        </view>
      </view>
    </view>

    <!-- 报修时间 -->
    <view class="field">
      <view class="field-label">
        <text class="label">报修时间</text>
        <text class="star">*</text>
      </view>
      <view class="input-wrap" bindtap="showDateTimePicker">
        <text class="datetime-text">{{formData.reportTime}}</text>
      </view>
    </view>

    <!-- 报修人（只读） -->
    <view class="field">
      <view class="field-label">
        <text class="label">报修人</text>
        <text class="star">*</text>
      </view>
      <view class="input-wrap">
        <text class="picker-text">{{formData.reporter}}</text>
      </view>
    </view>

    <!-- 问题描述 -->
    <view class="field">
      <view class="field-label">
        <text class="label">问题描述</text>
        <text class="star">*</text>
      </view>
      <view class="textarea-wrap textarea-wrap-sm">
        <textarea
          class="textarea textarea-sm"
          placeholder="请详细描述遇到的问题..."
          placeholder-class="ph"
          placeholder-style="font-weight: 400; font-size: 28rpx;"
          value="{{formData.description}}"
          bindinput="handleDescriptionChange"
          maxlength="30"
        />
      </view>
    </view>

    <!-- 现场照片 -->
    <view class="field">
      <view class="field-label">
        <text class="label">现场照片</text>
        <text class="star">*</text>
        <text class="label-tip">最多 3 张</text>
      </view>
      <view class="photos-row">
        <view wx:for="{{photoSlots}}" wx:key="index" class="photo-box">
          <view wx:if="{{item}}" class="photo-preview">
            <image class="photo-img" src="{{item}}" mode="aspectFill" bindtap="handlePreviewImage" data-index="{{index}}" />
            <view class="photo-del" bindtap="handleRemoveImage" data-index="{{index}}">
              <text class="del-text">×</text>
            </view>
          </view>
          <view wx:else class="photo-add" bindtap="handleAddImage" data-index="{{index}}">
            <text class="add-plus">+</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 备注 -->
    <view class="field">
      <view class="field-label">
        <text class="label">备注</text>
      </view>
      <view class="textarea-wrap textarea-wrap-sm">
        <textarea
          class="textarea textarea-sm"
          placeholder="请填写备注信息（非必填）"
          placeholder-class="ph"
          placeholder-style="font-weight: 400; font-size: 28rpx;"
          value="{{formData.remarks}}"
          bindinput="handleRemarksChange"
          maxlength="30"
        />
      </view>
    </view>
  </view>

  <!-- 底部按钮 -->
  <view class="bottom-surface">
    <view class="bottom-actions">
      <view class="btn btn-cancel" bindtap="handleCancel">
        <text class="btn-cancel-text">取消</text>
      </view>
      <view class="btn btn-submit" bindtap="handleSave">
        <text class="btn-submit-text">保存修改</text>
      </view>
    </view>
  </view>

  <!-- 日期时间选择弹窗 -->
  <view wx:if="{{isDateTimePickerOpen}}" class="modal-overlay" catchtap="closeDateTimePicker">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">选择日期时间</text>
      </view>

      <view class="datetime-picker-content">
        <view class="picker-row">
          <text class="picker-label">日期</text>
          <picker mode="date" value="{{tempDate}}" bindchange="onTempDateChange">
            <view class="datetime-picker-display">
              <text class="datetime-picker-text">{{tempDate || '请选择日期'}}</text>
            </view>
          </picker>
        </view>
        <view class="picker-row">
          <text class="picker-label">时间</text>
          <picker mode="time" value="{{tempTime}}" bindchange="onTempTimeChange">
            <view class="datetime-picker-display">
              <text class="datetime-picker-text">{{tempTime || '请选择时间'}}</text>
            </view>
          </picker>
        </view>
      </view>

      <view class="modal-actions">
        <view class="modal-button modal-button-cancel" bindtap="cancelDateTimePicker">
          <text class="modal-button-text">取消</text>
        </view>
        <view class="modal-button modal-button-confirm" bindtap="confirmDateTimePicker">
          <text class="modal-button-text modal-button-text-white">确定</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 通用底部选择器弹窗 -->
  <custom-picker
    show="{{ isSelectorOpen }}"
    columns="{{ selectorOptions }}"
    value="{{ selectorCurrentValue }}"
    bind:confirm="onSelectorConfirm"
    bind:cancel="closeSelector"
  />
</view>
