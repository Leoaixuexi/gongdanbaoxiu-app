<!-- pages/editOrder/editOrder.wxml -->
<view class="page-container">
  <!-- 自定义Header -->
  <custom-header title="编辑工单" />

  <!-- 主内容区域 -->
  <view class="main-content" style="padding-top: calc({{headerHeight}}px + 32rpx);">

    <!-- 工单编号 -->
    <form-row
      label="工单编号"
      value="{{formData.orderCode}}"
      type="display"
      size="compact"
      required="{{true}}"
    />

    <!-- 楼层 -->
    <form-row
      label="楼层"
      value="{{formData.floor}}"
      type="text"
      size="compact"
      bind:change="handleFloorChange"
      required="{{true}}"
    />

    <!-- 具体位置 -->
    <form-row
      label="具体位置"
      value="{{formData.location}}"
      type="text"
      size="compact"
      bind:change="handleLocationChange"
      required="{{true}}"
    />

    <!-- 工单类别 -->
    <form-row
      label="工单类别"
      value="{{formData.category}}"
      type="select"
      size="compact"
      bind:selectclick="handleCategorySelect"
      required="{{true}}"
    />

    <!-- 责任方 -->
    <form-row
      label="责任方"
      value="{{formData.responsible}}"
      type="select"
      size="compact"
      bind:selectclick="handleResponsibleSelect"
      required="{{true}}"
    />

    <!-- 优先级 -->
    <form-row
      label="优先级"
      size="compact"
      required="{{true}}"
      hasSlot="{{true}}"
    >
      <view class="priority-row">
        <view
          wx:for="{{priorityOptions}}"
          wx:key="key"
          class="priority-btn {{selectedPriority === item.key ? 'active-' + item.color : ''}}"
          bindtap="onPrioritySelect"
          data-key="{{item.key}}"
        >
          <text class="priority-text">{{item.label}}</text>
        </view>
      </view>
    </form-row>

    <!-- 报修时间 -->
    <form-row
      label="报修时间"
      size="compact"
      required="{{true}}"
      hasSlot="{{true}}"
    >
      <view class="datetime-display" bindtap="showDateTimePicker">
        <text class="datetime-text">{{formData.reportTime}}</text>
      </view>
    </form-row>

    <!-- 工单状态 -->
    <form-row
      label="工单状态"
      value="{{formData.status}}"
      type="display"
      size="compact"
      required="{{true}}"
    />

    <!-- 报修人 -->
    <form-row
      label="报修人"
      value="{{formData.reporter}}"
      type="display"
      size="compact"
      required="{{true}}"
    />

    <!-- 问题描述 -->
    <form-row
      label="问题描述"
      value="{{formData.description}}"
      type="textarea"
      align="start"
      bind:change="handleDescriptionChange"
      required="{{true}}"
      maxlength="50"
    />

    <!-- 现场照片 -->
    <form-row
      label="现场照片"
      align="start"
      required="{{true}}"
      hasSlot="{{true}}"
    >
      <view class="photo-container">
        <!-- 固定3个照片槽位 -->
        <block wx:for="{{photoSlots}}" wx:key="index">
          <view class="photo-slot">
            <!-- 如果有照片则显示照片 -->
            <block wx:if="{{item}}">
              <view class="photo-item">
                <image
                  class="photo-image"
                  src="{{item}}"
                  mode="aspectFill"
                  bindtap="handlePreviewImage"
                  data-index="{{index}}"
                />
                <!-- 删除按钮 -->
                <view class="delete-btn" bindtap="handleRemoveImage" data-index="{{index}}">
                  <view class="icon-x"></view>
                </view>
              </view>
            </block>
            <!-- 如果没有照片则显示添加按钮 -->
            <block wx:else>
              <view
                class="add-photo-btn"
                bindtap="handleAddImage"
                data-index="{{index}}"
              >
                <view class="icon-plus"></view>
              </view>
            </block>
          </view>
        </block>
      </view>
    </form-row>

    <!-- 备注 -->
    <view class="remarks-section">
      <view class="remarks-label">备注</view>
      <textarea
        class="remarks-input"
        placeholder="请填写备注信息(非必填)"
        value="{{formData.remarks}}"
        bindinput="handleRemarksChange"
        maxlength="-1"
      />
    </view>

  </view>

  <!-- 底部操作栏 -->
  <custom-footer bind:save="handleSave" bind:cancel="handleCancel" />

  <!-- 日期时间选择弹窗 -->
  <view wx:if="{{isDateTimePickerOpen}}" class="modal-overlay" catchtap="closeDateTimePicker">
    <view class="modal-content" catchtap="stopPropagation">
      <view class="modal-header">
        <text class="modal-title">选择日期时间</text>
      </view>

      <view class="datetime-picker-content">
        <view class="picker-row">
          <text class="picker-label">日期</text>
          <picker mode="date" value="{{tempDate}}" bindchange="onTempDateChange">
            <view class="datetime-picker-display">
              <text class="datetime-picker-text">{{tempDate || '请选择日期'}}</text>
            </view>
          </picker>
        </view>
        <view class="picker-row">
          <text class="picker-label">时间</text>
          <picker mode="time" value="{{tempTime}}" bindchange="onTempTimeChange">
            <view class="datetime-picker-display">
              <text class="datetime-picker-text">{{tempTime || '请选择时间'}}</text>
            </view>
          </picker>
        </view>
      </view>

      <view class="modal-actions">
        <view class="modal-button modal-button-cancel" bindtap="cancelDateTimePicker">
          <text class="modal-button-text">取消</text>
        </view>
        <view class="modal-button modal-button-confirm" bindtap="confirmDateTimePicker">
          <text class="modal-button-text modal-button-text-white">确定</text>
        </view>
      </view>
    </view>
  </view>
</view>
