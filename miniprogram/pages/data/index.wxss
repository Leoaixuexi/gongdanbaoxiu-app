/**
 * 数据页面样式
 */

/* 全局变量定义 */
page {
  --border: #e5e7eb;
  --foreground: #111827; /* Darker, crisper text */
  --muted-foreground: #6b7280;
  --muted: #f3f4f6;
  --secondary: #f9fafb;
  --primary: #00A678;
  --primary-gradient: linear-gradient(135deg, #00A678 0%, #059669 100%);
  --card-bg: rgba(255, 255, 255, 0.9);
  --glass-border: 1px solid rgba(255, 255, 255, 0.6);
  --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
  --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
}

.container {
  min-height: 100vh;
  padding-bottom: 180rpx;
  background: #f3f4f6; /* Lighter, warmer gray */
  background-image: linear-gradient(to bottom, #ebf5ff, #f3f4f6 600rpx); /* Subtle top gradient */
}

.gradient-bg {
  background: transparent;
}

/* 工具类 */
.flex {
  display: flex;
}

.items-center {
  align-items: center;
}

.justify-between {
  justify-content: space-between;
}

.justify-center {
  justify-content: center;
}

.flex-1 {
  flex: 1;
}

.min-w-0 {
  min-width: 0;
}

.gap-1 {
  gap: 8rpx;
}

.gap-2 {
  gap: 16rpx;
}

.gap-3 {
  gap: 24rpx;
}

.gap-4 {
  gap: 32rpx;
}

.flex-col {
  flex-direction: column;
}

.text-center {
  text-align: center;
}

.text-right {
  text-align: right;
}

.truncate {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tracking-tight {
  letter-spacing: -0.5rpx;
}

/* 文字大小 */
.text-xs {
  font-size: 24rpx;
}

.text-sm {
  font-size: 28rpx;
}

.text-base {
  font-size: 32rpx;
}

.text-xl {
  font-size: 36rpx;
}

.text-2xl {
  font-size: 48rpx;
}

.text-3xl {
  font-size: 56rpx;
}

/* 字重 */
.font-medium {
  font-weight: 500;
}

.font-semibold {
  font-weight: 600;
}

.font-bold {
  font-weight: 700;
}

/* 颜色 */
.text-white {
  color: #ffffff;
}

.text-foreground {
  color: var(--foreground);
}

.text-muted-foreground {
  color: var(--muted-foreground);
}

.text-primary {
  color: var(--primary);
}

.text-orange-500 {
  color: #f97316;
}

.text-blue-500 {
  color: #3b82f6;
}

.text-emerald-500 {
  color: #10b981;
}

.text-rose-500 {
  color: #f43f5e;
}

.text-amber-500 {
  color: #f59e0b;
}

.text-violet-500 {
  color: #8B5CF6;
}

.text-cyan-500 {
  color: #06B6D4;
}

/* Gradient text for KPI */
.text-gradient-green {
  background: linear-gradient(to right, #10b981, #14b8a6);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

/* 背景色 */
.bg-blue-50 {
  background-color: #eff6ff;
}

.bg-amber-50 {
  background-color: #fffbeb;
}

.bg-emerald-50 {
  background-color: #ecfdf5;
}

/* 间距 */
.p-4 {
  padding: 32rpx;
}

.p-5 {
  padding: 40rpx;
}

.px-5 {
  padding-left: 40rpx;
  padding-right: 40rpx;
}

.mb-1 {
  margin-bottom: 8rpx;
}

.mb-3 {
  margin-bottom: 24rpx;
}

.mt-1 {
  margin-top: 8rpx;
}

.mt-2 {
  margin-top: 16rpx;
}

.ml-1 {
  margin-left: 8rpx;
}

/* 边框 */
.border-r {
  border-right: 1rpx solid #e5e7eb;
}

.border-b {
  border-bottom: 1rpx solid #e5e7eb;
}

/* 定位 */
.relative {
  position: relative;
}

.absolute {
  position: absolute;
}

.right-0 {
  right: 0;
}

.bottom-0 {
  bottom: 0;
}

.z-0 {
  z-index: 0;
}

.z-10 {
  z-index: 10;
}

/* 透明度 */
.opacity-10 {
  opacity: 0.1;
}

/* 尺寸 */
.w-full {
  width: 100%;
}

.h-full {
  height: 100%;
}

/* 网格 */
.grid {
  display: grid;
}

.grid-cols-2 {
  grid-template-columns: repeat(2, 1fr);
}

.grid-cols-3 {
  grid-template-columns: repeat(3, 1fr);
}

.grid-cols-4 {
  grid-template-columns: repeat(4, 1fr);
}

/* 主内容区 */
.main {
  padding: 40rpx 40rpx 0;
}

.section {
  margin-bottom: 32rpx;
  padding: 40rpx;
  background-color: var(--card-bg);
  border-radius: 24rpx;
  backdrop-filter: blur(12px);
  border: var(--glass-border);
  box-shadow: var(--shadow-sm);
}

.section-title {
  margin-bottom: 32rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--foreground);
  letter-spacing: -0.5rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

/* 卡片样式 */
.card {
  background-color: var(--card-bg);
  border-radius: 24rpx;
  box-shadow: var(--shadow-sm);
  border: var(--glass-border);
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.card-backdrop {
  background-color: var(--card-bg);
  backdrop-filter: blur(8px);
}

/* 统计卡片 */
.stat-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 24rpx 20rpx;
  border-radius: 24rpx;
  transition: all 0.2s;
}

.stat-card:active {
  transform: scale(1.05);
}

/* 图标容器 */
.icon-wrapper {
  width: 64rpx;
  height: 64rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.icon-sm {
  width: 40rpx;
  height: 40rpx;
}

.icon-xs {
  width: 28rpx;
  height: 28rpx;
}

/* 分隔线 */
.separator {
  height: 1rpx;
  background-color: #e5e7eb;
  opacity: 0.6;
}

/* 徽章 */
.badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 16rpx;
  border-radius: 9999rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.badge-primary {
  background-color: #00A678;
  color: #ffffff;
  box-shadow: 0 2rpx 4rpx rgba(0, 166, 120, 0.2);
}

/* 头像 */
.avatar-sm {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
  border: 4rpx solid var(--border);
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.05);
  flex-shrink: 0;
}

.current-user-avatar {
  border-color: #00A678;
  box-shadow: 0 0 0 4rpx rgba(0, 166, 120, 0.2);
}

.avatar-sm image {
  width: 100%;
  height: 100%;
}

/* 趋势标识 */
.trend-badge {
  width: 56rpx;
  height: 56rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.trend-badge.up {
  background-color: #ecfdf5;
  color: #059669;
}

.trend-badge.down {
  background-color: #fff1f2;
  color: #e11d48;
}

.trend-badge.same {
  background-color: #f8fafc;
  color: #64748b;
}

.trend-badge.down image {
  transform: rotate(180deg);
}

.trend-line {
  width: 28rpx;
  height: 4rpx;
  background-color: #64748b;
  border-radius: 2rpx;
}

/* 个人绩效项 */
.performance-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f3f4f6;
}

.performance-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.performance-icon-text {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: bold;
  line-height: 1;
}

.performance-value {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.performance-number {
  font-size: 40rpx;
  font-weight: bold;
  color: #1f2937;
  line-height: 1;
}

.performance-unit {
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1;
}

.performance-stars {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  line-height: 1;
  margin-left: 8rpx;
}

/* 查看全部按钮 */
.view-all-button {
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #00A678;
  border-top: 1rpx solid #e5e7eb;
  cursor: pointer;
  transition: all 0.2s;
}

.view-all-button:active {
  background-color: #f9fafb;
}

/* ========== 行政经理专用样式 ========== */

/* 日期过滤器 */
.manager-date-filter {
  padding: 12rpx 24rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.date-chip {
  flex-shrink: 0;
  padding: 10rpx 12rpx;
  text-align: center;
  border-radius: 999rpx; /* Pill shape */
  background: #f3f4f6;
  color: #6b7280;
  font-size: 24rpx;
  font-weight: 600;
  transition: all 0.2s ease;
  border: 1px solid transparent;
  white-space: nowrap;
  min-width: 70rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.date-chip.active {
  background: linear-gradient(to right, #10b981, #14b8a6) !important;
  color: #ffffff !important;
  box-shadow: 0 4rpx 12rpx rgba(16, 185, 129, 0.3);
  border-color: transparent;
  font-weight: 700;
}

.date-chip:active {
  transform: scale(0.95);
}

/* Tab切换栏 - Clean Sticky Text Style */
.manager-tabs {
  position: sticky;
  z-index: 50;
  display: flex;
  justify-content: space-around;
  align-items: center;
  /* Extend to screen edges by counteracting parent padding */
  margin-left: -40rpx;
  margin-right: -40rpx;
  padding: 10rpx 40rpx 0 40rpx; /* Restore internal padding */
  margin-bottom: 24rpx;
  /* Background matches page */
  background-color: #F7F7F7;
}

.tab-item {
  position: relative;
  padding: 16rpx 32rpx;
  text-align: center;
  font-size: 30rpx; /* Smaller font size */
  font-weight: 500;
  color: #9ca3af; /* Gray for inactive */
  transition: all 0.3s ease;
}

.tab-item.active {
  background: transparent;
  color: #000000; /* Black for active */
  font-weight: 800; /* Bold/Heavy */
  box-shadow: none;
  transform: scale(1.05);
}

/* Custom indicator if needed, but the image shows just text. 
   Adding a small dot or line could be nice, but let's stick to the prompt's "text turns black" */
.active-indicator {
  display: none; 
}

/* Override active state transform from previous utility if it conflicts */
.tab-item:active {
  transform: scale(0.98);
}

/* KPI卡片网格 */
.kpi-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.kpi-card {
  background: #ffffff;
  padding: 40rpx 32rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
  border: 1px solid rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
  align-items: flex-start; /* Left align for modern look */
  gap: 12rpx;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.kpi-card:active {
  transform: translateY(-2rpx);
  box-shadow: var(--shadow-md);
}

/* Decorative background circle for KPI cards */
.kpi-card::after {
  content: '';
  position: absolute;
  top: -20rpx;
  right: -20rpx;
  width: 120rpx;
  height: 120rpx;
  background: linear-gradient(135deg, rgba(16, 185, 129, 0.08) 0%, rgba(20, 184, 166, 0.18) 100%);
  border-radius: 50%;
  z-index: 0;
}

.kpi-value {
  font-size: 64rpx;
  font-weight: 800;
  color: var(--foreground);
  line-height: 1;
  letter-spacing: -2rpx;
  position: relative;
  z-index: 1;
}

.kpi-label {
  font-size: 26rpx;
  color: var(--muted-foreground);
  font-weight: 500;
  position: relative;
  z-index: 1;
}

.kpi-subtitle {
  font-size: 24rpx;
  color: #00A678;
  font-weight: 600;
  margin-top: 4rpx;
}

/* 排名列表 */
.ranking-item {
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #f3f4f6;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.ranking-item:last-child {
  border-bottom: none;
}

.ranking-name {
  font-size: 28rpx;
  color: #1f2937;
  font-weight: 500;
}

.ranking-value {
  font-size: 26rpx;
  color: #6b7280;
}

/* 图表标题与内容之间的分割线 */
.chart-divider {
  width: 100%;
  height: 1px;
  background-color: #e5e7eb;
  margin-bottom: 16rpx;
}

/* 图表容器 */
.chart-container {
  width: 100%;
  height: 500rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.chart-canvas {
  width: 100%;
  height: 100%;
}

/* ========== 日期选择弹窗样式 ========== */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 10000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal-content {
  width: 100%;
  background-color: white;
  border-radius: 24rpx 24rpx 0 0; /* 保留非对称圆角 */
  padding: 32rpx;
  animation: slide-up 0.3s ease-out;
}

@keyframes slide-up {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.date-picker-content {
  margin-bottom: 64rpx;
}

.date-display {
  display: flex;
  justify-content: center;
  padding: 32rpx 0;
  border: 1rpx solid #e5e7eb;
  border-radius: 24rpx;
  margin-bottom: 16rpx;
}

.date-text {
  font-size: 32rpx;
  color: #333;
}

.date-separator {
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  font-size: 28rpx;
  color: #9ca3af;
  padding: 16rpx 0;
}

.modal-actions {
  display: flex;
  gap: 32rpx;
}

.modal-button {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
}

.modal-button-cancel {
  background-color: white;
  border: 1rpx solid #DDDDDD;
}

.modal-button-confirm {
  background-color: #00A678;
}

.modal-button-text {
  font-size: 32rpx;
  font-weight: 500;
  color: #666;
}

.modal-button-text-white {
  color: white;
}

/* ========== 排名空状态样式 ========== */
.empty-ranking {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 32rpx;
  gap: 10rpx;
}

.empty-ranking-icon {
  width: 200rpx;
  height: 200rpx;
}

.empty-ranking-text {
  font-size: 28rpx;
  color: #9ca3af;
  font-weight: 500;
}

/* ========== 替代图标样式 ========== */
/* 箭头图标 */
.arrow-icon {
  font-size: 36rpx;
  color: #9ca3af;
  padding: 0 8rpx;
  font-weight: 300;
}

/* 头像占位符 */
.avatar-placeholder {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #10b981 0%, #14b8a6 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
}

/* ========== 图表空状态样式 ========== */
.chart-empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 32rpx;
  gap: 24rpx;
  min-height: 400rpx;
}

.chart-empty-icon {
  width: 200rpx;
  height: 200rpx;
}

.chart-empty-text {
  font-size: 28rpx;
  color: #9ca3af;
  font-weight: 500;
}
