<!-- 数据统计页面 -->
<view class="container gradient-bg">
  <!-- 自定义导航栏 -->
  <custom-header title="数据" showBack="{{true}}" />

  <!-- ========== 简易视图（已停用：办美员工已统一走经理视图，仅留给未识别角色兜底） ========== -->
  <view wx:if="{{!isManager && !isPropertyStaff && !isMaintenanceWorker}}" class="main px-5" style="padding-top: {{headerHeight + 20}}px;">
    <!-- 日期筛选器 -->
    <view class="manager-date-filter mb-3">
      <view class="flex gap-1 justify-center">
        <view class="date-chip {{timeFilter === 'all' ? 'active' : ''}}"
              bindtap="onTimeFilterChange" data-filter="all">
          <text>全部</text>
        </view>
        <view class="date-chip {{timeFilter === 'yesterday' ? 'active' : ''}}"
              bindtap="onTimeFilterChange" data-filter="yesterday">
          <text>昨日</text>
        </view>
        <view class="date-chip {{timeFilter === 'today' ? 'active' : ''}}"
              bindtap="onTimeFilterChange" data-filter="today">
          <text>今日</text>
        </view>
        <view class="date-chip {{timeFilter === 'week' ? 'active' : ''}}"
              bindtap="onTimeFilterChange" data-filter="week">
          <text>本周</text>
        </view>
        <view class="date-chip {{timeFilter === 'month' ? 'active' : ''}}"
              bindtap="onTimeFilterChange" data-filter="month">
          <text>本月</text>
        </view>
        <view class="date-chip {{timeFilter === 'custom' ? 'active' : ''}}"
              bindtap="onTimeFilterChange" data-filter="custom">
          <image src="{{icons.calendar}}" mode="aspectFit"
                 style="width: 28rpx; height: 28rpx; {{timeFilter === 'custom' ? 'filter: brightness(0) invert(1);' : 'opacity: 0.5;'}}"></image>
        </view>
      </view>
    </view>

    <!-- KPI统计 -->
    <view class="section mb-3">
      <view class="section-title mb-3">
        <text class="text-base font-bold text-foreground tracking-tight">KPI统计</text>
      </view>

      <view class="kpi-grid">
        <!-- 1. 已接工单数/提报工单数 -->
        <view class="kpi-card">
          <text class="kpi-label">{{isMaintenanceWorker ? '已接工单数' : '提报工单数'}}</text>
          <text class="kpi-value" style="color: #10b981;">{{staffKpiData.totalOrders}}</text>
          <view class="absolute" style="right: 8rpx; top: 8rpx;">
            <text class="iconfont icon-icon_zonggongdan" style="font-size: 64rpx; opacity: 0.6; color: #10b981;"></text>
          </view>
        </view>

        <!-- 2. 进行中 -->
        <view class="kpi-card">
          <text class="kpi-label">进行中</text>
          <text class="kpi-value" style="color: #06B6D4;">{{staffKpiData.inProgressOrders}}</text>
          <view class="absolute" style="right: 8rpx; top: 8rpx;">
            <text class="iconfont icon-jinhangzhong" style="font-size: 64rpx; opacity: 0.6; color: #06B6D4;"></text>
          </view>
        </view>

        <!-- 3. 已完成 -->
        <view class="kpi-card">
          <text class="kpi-label">已完成</text>
          <view class="flex items-baseline gap-2">
            <text class="kpi-value" style="color: #8B5CF6;">{{staffKpiData.completedOrders}}</text>
            <text class="kpi-subtitle">({{staffKpiData.completionRate}}%)</text>
          </view>
          <view class="absolute" style="right: 8rpx; top: 8rpx;">
            <text class="iconfont icon-yiwancheng" style="font-size: 64rpx; opacity: 0.6; color: #8B5CF6;"></text>
          </view>
        </view>

        <!-- 4. 平均时长 -->
        <view class="kpi-card">
          <text class="kpi-label">平均时长(h)</text>
          <text class="kpi-value" style="color: #F59E0B;">{{staffKpiData.avgCompletionTime}}</text>
          <view class="absolute" style="right: 8rpx; top: 8rpx;">
            <text class="iconfont icon-chushenpingjunshichang" style="font-size: 64rpx; opacity: 0.6; color: #F59E0B;"></text>
          </view>
        </view>
      </view>
    </view>

    <!-- 月度排名 - 只对办美员工显示 -->
    <view wx:if="{{isPropertyStaff}}" class="section mb-3">
      <view class="flex items-center justify-between mb-3">
        <view class="flex items-center gap-2">
          <text class="text-base font-bold text-foreground tracking-tight">完成工单排名</text>
        </view>

        <view class="flex items-center gap-2">
          <text wx:if="{{rankings.length > 3}}" class="text-sm text-muted-foreground" style="margin-right: 8rpx;" bindtap="viewAllRankings">查看全部</text>
          <text class="arrow-icon" bindtap="prevMonth">‹</text>
          <picker mode="date" fields="month" value="{{rankingYear}}-{{rankingMonth < 10 ? '0' + rankingMonth : rankingMonth}}" bindchange="onMonthPickerChange">
            <view class="badge" style="background-color: #f5f5f5; padding: 8rpx 24rpx;">
              <text class="text-xs font-semibold">{{rankingMonth}}月</text>
            </view>
          </picker>
          <text class="arrow-icon" bindtap="nextMonth">›</text>
        </view>
      </view>

      <view class="card card-backdrop">
        <!-- 有排名数据时显示列表 -->
        <block wx:if="{{rankings.length > 0}}">
          <!-- 只显示前3名 -->
          <view wx:for="{{rankings}}" wx:key="rank" wx:if="{{index < 3}}">
            <view class="p-4 flex items-center gap-3"
                  style="border-bottom: 1rpx solid var(--border);">
              <view style="width: 60rpx; text-align: center; display: flex; align-items: center; justify-content: center;">
                <image wx:if="{{item.rank == 1}}" src="/images/icons/one.png" style="width: 64rpx; height: 64rpx;"></image>
                <image wx:elif="{{item.rank == 2}}" src="/images/icons/two.png" style="width: 64rpx; height: 64rpx;"></image>
                <image wx:elif="{{item.rank == 3}}" src="/images/icons/three.png" style="width: 64rpx; height: 64rpx;"></image>
                <text wx:else class="text-base font-bold">{{item.rank}}</text>
              </view>

              <view class="avatar-placeholder {{item.isCurrentUser && item.rank != 3 ? 'current-user-avatar' : ''}}">
                <image wx:if="{{item.avatar}}" class="avatar-img" src="{{item.avatar}}" mode="aspectFill"></image>
                <text wx:else>{{item.name[0] || '?'}}</text>
              </view>

              <view class="flex-1 min-w-0 flex items-center gap-2">
                <text class="text-sm truncate tracking-tight {{item.isCurrentUser && item.rank != 3 ? 'text-primary' : ''}}">{{item.name}}</text>
                <view wx:if="{{item.isCurrentUser && item.rank != 3}}" class="badge badge-primary" style="height: 40rpx; padding: 0 16rpx;">
                  <text class="text-xs">我</text>
                </view>
              </view>

              <view class="text-right">
                <text class="text-base font-bold text-foreground">{{item.completedOrders}}</text>
                <text class="text-xs text-muted-foreground ml-1">单</text>
              </view>
            </view>
          </view>
        </block>
        <!-- 无排名数据时显示缺省图 -->
        <view wx:else class="empty-ranking">
          <image class="empty-ranking-icon" src="{{emptyIconUrl}}" mode="aspectFit"></image>
          <text class="empty-ranking-text">暂无排名</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ========== 完整看板视图（行政经理 / 办美员工 / 维修员） ========== -->
  <view wx:if="{{isManager || isPropertyStaff || isMaintenanceWorker}}" class="main px-5" style="padding-top: {{headerHeight}}px;">
    <!-- 可视化图表 -->
    <view style="padding-top: 24rpx;">
      <!-- 日期范围选择器 -->
      <view class="manager-date-filter mb-3" style="top: {{headerHeight}}px;">
        <view class="flex gap-1 justify-center">
          <view class="date-chip {{timeFilter === 'all' ? 'active' : ''}}"
                bindtap="onTimeFilterChange" data-filter="all">
            <text>全部</text>
          </view>
          <view class="date-chip {{timeFilter === 'yesterday' ? 'active' : ''}}"
                bindtap="onTimeFilterChange" data-filter="yesterday">
            <text>昨日</text>
          </view>
          <view class="date-chip {{timeFilter === 'today' ? 'active' : ''}}"
                bindtap="onTimeFilterChange" data-filter="today">
            <text>今日</text>
          </view>
          <view class="date-chip {{timeFilter === 'week' ? 'active' : ''}}"
                bindtap="onTimeFilterChange" data-filter="week">
            <text>本周</text>
          </view>
          <view class="date-chip {{timeFilter === 'month' ? 'active' : ''}}"
                bindtap="onTimeFilterChange" data-filter="month">
            <text>本月</text>
          </view>
          <view class="date-chip {{timeFilter === 'custom' ? 'active' : ''}}"
                bindtap="onTimeFilterChange" data-filter="custom">
            <image src="{{icons.calendar}}" mode="aspectFit"
                   style="width: 28rpx; height: 28rpx; {{timeFilter === 'custom' ? 'filter: brightness(0) invert(1);' : 'opacity: 0.5;'}}"></image>
          </view>
        </view>
      </view>

      <!-- 1. 一周工单趋势折线图 -->
      <view class="section mb-3">
        <view class="section-title mb-2">
          <text class="text-base font-bold">一周工单趋势</text>
        </view>
        <view class="chart-container">
          <ec-canvas id="trendChart" canvas-id="trendChart" ec="{{ ecTrend }}" class="chart-canvas"></ec-canvas>
        </view>
      </view>

      <!-- 2. KPI数据面板 -->
      <view class="section mb-3">
        <view class="section-title mb-2">
          <text class="text-base font-bold">数据概览</text>
        </view>
        <view class="kpi-panel">
          <view class="kpi-panel-item" style="background: rgba(16,185,129,0.08);">
            <text class="kpi-panel-value" style="color: #10b981;">{{kpiData.totalOrders}}</text>
            <text class="kpi-panel-label">总工单</text>
          </view>
          <view class="kpi-panel-item" style="background: rgba(6,182,212,0.08);">
            <text class="kpi-panel-value" style="color: #06B6D4;">{{kpiData.inProgressOrders}}</text>
            <text class="kpi-panel-label">进行中</text>
          </view>
          <view class="kpi-panel-item" style="background: rgba(139,92,246,0.08);">
            <text class="kpi-panel-value" style="color: #8B5CF6;">{{kpiData.completedOrders}}</text>
            <text class="kpi-panel-label">已完成</text>
          </view>
          <view class="kpi-panel-item" style="background: rgba(245,158,11,0.08);">
            <text class="kpi-panel-value" style="color: #F59E0B;">{{kpiData.avgCompletionTime}}</text>
            <text class="kpi-panel-label">平均用时(h)</text>
          </view>
        </view>
      </view>

      <!-- 3. 工单状态环形图 -->
      <view class="section mb-3">
        <view class="section-title mb-2">
          <text class="text-base font-bold">工单状态</text>
        </view>
        <view class="status-chart-wrap">
          <view class="status-canvas-box">
            <ec-canvas id="statusChart" canvas-id="statusChart" ec="{{ ecStatus }}" class="chart-canvas"></ec-canvas>
          </view>
          <view class="status-legend-box">
            <view wx:for="{{statusChartLegend}}" wx:key="name" class="legend-item"
                  bind:tap="onLegendTap" data-index="{{index}}">
              <view class="legend-badge {{selectedStatusIdx === item.dataIndex ? 'legend-badge-selected' : ''}}"
                    style="background: linear-gradient(135deg, {{item.gradientFrom}}, {{item.gradientTo}});">
                <text class="legend-percent">{{item.count}}单</text>
              </view>
              <text class="legend-name">{{item.name}}</text>
            </view>
          </view>
        </view>
      </view>

      <!-- 3. 故障类型横向条形图 -->
      <view class="section mb-3">
        <view class="section-title mb-2">
          <text class="text-base font-bold">故障类型</text>
        </view>
        <view wx:if="{{categoryBarData.length > 0}}">
          <view wx:for="{{categoryBarData}}" wx:key="name" class="hbar-row">
            <text class="hbar-label">{{item.name}}</text>
            <view class="hbar-track">
              <view class="hbar-fill" style="width: {{item.barWidth}}%; background: {{item.color}};"></view>
            </view>
            <text class="hbar-pct">{{item.value}}单</text>
          </view>
        </view>
        <view wx:else class="chart-empty-state">
          <image class="chart-empty-icon" src="{{emptyIconUrl}}" mode="aspectFit"></image>
          <text class="chart-empty-text">暂无数据</text>
        </view>
      </view>

      <!-- 4. 责任方（维修员不显示：单部门无意义） -->
      <view class="section mb-3" wx:if="{{!isMaintenanceWorker}}">
        <view class="section-title mb-2">
          <text class="text-base font-bold">责任方</text>
        </view>
        <view wx:if="{{responsibleChartData.length > 0}}" class="status-chart-wrap">
          <view class="status-canvas-box">
            <ec-canvas id="responsibleChart" canvas-id="responsibleChart" ec="{{ ecResponsible }}" class="chart-canvas"></ec-canvas>
          </view>
          <view class="status-legend-box">
            <view wx:for="{{responsibleChartLegend}}" wx:key="name" class="legend-item"
                  bind:tap="onResponsibleLegendTap" data-index="{{index}}">
              <view class="legend-badge {{selectedResponsibleIdx === item.dataIndex ? 'legend-badge-selected' : ''}}"
                    style="background: linear-gradient(135deg, {{item.gradientFrom}}, {{item.gradientTo}});">
                <text class="legend-percent">{{item.count}}单</text>
              </view>
              <text class="legend-name">{{item.name}}</text>
            </view>
          </view>
        </view>
        <view wx:else class="chart-empty-state">
          <image class="chart-empty-icon" src="{{emptyIconUrl}}" mode="aspectFit"></image>
          <text class="chart-empty-text">暂无数据</text>
        </view>
      </view>

      <!-- 5. 楼层分布柱状图 -->
      <view class="section mb-3">
        <view class="section-title mb-2">
          <text class="text-base font-bold">楼层分布</text>
        </view>
        <view class="chart-container">
          <ec-canvas wx:if="{{floorChartData.categories && floorChartData.categories.length > 0}}" id="floorChart" canvas-id="floorChart" ec="{{ ecFloor }}" class="chart-canvas"></ec-canvas>
          <view wx:else class="chart-empty-state">
            <image class="chart-empty-icon" src="{{emptyIconUrl}}" mode="aspectFit"></image>
            <text class="chart-empty-text">暂无数据</text>
          </view>
        </view>
      </view>

      <!-- 6. 完成工单排名（维修员不显示） -->
      <view class="section mb-3" wx:if="{{!isMaintenanceWorker}}">
        <view class="section-title mb-2 justify-between">
          <text class="text-base font-bold">完成工单排名</text>
          <text wx:if="{{rankings.length > 3}}" class="text-sm text-muted-foreground" style="font-weight: normal;" bindtap="viewAllRankings">查看全部</text>
        </view>
        <view class="card card-backdrop">
          <!-- 有排名数据时显示列表 -->
          <block wx:if="{{rankings.length > 0}}">
            <!-- 只显示前3名 -->
            <view wx:for="{{rankings}}" wx:key="rank" wx:if="{{index < 3}}">
              <view class="p-4 flex items-center gap-3"
                    style="border-bottom: 1rpx solid var(--border);">
                <view style="width: 60rpx; text-align: center; display: flex; align-items: center; justify-content: center;">
                  <image wx:if="{{item.rank == 1}}" src="/images/icons/one.png" style="width: 64rpx; height: 64rpx;"></image>
                  <image wx:elif="{{item.rank == 2}}" src="/images/icons/two.png" style="width: 64rpx; height: 64rpx;"></image>
                  <image wx:elif="{{item.rank == 3}}" src="/images/icons/three.png" style="width: 64rpx; height: 64rpx;"></image>
                  <text wx:else class="text-base font-bold">{{item.rank}}</text>
                </view>

                <view class="avatar-placeholder">
                  <image wx:if="{{item.avatar}}" class="avatar-img" src="{{item.avatar}}" mode="aspectFill"></image>
                  <text wx:else>{{item.name[0] || '?'}}</text>
                </view>

                <view class="flex-1 min-w-0 flex items-center gap-2">
                  <text class="text-sm truncate tracking-tight">{{item.name}}</text>
                </view>

                <view class="text-right">
                  <text class="text-base font-bold text-foreground">{{item.completedOrders}}</text>
                  <text class="text-xs text-muted-foreground ml-1">单</text>
                </view>
              </view>
            </view>
          </block>
          <!-- 无排名数据时显示缺省图 -->
          <view wx:else class="empty-ranking">
            <image class="empty-ranking-icon" src="{{emptyIconUrl}}" mode="aspectFit"></image>
            <text class="empty-ranking-text">暂无排名</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 日期选择弹窗 -->
  <van-popup
    show="{{ showDatePicker }}"
    position="bottom"
    bind:close="closeDatePicker"
    round
    closeable
    close-icon="cross"
    z-index="10000"
  >
    <view class="date-picker-popup">
      <view class="date-picker-title">选择日期范围</view>

      <view class="date-picker-row">
        <view class="date-picker-col">
          <view class="date-picker-label">开始日期</view>
          <picker mode="date" value="{{customStartDate}}" bindchange="onCustomStartDateChange">
            <view class="date-picker-value {{customStartDate ? 'has-value' : ''}}">
              {{customStartDate || '请选择'}}
            </view>
          </picker>
        </view>
        <view class="date-picker-separator">至</view>
        <view class="date-picker-col">
          <view class="date-picker-label">结束日期</view>
          <picker mode="date" value="{{customEndDate}}" start="{{customStartDate}}" bindchange="onCustomEndDateChange">
            <view class="date-picker-value {{customEndDate ? 'has-value' : ''}}">
              {{customEndDate || '请选择'}}
            </view>
          </picker>
        </view>
      </view>

      <button
        class="date-picker-confirm-btn {{customStartDate && customEndDate ? '' : 'disabled'}}"
        bindtap="confirmDatePicker"
      >
        确定
      </button>
    </view>
  </van-popup>

  <!-- 全部排名弹窗 -->
  <view wx:if="{{showAllRankings}}" class="modal-overlay" catchtap="closeAllRankings" catchtouchmove="stopPropagation">
    <view class="modal-content" catchtap="stopPropagation" catchtouchmove="stopPropagation" style="max-height: 70vh; display: flex; flex-direction: column;">
      <!-- 弹窗标题 -->
      <view style="padding: 32rpx 32rpx 24rpx; border-bottom: 1rpx solid var(--color-divider);">
        <text class="text-lg font-bold">完成工单排名</text>
        <!-- 简易视图（未识别角色）保留按月显示，其余角色按时间筛选显示 -->
        <text wx:if="{{!isManager && !isPropertyStaff}}" class="text-sm text-muted-foreground ml-2">({{rankingMonth}}月)</text>
        <!-- 完整看板：根据日期筛选显示 -->
        <text wx:elif="{{timeFilter === 'all'}}" class="text-sm text-muted-foreground ml-2">(全部)</text>
        <text wx:elif="{{timeFilter === 'yesterday'}}" class="text-sm text-muted-foreground ml-2">(昨日)</text>
        <text wx:elif="{{timeFilter === 'today'}}" class="text-sm text-muted-foreground ml-2">(今日)</text>
        <text wx:elif="{{timeFilter === 'week'}}" class="text-sm text-muted-foreground ml-2">(本周)</text>
        <text wx:elif="{{timeFilter === 'month'}}" class="text-sm text-muted-foreground ml-2">({{rankingMonth}}月)</text>
        <text wx:elif="{{timeFilter === 'custom'}}" class="text-sm text-muted-foreground ml-2">({{startDate}} ~ {{endDate}})</text>
      </view>

      <!-- 排名列表 - 可滚动 -->
      <scroll-view scroll-y style="flex: 1; overflow-y: auto;">
        <view wx:for="{{rankings}}" wx:key="rank">
          <view class="p-4 flex items-center gap-3"
                style="border-bottom: 1rpx solid var(--color-divider);">
            <view style="width: 60rpx; text-align: center; display: flex; align-items: center; justify-content: center;">
              <image wx:if="{{item.rank == 1}}" src="/images/icons/one.png" style="width: 64rpx; height: 64rpx;"></image>
              <image wx:elif="{{item.rank == 2}}" src="/images/icons/two.png" style="width: 64rpx; height: 64rpx;"></image>
              <image wx:elif="{{item.rank == 3}}" src="/images/icons/three.png" style="width: 64rpx; height: 64rpx;"></image>
              <text wx:else class="text-base font-bold">{{item.rank}}</text>
            </view>

            <view class="avatar-placeholder {{item.isCurrentUser ? 'current-user-avatar' : ''}}">
              <image wx:if="{{item.avatar}}" class="avatar-img" src="{{item.avatar}}" mode="aspectFill"></image>
              <text wx:else>{{item.name[0] || '?'}}</text>
            </view>

            <view class="flex-1 min-w-0 flex items-center gap-2">
              <text class="text-sm truncate tracking-tight {{item.isCurrentUser ? 'text-primary' : ''}}">{{item.name}}</text>
              <view wx:if="{{item.isCurrentUser}}" class="badge badge-primary" style="height: 40rpx; padding: 0 16rpx;">
                <text class="text-xs">我</text>
              </view>
            </view>

            <view class="text-right">
              <text class="text-base font-bold text-foreground">{{item.completedOrders}}</text>
              <text class="text-xs text-muted-foreground ml-1">单</text>
            </view>
          </view>
        </view>
      </scroll-view>

      <!-- 关闭按钮 -->
      <view style="padding: 24rpx 32rpx;">
        <view class="modal-button modal-button-confirm" bindtap="closeAllRankings" style="width: 100%;">
          <text class="modal-button-text modal-button-text-white">关闭</text>
        </view>
      </view>
    </view>
  </view>
</view>
