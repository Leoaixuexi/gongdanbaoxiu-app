<!-- 数据统计页面 -->
<view class="container gradient-bg">
  <!-- 自定义导航栏 -->
  <custom-header title="数据" showBack="{{false}}" />

  <!-- ========== 物业员工/维修员视图 ========== -->
  <view wx:if="{{!isManager}}" class="main px-5" style="padding-top: {{headerHeight + 20}}px;">
    <!-- 工单汇总 -->
    <view class="section mb-3">
      <view class="section-title mb-3">
        <text class="text-base font-bold text-foreground tracking-tight">工单汇总</text>
      </view>

      <view class="card card-backdrop" style="border: none; box-shadow: none; border-radius: 0;">
        <view style="padding: 8rpx 8rpx;">
          <view class="grid grid-cols-4 gap-2">
            <view wx:for="{{stats}}" wx:key="index"
                  class="stat-card"
                  style="background-color: {{item.bgClass}};">
              <text class="text-2xl font-bold" style="color: {{item.color}};">{{item.value}}</text>
              <text class="text-xs text-muted-foreground font-medium mt-2">{{item.label}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 个人绩效 -->
    <view class="section mb-3">
      <view class="flex items-center justify-between mb-3">
        <view class="flex items-center gap-2">
          <text class="text-base font-bold text-foreground tracking-tight">个人绩效</text>
        </view>

        <view class="flex items-center gap-1">
          <image src="/images/icons/chevron-left.svg" class="icon-xs" style="opacity: 0.3;"></image>
          <view class="badge" style="background-color: transparent; padding: 8rpx 24rpx;">
            <text class="text-xs font-semibold" style="color: #9ca3af;">11月</text>
          </view>
          <image src="/images/icons/chevron-right.svg" class="icon-xs" style="opacity: 0.3;"></image>
        </view>
      </view>

      <view class="card card-backdrop">
        <!-- 已完成工单 -->
        <view class="performance-item">
          <view class="flex items-center gap-3">
            <view class="performance-icon" style="background-color: #10b981;">
              <text class="performance-icon-text">✓</text>
            </view>
            <text class="text-sm text-foreground">已完成工单</text>
          </view>
          <view class="performance-value">
            <text class="performance-number">28</text>
            <text class="performance-unit">单</text>
          </view>
        </view>

        <!-- 平均处理时长 -->
        <view class="performance-item">
          <view class="flex items-center gap-3">
            <view class="performance-icon" style="background-color: #3b82f6;">
              <text class="performance-icon-text">🕐</text>
            </view>
            <text class="text-sm text-foreground">平均处理时长</text>
          </view>
          <view class="performance-value">
            <text class="performance-number">2.5</text>
            <text class="performance-unit">小时</text>
          </view>
        </view>

        <!-- 超时工单 -->
        <view class="performance-item">
          <view class="flex items-center gap-3">
            <view class="performance-icon" style="background-color: #ef4444;">
              <text class="performance-icon-text">🔔</text>
            </view>
            <text class="text-sm text-foreground">超时工单</text>
          </view>
          <view class="performance-value">
            <text class="performance-number">1</text>
            <text class="performance-unit">单</text>
          </view>
        </view>

        <!-- 超时率 -->
        <view class="performance-item" style="border-bottom: none;">
          <view class="flex items-center gap-3">
            <view class="performance-icon" style="background-color: #f97316;">
              <text class="performance-icon-text">%</text>
            </view>
            <text class="text-sm text-foreground">超时率</text>
          </view>
          <view class="performance-value">
            <text class="performance-number">3.6</text>
            <text class="performance-unit">%</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 月度排名 - 只对物业员工显示 -->
    <view wx:if="{{isPropertyStaff}}" class="section mb-3">
      <view class="flex items-center justify-between mb-3">
        <view class="flex items-center gap-2">
          <text class="text-base font-bold text-foreground tracking-tight">完成工单排名</text>
        </view>

        <view class="flex items-center gap-1">
          <image src="/images/icons/chevron-left.svg" class="icon-xs"></image>
          <view class="badge" style="background-color: #f5f5f5; padding: 8rpx 24rpx;">
            <text class="text-xs font-semibold">10月</text>
          </view>
          <image src="/images/icons/chevron-right.svg" class="icon-xs"></image>
        </view>
      </view>

      <view class="card card-backdrop">
        <view wx:for="{{rankings}}" wx:key="rank">
          <view class="p-4 flex items-center gap-3"
                style="border-bottom: 1rpx solid var(--border);">
            <view style="width: 60rpx; text-align: center; display: flex; align-items: center; justify-content: center;">
              <image wx:if="{{item.rank == 1}}" src="/images/icons/rank-1.png" style="width: 48rpx; height: 48rpx;" mode="aspectFit"></image>
              <image wx:elif="{{item.rank == 2}}" src="/images/icons/rank-2.png" style="width: 48rpx; height: 48rpx;" mode="aspectFit"></image>
              <image wx:elif="{{item.rank == 3}}" src="/images/icons/rank-3.png" style="width: 48rpx; height: 48rpx;" mode="aspectFit"></image>
              <text wx:else class="text-base font-bold">{{item.rank}}</text>
            </view>

            <view class="avatar-sm {{item.isCurrentUser && item.rank != 3 ? 'current-user-avatar' : ''}}">
              <image src="{{item.avatar}}" mode="aspectFill"></image>
            </view>

            <view class="flex-1 min-w-0 flex items-center gap-2">
              <text class="text-sm truncate tracking-tight {{item.isCurrentUser && item.rank != 3 ? 'text-primary' : ''}}">{{item.name}}</text>
              <view wx:if="{{item.isCurrentUser && item.rank != 3}}" class="badge badge-primary" style="height: 40rpx; padding: 0 16rpx;">
                <text class="text-xs">我</text>
              </view>
            </view>

            <view class="text-right">
              <text class="text-base font-bold text-foreground">{{item.completedOrders}}</text>
              <text class="text-xs text-muted-foreground ml-1">单</text>
            </view>
          </view>
        </view>

        <!-- 查看全部 -->
        <view class="view-all-button" bindtap="viewAllRankings">
          <text class="text-base font-semibold">查看全部</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ========== 物业经理视图 ========== -->
  <view wx:if="{{isManager}}" class="main px-5" style="padding-top: {{headerHeight + 20}}px;">
    <!-- 日期范围选择器 -->
    <view class="manager-date-filter mb-3">
      <view class="flex gap-2">
        <view class="date-chip {{timeFilter === 'yesterday' ? 'active' : ''}}"
              bindtap="onTimeFilterChange" data-filter="yesterday">
          <text>昨</text>
        </view>
        <view class="date-chip {{timeFilter === 'today' ? 'active' : ''}}"
              bindtap="onTimeFilterChange" data-filter="today">
          <text>今</text>
        </view>
        <view class="date-chip {{timeFilter === 'week' ? 'active' : ''}}"
              bindtap="onTimeFilterChange" data-filter="week">
          <text>周</text>
        </view>
        <view class="date-chip {{timeFilter === 'month' ? 'active' : ''}}"
              bindtap="onTimeFilterChange" data-filter="month">
          <text>月</text>
        </view>
        <view class="date-chip {{timeFilter === 'custom' ? 'active' : ''}}"
              bindtap="onTimeFilterChange" data-filter="custom">
          <text>📅</text>
        </view>
      </view>
    </view>

    <!-- Tab切换栏 -->
    <view class="manager-tabs mb-3">
      <view class="tab-item {{activeTab === 'stats' ? 'active' : ''}}"
            bindtap="switchTab" data-tab="stats">
        <text>数据统计</text>
      </view>
      <view class="tab-item {{activeTab === 'charts' ? 'active' : ''}}"
            bindtap="switchTab" data-tab="charts">
        <text>可视化图表</text>
      </view>
    </view>

    <!-- Tab 1: 数据统计 -->
    <view wx:if="{{activeTab === 'stats'}}">
      <!-- KPI卡片 -->
      <view class="kpi-grid mb-3">
        <view class="kpi-card" animation="{{card1Anim}}">
          <text class="kpi-value">{{kpiData.totalOrders}}</text>
          <text class="kpi-label">总工单数</text>
        </view>
        <view class="kpi-card" animation="{{card2Anim}}">
          <text class="kpi-value">{{kpiData.completedOrders}}</text>
          <text class="kpi-label">已完成</text>
          <text class="kpi-subtitle">{{kpiData.completionRate}}%</text>
        </view>
        <view class="kpi-card" animation="{{card3Anim}}">
          <text class="kpi-value">{{kpiData.inProgressOrders}}</text>
          <text class="kpi-label">进行中</text>
        </view>
        <view class="kpi-card" animation="{{card4Anim}}">
          <text class="kpi-value">{{kpiData.avgCompletionTime}}</text>
          <text class="kpi-label">平均时长(h)</text>
        </view>
      </view>

      <!-- 员工排名 -->
      <view class="section mb-3">
        <view class="section-title mb-2">
          <text class="text-base font-bold">员工已完成工单排名</text>
        </view>
        <view class="card card-backdrop">
          <view wx:for="{{employeeRankings}}" wx:key="employeeId" class="ranking-item">
            <text class="ranking-name">{{item.employeeName}}</text>
            <text class="ranking-value">已完成: {{item.totalCompleted}}</text>
          </view>
        </view>
      </view>

      <!-- 责任方排名 -->
      <view class="section mb-3">
        <view class="section-title mb-2">
          <text class="text-base font-bold">责任方已修复工单排名</text>
        </view>
        <view class="card card-backdrop">
          <view wx:for="{{responsiblePartyRankings}}" wx:key="responsibleParty" class="ranking-item">
            <text class="ranking-name">{{item.responsibleParty}}</text>
            <text class="ranking-value">{{item.completedCount}}单 ({{item.percentage}}%)</text>
          </view>
        </view>
      </view>
    </view>

    <!-- Tab 2: 可视化图表 -->
    <view wx:if="{{activeTab === 'charts'}}">
      <text class="text-muted-foreground">图表功能开发中...</text>
      <!-- TODO: 添加ECharts组件 -->
    </view>
  </view>
</view>
