/**
 * 消息页面样式 - Professionally Redesigned
 * Style: Modern, Clean, Soft Depth
 */

/* 页面容器 - 使用更高级的冷灰背景 */
.message-page {
  min-height: 100vh;
  background-color: #F7F8FA;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 页面内容 */
.page-content {
  padding-left: 32rpx;
  padding-right: 32rpx;
  padding-bottom: 40rpx;
}

/* 消息分类列表 */
.category-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx; /* 减小列表间距 */
  margin-top: 24rpx;
}

/* 分类卡片 - 核心容器 */
.category-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 24rpx; /* 稍微减小圆角以匹配紧凑感 */
  padding: 20rpx 24rpx; /* 显著减小上下内边距 */
  position: relative;
  overflow: hidden;
  box-shadow: 
    0 12rpx 32rpx -8rpx rgba(16, 24, 40, 0.08),
    0 4rpx 8rpx -4rpx rgba(16, 24, 40, 0.03);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  border: 1px solid rgba(255, 255, 255, 0.6);
}

/* 按压交互 - 物理下沉感 */
.category-card:active {
  transform: scale(0.98);
  box-shadow: 
    0 4rpx 12rpx -4rpx rgba(16, 24, 40, 0.12),
    0 2rpx 4rpx -2rpx rgba(16, 24, 40, 0.04);
}

/* 图标容器 - 紧凑尺寸 */
.card-icon {
  width: 88rpx; /* 圆框大小 */
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
  position: relative;
  box-sizing: border-box;
  border-radius: 50%; /* 圆形背景 */
}

/* 1. 通知公告 - 橙色背景 */
.icon-notification {
  background-color: #FFF7ED;
}

/* 2. 待办事项 - 紫色背景 */
.icon-workorder {
  background-color: #FAF5FF;
}

/* 3. 提醒我的 - 蓝色背景 */
.icon-reminder {
  background-color: #EFF6FF;
}

/* 卡片文本内容 */
.card-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  min-width: 0;
  justify-content: center;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #374151; /* 调暗标题颜色 */
  letter-spacing: 0.5rpx;
  line-height: 1.2;
}

.card-subtitle {
  font-size: 26rpx;
  color: #6B7280; /* 使用 Cool Gray 色系 */
  line-height: 1.4;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 卡片右侧信息 */
.card-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 16rpx;
  flex-shrink: 0;
  margin-left: 24rpx;
  justify-content: center;
  height: 100%;
}

.card-time {
  font-size: 24rpx;
  color: #9CA3AF;
  font-weight: 500;
  font-family: 'DIN Alternate', sans-serif; /* 尝试使用数字字体 */
}

/* 数量徽章 - 完美圆形 + 投影 */
.card-badge {
  min-width: 44rpx; /* 稍微加大 */
  height: 44rpx;
  padding: 0 8rpx;
  border-radius: 44rpx; /* 胶囊形兼容多位数 */
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 700;
  color: #FFFFFF;
  /* 鲜艳的红色渐变 */
  background: linear-gradient(135deg, #EF4444 0%, #F87171 100%);
  /* 红色发光投影 */
  box-shadow: 0 4rpx 12rpx rgba(239, 68, 68, 0.4); 
  box-sizing: border-box;
}

/* 底部提示 */
.footer-tip {
  text-align: center;
  color: #9CA3AF;
  font-size: 24rpx;
  margin-top: 60rpx;
  padding-bottom: 80rpx;
  opacity: 0.6;
  letter-spacing: 1rpx;
}
