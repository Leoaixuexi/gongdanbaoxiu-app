/* 首页样式 */
.container {
  min-height: 100vh;
  background-color: #f3f4f6;
}

/* 头部 */
.header {
  background-color: #14b8a6;
  color: #ffffff;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.header-title {
  font-size: 36rpx;
  font-weight: 500;
}

/* 主内容 */
.main-content {
  padding: 32rpx;
  padding-bottom: 64rpx;
}

/* 底部提示 */
.footer-tip {
  text-align: center;
  color: #9ca3af;
  font-size: 28rpx;
  padding: 64rpx 0;
}
