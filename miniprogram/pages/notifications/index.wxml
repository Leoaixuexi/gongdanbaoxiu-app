<!-- 首页 - 消息模块列表 -->
<view class="container">
  <!-- 头部 -->
  <view class="header">
    <text class="header-title">消息</text>
  </view>

  <!-- 主内容 -->
  <view class="main-content">
    <!-- 通知公告 -->
    <message-card
      moduleId="announcements"
      moduleName="{{modules.announcements.name}}"
      iconBgColor="bg-orange-100"
      latestMessage="{{latestMessages.announcements}}"
      unreadCount="{{unreadCounts.announcements}}"
      bindtap="handleCardTap"
    />

    <!-- 待办工单 -->
    <message-card
      moduleId="tasks"
      moduleName="{{modules.tasks.name}}"
      iconBgColor="bg-purple-100"
      latestMessage="{{latestMessages.tasks}}"
      unreadCount="{{unreadCounts.tasks}}"
      bindtap="handleCardTap"
    />

    <!-- 提醒我的 -->
    <message-card
      moduleId="reminders"
      moduleName="{{modules.reminders.name}}"
      iconBgColor="bg-blue-100"
      latestMessage="{{latestMessages.reminders}}"
      unreadCount="{{unreadCounts.reminders}}"
      bindtap="handleCardTap"
    />

    <!-- 底部提示 -->
    <view class="footer-tip">90天以前的消息将自动删除</view>
  </view>
</view>
