/* Audit Logs Page Styles */

/* 页面容器 */
.audit-page {
  min-height: 100vh;
  background-color: #F5F5F5;
  padding-bottom: env(safe-area-inset-bottom);
}

/* 页面标题 */
.page-header {
  padding: 40rpx 32rpx 32rpx;
  background: linear-gradient(135deg, #0CA77D 0%, #10B981 100%);
}

.header-title {
  display: block;
  font-size: 40rpx;
  font-weight: 600;
  color: #FFFFFF;
  margin-bottom: 8rpx;
}

.header-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 高级筛选区域 */
.filter-section {
  background: #FFFFFF;
  padding: 24rpx;
  margin-bottom: 8rpx;
}

.filter-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.filter-item-box {
  flex: 1;
  background: #F9FAFB;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  border: 1rpx solid #E5E7EB;
}

.filter-item-box:active {
  background: #F3F4F6;
}

.filter-label {
  display: block;
  font-size: 22rpx;
  color: #9CA3AF;
  margin-bottom: 8rpx;
}

.filter-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 28rpx;
  color: #374151;
}

/* 按钮区域 */
.filter-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.action-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 20rpx 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
}

.reset-btn {
  background: #F3F4F6;
  color: #6B7280;
}

.search-btn {
  background: #0CA77D;
  color: #FFFFFF;
}

.export-btn {
  background: #3B82F6;
  color: #FFFFFF;
}

.action-btn:active {
  opacity: 0.8;
}

/* 统计信息 */
.filter-stats {
  text-align: center;
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #9CA3AF;
}

/* 筛选下拉面板 */
.filter-dropdown {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
}

.filter-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.3);
}

.filter-panel {
  position: absolute;
  top: 280rpx;
  left: 24rpx;
  right: 24rpx;
  max-height: 60vh;
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
  overflow-y: auto;
}

.filter-option {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #F3F4F6;
  font-size: 28rpx;
  color: #374151;
}

.filter-option:last-child {
  border-bottom: none;
}

.filter-option.selected {
  color: #0CA77D;
  background: rgba(12, 167, 125, 0.05);
}

.filter-option .check {
  color: #0CA77D;
  font-weight: 600;
}

/* 加载状态 */
.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 120rpx 0;
  color: #9CA3AF;
  font-size: 28rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #9CA3AF;
}

/* 日志列表 */
.log-list {
  padding: 24rpx;
}

/* 日志项 */
.log-item {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.log-item:active {
  background: #F9FAFB;
}

.log-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #0CA77D 0%, #10B981 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.log-icon text {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 600;
}

.log-content {
  flex: 1;
  min-width: 0;
}

.log-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.log-action {
  font-size: 28rpx;
  font-weight: 500;
  color: #1F2937;
}

.log-time {
  font-size: 24rpx;
  color: #9CA3AF;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.log-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.log-user {
  font-size: 24rpx;
  color: #6B7280;
}

.log-resource {
  font-size: 22rpx;
  color: #9CA3AF;
  padding: 4rpx 12rpx;
  background: #F3F4F6;
  border-radius: 8rpx;
}

.log-arrow {
  margin-left: 12rpx;
  color: #D1D5DB;
  font-size: 32rpx;
}

/* 加载更多 */
.loading-more,
.no-more {
  text-align: center;
  padding: 32rpx 0;
  font-size: 26rpx;
  color: #9CA3AF;
}
