<!--
  Audit Logs Page
  审计日志页面
-->
<view class="audit-page">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="header-title">审计日志</text>
    <text class="header-desc">查看系统操作记录</text>
  </view>

  <!-- 高级筛选区域 -->
  <view class="filter-section">
    <!-- 第一行：日期筛选 -->
    <view class="filter-row">
      <view class="filter-item-box" bindtap="showStartDatePicker">
        <text class="filter-label">开始日期</text>
        <view class="filter-value">
          <text>{{startDateText || '不限'}}</text>
          <van-icon name="arrow-down" size="24rpx" color="#9CA3AF" />
        </view>
      </view>
      <view class="filter-item-box" bindtap="showEndDatePicker">
        <text class="filter-label">结束日期</text>
        <view class="filter-value">
          <text>{{endDateText || '不限'}}</text>
          <van-icon name="arrow-down" size="24rpx" color="#9CA3AF" />
        </view>
      </view>
    </view>

    <!-- 第二行：操作人和操作类型 -->
    <view class="filter-row">
      <view class="filter-item-box" bindtap="showUserPicker">
        <text class="filter-label">操作人</text>
        <view class="filter-value">
          <text>{{selectedUserLabel || '全部'}}</text>
          <van-icon name="arrow-down" size="24rpx" color="#9CA3AF" />
        </view>
      </view>
      <view class="filter-item-box" bindtap="toggleFilter">
        <text class="filter-label">操作类型</text>
        <view class="filter-value">
          <text>{{selectedActionLabel}}</text>
          <van-icon name="arrow-down" size="24rpx" color="#9CA3AF" />
        </view>
      </view>
    </view>

    <!-- 第三行：按钮区域 -->
    <view class="filter-actions">
      <view class="action-btn reset-btn" bindtap="resetFilters">
        <van-icon name="replay" size="28rpx" />
        <text>重置</text>
      </view>
      <view class="action-btn search-btn" bindtap="doSearch">
        <van-icon name="search" size="28rpx" />
        <text>搜索</text>
      </view>
      <view class="action-btn export-btn" bindtap="exportCSV">
        <van-icon name="down" size="28rpx" />
        <text>导出</text>
      </view>
    </view>

    <!-- 统计信息 -->
    <view class="filter-stats">
      <text>共 {{total}} 条记录</text>
    </view>
  </view>

  <!-- 操作类型筛选下拉面板 -->
  <view wx:if="{{showFilter}}" class="filter-dropdown" catchtap="stopPropagation">
    <view class="filter-mask" bindtap="toggleFilter"></view>
    <view class="filter-panel">
      <view
        wx:for="{{actions}}"
        wx:key="value"
        class="filter-option {{selectedAction === item.value ? 'selected' : ''}}"
        bindtap="selectAction"
        data-value="{{item.value}}"
        data-label="{{item.label}}"
      >
        <text>{{item.label}}</text>
        <text wx:if="{{selectedAction === item.value}}" class="check">✓</text>
      </view>
    </view>
  </view>

  <!-- 日期选择器弹窗 -->
  <van-popup show="{{showStartDate}}" position="bottom" bind:close="hideStartDatePicker">
    <van-datetime-picker
      type="date"
      value="{{startDateValue}}"
      min-date="{{minDate}}"
      max-date="{{maxDate}}"
      bind:confirm="onStartDateConfirm"
      bind:cancel="hideStartDatePicker"
    />
  </van-popup>

  <van-popup show="{{showEndDate}}" position="bottom" bind:close="hideEndDatePicker">
    <van-datetime-picker
      type="date"
      value="{{endDateValue}}"
      min-date="{{minDate}}"
      max-date="{{maxDate}}"
      bind:confirm="onEndDateConfirm"
      bind:cancel="hideEndDatePicker"
    />
  </van-popup>

  <!-- 操作人选择器弹窗 -->
  <van-popup show="{{showUserSelect}}" position="bottom" bind:close="hideUserPicker">
    <van-picker
      show-toolbar
      title="选择操作人"
      columns="{{userColumns}}"
      bind:confirm="onUserConfirm"
      bind:cancel="hideUserPicker"
    />
  </van-popup>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-state">
    <text>加载中...</text>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{logs.length === 0}}" class="empty-state">
    <view class="empty-icon">📋</view>
    <text class="empty-text">暂无审计日志</text>
  </view>

  <!-- 日志列表 -->
  <view wx:else class="log-list">
    <view
      wx:for="{{logs}}"
      wx:key="_id"
      class="log-item"
      bindtap="viewDetail"
      data-log="{{item}}"
    >
      <view class="log-icon">
        <text>{{item.actionLabel[0]}}</text>
      </view>
      <view class="log-content">
        <view class="log-header">
          <text class="log-action">{{item.actionLabel}}</text>
          <text class="log-time">{{item.timeText}}</text>
        </view>
        <view class="log-meta">
          <text class="log-user">{{item.user_name || '系统'}}</text>
          <text wx:if="{{item.resource_type}}" class="log-resource">{{item.resource_type}}</text>
        </view>
      </view>
      <view class="log-arrow">
        <text>›</text>
      </view>
    </view>

    <!-- 加载更多 -->
    <view wx:if="{{loadingMore}}" class="loading-more">
      <text>加载中...</text>
    </view>

    <view wx:elif="{{!hasMore}}" class="no-more">
      <text>没有更多了</text>
    </view>
  </view>
</view>
