/* System Configuration Page - Apple Design Style */

/* ==================== Container ==================== */
.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: var(--color-bg-secondary);
}

/* ==================== Scrollable Area ==================== */
.config-scroll {
  flex: 1;
  overflow-y: auto;
}

.config-container {
  padding: var(--spacing-lg);
  padding-bottom: calc(120rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* ==================== Config Section ==================== */
.config-section {
  background-color: var(--color-bg-elevated);
  border-radius: var(--radius-xl);
  padding: var(--spacing-xl);
  margin-bottom: var(--spacing-lg);
  box-shadow: var(--shadow-sm);
  transition: all var(--transition-base);
}

.section-header {
  margin-bottom: var(--spacing-xl);
  padding-bottom: var(--spacing-lg);
  border-bottom: 1rpx solid var(--color-border);
}

.section-title {
  display: block;
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-xs);
}

.section-desc {
  display: block;
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
  line-height: 1.6;
  font-weight: var(--font-weight-medium);
}

/* ==================== Config Item ==================== */
.config-item {
  padding: var(--spacing-lg) 0;
  border-bottom: 1rpx solid var(--color-border);
}

.config-item:last-child {
  border-bottom: none;
}

.config-label {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-xs);
  margin-bottom: var(--spacing-md);
}

.label-text {
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  font-weight: var(--font-weight-semibold);
}

.label-desc {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
  line-height: 1.5;
}

/* ==================== Input Groups ==================== */
.config-inputs {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
}

.input-group {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
}

.input-label {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  min-width: 120rpx;
  font-weight: var(--font-weight-medium);
}

.weui-input {
  flex: 1;
  padding: var(--spacing-md) var(--spacing-lg);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  font-size: var(--font-size-base);
  background-color: var(--color-bg-primary);
  color: var(--color-text-primary);
  transition: all var(--transition-base);
}

.weui-input:focus {
  border-color: var(--color-primary);
  background-color: white;
  box-shadow: 0 0 0 4rpx rgba(0, 122, 255, 0.1);
}

.input-unit {
  font-size: var(--font-size-sm);
  color: var(--color-text-tertiary);
  min-width: 60rpx;
  font-weight: var(--font-weight-medium);
}

.config-input-row {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
}

/* ==================== Fault Type Items ==================== */
.fault-type-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-lg);
  background-color: var(--color-bg-primary);
  border-radius: var(--radius-lg);
  margin-bottom: var(--spacing-md);
  border: 1rpx solid var(--color-border);
  transition: all var(--transition-base);
}

.fault-type-item:active {
  background-color: var(--color-bg-secondary);
  transform: scale(0.98);
}

.fault-type-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: var(--spacing-xs);
}

.fault-type-name {
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  font-weight: var(--font-weight-semibold);
}

.fault-type-status {
  font-size: var(--font-size-xs);
  padding: 6rpx 12rpx;
  border-radius: var(--radius-full);
  width: fit-content;
  font-weight: var(--font-weight-semibold);
}

.fault-type-status.active {
  background-color: rgba(52, 199, 89, 0.15);
  color: var(--color-success);
}

.fault-type-status.inactive {
  background-color: rgba(255, 59, 48, 0.15);
  color: var(--color-error);
}

/* ==================== Fault Type Actions ==================== */
.fault-type-actions {
  display: flex;
  gap: var(--spacing-sm);
}

.mini-btn {
  padding: var(--spacing-sm) var(--spacing-lg);
  font-size: var(--font-size-sm);
  border-radius: var(--radius-full);
  border: 2rpx solid var(--color-border);
  background-color: var(--color-bg-elevated);
  color: var(--color-text-primary);
  font-weight: var(--font-weight-semibold);
  transition: all var(--transition-base);
}

.mini-btn:active {
  transform: scale(0.95);
  background-color: var(--color-bg-secondary);
}

.mini-btn.primary {
  background: linear-gradient(135deg, #007AFF 0%, #5AC8FA 100%);
  color: white;
  border-color: transparent;
  box-shadow: 0 2rpx 8rpx rgba(0, 122, 255, 0.3);
}

.mini-btn.primary:active {
  box-shadow: 0 1rpx 4rpx rgba(0, 122, 255, 0.2);
}

.mini-btn.warn {
  background: linear-gradient(135deg, #FF9500 0%, #FF9F0A 100%);
  color: white;
  border-color: transparent;
  box-shadow: 0 2rpx 8rpx rgba(255, 149, 0, 0.3);
}

.mini-btn.warn:active {
  box-shadow: 0 1rpx 4rpx rgba(255, 149, 0, 0.2);
}

.add-btn {
  margin-top: var(--spacing-md);
  width: 100%;
  padding: var(--spacing-md);
  background-color: rgba(0, 122, 255, 0.1);
  color: var(--color-primary);
  border: 2rpx dashed var(--color-primary);
  border-radius: var(--radius-lg);
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-semibold);
  transition: all var(--transition-base);
}

.add-btn:active {
  background-color: rgba(0, 122, 255, 0.2);
  transform: scale(0.98);
}

/* ==================== Action Buttons ==================== */
.action-buttons {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: var(--spacing-lg);
  padding-bottom: calc(var(--spacing-lg) + constant(safe-area-inset-bottom));
  padding-bottom: calc(var(--spacing-lg) + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(40rpx);
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.08);
  z-index: 100;
}

.action-buttons button {
  width: 100%;
  height: 96rpx;
  border-radius: var(--radius-full);
  background: linear-gradient(135deg, #007AFF 0%, #5AC8FA 100%);
  color: white;
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(0, 122, 255, 0.3);
  transition: all var(--transition-base);
  margin: 0;
}

.action-buttons button:active {
  transform: scale(0.96);
  box-shadow: 0 2rpx 8rpx rgba(0, 122, 255, 0.2);
}

.action-buttons button::after {
  border: none;
}

/* ==================== Modal Styles ==================== */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.4);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  animation: fadeIn 0.3s ease-out;
}

@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

.modal-container {
  width: 90%;
  max-width: 600rpx;
  background-color: var(--color-bg-elevated);
  border-radius: var(--radius-2xl);
  overflow: hidden;
  box-shadow: 0 24rpx 48rpx rgba(0, 0, 0, 0.2);
  animation: scaleIn 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes scaleIn {
  from {
    opacity: 0;
    transform: scale(0.9);
  }
  to {
    opacity: 1;
    transform: scale(1);
  }
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: var(--spacing-xl);
  border-bottom: 1rpx solid var(--color-border);
  background-color: var(--color-bg-primary);
}

.modal-title {
  font-size: var(--font-size-xl);
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-primary);
}

.modal-close {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background-color: var(--color-bg-secondary);
  color: var(--color-text-secondary);
  font-size: var(--font-size-xl);
  transition: all var(--transition-base);
}

.modal-close:active {
  background-color: var(--color-bg-tertiary);
  transform: scale(0.9);
}

.modal-content {
  padding: var(--spacing-xl);
}

/* ==================== Form Fields ==================== */
.form-field {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-md);
  margin-bottom: var(--spacing-lg);
}

.form-field:last-child {
  margin-bottom: 0;
}

.field-label {
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  font-weight: var(--font-weight-semibold);
}

.field-input {
  padding: var(--spacing-md) var(--spacing-lg);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-lg);
  font-size: var(--font-size-base);
  background-color: var(--color-bg-primary);
  color: var(--color-text-primary);
  transition: all var(--transition-base);
}

.field-input:focus {
  border-color: var(--color-primary);
  background-color: white;
  box-shadow: 0 0 0 4rpx rgba(0, 122, 255, 0.1);
}

/* ==================== Modal Actions ==================== */
.modal-actions {
  display: flex;
  gap: var(--spacing-md);
  padding: var(--spacing-lg) var(--spacing-xl);
  border-top: 1rpx solid var(--color-border);
  background-color: var(--color-bg-primary);
}

.modal-actions button {
  flex: 1;
  height: 88rpx;
  margin: 0;
  border-radius: var(--radius-full);
  font-size: var(--font-size-base);
  font-weight: var(--font-weight-semibold);
  transition: all var(--transition-base);
}

.modal-actions button::after {
  border: none;
}

.modal-actions button:active {
  transform: scale(0.96);
}

.cancel-btn {
  background-color: var(--color-bg-secondary);
  color: var(--color-text-secondary);
}

.confirm-btn {
  background: linear-gradient(135deg, #007AFF 0%, #5AC8FA 100%);
  color: white;
  box-shadow: 0 4rpx 12rpx rgba(0, 122, 255, 0.3);
}

.confirm-btn:active {
  box-shadow: 0 2rpx 8rpx rgba(0, 122, 255, 0.2);
}
