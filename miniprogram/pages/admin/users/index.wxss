/* User Management Page - 参考设计图优化 */

/* 页面容器 */
.user-page {
  min-height: 100vh;
  background-color: #F5F5F5;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* 顶部搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 32rpx;
  background: #0CA77D;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 28rpx;
  background: #FFFFFF;
  border-radius: 40rpx;
}

.search-icon {
  width: 36rpx;
  height: 36rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
}

.search-input::placeholder {
  color: #CCCCCC;
}

/* 筛选按钮 */
.filter-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 16rpx;
}

.filter-icon {
  width: 40rpx;
  height: 40rpx;
}

.filter-btn.active {
  background: #FFFFFF;
}

.filter-btn.active .filter-icon {
  filter: brightness(0) saturate(100%) invert(45%) sepia(79%) saturate(431%) hue-rotate(115deg) brightness(92%) contrast(89%);
}

/* 筛选面板 */
.filter-panel {
  max-height: 0;
  overflow: hidden;
  background: #FFFFFF;
  transition: max-height 0.3s ease;
}

.filter-panel.show {
  max-height: 400rpx;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.filter-group {
  margin-bottom: 20rpx;
}

.filter-label {
  font-size: 26rpx;
  color: #999999;
  margin-bottom: 16rpx;
}

.filter-options {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.filter-option {
  padding: 12rpx 28rpx;
  background: #F5F5F5;
  border-radius: 32rpx;
  font-size: 26rpx;
  color: #666666;
}

.filter-option.active {
  background: #0CA77D;
  color: #FFFFFF;
}

.filter-actions {
  display: flex;
  justify-content: flex-end;
  padding-top: 16rpx;
}

.reset-btn {
  font-size: 26rpx;
  color: #0CA77D;
  padding: 8rpx 24rpx;
}

/* 数据统计 */
.data-count {
  padding: 24rpx 32rpx 16rpx;
  font-size: 26rpx;
  color: #999999;
}

/* 用户列表 */
.user-list {
  padding: 0 32rpx;
}

/* 加载状态 */
.loading-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 120rpx 0;
  color: #999999;
  font-size: 28rpx;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.4;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

/* 用户卡片 */
.user-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  position: relative;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}

.user-card:active {
  background: #FAFAFA;
}

.user-card.disabled {
  opacity: 0.6;
}

/* 头像 */
.user-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #E8F5F0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
  overflow: hidden;
}

.user-avatar .avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.user-avatar .avatar-text {
  font-size: 36rpx;
  color: #0CA77D;
  font-weight: 500;
}

/* 用户信息 */
.user-info {
  flex: 1;
  min-width: 0;
  padding-right: 140rpx;
}

.user-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333333;
  margin-bottom: 16rpx;
}

.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 8rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-label {
  font-size: 26rpx;
  color: #999999;
  min-width: 100rpx;
}

.info-value {
  font-size: 26rpx;
  color: #333333;
}

/* 角色标签 */
.role-tag {
  position: absolute;
  top: 28rpx;
  right: 28rpx;
  padding: 8rpx 20rpx;
  background: rgba(12, 167, 125, 0.1);
  color: #0CA77D;
  font-size: 24rpx;
  font-weight: 500;
  border-radius: 8rpx;
}

/* 浮动按钮 */
.fab-button {
  position: fixed;
  right: 40rpx;
  bottom: calc(100rpx + env(safe-area-inset-bottom));
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FFA500 0%, #FF8C00 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 140, 0, 0.4);
  z-index: 100;
}

.fab-button:active {
  transform: scale(0.95);
}

.fab-icon {
  font-size: 56rpx;
  color: #FFFFFF;
  font-weight: 300;
}

/* 列表动画 */
.list-content {
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
