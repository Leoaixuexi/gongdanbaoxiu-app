<!--
  Add User Page (Premium Redesign)
-->
<view class="container">
  <scroll-view scroll-y class="form-scroll" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view class="form-container">
      
      <!-- 主卡片：核心信息 -->
      <view class="card">
        <!-- Username -->
        <view class="form-section">
          <view class="form-label required">用户名</view>
          <input
            class="weui-input {{errors.username ? 'error' : ''}}"
            placeholder="请输入用户名"
            value="{{formData.username}}"
            bindinput="onUsernameInput"
            bindblur="onUsernameBlur"
          />
        </view>
        <view wx:if="{{errors.username}}" class="error-text">{{errors.username}}</view>
        
        <!-- Password -->
        <view class="form-section">
          <view class="form-label required">密码</view>
          <input
            class="weui-input {{errors.password ? 'error' : ''}}"
            placeholder="请输入初始密码"
            type="password"
            value="{{formData.password}}"
            bindinput="onPasswordInput"
            bindblur="onPasswordBlur"
          />
        </view>
        <view wx:if="{{errors.password}}" class="error-text">{{errors.password}}</view>

        <!-- Name -->
        <view class="form-section">
          <view class="form-label required">姓名</view>
          <input
            class="weui-input {{errors.name ? 'error' : ''}}"
            placeholder="请输入真实姓名"
            value="{{formData.name}}"
            bindinput="onNameInput"
            bindblur="onNameBlur"
          />
        </view>
        <view wx:if="{{errors.name}}" class="error-text">{{errors.name}}</view>

        <!-- Gender -->
        <view class="form-section">
          <view class="form-label required">性别</view>
          <view class="gender-options">
            <view
              class="gender-option {{formData.gender === 1 ? 'selected' : ''}}"
              bindtap="onSelectGender"
              data-gender="1"
            >
              <text class="gender-icon male">♂</text>
              <text>男</text>
            </view>
            <view
              class="gender-option {{formData.gender === 2 ? 'selected' : ''}}"
              bindtap="onSelectGender"
              data-gender="2"
            >
              <text class="gender-icon female">♀</text>
              <text>女</text>
            </view>
          </view>
        </view>
        <view wx:if="{{errors.gender}}" class="error-text">{{errors.gender}}</view>

        <!-- Role -->
        <view class="form-section">
          <view class="form-label required">角色</view>
          <view class="picker-container" bindtap="onShowRolePicker">
            <text class="picker-text {{formData.role_id ? '' : 'placeholder'}}">{{selectedRoleName || '请选择角色'}}</text>
            <!-- 自定义 Chevron 图标 -->
            <text style="color: #ccc; font-size: 24rpx;">></text>
          </view>
        </view>
        <view wx:if="{{errors.role_id}}" class="error-text">{{errors.role_id}}</view>
      </view>

      <!-- 次要卡片：联系与状态 -->
      <view class="card">
        <!-- Contact Phone -->
        <view class="form-section">
          <view class="form-label">联系电话</view>
          <input
            class="weui-input {{errors.contact_phone ? 'error' : ''}}"
            placeholder="请输入手机号"
            type="number"
            maxlength="11"
            value="{{formData.contact_phone}}"
            bindinput="onPhoneInput"
            bindblur="onPhoneBlur"
          />
        </view>
        <view wx:if="{{errors.contact_phone}}" class="error-text">{{errors.contact_phone}}</view>

        <!-- Department -->
        <view class="form-section">
          <view class="form-label">部门</view>
          <view class="picker-container" bindtap="onShowDeptPicker">
            <text class="picker-text {{formData.department ? '' : 'placeholder'}}">{{formData.department || '请选择部门'}}</text>
            <text style="color: #ccc; font-size: 24rpx;">></text>
          </view>
        </view>

        <!-- Active Status -->
        <view class="form-section">
          <view class="form-label">启用状态</view>
          <switch
            checked="{{formData.is_active}}"
            bindchange="onActiveChange"
            color="#10b981"
            style="transform: scale(0.8);"
          />
        </view>
        <!-- 提示移至底部，更整洁 -->
        <view class="form-hint" wx:if="{{!formData.is_active}}">当前状态：禁用 (用户无法登录)</view>
      </view>

    </view>
  </scroll-view>

  <!-- Action Buttons -->
  <view class="action-buttons">
    <button class="weui-btn cancel-btn" bindtap="onCancel">取消</button>
    <button
      class="weui-btn"
      type="primary"
      bindtap="onSubmit"
      disabled="{{submitting}}"
      loading="{{submitting}}"
    >
      {{submitting ? '提交中...' : '确认创建'}}
    </button>
  </view>
</view>

<!-- Role Picker Modal -->
<view wx:if="{{showRolePicker}}" class="modal-overlay" catchtap="onCloseRolePicker">
  <view class="modal-content selector-modal" catchtap="onModalStopPropagation">
    <view class="modal-header">
      <text class="modal-title">选择角色</text>
      <view class="modal-close" catchtap="onCloseRolePicker">
        <text class="iconfont icon-close">×</text>
      </view>
    </view>

    <scroll-view scroll-y class="selector-scroll">
      <view
        wx:for="{{roles}}"
        wx:key="id"
        class="selector-item {{formData.role_id === item.id ? 'active' : ''}}"
        catchtap="onSelectRole"
        data-id="{{item.id}}"
        data-name="{{item.name}}"
      >
        <text class="selector-item-text">{{item.name}}</text>
        <view wx:if="{{formData.role_id === item.id}}" class="selector-check"></view>
      </view>
    </scroll-view>
  </view>
</view>

<!-- Department Picker Modal -->
<view wx:if="{{showDeptPicker}}" class="modal-overlay" catchtap="onCloseDeptPicker">
  <view class="modal-content selector-modal" catchtap="onModalStopPropagation">
    <view class="modal-header">
      <text class="modal-title">选择部门</text>
      <view class="modal-close" catchtap="onCloseDeptPicker">
        <text class="iconfont icon-close">×</text>
      </view>
    </view>

    <scroll-view scroll-y class="selector-scroll">
      <view
        wx:for="{{departments}}"
        wx:key="*this"
        class="selector-item {{formData.department === item ? 'active' : ''}}"
        catchtap="onSelectDept"
        data-dept="{{item}}"
      >
        <text class="selector-item-text">{{item}}</text>
        <view wx:if="{{formData.department === item}}" class="selector-check"></view>
      </view>
    </scroll-view>
  </view>
</view>