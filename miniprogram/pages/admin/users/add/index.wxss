/* Add User Page Styles - Premium Redesign */

/* 全局字体设置 */
page {
  font-family: "PingFang SC", -apple-system, BlinkMacSystemFont, "Segoe UI", "Hiragino Sans GB", "Microsoft YaHei", "Helvetica Neue", Helvetica, Arial, sans-serif;
  background-color: #F7F8FA; /* 浅灰底色 */
  color: #333;
}

.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom)); /* 为底部悬浮按钮留出空间 */
}

/* 滚动区域 */
.form-scroll {
  flex: 1;
  width: 100%;
}

.form-container {
  padding: 32rpx;
}

/* 核心卡片容器 */
.card {
  background-color: #ffffff;
  border-radius: 32rpx;
  padding: 0 32rpx; /* 左右内边距 */
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04); /* 弥散阴影 */
  margin-bottom: 32rpx;
}

/* 表单行 */
.form-section {
  display: flex;
  align-items: center; /* 垂直居中 */
  justify-content: space-between;
  padding: 36rpx 0; /* 增加行高，呼吸感更强 */
  border-bottom: 1rpx solid #F5F7FA; /* 极细分割线 */
  background-color: transparent;
  border-radius: 0;
  margin-bottom: 0;
}

.form-section:last-child {
  border-bottom: none;
}

/* 标签列 */
.form-label {
  font-size: 30rpx;
  color: #1F2937; /* 深灰偏黑 */
  font-weight: 500;
  min-width: 160rpx; /* 固定宽度，对齐 */
  flex-shrink: 0;
}

.form-label.required::before {
  content: '*';
  color: #FF3B30;
  margin-right: 4rpx;
  font-size: 30rpx;
}

/* 输入框样式 (右对齐，无边框) */
.weui-input {
  flex: 1;
  text-align: right;
  font-size: 30rpx;
  color: #111827;
  padding: 0;
  border: none;
  background: transparent;
  height: 44rpx;
  min-height: 44rpx;
}

.weui-input::placeholder {
  color: #CCCCCC;
  font-size: 30rpx;
  font-weight: 400;
}

/* 选择器显示文字 */
.picker-container {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding: 0;
  border: none;
  background: transparent;
}

.picker-text {
  font-size: 30rpx;
  color: #111827;
  margin-right: 12rpx;
  font-weight: 500;
}

.picker-text.placeholder {
  color: #CCCCCC;
  font-weight: 400;
}

/* 箭头图标统一 */
icon[type="arrow"] {
  opacity: 0.3;
}

/* 性别选择 - 胶囊风格 */
.gender-options {
  display: flex;
  gap: 24rpx;
}

.gender-option {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 32rpx;
  background-color: #F3F4F6;
  border-radius: 40rpx; /* 全圆角 */
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  border: 2rpx solid transparent;
}

.gender-option text {
  font-size: 28rpx;
  color: #6B7280;
  font-weight: 500;
}

.gender-icon {
  font-size: 28rpx;
  margin: 0;
  width: auto;
  height: auto;
  border-radius: 0;
  background: transparent;
}

.gender-icon.male {
  color: #6B7280;
}

.gender-icon.female {
  color: #6B7280;
}

/* 选中态 - 男 */
.gender-option.selected[data-gender="1"] {
  background-color: #EBF8FF; /* 浅蓝背景 */
  border-color: #3B82F6;
}

.gender-option.selected[data-gender="1"] text {
  color: #3B82F6;
}

.gender-option.selected[data-gender="1"] .gender-icon.male {
  color: #3B82F6;
}

/* 选中态 - 女 */
.gender-option.selected[data-gender="2"] {
  background-color: #FFF0F5; /* 浅粉背景 */
  border-color: #EC4899;
}

.gender-option.selected[data-gender="2"] text {
  color: #EC4899;
}

.gender-option.selected[data-gender="2"] .gender-icon.female {
  color: #EC4899;
}


/* 提示文字 */
.form-hint {
  font-size: 24rpx;
  color: #9CA3AF;
  margin-top: 8rpx;
  text-align: right;
  width: 100%;
}

.form-section-col {
  display: flex;
  flex-direction: column;
  padding: 36rpx 0;
  border-bottom: 1rpx solid #F5F7FA;
}

.form-section-col .form-label {
  margin-bottom: 16rpx;
}

/* 错误提示 */
.error-text {
  font-size: 24rpx;
  color: #EF4444;
  text-align: right;
  margin-top: 8rpx;
  animation: fadeIn 0.3s ease;
}

@keyframes fadeIn {
  from { opacity: 0; transform: translateY(-4rpx); }
  to { opacity: 1; transform: translateY(0); }
}

/* 底部操作区 - 悬浮卡片 */
.action-buttons {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
  padding: 24rpx 48rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center; /* 确保子元素垂直居中 */
  gap: 32rpx;
  z-index: 100;
}

.action-buttons button {
  margin: 0 !important;
  padding: 0 !important;
  height: 96rpx !important;
  line-height: 96rpx !important; /* 强制行高一致 */
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none !important;
  box-sizing: border-box; /* 统一盒模型 */
}

/* 彻底去除小程序按钮自带的边框 */
.action-buttons button::after {
  display: none !important;
  border: none !important;
}

.cancel-btn {
  flex: 1;
  background-color: #F3F4F6;
  color: #4B5563;
}

.weui-btn[type="primary"] {
  flex: 1; /* 宽度保持一致 */
  background: linear-gradient(135deg, #10b981 0%, #14b8a6 100%);
  color: white;
  box-shadow: 0 8rpx 20rpx rgba(16, 185, 129, 0.3);
}

.weui-btn[disabled] {
  opacity: 0.6;
  background: #E5E7EB !important;
  color: #9CA3AF !important;
  box-shadow: none;
}

/* 标准弹窗样式 (统一全站) */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.modal-content {
  width: 100%;
  background-color: white;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  animation: slide-up 0.3s ease-out;
}

@keyframes slide-up {
  from {
    transform: translateY(100%);
  }
  to {
    transform: translateY(0);
  }
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 48rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 500;
  color: #333;
}

.selector-modal {
  display: flex;
  flex-direction: column;
  max-height: 80vh;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.modal-close {
  position: absolute;
  right: 32rpx;
  top: 32rpx;
  padding: 10rpx;
  line-height: 1;
}

.icon-close {
  font-size: 40rpx;
  color: #999;
  font-weight: 300;
}

.selector-scroll {
  width: 100%;
  max-height: 60vh;
  margin-top: 20rpx;
}

.selector-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 16rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.selector-item:active {
  background-color: #F9F9F9;
}

.selector-item:last-child {
  border-bottom: none;
}

.selector-item-text {
  font-size: 32rpx;
  color: #333;
}

.selector-item.active .selector-item-text {
  color: #0CA77D;
  font-weight: 500;
}

.selector-check {
  width: 32rpx;
  height: 16rpx;
  border-left: 4rpx solid #0CA77D;
  border-bottom: 4rpx solid #0CA77D;
  transform: rotate(-45deg) translateY(-4rpx);
}