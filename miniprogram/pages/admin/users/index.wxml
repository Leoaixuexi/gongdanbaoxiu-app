<!--
  User Management Page
  账号管理列表页面 - 参考设计图优化
-->
<view class="user-page">
  <!-- 顶部搜索栏 -->
  <view class="search-bar">
    <view class="search-box">
      <image class="search-icon" src="/images/icons/search.svg" mode="aspectFit"></image>
      <input
        class="search-input"
        placeholder="用户名/姓名/简拼"
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
        bindconfirm="onSearch"
      />
    </view>
    <view class="filter-btn {{hasFilter ? 'active' : ''}}" bindtap="toggleFilter">
      <image class="filter-icon" src="/images/icons/filter.svg" mode="aspectFit"></image>
    </view>
  </view>

  <!-- 筛选面板 -->
  <view class="filter-panel {{showFilter ? 'show' : ''}}">
    <view class="filter-group">
      <view class="filter-label">角色</view>
      <view class="filter-options">
        <view
          class="filter-option {{filterRole === '' ? 'active' : ''}}"
          bindtap="filterByRole"
          data-role=""
        >全部</view>
        <view
          wx:for="{{roleOptions}}"
          wx:key="value"
          class="filter-option {{filterRole === item.value ? 'active' : ''}}"
          bindtap="filterByRole"
          data-role="{{item.value}}"
        >{{item.label}}</view>
      </view>
    </view>
    <view class="filter-group">
      <view class="filter-label">状态</view>
      <view class="filter-options">
        <view
          class="filter-option {{filterStatus === '' ? 'active' : ''}}"
          bindtap="filterByStatus"
          data-status=""
        >全部</view>
        <view
          class="filter-option {{filterStatus === 'active' ? 'active' : ''}}"
          bindtap="filterByStatus"
          data-status="active"
        >启用</view>
        <view
          class="filter-option {{filterStatus === 'inactive' ? 'active' : ''}}"
          bindtap="filterByStatus"
          data-status="inactive"
        >停用</view>
      </view>
    </view>
    <view class="filter-actions">
      <view class="reset-btn" bindtap="resetFilter">重置</view>
    </view>
  </view>

  <!-- 数据统计 -->
  <view class="data-count">共 {{users.length}} 条数据</view>

  <!-- 用户列表 -->
  <view class="user-list">
    <view wx:if="{{loading}}" class="loading-state">
      <text>加载中...</text>
    </view>

    <view wx:elif="{{users.length === 0}}" class="empty-state">
      <text class="empty-icon">👤</text>
      <text class="empty-text">暂无用户</text>
    </view>

    <view wx:else class="list-content">
      <view
        wx:for="{{users}}"
        wx:key="_id"
        class="user-card {{item.active === false ? 'disabled' : ''}}"
        bindtap="editUser"
        data-id="{{item._id}}"
        data-user-id="{{item.user_id}}"
      >
        <!-- 右上角角色标签 -->
        <view class="role-tag">{{item.roleName}}</view>

        <!-- 左侧头像 -->
        <view class="user-avatar">
          <image wx:if="{{item.avatar}}" class="avatar-img" src="{{item.avatar}}" mode="aspectFill"></image>
          <text wx:else class="avatar-text">{{item.name[0] || '?'}}</text>
        </view>

        <!-- 中间信息 -->
        <view class="user-info">
          <view class="user-name">{{item.name}}</view>
          <view class="info-row">
            <text class="info-label">手机号</text>
            <text class="info-value">{{item.contact_phone || '未填写'}}</text>
          </view>
          <view class="info-row">
            <text class="info-label">部门</text>
            <text class="info-value">{{item.department || '无'}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 新建按钮 -->
  <view class="fab-button" bindtap="addUser">
    <text class="fab-icon">+</text>
  </view>
</view>
