<!--
  Edit User Page (T155-T156)
  Edit existing user with restrictions
-->
<view class="container">
  <!-- Loading State -->
  <view wx:if="{{loading}}" class="loading-container">
    <view class="weui-loadmore">
      <view class="weui-loading"></view>
      <view class="weui-loadmore__tips">加载中...</view>
    </view>
  </view>

  <!-- Form -->
  <scroll-view wx:else scroll-y class="form-scroll" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view class="form-container">
      <!-- WeChat OpenID (Read-only) -->
      <view class="form-section">
        <view class="form-label">微信OpenID</view>
        <view class="readonly-field">{{formData.openid}}</view>
        <view class="form-hint">OpenID不可修改</view>
      </view>

      <!-- Name -->
      <view class="form-section">
        <view class="form-label required">姓名</view>
        <input
          class="weui-input {{errors.name ? 'error' : ''}}"
          placeholder="请输入姓名"
          value="{{formData.name}}"
          bindinput="onNameInput"
          bindblur="onNameBlur"
        />
        <view wx:if="{{errors.name}}" class="error-text">{{errors.name}}</view>
      </view>

      <!-- Role -->
      <view class="form-section">
        <view class="form-label required">角色</view>
        <view
          class="picker-container {{isSelf ? 'disabled' : ''}}"
          bindtap="{{isSelf ? '' : 'onShowRolePicker'}}"
        >
          <text class="picker-text">{{selectedRoleName}}</text>
          <icon wx:if="{{!isSelf}}" type="arrow" size="12" color="#999"/>
        </view>
        <view wx:if="{{isSelf}}" class="form-hint">不能修改自己的角色</view>
        <view wx:if="{{errors.role_id}}" class="error-text">{{errors.role_id}}</view>
      </view>

      <!-- Contact Phone -->
      <view class="form-section">
        <view class="form-label">联系电话</view>
        <input
          class="weui-input {{errors.contact_phone ? 'error' : ''}}"
          placeholder="请输入联系电话"
          type="number"
          maxlength="11"
          value="{{formData.contact_phone}}"
          bindinput="onPhoneInput"
          bindblur="onPhoneBlur"
        />
        <view wx:if="{{errors.contact_phone}}" class="error-text">{{errors.contact_phone}}</view>
      </view>

      <!-- Department -->
      <view class="form-section">
        <view class="form-label">部门</view>
        <view class="picker-container" bindtap="onShowDeptPicker">
          <text class="picker-text {{formData.department ? '' : 'placeholder'}}">
            {{formData.department || '请选择部门'}}
          </text>
          <icon type="arrow" size="12" color="#999"/>
        </view>
      </view>

      <!-- Supervisor -->
      <view class="form-section">
        <view class="form-label">主管</view>
        <view class="picker-container" bindtap="onShowSupervisorPicker">
          <text class="picker-text {{formData.supervisor_id ? '' : 'placeholder'}}">
            {{selectedSupervisorName || '请选择主管'}}
          </text>
          <icon type="arrow" size="12" color="#999"/>
        </view>
      </view>

      <!-- Active Status -->
      <view class="form-section">
        <view class="form-row">
          <view class="form-label">启用状态</view>
          <switch
            checked="{{formData.is_active}}"
            bindchange="onActiveChange"
            color="#1aad19"
            disabled="{{isSelf}}"
          />
        </view>
        <view wx:if="{{isSelf}}" class="form-hint warning">不能停用自己的账号</view>
        <view wx:else class="form-hint">停用后用户将无法登录系统</view>
      </view>
    </view>
  </scroll-view>

  <!-- Action Buttons -->
  <view wx:if="{{!loading}}" class="action-buttons">
    <button class="weui-btn cancel-btn" bindtap="onCancel">取消</button>
    <button
      class="weui-btn"
      type="primary"
      bindtap="onSubmit"
      disabled="{{submitting}}"
      loading="{{submitting}}"
    >
      {{submitting ? '保存中...' : '保存修改'}}
    </button>
  </view>
</view>

<!-- Role Picker Modal -->
<view class="modal-mask" wx:if="{{showRolePicker}}" bindtap="onCloseRolePicker">
  <view class="modal-container" catchtap="onModalStopPropagation">
    <view class="modal-header">
      <text class="modal-title">选择角色</text>
      <icon type="close" size="20" bindtap="onCloseRolePicker"/>
    </view>
    <view class="modal-content">
      <view
        wx:for="{{roles}}"
        wx:key="id"
        class="option-item {{formData.role_id === item.id ? 'selected' : ''}}"
        bindtap="onSelectRole"
        data-id="{{item.id}}"
        data-name="{{item.name}}"
      >
        <text>{{item.name}}</text>
        <icon wx:if="{{formData.role_id === item.id}}" type="success" size="18" color="#1aad19"/>
      </view>
    </view>
  </view>
</view>

<!-- Department Picker Modal -->
<view class="modal-mask" wx:if="{{showDeptPicker}}" bindtap="onCloseDeptPicker">
  <view class="modal-container" catchtap="onModalStopPropagation">
    <view class="modal-header">
      <text class="modal-title">选择部门</text>
      <icon type="close" size="20" bindtap="onCloseDeptPicker"/>
    </view>
    <view class="modal-content">
      <view
        wx:for="{{departments}}"
        wx:key="*this"
        class="option-item {{formData.department === item ? 'selected' : ''}}"
        bindtap="onSelectDept"
        data-dept="{{item}}"
      >
        <text>{{item}}</text>
        <icon wx:if="{{formData.department === item}}" type="success" size="18" color="#1aad19"/>
      </view>
    </view>
  </view>
</view>

<!-- Supervisor Picker Modal -->
<view class="modal-mask" wx:if="{{showSupervisorPicker}}" bindtap="onCloseSupervisorPicker">
  <view class="modal-container" catchtap="onModalStopPropagation">
    <view class="modal-header">
      <text class="modal-title">选择主管</text>
      <icon type="close" size="20" bindtap="onCloseSupervisorPicker"/>
    </view>
    <view class="modal-content">
      <view wx:if="{{supervisors.length === 0}}" class="empty-hint">
        <text>暂无可选主管</text>
      </view>
      <view
        wx:for="{{supervisors}}"
        wx:key="id"
        class="option-item {{formData.supervisor_id === item.id ? 'selected' : ''}}"
        bindtap="onSelectSupervisor"
        data-id="{{item.id}}"
        data-name="{{item.name}}"
      >
        <view class="option-info">
          <text class="option-name">{{item.name}}</text>
          <text class="option-desc">{{item.role_name}} - {{item.department}}</text>
        </view>
        <icon wx:if="{{formData.supervisor_id === item.id}}" type="success" size="18" color="#1aad19"/>
      </view>
    </view>
  </view>
</view>

<!-- Deactivation Confirmation Modal -->
<view class="modal-mask" wx:if="{{showDeactivateConfirm}}" bindtap="onCancelDeactivate">
  <view class="confirm-modal" catchtap="onModalStopPropagation">
    <view class="confirm-title">确认停用用户?</view>
    <view class="confirm-content">
      <text>用户"{{formData.name}}"停用后将无法登录系统，确认要继续吗？</text>
    </view>
    <view class="confirm-actions">
      <button class="weui-btn cancel-btn" bindtap="onCancelDeactivate">取消</button>
      <button class="weui-btn" type="warn" bindtap="onConfirmDeactivate">确认停用</button>
    </view>
  </view>
</view>
