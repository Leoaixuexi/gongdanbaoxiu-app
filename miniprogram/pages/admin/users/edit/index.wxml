<!--
  Edit User Page (Photo Reference Style)
-->
<view class="container">
  <!-- Loading State -->
  <view wx:if="{{loading}}" class="loading-container">
    <view class="weui-loadmore">
      <view class="weui-loading"></view>
      <view class="weui-loadmore__tips">加载中...</view>
    </view>
  </view>

  <scroll-view wx:else scroll-y class="form-scroll" enhanced="{{true}}" show-scrollbar="{{false}}">
    <view class="form-container">
      
      <!-- 核心大卡片 -->
      <view class="mega-card">
        
        <!-- 头像行 -->
        <view class="form-row avatar-row">
          <text class="label-text">头像</text>
          <view class="avatar-wrapper">
            <!-- 假设有 avatar 字段，暂时用占位符 -->
            <text class="avatar-placeholder">👤</text> 
          </view>
        </view>

        <!-- 用户账号 (只读) -->
        <view class="form-row">
          <text class="label-text">用户名</text>
          <text class="value-text">{{formData.username}}</text>
        </view>

        <!-- 姓名 -->
        <view class="form-row">
          <text class="label-text">姓名</text>
          <input
            class="weui-input"
            value="{{formData.name}}"
            bindinput="onNameInput"
            placeholder="请输入"
          />
        </view>
        <!-- 错误提示跟随 -->
        <view wx:if="{{errors.name}}" class="error-tip">{{errors.name}}</view>

        <!-- 手机号 -->
        <view class="form-row">
          <text class="label-text">手机号</text>
          <input
            class="weui-input"
            type="number"
            maxlength="11"
            value="{{formData.contact_phone}}"
            bindinput="onPhoneInput"
            placeholder="请输入"
          />
        </view>
        <view wx:if="{{errors.contact_phone}}" class="error-tip">{{errors.contact_phone}}</view>

        <!-- 角色 -->
        <view class="form-row" bindtap="{{isSelf ? '' : 'onShowRolePicker'}}">
          <text class="label-text">角色</text>
          <view class="picker-trigger">
            <text class="value-text">{{selectedRoleName || '请选择'}}</text>
            <text wx:if="{{!isSelf}}" class="picker-arrow">></text>
          </view>
        </view>
        <view wx:if="{{errors.role_id}}" class="error-tip">{{errors.role_id}}</view>

        <!-- 性别 (图中没有明确显示，但作为基础字段保留) -->
        <view class="form-row">
          <text class="label-text">性别</text>
          <view class="picker-trigger">
            <!-- 简化展示，点击可切换 -->
            <view class="gender-toggle" style="display:flex; gap:20rpx;">
              <text 
                bindtap="onSelectGender" data-gender="1" 
                style="color: {{formData.gender === 1 ? '#333' : '#ccc'}}">男</text>
              <text style="color:#eee">|</text>
              <text 
                bindtap="onSelectGender" data-gender="2" 
                style="color: {{formData.gender === 2 ? '#333' : '#ccc'}}">女</text>
            </view>
          </view>
        </view>

        <!-- 部门 -->
        <view class="form-row" bindtap="onShowDeptPicker">
          <text class="label-text">部门</text>
          <view class="picker-trigger">
            <text class="value-text">{{formData.department || '无'}}</text>
            <text class="picker-arrow">></text>
          </view>
        </view>

        <!-- 虚拟用户 (启用状态) -->
        <view class="form-row">
          <text class="label-text">账号启用</text>
          <view class="picker-trigger">
            <text class="value-text" wx:if="{{isSelf}}">是</text>
            <switch
              wx:else
              checked="{{formData.is_active}}"
              bindchange="onActiveChange"
              color="#56B78A"
              style="transform: scale(0.8);"
            />
          </view>
        </view>

      </view>

    </view>
  </scroll-view>

  <!-- 底部悬浮操作栏 -->
  <view class="bottom-bar">
    <!-- 更多按钮 -->
    <view class="more-btn" bindtap="onShowActionMenu">
      <text>...</text>
    </view>

    <!-- 修改按钮 -->
    <view class="submit-btn" bindtap="onSubmit">
      <text>{{submitting ? '保存中...' : '修改'}}</text>
    </view>
  </view>
</view>

<!-- 操作菜单弹窗 -->
<view class="modal-mask" wx:if="{{showActionMenu}}" bindtap="onCloseActionMenu">
  <view class="action-menu" catchtap="onModalStopPropagation">
    <view class="action-grid">
      <view class="action-item" bindtap="onResetPassword">
        <view class="action-icon-wrapper">
          <image class="action-icon" src="/images/icons/lock-reset.svg" mode="aspectFit"></image>
        </view>
        <text class="action-text">重置密码</text>
      </view>
      <view class="action-item {{isSelf ? 'disabled' : ''}}" bindtap="onDisableUser">
        <view class="action-icon-wrapper">
          <image class="action-icon" src="/images/icons/ban.svg" mode="aspectFit"></image>
        </view>
        <text class="action-text">{{formData.is_active ? '禁用' : '启用'}}</text>
      </view>
    </view>
  </view>
</view>

<!-- 保持原有的弹窗组件，样式会自动适配全局 -->
<!-- Role Picker Modal -->
<view class="modal-mask" wx:if="{{showRolePicker}}" bindtap="onCloseRolePicker">
  <view class="modal-container" catchtap="onModalStopPropagation" style="background:white; border-radius: 24rpx 24rpx 0 0;">
    <view class="modal-header" style="padding: 32rpx; text-align: center; border-bottom: 1rpx solid #eee;">
      <text style="font-size: 32rpx; font-weight: bold;">选择角色</text>
    </view>
    <view class="modal-content" style="padding: 0;">
      <view
        wx:for="{{roles}}"
        wx:key="id"
        style="padding: 32rpx; border-bottom: 1rpx solid #f9f9f9; display: flex; justify-content: space-between;"
        bindtap="onSelectRole"
        data-id="{{item.id}}"
        data-name="{{item.name}}"
      >
        <text style="color: {{formData.role_id === item.id ? '#56B78A' : '#333'}}">{{item.name}}</text>
        <icon wx:if="{{formData.role_id === item.id}}" type="success_no_circle" size="16" color="#56B78A"/>
      </view>
    </view>
  </view>
</view>

<!-- Department Picker Modal -->
<view class="modal-mask" wx:if="{{showDeptPicker}}" bindtap="onCloseDeptPicker">
  <view class="modal-container" catchtap="onModalStopPropagation" style="background:white; border-radius: 24rpx 24rpx 0 0;">
    <view class="modal-header" style="padding: 32rpx; text-align: center; border-bottom: 1rpx solid #eee;">
      <text style="font-size: 32rpx; font-weight: bold;">选择部门</text>
    </view>
    <view class="modal-content" style="padding: 0;">
      <view
        wx:for="{{departments}}"
        wx:key="*this"
        style="padding: 32rpx; border-bottom: 1rpx solid #f9f9f9; display: flex; justify-content: space-between;"
        bindtap="onSelectDept"
        data-dept="{{item}}"
      >
        <text style="color: {{formData.department === item ? '#56B78A' : '#333'}}">{{item}}</text>
        <icon wx:if="{{formData.department === item}}" type="success_no_circle" size="16" color="#56B78A"/>
      </view>
    </view>
  </view>
</view>