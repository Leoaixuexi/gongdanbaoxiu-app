/* Edit User Page - 仿图极简风格 */

/* 页面整体 */
.container {
  min-height: 100vh;
  background-color: #F5F5F5; /* 浅灰背景 */
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
}

/* 顶部绿色背景装饰 (模拟图中导航栏延伸) */
.container::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 120rpx;
  background-color: #0CA77D; /* 品牌绿 */
  z-index: 0;
}

/* 表单滚动区 */
.form-scroll {
  flex: 1;
  position: relative;
  z-index: 1;
}

.form-container {
  padding: 24rpx;
}

/* 核心大卡片 */
.mega-card {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 0 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

/* 通用表单行 */
.form-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 0;
  min-height: 40rpx;
  /* 无底边框，靠留白 */
}

/* 标签样式 */
.label-text {
  font-size: 30rpx;
  color: #999999; /* 浅灰标签 */
  font-weight: 400;
  min-width: 160rpx;
}

/* 内容样式 */
.value-text, 
.weui-input {
  flex: 1;
  text-align: right;
  font-size: 30rpx;
  color: #333333; /* 深黑内容 */
  font-weight: 400;
  height: auto;
  min-height: auto;
}

.weui-input {
  padding: 0;
  border: none;
  background: transparent;
}

.weui-input::placeholder {
  color: #CCCCCC;
}

/* 只读文本 */
.readonly-text {
  color: #333333;
}

/* 头像行特殊样式 */
.avatar-row {
  padding: 40rpx 0;
}

.avatar-wrapper {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: #F0F0F0;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  font-size: 40rpx;
  color: #CCCCCC;
}

/* 二维码行 */
.qrcode-row {
  flex-direction: column;
  align-items: flex-start;
  padding-bottom: 40rpx;
}

.qrcode-label {
  margin-bottom: 24rpx;
  color: #999999;
  font-size: 30rpx;
}

.qrcode-img {
  width: 300rpx;
  height: 300rpx;
  background-color: #F0F0F0; /* 占位 */
  align-self: flex-end; /* 靠右显示，符合图中风格 */
  margin-right: 0;
}

/* 底部提示行 (如人脸头像) */
.hint-row {
  display: flex;
  align-items: center;
  padding: 32rpx 0;
  margin-top: 20rpx;
}

.hint-icon {
  font-size: 28rpx;
  color: #999999;
  margin-right: 8rpx;
}

.hint-text {
  font-size: 28rpx;
  color: #999999;
}

/* 性别选择 (改为纯文本点击切换或保持右侧显示) */
/* 为了还原图中的纯文本效果，这里把性别做成右侧文本，点击弹出选择 */
.picker-trigger {
  flex: 1;
  display: flex;
  justify-content: flex-end;
  align-items: center;
}

.picker-arrow {
  font-size: 24rpx;
  color: #CCCCCC;
  margin-left: 12rpx;
  /* 如果完全仿图，可能不需要箭头，或者箭头很淡 */
}

/* 底部悬浮操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #FFFFFF;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

/* 左侧圆形更多按钮 */
.more-btn {
  width: 96rpx;
  height: 96rpx;
  background-color: #F5F5F5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999999;
  font-weight: bold;
  font-size: 40rpx;
  flex-shrink: 0;
}

/* 右侧长条确认按钮 */
.submit-btn {
  flex: 1;
  height: 96rpx;
  background-color: #56B78A; /* 图中的绿色，稍微偏柔和 */
  border-radius: 16rpx; /* 图中圆角较小，约 8-12px */
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 500;
  box-shadow: 0 8rpx 24rpx rgba(86, 183, 138, 0.3);
}

.submit-btn:active {
  opacity: 0.9;
  transform: scale(0.99);
}

/* 隐藏 WeUI 默认样式干扰 */
.weui-btn {
  margin: 0 !important;
  padding: 0 !important;
  width: auto !important;
  background: transparent !important;
}

/* 错误提示 - 紧凑显示在输入框下方 */
.error-tip {
  font-size: 22rpx;
  color: #FF3B30;
  text-align: right;
  margin-top: -20rpx;
  margin-bottom: 20rpx;
}

/* 弹窗遮罩 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

/* 操作菜单 */
.action-menu {
  width: 100%;
  background-color: #FFFFFF;
  border-radius: 24rpx 24rpx 0 0;
  padding: 40rpx 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.action-grid {
  display: flex;
  justify-content: flex-start;
  gap: 48rpx;
  padding-left: 32rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.action-item.disabled {
  opacity: 0.4;
  pointer-events: none;
}

.action-icon-wrapper {
  width: 120rpx;
  height: 120rpx;
  background-color: #F5F5F5;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-icon {
  width: 48rpx;
  height: 48rpx;
}

.action-text {
  font-size: 26rpx;
  color: #333333;
}