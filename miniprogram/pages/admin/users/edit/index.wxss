/* Edit User Page Styles - 现代3D高级版 */

/* 页面容器 */
.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: linear-gradient(135deg, #F0F4F3 0%, #E8EFED 50%, #F5F9F8 100%);
  position: relative;
}

/* 背景装饰 */
.container::before {
  content: '';
  position: fixed;
  top: -200rpx;
  right: -200rpx;
  width: 600rpx;
  height: 600rpx;
  background: radial-gradient(circle, rgba(12, 167, 125, 0.08) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

.container::after {
  content: '';
  position: fixed;
  bottom: -150rpx;
  left: -150rpx;
  width: 500rpx;
  height: 500rpx;
  background: radial-gradient(circle, rgba(16, 185, 129, 0.06) 0%, transparent 70%);
  border-radius: 50%;
  pointer-events: none;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  height: 100vh;
  gap: 32rpx;
}

.weui-loadmore {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.weui-loading {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid rgba(12, 167, 125, 0.15);
  border-top-color: #0CA77D;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.weui-loadmore__tips {
  font-size: 28rpx;
  color: #0CA77D;
  font-weight: 500;
  letter-spacing: 2rpx;
}

/* 表单滚动区 */
.form-scroll {
  flex: 1;
  overflow-y: auto;
}

/* 表单容器 */
.form-container {
  padding: 40rpx 32rpx;
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

/* 表单卡片 - 3D玻璃拟态效果 */
.form-section {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: 32rpx;
  padding: 36rpx;
  margin-bottom: 28rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.9);
  box-shadow:
    0 8rpx 32rpx rgba(0, 0, 0, 0.04),
    0 2rpx 8rpx rgba(0, 0, 0, 0.02),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.8);
  position: relative;
  overflow: hidden;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  transform: perspective(1000rpx) translateZ(0);
}

.form-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, transparent, rgba(12, 167, 125, 0.3), transparent);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.form-section:active {
  transform: perspective(1000rpx) translateZ(-10rpx) scale(0.99);
  box-shadow:
    0 4rpx 16rpx rgba(0, 0, 0, 0.06),
    0 1rpx 4rpx rgba(0, 0, 0, 0.03),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.6);
}

.form-section:active::before {
  opacity: 1;
}

/* 表单标签 */
.form-label {
  font-size: 28rpx;
  color: #374151;
  margin-bottom: 20rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.form-label.required::before {
  content: '*';
  color: #EF4444;
  font-size: 32rpx;
  font-weight: 700;
  margin-right: 4rpx;
  text-shadow: 0 2rpx 8rpx rgba(239, 68, 68, 0.3);
}

/* 只读字段 - 3D内凹效果 */
.readonly-field {
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #9CA3AF;
  background: linear-gradient(145deg, #E8EFED 0%, #F0F4F3 100%);
  border: 2rpx solid #E5E7EB;
  box-shadow:
    inset 2rpx 2rpx 6rpx rgba(0, 0, 0, 0.05),
    inset -2rpx -2rpx 6rpx rgba(255, 255, 255, 0.8);
  font-family: 'Courier New', monospace;
  word-break: break-all;
  line-height: 1.5;
}

/* 输入框 - 3D浮雕效果 */
.weui-input {
  padding: 24rpx 28rpx;
  border: 2rpx solid #E8F5F0;
  border-radius: 20rpx;
  font-size: 28rpx;
  background: linear-gradient(145deg, #FFFFFF 0%, #FAFCFB 100%);
  color: #1F2937;
  box-shadow:
    0 4rpx 12rpx rgba(0, 0, 0, 0.03),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.9);
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  transform: translateZ(0);
}

.weui-input:focus {
  border-color: #0CA77D;
  box-shadow:
    0 8rpx 24rpx rgba(12, 167, 125, 0.15),
    0 0 0 4rpx rgba(12, 167, 125, 0.08),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.9);
  transform: translateZ(4rpx);
}

.weui-input.error {
  border-color: #EF4444;
  box-shadow:
    0 4rpx 16rpx rgba(239, 68, 68, 0.15),
    0 0 0 4rpx rgba(239, 68, 68, 0.08),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.9);
}

.weui-input::placeholder {
  color: #9CA3AF;
}

/* 提示文字 */
.form-hint {
  font-size: 24rpx;
  color: #9CA3AF;
  margin-top: 16rpx;
  line-height: 1.6;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.form-hint::before {
  content: '';
  width: 6rpx;
  height: 6rpx;
  background: #D1D5DB;
  border-radius: 50%;
}

.form-hint.warning {
  color: #F59E0B;
}

.form-hint.warning::before {
  background: #F59E0B;
  box-shadow: 0 0 8rpx rgba(245, 158, 11, 0.5);
}

/* 错误提示 */
.error-text {
  font-size: 24rpx;
  color: #EF4444;
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
  animation: shake 0.4s ease;
}

.error-text::before {
  content: '!';
  width: 28rpx;
  height: 28rpx;
  background: linear-gradient(135deg, #EF4444 0%, #F87171 100%);
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
  box-shadow: 0 2rpx 8rpx rgba(239, 68, 68, 0.3);
}

@keyframes shake {
  0%, 100% { transform: translateX(0); }
  25% { transform: translateX(-8rpx); }
  75% { transform: translateX(8rpx); }
}

/* 选择器容器 - 3D按钮效果 */
.picker-container {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 28rpx;
  border: 2rpx solid #E8F5F0;
  border-radius: 20rpx;
  background: linear-gradient(145deg, #FFFFFF 0%, #FAFCFB 100%);
  box-shadow:
    0 4rpx 12rpx rgba(0, 0, 0, 0.03),
    0 2rpx 4rpx rgba(0, 0, 0, 0.02),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.9);
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  transform: perspective(500rpx) translateZ(0);
}

.picker-container:active {
  transform: perspective(500rpx) translateZ(-8rpx) scale(0.98);
  box-shadow:
    0 2rpx 6rpx rgba(0, 0, 0, 0.04),
    inset 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}

.picker-container.disabled {
  background: linear-gradient(145deg, #F3F4F6 0%, #E5E7EB 100%);
  border-color: #E5E7EB;
  box-shadow:
    inset 2rpx 2rpx 6rpx rgba(0, 0, 0, 0.04),
    inset -2rpx -2rpx 6rpx rgba(255, 255, 255, 0.6);
}

.picker-text {
  font-size: 28rpx;
  color: #1F2937;
  font-weight: 500;
}

.picker-text.placeholder {
  color: #9CA3AF;
  font-weight: 400;
}

/* 表单行 */
.form-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.form-row .form-label {
  margin-bottom: 0;
}

/* 开关样式覆盖 */
switch {
  transform: scale(0.9);
}

/* 底部按钮区域 - 毛玻璃效果 */
.action-buttons {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 28rpx;
  padding: 32rpx 36rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.95) 0%, rgba(248, 250, 249, 0.98) 100%);
  backdrop-filter: blur(24rpx);
  -webkit-backdrop-filter: blur(24rpx);
  border-top: 1rpx solid rgba(12, 167, 125, 0.1);
  box-shadow:
    0 -12rpx 48rpx rgba(0, 0, 0, 0.08),
    0 -4rpx 16rpx rgba(0, 0, 0, 0.04);
  z-index: 100;
}

.action-buttons button {
  flex: 1;
  margin: 0 !important;
  padding: 0 !important;
  height: 100rpx !important;
  line-height: 100rpx !important;
  font-size: 32rpx !important;
  font-weight: 600 !important;
  letter-spacing: 4rpx;
  border-radius: 50rpx !important;
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

.action-buttons button::after {
  border: none !important;
}

.action-buttons button:active {
  transform: scale(0.96);
}

/* 取消按钮 */
.cancel-btn {
  background: linear-gradient(135deg, #FFFFFF 0%, #F3F4F6 100%) !important;
  color: #6B7280 !important;
  border: 2rpx solid #E5E7EB !important;
  box-shadow:
    0 4rpx 16rpx rgba(0, 0, 0, 0.06),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 1) !important;
}

.cancel-btn:active {
  background: linear-gradient(135deg, #F3F4F6 0%, #E5E7EB 100%) !important;
  box-shadow:
    0 2rpx 8rpx rgba(0, 0, 0, 0.08),
    inset 0 2rpx 6rpx rgba(0, 0, 0, 0.03) !important;
}

/* 主按钮 */
.action-buttons button[type="primary"] {
  background: linear-gradient(135deg, #0CA77D 0%, #10B981 100%) !important;
  color: #FFFFFF !important;
  border: none !important;
  box-shadow:
    0 6rpx 24rpx rgba(12, 167, 125, 0.4),
    0 2rpx 8rpx rgba(12, 167, 125, 0.3),
    inset 0 1rpx 2rpx rgba(255, 255, 255, 0.3) !important;
}

.action-buttons button[type="primary"]:active {
  background: linear-gradient(135deg, #059669 0%, #0CA77D 100%) !important;
  box-shadow:
    0 3rpx 12rpx rgba(12, 167, 125, 0.5),
    inset 0 2rpx 6rpx rgba(0, 0, 0, 0.1) !important;
}

/* ==================== 弹窗样式 ==================== */

/* 遮罩层 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.3) 0%, rgba(0, 0, 0, 0.6) 100%);
  backdrop-filter: blur(8rpx);
  -webkit-backdrop-filter: blur(8rpx);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  animation: fadeIn 0.25s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

/* 底部弹出容器 - 3D玻璃效果 */
.modal-container {
  width: 100%;
  max-height: 75vh;
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(40rpx);
  -webkit-backdrop-filter: blur(40rpx);
  border-radius: 48rpx 48rpx 0 0;
  overflow: hidden;
  box-shadow:
    0 -16rpx 80rpx rgba(0, 0, 0, 0.15),
    0 -4rpx 20rpx rgba(0, 0, 0, 0.1),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.9);
  animation: slideUp 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  transform: translateZ(0);
}

@keyframes slideUp {
  from {
    transform: translateY(100%);
    opacity: 0.8;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

/* 弹窗顶部拖拽指示器 */
.modal-container::before {
  content: '';
  position: absolute;
  top: 16rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 80rpx;
  height: 8rpx;
  background: linear-gradient(90deg, #D1D5DB, #E5E7EB, #D1D5DB);
  border-radius: 4rpx;
}

/* 弹窗头部 */
.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 48rpx 36rpx 28rpx;
  border-bottom: 2rpx solid rgba(0, 0, 0, 0.05);
  background: linear-gradient(180deg, rgba(255, 255, 255, 1) 0%, rgba(248, 250, 249, 0.8) 100%);
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1F2937;
  letter-spacing: 2rpx;
}

/* 关闭按钮区域 */
.modal-header icon {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #F3F4F6 0%, #E5E7EB 100%);
  border-radius: 50%;
  box-shadow:
    2rpx 2rpx 6rpx rgba(0, 0, 0, 0.08),
    -2rpx -2rpx 6rpx rgba(255, 255, 255, 0.9);
  transition: all 0.2s ease;
}

.modal-header icon:active {
  box-shadow:
    inset 2rpx 2rpx 6rpx rgba(0, 0, 0, 0.1),
    inset -2rpx -2rpx 6rpx rgba(255, 255, 255, 0.5);
}

/* 弹窗内容 */
.modal-content {
  max-height: 60vh;
  overflow-y: auto;
  padding: 20rpx 0;
}

/* 选项项 - 3D列表效果 */
.option-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  margin: 0 24rpx 12rpx;
  font-size: 28rpx;
  color: #374151;
  background: linear-gradient(145deg, #FAFCFB 0%, #F3F4F6 100%);
  border-radius: 20rpx;
  border: 2rpx solid transparent;
  box-shadow:
    0 4rpx 12rpx rgba(0, 0, 0, 0.03),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.8);
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  transform: perspective(500rpx) translateZ(0);
}

.option-item:last-child {
  margin-bottom: 24rpx;
}

.option-item:active {
  transform: perspective(500rpx) translateZ(-6rpx) scale(0.98);
  box-shadow:
    0 2rpx 6rpx rgba(0, 0, 0, 0.04),
    inset 0 2rpx 8rpx rgba(0, 0, 0, 0.02);
}

.option-item.selected {
  background: linear-gradient(135deg, rgba(12, 167, 125, 0.1) 0%, rgba(16, 185, 129, 0.08) 100%);
  border-color: rgba(12, 167, 125, 0.3);
  color: #059669;
  box-shadow:
    0 6rpx 20rpx rgba(12, 167, 125, 0.15),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.6);
}

.option-item.selected::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 60%;
  background: linear-gradient(180deg, #0CA77D 0%, #10B981 100%);
  border-radius: 0 4rpx 4rpx 0;
}

/* 选项信息 */
.option-info {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.option-name {
  font-size: 30rpx;
  color: #1F2937;
  font-weight: 600;
}

.option-desc {
  font-size: 24rpx;
  color: #9CA3AF;
  font-weight: 400;
}

/* 空提示 */
.empty-hint {
  padding: 120rpx 40rpx;
  text-align: center;
  font-size: 28rpx;
  color: #9CA3AF;
}

.empty-hint::before {
  content: '';
  display: block;
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 32rpx;
  background: linear-gradient(145deg, #F3F4F6 0%, #E5E7EB 100%);
  border-radius: 50%;
  box-shadow:
    inset 4rpx 4rpx 12rpx rgba(0, 0, 0, 0.05),
    inset -4rpx -4rpx 12rpx rgba(255, 255, 255, 0.8);
}

/* ==================== 确认弹窗 ==================== */

.confirm-modal {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 620rpx;
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(40rpx);
  -webkit-backdrop-filter: blur(40rpx);
  border-radius: 36rpx;
  overflow: hidden;
  box-shadow:
    0 32rpx 100rpx rgba(0, 0, 0, 0.2),
    0 8rpx 32rpx rgba(0, 0, 0, 0.15),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.9);
  animation: popIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes popIn {
  from {
    transform: translate(-50%, -50%) scale(0.8);
    opacity: 0;
  }
  to {
    transform: translate(-50%, -50%) scale(1);
    opacity: 1;
  }
}

/* 警告图标 */
.confirm-modal::before {
  content: '!';
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 100rpx;
  margin: 48rpx auto 24rpx;
  background: linear-gradient(135deg, #FEF3C7 0%, #FDE68A 100%);
  border-radius: 50%;
  font-size: 56rpx;
  font-weight: 700;
  color: #D97706;
  box-shadow:
    0 8rpx 32rpx rgba(217, 119, 6, 0.25),
    inset 0 -4rpx 12rpx rgba(0, 0, 0, 0.05),
    inset 0 4rpx 8rpx rgba(255, 255, 255, 0.8);
}

.confirm-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1F2937;
  padding: 0 40rpx 20rpx;
  text-align: center;
  letter-spacing: 2rpx;
}

.confirm-content {
  font-size: 28rpx;
  color: #6B7280;
  padding: 0 40rpx 48rpx;
  line-height: 1.8;
  text-align: center;
}

.confirm-actions {
  display: flex;
  border-top: 2rpx solid rgba(0, 0, 0, 0.05);
}

.confirm-actions button {
  flex: 1;
  margin: 0;
  height: 108rpx;
  line-height: 108rpx;
  border-radius: 0;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  transition: all 0.2s ease;
}

.confirm-actions button::after {
  border: none !important;
}

.confirm-actions button:first-child {
  border-right: 2rpx solid rgba(0, 0, 0, 0.05);
  background: linear-gradient(180deg, #FFFFFF 0%, #F9FAFB 100%) !important;
  color: #6B7280 !important;
}

.confirm-actions button:first-child:active {
  background: linear-gradient(180deg, #F3F4F6 0%, #E5E7EB 100%) !important;
}

.confirm-actions button[type="warn"] {
  background: linear-gradient(135deg, #EF4444 0%, #F87171 100%) !important;
  color: #FFFFFF !important;
  box-shadow: inset 0 2rpx 4rpx rgba(255, 255, 255, 0.2);
}

.confirm-actions button[type="warn"]:active {
  background: linear-gradient(135deg, #DC2626 0%, #EF4444 100%) !important;
}

/* ==================== 动画增强 ==================== */

/* 卡片入场动画 */
.form-section {
  animation: cardFadeIn 0.5s cubic-bezier(0.4, 0, 0.2, 1) backwards;
}

.form-section:nth-child(1) { animation-delay: 0.05s; }
.form-section:nth-child(2) { animation-delay: 0.1s; }
.form-section:nth-child(3) { animation-delay: 0.15s; }
.form-section:nth-child(4) { animation-delay: 0.2s; }
.form-section:nth-child(5) { animation-delay: 0.25s; }
.form-section:nth-child(6) { animation-delay: 0.3s; }

@keyframes cardFadeIn {
  from {
    opacity: 0;
    transform: perspective(1000rpx) translateY(40rpx) rotateX(-5deg);
  }
  to {
    opacity: 1;
    transform: perspective(1000rpx) translateY(0) rotateX(0);
  }
}

/* 按钮悬浮发光效果 */
.action-buttons button[type="primary"]::before {
  content: '';
  position: absolute;
  inset: -4rpx;
  background: linear-gradient(135deg, #0CA77D 0%, #10B981 100%);
  border-radius: 28rpx;
  z-index: -1;
  opacity: 0;
  filter: blur(16rpx);
  transition: opacity 0.3s ease;
}

/* 输入框聚焦发光 */
.weui-input:focus::after {
  content: '';
  position: absolute;
  inset: -8rpx;
  background: linear-gradient(135deg, rgba(12, 167, 125, 0.1) 0%, rgba(16, 185, 129, 0.05) 100%);
  border-radius: 28rpx;
  z-index: -1;
  animation: glowPulse 2s ease-in-out infinite;
}

@keyframes glowPulse {
  0%, 100% { opacity: 0.5; }
  50% { opacity: 1; }
}
