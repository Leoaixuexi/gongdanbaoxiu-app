/* Message Template Edit Page Styles */

/* 页面容器 */
.edit-page {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background-color: #F5F5F5;
}

.edit-scroll {
  flex: 1;
  overflow-y: auto;
}

.form-container {
  padding: 24rpx;
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* 表单区块 */
.form-section {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.section-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #1F2937;
  margin-bottom: 20rpx;
}

/* 选择器 */
.form-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  border: 2rpx solid #E5E7EB;
  border-radius: 16rpx;
  background: #FAFAFA;
  font-size: 30rpx;
  color: #1F2937;
}

.form-picker.disabled {
  background: #F3F4F6;
  color: #9CA3AF;
}

.picker-arrow {
  font-size: 24rpx;
  color: #9CA3AF;
}

/* 输入框 */
.form-input {
  width: 100%;
  padding: 24rpx;
  border: 2rpx solid #E5E7EB;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #1F2937;
  background: #FAFAFA;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: #0CA77D;
  background: #FFFFFF;
}

/* 文本域 */
.form-textarea {
  width: 100%;
  min-height: 200rpx;
  padding: 24rpx;
  border: 2rpx solid #E5E7EB;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #1F2937;
  background: #FAFAFA;
  box-sizing: border-box;
  line-height: 1.6;
}

.form-textarea:focus {
  border-color: #0CA77D;
  background: #FFFFFF;
}

.input-hint {
  font-size: 24rpx;
  color: #9CA3AF;
  margin-top: 16rpx;
}

/* 变量列表 */
.variable-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.variable-tag {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  padding: 16rpx 24rpx;
  background: rgba(12, 167, 125, 0.1);
  border-radius: 16rpx;
  border: 1rpx solid rgba(12, 167, 125, 0.2);
}

.variable-tag:active {
  background: rgba(12, 167, 125, 0.2);
}

.variable-name {
  font-size: 26rpx;
  color: #1F2937;
}

.variable-key {
  font-size: 22rpx;
  color: #0CA77D;
  font-family: monospace;
}

.no-variables {
  font-size: 28rpx;
  color: #9CA3AF;
  text-align: center;
  padding: 32rpx;
}

/* 操作按钮 */
.action-buttons {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.save-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #0CA77D 0%, #10B981 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(12, 167, 125, 0.3);
}

.save-btn:active {
  transform: scale(0.98);
}

.save-btn[disabled] {
  background: #D1D5DB;
  box-shadow: none;
}
