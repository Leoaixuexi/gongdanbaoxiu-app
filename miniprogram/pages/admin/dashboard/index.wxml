<!--
  Admin Dashboard Page
  管理台首页 - 卡片入口式导航
-->
<view class="dashboard-page">
  <!-- 自定义导航栏 -->
  <view class="custom-nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-content">
      <text class="nav-title">管理台</text>
    </view>
  </view>

  <!-- 页面标题 -->
  <view class="page-header" style="margin-top: {{navBarHeight}}px;">
    <text class="welcome-text">管理控制台</text>
    <text class="user-name">{{userName}}</text>
  </view>

  <!-- 功能模块卡片列表 -->
  <view class="module-grid">
    <!-- 账号管理 -->
    <view class="module-card" bindtap="navigateTo" data-path="/pages/admin/users/index">
      <view class="card-icon icon-users">
        <van-icon name="friends-o" size="44rpx" color="#fff" />
      </view>
      <view class="card-info">
        <text class="card-title">账号管理</text>
        <text class="card-desc">用户账号与权限管理</text>
      </view>
      <view class="card-arrow">
        <van-icon name="arrow" size="32rpx" color="#D1D5DB" />
      </view>
    </view>

    <!-- 角色与权限 -->
    <view class="module-card" bindtap="navigateTo" data-path="/pages/admin/roles/index">
      <view class="card-icon icon-roles">
        <van-icon name="shield-o" size="44rpx" color="#fff" />
      </view>
      <view class="card-info">
        <text class="card-title">角色与权限</text>
        <text class="card-desc">角色权限配置</text>
      </view>
      <view class="card-arrow">
        <van-icon name="arrow" size="32rpx" color="#D1D5DB" />
      </view>
    </view>

    <!-- 系统配置 -->
    <view class="module-card" bindtap="navigateTo" data-path="/pages/admin/config/index">
      <view class="card-icon icon-config">
        <van-icon name="setting-o" size="44rpx" color="#fff" />
      </view>
      <view class="card-info">
        <text class="card-title">系统配置</text>
        <text class="card-desc">SLA规则与系统参数</text>
      </view>
      <view class="card-arrow">
        <van-icon name="arrow" size="32rpx" color="#D1D5DB" />
      </view>
    </view>

    <!-- 公告管理 -->
    <view class="module-card" bindtap="navigateTo" data-path="/pages/admin/announcements/index">
      <view class="card-icon icon-announcements">
        <van-icon name="volume-o" size="44rpx" color="#fff" />
      </view>
      <view class="card-info">
        <text class="card-title">公告管理</text>
        <text class="card-desc">发布与管理公告</text>
      </view>
      <view class="card-arrow">
        <van-icon name="arrow" size="32rpx" color="#D1D5DB" />
      </view>
    </view>

    <!-- 字典管理 -->
    <view class="module-card" bindtap="navigateTo" data-path="/pages/admin/dict/index">
      <view class="card-icon icon-dict">
        <van-icon name="orders-o" size="44rpx" color="#fff" />
      </view>
      <view class="card-info">
        <text class="card-title">字典管理</text>
        <text class="card-desc">下拉选项数据维护</text>
      </view>
      <view class="card-arrow">
        <van-icon name="arrow" size="32rpx" color="#D1D5DB" />
      </view>
    </view>

    <!-- 审计日志 -->
    <view class="module-card" bindtap="navigateTo" data-path="/pages/admin/audit-logs/index">
      <view class="card-icon icon-audit">
        <van-icon name="description" size="44rpx" color="#fff" />
      </view>
      <view class="card-info">
        <text class="card-title">审计日志</text>
        <text class="card-desc">系统操作记录查询</text>
      </view>
      <view class="card-arrow">
        <van-icon name="arrow" size="32rpx" color="#D1D5DB" />
      </view>
    </view>

    <!-- 用户反馈 -->
    <view class="module-card" bindtap="navigateTo" data-path="/pages/admin/feedbacks/index">
      <view class="card-icon icon-feedback">
        <van-icon name="comment-o" size="44rpx" color="#fff" />
      </view>
      <view class="card-info">
        <text class="card-title">用户反馈</text>
        <text class="card-desc">查看用户提交的反馈</text>
      </view>
      <view class="card-arrow">
        <van-icon name="arrow" size="32rpx" color="#D1D5DB" />
      </view>
    </view>
  </view>

  <!-- 底部退出登录按钮 -->
  <view class="logout-section" bindtap="handleLogout">
    <van-icon name="revoke" size="36rpx" color="#EF4444" />
    <text class="logout-text">退出登录</text>
  </view>
</view>
