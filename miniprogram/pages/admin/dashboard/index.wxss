/* Admin Dashboard Page Styles */

/* 页面容器 */
.dashboard-page {
  min-height: 100vh;
  background-color: #F5F5F5;
  padding: 32rpx;
  padding-top: 0;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* 自定义导航栏 */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background: #0CA77D;
  z-index: 1000;
}

.nav-content {
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #FFFFFF;
}

/* 页面头部 */
.page-header {
  margin-bottom: 40rpx;
  padding: 24rpx 0;
}

.welcome-text {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #1F2937;
  margin-bottom: 8rpx;
}

.user-name {
  font-size: 28rpx;
  color: #6B7280;
}

/* 模块卡片网格 */
.module-grid {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 模块卡片 */
.module-card {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
  transition: all 0.2s ease;
}

.module-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.08);
}

/* 图标容器 */
.card-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 24rpx;
}

.card-icon .iconfont {
  font-size: 44rpx;
  color: #FFFFFF;
}

/* 图标颜色 */
.icon-users {
  background: linear-gradient(135deg, #3B82F6 0%, #60A5FA 100%);
  box-shadow: 0 8rpx 24rpx rgba(59, 130, 246, 0.3);
}

.icon-roles {
  background: linear-gradient(135deg, #8B5CF6 0%, #A78BFA 100%);
  box-shadow: 0 8rpx 24rpx rgba(139, 92, 246, 0.3);
}

.icon-config {
  background: linear-gradient(135deg, #6B7280 0%, #9CA3AF 100%);
  box-shadow: 0 8rpx 24rpx rgba(107, 114, 128, 0.3);
}

.icon-announcements {
  background: linear-gradient(135deg, #F97316 0%, #FB923C 100%);
  box-shadow: 0 8rpx 24rpx rgba(249, 115, 22, 0.3);
}

.icon-templates {
  background: linear-gradient(135deg, #10B981 0%, #34D399 100%);
  box-shadow: 0 8rpx 24rpx rgba(16, 185, 129, 0.3);
}

.icon-dict {
  background: linear-gradient(135deg, #14B8A6 0%, #2DD4BF 100%);
  box-shadow: 0 8rpx 24rpx rgba(20, 184, 166, 0.3);
}

.icon-audit {
  background: linear-gradient(135deg, #EF4444 0%, #F87171 100%);
  box-shadow: 0 8rpx 24rpx rgba(239, 68, 68, 0.3);
}

.icon-feedback {
  background: linear-gradient(135deg, #10B981 0%, #34D399 100%);
  box-shadow: 0 8rpx 24rpx rgba(16, 185, 129, 0.3);
}

/* 卡片信息 */
.card-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2937;
  line-height: 1.4;
}

.card-desc {
  font-size: 26rpx;
  color: #9CA3AF;
  line-height: 1.4;
}

/* 箭头 */
.card-arrow {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.card-arrow .iconfont {
  font-size: 32rpx;
  color: #D1D5DB;
}

/* 退出登录按钮 */
.logout-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20rpx);
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
}

.logout-section:active {
  background: rgba(245, 245, 245, 0.95);
}

.logout-section .iconfont {
  font-size: 36rpx;
  color: #EF4444;
}

.logout-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #EF4444;
}
