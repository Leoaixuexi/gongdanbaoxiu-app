/* Dictionary Management Page Styles */

/* 页面容器 */
.dict-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #F8FAF9 0%, #EEF2F0 100%);
  padding-bottom: calc(140rpx + env(safe-area-inset-bottom));
}

/* 字典列表 */
.dict-list {
  padding: 32rpx;
}

/* 加载状态 */
.loading-state {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  padding: 160rpx 0;
  color: #0CA77D;
  font-size: 28rpx;
}

.loading-state::before {
  content: '';
  width: 64rpx;
  height: 64rpx;
  border: 4rpx solid #E8F5F0;
  border-top-color: #0CA77D;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 40rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.04);
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 32rpx;
  color: #9CA3AF;
  font-weight: 500;
}

/* 字典卡片 */
.dict-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 36rpx;
  margin-bottom: 28rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.04);
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.dict-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 6rpx;
  height: 100%;
  background: linear-gradient(180deg, #0CA77D 0%, #10B981 100%);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.dict-card:active {
  transform: scale(0.99);
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}

.dict-card:active::before {
  opacity: 1;
}

.card-header {
  display: flex;
  align-items: center;
}

.dict-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #E8F5F0 0%, #D1FAE5 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.dict-icon text {
  font-size: 40rpx;
}

.dict-info {
  flex: 1;
  min-width: 0;
}

.dict-name {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.dict-name text {
  font-size: 32rpx;
  font-weight: 700;
  color: #1F2937;
}

.system-tag {
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 600;
  background: linear-gradient(135deg, rgba(59, 130, 246, 0.15) 0%, rgba(37, 99, 235, 0.1) 100%);
  color: #2563EB;
  border: 1rpx solid rgba(59, 130, 246, 0.3);
}

.dict-key {
  font-size: 24rpx;
  color: #9CA3AF;
  font-family: 'Courier New', monospace;
  background: #F8FAF9;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  display: inline-block;
}

.item-count {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 24rpx;
  background: linear-gradient(135deg, #F8FAF9 0%, #F3F4F6 100%);
  border-radius: 16rpx;
}

.count-num {
  font-size: 36rpx;
  font-weight: 700;
  color: #0CA77D;
}

.count-label {
  font-size: 22rpx;
  color: #9CA3AF;
}

.card-desc {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  background: linear-gradient(135deg, #F8FAF9 0%, #F3F4F6 100%);
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #6B7280;
}

/* 操作按钮 */
.card-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #F3F4F6;
}

.action-btn {
  padding: 18rpx 36rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 600;
  background: linear-gradient(135deg, #0CA77D 0%, #10B981 100%);
  color: #FFFFFF;
  box-shadow: 0 4rpx 16rpx rgba(12, 167, 125, 0.3);
  transition: all 0.2s ease;
}

.action-btn:active {
  transform: scale(0.95);
}

.action-btn.danger {
  background: linear-gradient(135deg, #EF4444 0%, #F87171 100%);
  box-shadow: 0 4rpx 16rpx rgba(239, 68, 68, 0.3);
}

/* 浮动按钮 */
.fab-button {
  position: fixed;
  right: 40rpx;
  bottom: calc(120rpx + env(safe-area-inset-bottom));
  width: 120rpx;
  height: 120rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #0CA77D 0%, #10B981 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow:
    0 8rpx 32rpx rgba(12, 167, 125, 0.4),
    0 0 0 8rpx rgba(12, 167, 125, 0.1);
  z-index: 100;
  transition: all 0.3s ease;
}

.fab-button:active {
  transform: scale(0.92) rotate(90deg);
}

.fab-icon {
  font-size: 64rpx;
  color: #FFFFFF;
  font-weight: 300;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  width: 85%;
  max-width: 600rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  overflow: hidden;
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 2rpx solid #F3F4F6;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1F2937;
}

.close-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #9CA3AF;
  border-radius: 50%;
  background: #F8FAF9;
}

.modal-body {
  padding: 32rpx;
}

.form-item {
  margin-bottom: 28rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #6B7280;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.required {
  color: #EF4444;
}

.form-input {
  width: 100%;
  padding: 24rpx;
  background: #F8FAF9;
  border-radius: 16rpx;
  border: 2rpx solid #E8F5F0;
  font-size: 28rpx;
  color: #1F2937;
  box-sizing: border-box;
}

.form-input:focus {
  border-color: #0CA77D;
}

.form-textarea {
  width: 100%;
  height: 160rpx;
  padding: 24rpx;
  background: #F8FAF9;
  border-radius: 16rpx;
  border: 2rpx solid #E8F5F0;
  font-size: 28rpx;
  color: #1F2937;
  box-sizing: border-box;
}

.modal-footer {
  display: flex;
  border-top: 2rpx solid #F3F4F6;
}

.btn-cancel,
.btn-confirm {
  flex: 1;
  padding: 32rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-cancel {
  color: #6B7280;
  border-right: 2rpx solid #F3F4F6;
}

.btn-confirm {
  color: #0CA77D;
}

.btn-cancel:active,
.btn-confirm:active {
  background: #F8FAF9;
}

/* 列表内容动画 */
.list-content {
  animation: fadeInUp 0.4s ease;
}

@keyframes fadeInUp {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
