<!--
  Role Management Page
  角色与权限管理页面
-->
<view class="role-page">
  <!-- 页面标题 -->
  <view class="page-header">
    <text class="header-title">角色与权限</text>
    <text class="header-desc">管理系统角色和权限配置</text>
  </view>

  <!-- 加载状态 -->
  <view wx:if="{{loading}}" class="loading-state">
    <text>加载中...</text>
  </view>

  <!-- 角色列表 -->
  <view wx:else class="role-list">
    <view
      wx:for="{{roles}}"
      wx:key="role_id"
      class="role-card"
    >
      <!-- 角色头部 -->
      <view class="card-header">
        <view class="role-icon role-{{item.role_id}}">
          <text>{{item.display_name[0]}}</text>
        </view>
        <view class="role-info">
          <view class="role-name">{{item.display_name}}</view>
          <view class="role-code">{{item.name}}</view>
        </view>
        <view class="role-badge" wx:if="{{item.role_id === 1}}">
          <text>系统管理员</text>
        </view>
      </view>

      <!-- 权限概览 -->
      <view class="permission-overview">
        <view class="overview-label">权限范围</view>
        <view class="overview-value">{{item.permissionList}}</view>
      </view>

      <!-- 权限数量 -->
      <view class="permission-count">
        <text class="count-num">{{item.permissionCount}}</text>
        <text class="count-label">/ {{modules.length}} 个模块</text>
      </view>

      <!-- 操作按钮 -->
      <view class="card-actions">
        <view
          class="action-btn primary"
          bindtap="editPermissions"
          data-role-id="{{item.role_id}}"
        >
          <text>编辑权限</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 权限编辑弹窗 -->
  <view wx:if="{{showPermissionModal}}" class="modal-overlay" bindtap="closePermissionModal">
    <view class="modal-content" catchtap="stopPropagation">
      <!-- 弹窗头部 -->
      <view class="modal-header">
        <text class="modal-title">编辑权限 - {{editingRole.display_name}}</text>
        <view class="modal-close" bindtap="closePermissionModal">
          <text>×</text>
        </view>
      </view>

      <!-- 全选操作 -->
      <view class="select-all" bindtap="toggleAllPermissions">
        <text>全选/取消全选</text>
      </view>

      <!-- 权限列表 -->
      <scroll-view scroll-y class="permission-list">
        <view
          wx:for="{{modules}}"
          wx:key="key"
          class="permission-item {{editingPermissions[item.key] ? 'enabled' : ''}}"
          bindtap="togglePermission"
          data-key="{{item.key}}"
        >
          <view class="permission-info">
            <text class="permission-name">{{item.name}}</text>
            <text class="permission-desc">{{item.desc}}</text>
          </view>
          <view class="permission-switch">
            <view class="switch-track {{editingPermissions[item.key] ? 'on' : ''}}">
              <view class="switch-thumb"></view>
            </view>
          </view>
        </view>
      </scroll-view>

      <!-- 弹窗底部 -->
      <view class="modal-footer">
        <view class="btn-cancel" bindtap="closePermissionModal">取消</view>
        <view class="btn-confirm" bindtap="savePermissions">保存</view>
      </view>
    </view>
  </view>
</view>
