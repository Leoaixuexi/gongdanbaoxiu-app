/* 管理员-用户反馈列表页面 */

.feedback-page {
  min-height: 100vh;
  background-color: #F5F5F5;
  padding-bottom: 48rpx;
}

/* 导航栏 */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  background-color: #fff;
  z-index: 100;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.nav-content {
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
}

.nav-left {
  width: 80rpx;
  display: flex;
  align-items: center;
}

.nav-left .iconfont {
  font-size: 40rpx;
  color: #333;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1F1F1F;
}

.nav-right {
  width: 80rpx;
}

/* 列表区域 */
.list-content {
  padding: 24rpx 32rpx;
}

/* 加载中 */
.loading-wrapper {
  display: flex;
  justify-content: center;
  padding: 100rpx 0;
}

/* 空态 */
.empty-wrapper {
  padding: 100rpx 0;
}

/* 反馈列表 */
.feedback-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.feedback-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.feedback-card:active {
  background-color: #f9f9f9;
}

/* 卡片头部 */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.user-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.user-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333;
}

.user-role {
  font-size: 22rpx;
  color: #0CA77D;
  background-color: rgba(12, 167, 125, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.card-time {
  font-size: 24rpx;
  color: #999;
}

/* 标题 */
.card-title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 内容摘要 */
.card-content {
  font-size: 28rpx;
  color: #666;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

/* 照片缩略图 */
.card-photos {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.photo-thumb {
  width: calc((100% - 36rpx) / 4);
  aspect-ratio: 1;
  border-radius: 8rpx;
  object-fit: cover;
}

.photo-more {
  width: calc((100% - 36rpx) / 4);
  aspect-ratio: 1;
  border-radius: 8rpx;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-more text {
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 32rpx 0;
  color: #999;
  font-size: 28rpx;
}

.no-more {
  text-align: center;
  padding: 32rpx 0;
  color: #ccc;
  font-size: 26rpx;
}
