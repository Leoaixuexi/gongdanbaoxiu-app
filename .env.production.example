################################################################################
# Work Order Management System - Production Environment Configuration
#
# IMPORTANT: This is a template for production environment variables.
# Copy this file to .env and fill in actual values.
#
# Security Notes:
# - Never commit .env file to version control
# - Use strong, random values for all secrets
# - Rotate secrets regularly
# - Restrict file permissions: chmod 600 .env
#
# Usage:
# 1. Copy this file: cp .env.production.example .env
# 2. Replace all placeholder values with actual production values
# 3. Secure the file: chmod 600 .env
# 4. Verify all required variables are set before deployment
################################################################################

################################################################################
# Server Configuration
################################################################################

# Server port (default: 3000)
# If using reverse proxy (nginx), this is the internal port
PORT=3000

# Node environment (must be 'production' for production deployment)
NODE_ENV=production

# Server timezone (default: Asia/Shanghai, UTC+8)
# Options: Asia/Shanghai, Asia/Hong_Kong, UTC, etc.
TZ=Asia/Shanghai

################################################################################
# Database Configuration (MySQL)
################################################################################

# Database host
# - Use 'localhost' if MySQL is on same server
# - Use private IP if MySQL is on separate server
# - Use RDS endpoint if using cloud database
DB_HOST=localhost

# Database port (default: 3306)
DB_PORT=3306

# Database name
# IMPORTANT: Use different database name for production
DB_NAME=workorder_production

# Database user
# IMPORTANT: Create dedicated database user for this application
# DO NOT use 'root' in production
DB_USER=workorder_user

# Database password
# IMPORTANT: Use strong password (min 16 chars, mixed case, numbers, symbols)
# Generate with: openssl rand -base64 32
DB_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD

# Database connection pool settings
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

################################################################################
# Redis Configuration
################################################################################

# Redis host
# - Use 'localhost' if Redis is on same server
# - Use private IP if Redis is on separate server
# - Use ElastiCache endpoint if using AWS
REDIS_HOST=localhost

# Redis port (default: 6379)
REDIS_PORT=6379

# Redis password
# IMPORTANT: Always set password for production Redis
# Generate with: openssl rand -base64 32
REDIS_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD

# Redis database number (0-15)
REDIS_DB=0

# Redis key prefix (helps avoid conflicts if sharing Redis instance)
REDIS_KEY_PREFIX=workorder:

# Redis connection timeout (milliseconds)
REDIS_CONNECT_TIMEOUT=10000

################################################################################
# JWT Configuration
################################################################################

# JWT secret key
# IMPORTANT: Use strong, random secret (min 32 chars)
# Generate with: openssl rand -base64 64
# NEVER use the same secret across environments
JWT_SECRET=CHANGE_THIS_TO_RANDOM_SECRET_MIN_32_CHARS

# JWT token expiration time
# Format: Ns (seconds), Nm (minutes), Nh (hours), Nd (days)
# Examples: 3600s, 60m, 24h, 7d
# Recommended: 24h for user sessions
JWT_EXPIRES_IN=24h

# JWT issuer (optional, for additional security)
JWT_ISSUER=workorder-system

################################################################################
# WeChat MiniProgram Configuration
################################################################################

# WeChat MiniProgram AppID
# Obtain from: https://mp.weixin.qq.com/
# Navigate to: 开发 > 开发管理 > 开发设置
WECHAT_APPID=wx1234567890abcdef

# WeChat MiniProgram AppSecret
# IMPORTANT: Keep this secret secure, never expose in client code
# Obtain from: https://mp.weixin.qq.com/
# Navigate to: 开发 > 开发管理 > 开发设置
WECHAT_SECRET=1234567890abcdef1234567890abcdef

# WeChat subscription message template IDs
# Configure templates at: https://mp.weixin.qq.com/
# Navigate to: 功能 > 订阅消息

# Template: Work Order Created
# Title: 工单已创建
# Content: 您提交的工单已创建，工单号：{{order_number}}，已分配给：{{technician_name}}
WECHAT_TEMPLATE_CREATED=your_template_id_for_work_order_created

# Template: Status Changed
# Title: 工单状态变更
# Content: 工单 {{order_number}} 状态已变更为：{{new_status}}
WECHAT_TEMPLATE_STATUS=your_template_id_for_status_changed

# Template: SLA Warning
# Title: 工单即将超时
# Content: 工单 {{order_number}} 即将超过SLA时限，请及时处理
WECHAT_TEMPLATE_SLA=your_template_id_for_sla_warning

# Template: Escalation
# Title: 工单已升级
# Content: 工单 {{order_number}} 已超时，已升级处理
WECHAT_TEMPLATE_ESCALATION=your_template_id_for_escalation

################################################################################
# Tencent Cloud Object Storage (COS) Configuration
################################################################################

# COS Secret ID
# Obtain from: https://console.cloud.tencent.com/cam/capi
# Create sub-account with minimal permissions (recommended)
COS_SECRET_ID=your_cos_secret_id_here

# COS Secret Key
# IMPORTANT: Keep this secret secure
COS_SECRET_KEY=your_cos_secret_key_here

# COS Bucket name (format: bucket-name-appid)
# Create at: https://console.cloud.tencent.com/cos
# Example: workorder-photos-1234567890
COS_BUCKET=your-bucket-name-1234567890

# COS Region
# Options: ap-beijing, ap-shanghai, ap-guangzhou, ap-chengdu, etc.
# Choose region closest to your users for best performance
COS_REGION=ap-guangzhou

# COS upload path prefix (optional)
# Photos will be uploaded to: {COS_BUCKET}/{COS_PATH_PREFIX}/photos/
COS_PATH_PREFIX=production

# Maximum file size for uploads (bytes)
# Default: 10MB = 10 * 1024 * 1024
MAX_FILE_SIZE=10485760

################################################################################
# Notification Configuration
################################################################################

# Maximum retry attempts for failed notifications
NOTIFICATION_RETRY_MAX=3

# Delay between retry attempts (milliseconds)
# Default: 10 seconds
NOTIFICATION_RETRY_DELAY=10000

# Enable/disable notifications (true/false)
# Set to false to disable all notifications (e.g., during maintenance)
NOTIFICATION_ENABLED=true

################################################################################
# SLA Monitoring Configuration
################################################################################

# SLA check interval (milliseconds)
# Default: 60000 (1 minute)
# Recommended: Keep at 1 minute for timely alerts
SLA_CHECK_INTERVAL=60000

# SLA warning threshold (hours before deadline)
# Send warning notification this many hours before SLA deadline
SLA_WARNING_HOURS=2

# Enable/disable SLA monitoring (true/false)
SLA_MONITORING_ENABLED=true

################################################################################
# Logging Configuration
################################################################################

# Log level
# Options: error, warn, info, http, verbose, debug, silly
# Production: 'info' or 'warn'
# Development: 'debug'
LOG_LEVEL=info

# Log file directory
# Default: ./logs (relative to backend directory)
LOG_DIR=./logs

# Log file max size (bytes)
# Files will rotate when reaching this size
LOG_MAX_SIZE=10485760

# Log file max age (days)
# Old log files will be deleted after this many days
LOG_MAX_FILES=14

# Enable console logging (true/false)
# Disable in production if using log aggregation service
LOG_CONSOLE=true

# Enable file logging (true/false)
LOG_FILE=true

################################################################################
# Security Configuration
################################################################################

# CORS allowed origins (comma-separated)
# Add all domains that should be allowed to access the API
# Examples:
# - Single domain: https://yourdomain.com
# - Multiple domains: https://yourdomain.com,https://admin.yourdomain.com
# - All domains (NOT recommended): *
CORS_ORIGIN=https://yourdomain.com

# Rate limiting - requests per window
# Max number of requests per IP address per window
RATE_LIMIT_MAX=100

# Rate limiting - window (milliseconds)
# Time window for rate limiting (default: 15 minutes)
RATE_LIMIT_WINDOW=900000

# Enable helmet security headers (true/false)
# Recommended: true for production
HELMET_ENABLED=true

# Session secret (for future session-based auth)
# Generate with: openssl rand -base64 64
SESSION_SECRET=CHANGE_THIS_TO_RANDOM_SESSION_SECRET

################################################################################
# Email Configuration (Optional - for future email notifications)
################################################################################

# SMTP host
# Example: smtp.gmail.com, smtp.office365.com, smtp.sendgrid.net
# SMTP_HOST=smtp.gmail.com

# SMTP port
# Common ports: 587 (TLS), 465 (SSL), 25 (plain)
# SMTP_PORT=587

# SMTP user (email address)
# SMTP_USER=noreply@yourdomain.com

# SMTP password
# SMTP_PASSWORD=your_email_password

# Email from address
# EMAIL_FROM=Work Order System <noreply@yourdomain.com>

################################################################################
# Monitoring & Analytics (Optional)
################################################################################

# Sentry DSN for error tracking
# Sign up at: https://sentry.io/
# SENTRY_DSN=https://xxxxx@sentry.io/xxxxx

# Google Analytics ID (for future web dashboard)
# GA_TRACKING_ID=UA-XXXXXXXXX-X

# New Relic License Key (for performance monitoring)
# NEW_RELIC_LICENSE_KEY=your_new_relic_key

################################################################################
# Feature Flags (Optional)
################################################################################

# Enable duplicate detection feature (true/false)
FEATURE_DUPLICATE_DETECTION=true

# Enable analytics dashboard (true/false)
FEATURE_ANALYTICS=true

# Enable audit logs (true/false)
FEATURE_AUDIT_LOGS=true

# Enable photo uploads (true/false)
FEATURE_PHOTO_UPLOAD=true

################################################################################
# Maintenance Mode (Optional)
################################################################################

# Enable maintenance mode (true/false)
# When enabled, API returns 503 Service Unavailable
# MAINTENANCE_MODE=false

# Maintenance message
# MAINTENANCE_MESSAGE=System is under maintenance. Please try again later.

################################################################################
# Backup Configuration (Optional)
################################################################################

# Database backup directory
# BACKUP_DIR=/var/backups/workorder

# Backup retention days
# BACKUP_RETENTION_DAYS=30

################################################################################
# IMPORTANT SECURITY CHECKLIST
################################################################################
#
# Before deploying to production, ensure:
#
# ✓ Changed all default passwords
# ✓ Generated strong random secrets for JWT_SECRET and SESSION_SECRET
# ✓ Set DB_PASSWORD and REDIS_PASSWORD to strong values
# ✓ Configured actual WeChat AppID and Secret
# ✓ Configured actual COS credentials and bucket
# ✓ Set CORS_ORIGIN to your actual domain (not *)
# ✓ Set NODE_ENV=production
# ✓ Set LOG_LEVEL=info or warn
# ✓ Secured .env file permissions: chmod 600 .env
# ✓ Added .env to .gitignore
# ✓ Never committed .env to version control
# ✓ Set up SSL/TLS certificates for HTTPS
# ✓ Configured firewall rules
# ✓ Set up database backups
# ✓ Configured monitoring and alerting
#
################################################################################

################################################################################
# HOW TO OBTAIN API KEYS AND CREDENTIALS
################################################################################
#
# WeChat MiniProgram:
# 1. Register account at: https://mp.weixin.qq.com/
# 2. Create MiniProgram application
# 3. Navigate to: 开发 > 开发管理 > 开发设置
# 4. Copy AppID and AppSecret
#
# Tencent Cloud COS:
# 1. Sign up at: https://cloud.tencent.com/
# 2. Navigate to: 对象存储 COS
# 3. Create bucket
# 4. Navigate to: 访问管理 > API密钥管理
# 5. Create or view SecretId and SecretKey
# 6. Configure bucket CORS settings
#
# Template IDs (WeChat Subscription Messages):
# 1. Log in to: https://mp.weixin.qq.com/
# 2. Navigate to: 功能 > 订阅消息
# 3. Search and apply for required templates
# 4. Copy template IDs
#
################################################################################
