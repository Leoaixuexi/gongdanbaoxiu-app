              "raw": "{\n  \"floor\": \"5F\",\n  \"location\": \"Room 501\",\n  \"fault_type_id\": 1,\n  \"priority\": \"High\",\n  \"description\": \"Water leaking from ceiling in bathroom. Urgent repair needed. The leak started this morning and is getting worse.\",\n  \"photos_json\": []\n}"
